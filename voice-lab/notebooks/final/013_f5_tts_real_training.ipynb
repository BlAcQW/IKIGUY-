   "source": [
    "# Real F5 TTS trainer with flow-specific loss\n",
    "import torch.optim as optim\n",
    "from torch.optim.lr_scheduler import CosineAnnealingLR\n",
    "from torch.utils.tensorboard import SummaryWriter\n",
    "\n",
    "class RealF5Trainer:\n",
    "    \"\"\"REAL trainer for production F5 TTS training.\"\"\"\n",
    "    \n",
    "    def __init__(self, model, config, train_loader, val_loader):\n",
    "        self.model = model\n",
    "        self.config = config\n",
    "        self.train_loader = train_loader\n",
    "        self.val_loader = val_loader\n",
    "        self.device = next(model.parameters()).device\n",
    "        \n",
    "        # Optimizer with different learning rates for different components\n",
    "        flow_params = []\n",
    "        other_params = []\n",
    "        \n",
    "        for name, param in model.named_parameters():\n",
    "            if 'flows' in name:\n",
    "                flow_params.append(param)\n",
    "            else:\n",
    "                other_params.append(param)\n",
    "        \n",
    "        self.optimizer = optim.AdamW([\n",
    "            {'params': flow_params, 'lr': config.learning_rate},\n",
    "            {'params': other_params, 'lr': config.learning_rate * 0.5}  # Lower LR for non-flow components\n",
    "        ], weight_decay=1e-4)\n",
    "        \n",
    "        # Scheduler\n",
    "        self.scheduler = CosineAnnealingLR(\n",
    "            self.optimizer,\n",
    "            T_max=config.max_steps,\n",
    "            eta_min=config.learning_rate * 0.01\n",
    "        )\n",
    "        \n",
    "        # Logging\n",
    "        self.writer = SummaryWriter(log_dir=config.logs_dir)\n",
    "        \n",
    "        # Training state\n",
    "        self.global_step = 0\n",
    "        self.best_val_loss = float('inf')\n",
    "        self.patience_counter = 0\n",
    "    \n",
    "    def compute_loss(self, batch, outputs):\n",
    "        \"\"\"Compute flow-based training loss.\"\"\"\n",
    "        # Flow loss (negative log-likelihood)\n",
    "        z = outputs['z']\n",
    "        log_det = outputs['log_det']\n",
    "        prior_mean = outputs['prior_mean']\n",
    "        prior_log_std = outputs['prior_log_std']\n",
    "        \n",
    "        # Prior loss (KL divergence)\n",
    "        prior_std = torch.exp(prior_log_std)\n",
    "        prior_loss = 0.5 * torch.sum(\n",
    "            (z - prior_mean) ** 2 / (prior_std ** 2) + 2 * prior_log_std + math.log(2 * math.pi),\n",
    "            dim=-1\n",
    "        ).mean()\n",
    "        \n",
    "        # Flow loss (log determinant)\n",
    "        flow_loss = -log_det.mean()\n",
    "        \n",
    "        # Duration loss\n",
    "        durations_pred = outputs['durations']\n",
    "        text_lengths = batch['text_lengths'].to(self.device).float()\n",
    "        mel_lengths = batch['mel_lengths'].to(self.device).float()\n",
    "        \n",
    "        # Target duration per character\n",
    "        target_durations = (mel_lengths.unsqueeze(1) / text_lengths.unsqueeze(1))\n",
    "        target_durations = target_durations.expand(-1, durations_pred.shape[1])\n",
    "        \n",
    "        # Mask for valid positions\n",
    "        duration_mask = torch.arange(durations_pred.shape[1]).unsqueeze(0).to(self.device)\n",
    "        duration_mask = duration_mask < text_lengths.unsqueeze(1)\n",
    "        \n",
    "        if duration_mask.sum() > 0:\n",
    "            duration_loss = F.mse_loss(\n",
    "                durations_pred[duration_mask],\n",
    "                target_durations[duration_mask]\n",
    "            )\n",
    "        else:\n",
    "            duration_loss = torch.tensor(0.0).to(self.device)\n",
    "        \n",
    "        # Reconstruction loss (optional, for stability)\n",
    "        mel_target = batch['mel_specs'].to(self.device)\n",
    "        mel_enc = outputs['mel_enc']\n",
    "        \n",
    "        min_len = min(mel_target.shape[1], mel_enc.shape[1])\n",
    "        recon_loss = F.mse_loss(\n",
    "            mel_enc[:, :min_len],\n",
    "            mel_target[:, :min_len]\n",
    "        )\n",
    "        \n",
    "        # Combined loss\n",
    "        total_loss = prior_loss + flow_loss + 0.1 * duration_loss + 0.1 * recon_loss\n",
    "        \n",
    "        return {\n",
    "            'total_loss': total_loss,\n",
    "            'prior_loss': prior_loss,\n",
    "            'flow_loss': flow_loss,\n",
    "            'duration_loss': duration_loss,\n",
    "            'recon_loss': recon_loss\n",
    "        }\n",
    "    \n",
    "    def train_epoch(self):\n",
    "        \"\"\"Train for one epoch.\"\"\"\n",
    "        self.model.train()\n",
    "        epoch_losses = {'total': 0, 'prior': 0, 'flow': 0, 'duration': 0, 'recon': 0}\n",
    "        \n",
    "        for batch_idx, batch in enumerate(self.train_loader):\n",
    "            # Move batch to device\n",
    "            text_ids = batch['text_ids'].to(self.device)\n",
    "            speaker_embs = batch['speaker_embs'].to(self.device)\n",
    "            mel_specs = batch['mel_specs'].to(self.device)\n",
    "            \n",
    "            # Forward pass\n",
    "            outputs = self.model(text_ids, speaker_embs, mel_specs)\n",
    "            \n",
    "            # Compute loss\n",
    "            losses = self.compute_loss(batch, outputs)\n",
    "            \n",
    "            # Backward pass\n",
    "            self.optimizer.zero_grad()\n",
    "            losses['total_loss'].backward()\n",
    "            \n",
    "            # Gradient clipping\n",
    "            torch.nn.utils.clip_grad_norm_(self.model.parameters(), max_norm=5.0)\n",
    "            \n",
    "            self.optimizer.step()\n",
    "            self.scheduler.step()\n",
    "            \n",
    "            # Update running losses\n",
    "            epoch_losses['total'] += losses['total_loss'].item()\n",
    "            epoch_losses['prior'] += losses['prior_loss'].item()\n",
    "            epoch_losses['flow'] += losses['flow_loss'].item()\n",
    "            epoch_losses['duration'] += losses['duration_loss'].item()\n",
    "            epoch_losses['recon'] += losses['recon_loss'].item()\n",
    "            \n",
    "            # Logging\n",
    "            if self.global_step % self.config.logging_steps == 0:\n",
    "                current_lr = self.scheduler.get_last_lr()[0]\n",
    "                self.writer.add_scalar('train/total_loss', losses['total_loss'].item(), self.global_step)\n",
    "                self.writer.add_scalar('train/prior_loss', losses['prior_loss'].item(), self.global_step)\n",
    "                self.writer.add_scalar('train/flow_loss', losses['flow_loss'].item(), self.global_step)\n",
    "                self.writer.add_scalar('train/duration_loss', losses['duration_loss'].item(), self.global_step)\n",
    "                self.writer.add_scalar('train/recon_loss', losses['recon_loss'].item(), self.global_step)\n",
    "                self.writer.add_scalar('train/learning_rate', current_lr, self.global_step)\n",
    "                \n",
    "                print(f\"Step {self.global_step}: Total={losses['total_loss'].item():.4f}, \"\n",
    "                      f\"Prior={losses['prior_loss'].item():.4f}, Flow={losses['flow_loss'].item():.4f}, \"\n",
    "                      f\"Dur={losses['duration_loss'].item():.4f}, LR={current_lr:.2e}\")\n",
    "            \n",
    "            self.global_step += 1\n",
    "            \n",
    "            # Early stopping check\n",
    "            if self.global_step >= self.config.max_steps:\n",
    "                break\n",
    "        \n",
    "        # Average losses\n",
    "        num_batches = len(self.train_loader)\n",
    "        for key in epoch_losses:\n",
    "            epoch_losses[key] /= num_batches\n",
    "        \n",
    "        return epoch_losses\n",
    "    \n",
    "    def validate(self):\n",
    "        \"\"\"Validate the model.\"\"\"\n",
    "        self.model.eval()\n",
    "        val_losses = {'total': 0, 'prior': 0, 'flow': 0, 'duration': 0, 'recon': 0}\n",
    "        \n",
    "        with torch.no_grad():\n",
    "            for batch in self.val_loader:\n",
    "                # Move batch to device\n",
    "                text_ids = batch['text_ids'].to(self.device)\n",
    "                speaker_embs = batch['speaker_embs'].to(self.device)\n",
    "                mel_specs = batch['mel_specs'].to(self.device)\n",
    "                \n",
    "                # Forward pass\n",
    "                outputs = self.model(text_ids, speaker_embs, mel_specs)\n",
    "                \n",
    "                # Compute loss\n",
    "                losses = self.compute_loss(batch, outputs)\n",
    "                \n",
    "                val_losses['total'] += losses['total_loss'].item()\n",
    "                val_losses['prior'] += losses['prior_loss'].item()\n",
    "                val_losses['flow'] += losses['flow_loss'].item()\n",
    "                val_losses['duration'] += losses['duration_loss'].item()\n",
    "                val_losses['recon'] += losses['recon_loss'].item()\n",
    "        \n",
    "        # Average losses\n",
    "        num_batches = len(self.val_loader)\n",
    "        for key in val_losses:\n",
    "            val_losses[key] /= num_batches\n",
    "        \n",
    "        return val_losses\n",
    "    \n",
    "    def save_checkpoint(self, epoch, val_loss):\n",
    "        \"\"\"Save model checkpoint.\"\"\"\n",
    "        checkpoint = {\n",
    "            'epoch': epoch,\n",
    "            'global_step': self.global_step,\n",
    "            'model_state_dict': self.model.state_dict(),\n",
    "            'optimizer_state_dict': self.optimizer.state_dict(),\n",
    "            'scheduler_state_dict': self.scheduler.state_dict(),\n",
    "            'val_loss': val_loss,\n",
    "            'config': self.config\n",
    "        }\n",
    "        \n",
    "        checkpoint_path = self.config.checkpoints_dir / f'checkpoint_step_{self.global_step}.pt'\n",
    "        torch.save(checkpoint, checkpoint_path)\n",
    "        \n",
    "        # Save best model\n",
    "        if val_loss < self.best_val_loss:\n",
    "            self.best_val_loss = val_loss\n",
    "            best_path = self.config.output_dir / 'best_f5_model.pt'\n",
    "            torch.save(checkpoint, best_path)\n",
    "            self.patience_counter = 0\n",
    "        else:\n",
    "            self.patience_counter += 1\n",
    "    \n",
    "    def train(self):\n",
    "        \"\"\"Full training loop.\"\"\"\n",
    "        print(f\"\\n🚀 Starting REAL F5 TTS training...\")\n",
    "        \n",
    "        for epoch in range(self.config.num_train_epochs):\n",
    "            if self.global_step >= self.config.max_steps:\n",
    "                break\n",
    "            \n",
    "            print(f\"\\n📊 Epoch {epoch + 1}/{self.config.num_train_epochs}\")\n",
    "            \n",
    "            # Train\n",
    "            train_losses = self.train_epoch()\n",
    "            print(f\"   Train - Total: {train_losses['total']:.4f}, Prior: {train_losses['prior']:.4f}, \"\n",
    "                  f\"Flow: {train_losses['flow']:.4f}, Duration: {train_losses['duration']:.4f}\")\n",
    "            \n",
    "            # Validate\n",
    "            if epoch % 2 == 0:  # Validate every 2 epochs\n",
    "                val_losses = self.validate()\n",
    "                print(f\"   Val - Total: {val_losses['total']:.4f}, Prior: {val_losses['prior']:.4f}, \"\n",
    "                      f\"Flow: {val_losses['flow']:.4f}, Duration: {val_losses['duration']:.4f}\")\n",
    "                \n",
    "                # Log validation losses\n",
    "                self.writer.add_scalar('val/total_loss', val_losses['total'], self.global_step)\n",
    "                self.writer.add_scalar('val/prior_loss', val_losses['prior'], self.global_step)\n",
    "                self.writer.add_scalar('val/flow_loss', val_losses['flow'], self.global_step)\n",
    "                self.writer.add_scalar('val/duration_loss', val_losses['duration'], self.global_step)\n",
    "                \n",
    "                # Save checkpoint\n",
    "                self.save_checkpoint(epoch, val_losses['total'])\n",
    "                \n",
    "                # Early stopping\n",
    "                if self.patience_counter >= self.config.early_stopping_patience:\n",
    "                    print(f\"\\n⚠️ Early stopping triggered after {self.patience_counter} epochs without improvement\")\n",
    "                    break\n",
    "        \n",
    "        print(f\"\\n✅ Training completed!\")\n",
    "        print(f\"   Total steps: {self.global_step}\")\n",
    "        print(f\"   Best validation loss: {self.best_val_loss:.4f}\")\n",
    "        \n",
    "        self.writer.close()\n",
    "\n",
    "# Initialize trainer\n",
    "trainer = RealF5Trainer(f5_model, config, train_loader, val_loader)\n",
    "\n",
    "print(f\"\\n✅ REAL F5 TTS trainer initialized!\")\n",
    "print(f\"   Training samples: {len(train_dataset)}\")\n",
    "print(f\"   Validation samples: {len(val_dataset)}\")\n",
