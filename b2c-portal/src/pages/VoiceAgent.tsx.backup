            <div 
              className={`flex items-center ${sidebarCollapsed ? 'justify-center' : 'space-x-2'} px-2 py-2 rounded-md text-gray-300 hover:bg-gray-800 cursor-pointer`}
              title={sidebarCollapsed ? "Call Logs" : ""}
            >
              <Phone className="w-4 h-4" />
              {!sidebarCollapsed && <span className="text-sm">Call Logs</span>}
            </div>
            <div 
              className={`flex items-center ${sidebarCollapsed ? 'justify-center' : 'space-x-2'} px-2 py-2 rounded-md text-gray-300 hover:bg-gray-800 cursor-pointer`}
              title={sidebarCollapsed ? "Chat Logs" : ""}
            >
              <MessageCircle className="w-4 h-4" />
              {!sidebarCollapsed && <span className="text-sm">Chat Logs</span>}
            </div>
            <div 
              className={`flex items-center ${sidebarCollapsed ? 'justify-center' : 'space-x-2'} px-2 py-2 rounded-md text-gray-300 hover:bg-gray-800 cursor-pointer`}
              title={sidebarCollapsed ? "Session Logs" : ""}
            >
              <BarChart3 className="w-4 h-4" />
              {!sidebarCollapsed && <span className="text-sm">Session Logs</span>}
            </div>
          </div>
        </div>

        {/* Credits */}
        <div className={`${sidebarCollapsed ? 'p-2' : 'p-4'} border-t border-gray-800`}>
          {sidebarCollapsed ? (
            <div className="text-center">
              <div className="text-xs text-gray-400 mb-1">29.52</div>
              <button className="w-full bg-green-600 hover:bg-green-700 text-white py-1 px-2 rounded-md text-xs font-medium transition-colors">
                ↑
              </button>
            </div>
          ) : (
            <>
              <div className="text-sm text-gray-400 mb-2">PAYG</div>
              <div className="text-lg font-semibold mb-2">29.52 Credits</div>
              <button className="w-full bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-md text-sm font-medium transition-colors">
                ↑ Buy Credits
              </button>
