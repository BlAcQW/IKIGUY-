    "# Kokoro TTS dataset preparation and model setup\n",
    "class KokoroDatasetPreparer:\n",
    "    \"\"\"Prepare dataset for Kokoro TTS training.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: KokoroManifestConfig):\n",
    "        self.config = config\n",
    "        \n",
    "    def prepare_kokoro_dataset(self, manifests: Dict[str, pd.DataFrame]) -> Path:\n",
    "        \"\"\"Prepare dataset in Kokoro TTS format.\"\"\"\n",
    "        print(\"📦 Preparing Kokoro TTS dataset from manifests...\")\n",
    "        \n",
    "        dataset_dir = self.config.kokoro_dataset_dir\n",
    "        audio_dir = dataset_dir / \"audio\"\n",
    "        audio_dir.mkdir(parents=True, exist_ok=True)\n",
    "        \n",
    "        # Combine all manifests\n",
    "        all_samples = pd.DataFrame()\n",
    "        for split_name, df in manifests.items():\n",
    "            if not df.empty:\n",
    "                all_samples = pd.concat([all_samples, df], ignore_index=True)\n",
    "        \n",
    "        if all_samples.empty:\n",
    "            print(\"   ❌ No samples to process\")\n",
    "            return None\n",
    "        \n",
    "        print(f\"   📊 Processing {len(all_samples)} total samples\")\n",
    "        \n",
    "        # Process and save audio files\n",
    "        processed_samples = []\n",
    "        \n",
    "        for _, row in tqdm(all_samples.iterrows(), total=len(all_samples), desc=\"Processing audio\"):\n",
    "            try:\n",
    "                audio_path = Path(row['audio_path'])\n",
    "                if not audio_path.exists():\n",
    "                    continue\n",
    "                \n",
    "                # Load and resample to 24kHz\n",
    "                audio, sr = librosa.load(audio_path, sr=self.config.sample_rate)\n",
    "                \n",
    "                # Apply high-quality processing\n",
    "                audio = self._process_audio_for_kokoro(audio)\n",
    "                \n",
    "                # Create output filename\n",
    "                dataset_name = row.get('dataset', 'unknown')\n",
    "                speaker_id = row.get('speaker_id', 'default')\n",
    "                original_stem = audio_path.stem\n",
    "                \n",
    "                output_filename = f\"{dataset_name}_{speaker_id}_{original_stem}.wav\"\n",
    "                output_path = audio_dir / output_filename\n",
    "                \n",
    "                # Save high-quality audio\n",
    "                sf.write(output_path, audio, self.config.sample_rate, subtype='PCM_24')\n",
    "                \n",
    "                # Get processed text\n",
    "                text = row.get('processed_text', row.get('text', ''))\n",
    "                phonemes = row.get('phonemes', text)\n",
    "                \n",
    "                if len(text) > 0:\n",
    "                    processed_samples.append({\n",
    "                        'audio_path': str(output_path),\n",
    "                        'text': text,\n",
    "                        'phonemes': phonemes,\n",
    "                        'speaker_id': speaker_id,\n",
    "                        'duration': len(audio) / self.config.sample_rate,\n",
    "                        'language': row.get('language', 'tw'),\n",
    "                        'dataset': dataset_name\n",
    "                    })\n",
    "                    \n",
    "            except Exception as e:\n",
    "                print(f\"   ⚠️ Error processing {row.get('audio_path', 'unknown')}: {e}\")\n",
    "                continue\n",
    "        \n",
    "        print(f\"   ✅ Successfully processed {len(processed_samples)} samples\")\n",
    "        \n",
    "        # Create training datasets\n",
    "        self._create_kokoro_datasets(dataset_dir, processed_samples)\n",
    "        \n",
    "        # Create model configuration\n",
    "        self._create_kokoro_config(dataset_dir, processed_samples)\n",
    "        \n",
    "        print(f\"   📁 Dataset prepared at: {dataset_dir}\")\n",
    "        return dataset_dir\n",
    "    \n",
    "    def _process_audio_for_kokoro(self, audio: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"Apply high-quality audio processing for Kokoro TTS.\"\"\"\n",
    "        # Normalize audio\n",
    "        if audio.max() > 0:\n",
    "            audio = audio / audio.max() * 0.95\n",
    "        \n",
    "        # Apply gentle filtering for better quality\n",
    "        try:\n",
    "            from scipy import signal\n",
    "            \n",
    "            # High-pass filter at 80Hz to remove low-frequency noise\n",
    "            sos = signal.butter(2, 80, btype='high', fs=self.config.sample_rate, output='sos')\n",
    "            audio = signal.sosfilt(sos, audio)\n",
    "            \n",
    "            # Gentle low-pass filter at 11kHz for anti-aliasing\n",
    "            sos = signal.butter(2, 11000, btype='low', fs=self.config.sample_rate, output='sos')\n",
    "            audio = signal.sosfilt(sos, audio)\n",
    "            \n",
    "        except ImportError:\n",
    "            # If scipy not available, skip filtering\n",
    "            pass\n",
    "        \n",
    "        return audio.astype(np.float32)\n",
    "    \n",
    "    def _create_kokoro_datasets(self, dataset_dir: Path, samples: List[Dict]):\n",
    "        \"\"\"Create training and validation datasets for Kokoro.\"\"\"\n",
    "        print(\"   📊 Creating Kokoro training datasets...\")\n",
    "        \n",
    "        # Convert to DataFrame for easier manipulation\n",
    "        df = pd.DataFrame(samples)\n",
    "        \n",
    "        # Shuffle and split\n",
    "        df = df.sample(frac=1, random_state=42).reset_index(drop=True)\n",
    "        split_idx = int(len(df) * 0.9)\n",
    "        \n",
    "        train_df = df.iloc[:split_idx]\n",
    "        val_df = df.iloc[split_idx:]\n",
    "        \n",
    "        # Save as JSON for easy loading\n",
    "        train_path = dataset_dir / \"train_dataset.json\"\n",
    "        val_path = dataset_dir / \"val_dataset.json\"\n",
    "        \n",
    "        train_df.to_json(train_path, orient='records', indent=2)\n",
    "        val_df.to_json(val_path, orient='records', indent=2)\n",
    "        \n",
    "        # Also save as CSV for compatibility\n",
    "        train_df.to_csv(dataset_dir / \"train_dataset.csv\", index=False)\n",
    "        val_df.to_csv(dataset_dir / \"val_dataset.csv\", index=False)\n",
    "        \n",
    "        print(f\"     Train: {len(train_df)} samples\")\n",
    "        print(f\"     Validation: {len(val_df)} samples\")\n",
    "        \n",
    "    def _create_kokoro_config(self, dataset_dir: Path, samples: List[Dict]):\n",
    "        \"\"\"Create Kokoro model configuration.\"\"\"\n",
    "        df = pd.DataFrame(samples)\n",
    "        \n",
    "        kokoro_config = {\n",
    "            # Model architecture\n",
    "            \"model\": {\n",
    "                \"name\": \"kokoro_tts\",\n",
    "                \"sample_rate\": self.config.sample_rate,\n",
    "                \"hop_length\": self.config.hop_length,\n",
    "                \"win_length\": self.config.win_length,\n",
    "                \"n_fft\": self.config.n_fft,\n",
    "                \"n_mels\": self.config.n_mels,\n",
    "                \"max_text_length\": self.config.max_text_length\n",
    "            },\n",
    "            \n",
    "            # Training configuration\n",
    "            \"training\": {\n",
    "                \"batch_size\": self.config.batch_size,\n",
    "                \"learning_rate\": self.config.learning_rate,\n",
    "                \"num_epochs\": self.config.num_epochs,\n",
    "                \"warmup_steps\": self.config.warmup_steps,\n",
    "                \"eval_steps\": self.config.eval_steps,\n",
    "                \"save_steps\": self.config.save_steps\n",
    "            },\n",
    "            \n",
    "            # Dataset information\n",
    "            \"dataset\": {\n",
    "                \"name\": \"twi_kokoro_manifests\",\n",
    "                \"language\": \"tw\",\n",
    "                \"total_samples\": len(samples),\n",
    "                \"unique_speakers\": df['speaker_id'].nunique(),\n",
    "                \"total_duration_hours\": df['duration'].sum() / 3600,\n",
    "                \"average_duration\": df['duration'].mean(),\n",
    "                \"datasets_included\": df['dataset'].unique().tolist()\n",
    "            },\n",
    "            \n",
    "            # Optimization settings\n",
    "            \"optimization\": {\n",
    "                \"use_onnx\": self.config.use_onnx,\n",
    "                \"quantization\": self.config.quantization,\n",
    "                \"optimize_for_mobile\": self.config.optimize_for_mobile\n",
    "            }\n",
    "        }\n",
    "        \n",
    "        config_path = dataset_dir / \"kokoro_config.json\"\n",
    "        with open(config_path, 'w', encoding='utf-8') as f:\n",
    "            json.dump(kokoro_config, f, indent=2, ensure_ascii=False)\n",
    "        \n",
    "        print(f\"   📋 Kokoro config saved to: {config_path}\")\n",
    "\n",
    "# Prepare dataset if processed manifests are available\n",
    "if any(not df.empty for df in processed_manifests.values()):\n",
    "    dataset_preparer = KokoroDatasetPreparer(config)\n",
    "    kokoro_dataset_path = dataset_preparer.prepare_kokoro_dataset(processed_manifests)\n",
