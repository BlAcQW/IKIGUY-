        voice-show-transcript="true"
        consent-required="false"
    ></vapi-widget>

    <script src="https://unpkg.com/@vapi-ai/client-sdk-react/dist/embed/widget.umd.js" async type="text/javascript"></script>

    <script>
        // Helper functions to trigger Vapi widgets
        function triggerVapiVoice() {
            // Trigger the voice widget (bottom-right)
            const vapiWidgets = document.querySelectorAll('vapi-widget');
            const voiceWidget = Array.from(vapiWidgets).find(w => w.getAttribute('mode') === 'voice');
            if (voiceWidget) {
                // Scroll to widget
                voiceWidget.scrollIntoView({ behavior: 'smooth', block: 'end' });
                // The widget will open automatically when user interacts
            }
        }

        function triggerVapiChat() {
            // Trigger the chat widget (bottom-left)
            const vapiWidgets = document.querySelectorAll('vapi-widget');
            const chatWidget = Array.from(vapiWidgets).find(w => w.getAttribute('mode') === 'chat');
            if (chatWidget) {
                // Scroll to widget
                chatWidget.scrollIntoView({ behavior: 'smooth', block: 'end' });
                // The widget will open automatically when user interacts
            }
        }

        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add visual indicator for dual widgets on page load
        window.addEventListener('load', function() {
            console.log('Premier Health Demo: Voice widget (bottom-right) and Chat widget (bottom-left) loaded successfully');
        });
    </script>

</body>
</html>
