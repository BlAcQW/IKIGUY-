   "source": [
    "# OPTIMIZED path setup for Google Drive integration\n",
    "if IN_COLAB:\n",
    "    from google.colab import drive\n",
    "    drive.mount('/content/drive')\n",
    "    BASE_DIR = Path('/content/drive/My Drive/voice-lab-data')\n",
    "elif IN_KAGGLE:\n",
    "    BASE_DIR = Path('/kaggle/working/voice-lab-data')\n",
    "else:\n",
    "    # For local development\n",
    "    BASE_DIR = Path('G:/My Drive/voice-lab-data')\n",
    "\n",
    "# Enhanced directory structure\n",
    "DIRS = {\n",
    "    'base': BASE_DIR,\n",
    "    'raw': BASE_DIR / 'raw',\n",
    "    'processed': BASE_DIR / 'processed',\n",
    "    'asr_ready': BASE_DIR / 'processed' / 'asr_ready',\n",
    "    'splits': BASE_DIR / 'splits',\n",
    "    'models': BASE_DIR / 'models' / 'faster_whisper',\n",
    "    'checkpoints': BASE_DIR / 'checkpoints' / 'faster_whisper',\n",
    "    'exports': BASE_DIR / 'exports' / 'faster_whisper',\n",
    "    'ct2_models': BASE_DIR / 'models' / 'ct2_optimized',\n",
    "    'metrics': BASE_DIR / 'metrics' / 'faster_whisper',\n",
    "    'cache': BASE_DIR / 'cache'\n",
    "}\n",
    "\n",
    "# Create directories\n",
    "for dir_path in DIRS.values():\n",
    "    dir_path.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print(f\"📁 Base directory: {BASE_DIR}\")\n",
    "print(f\"📁 Models directory: {DIRS['models']}\")\n",
    "print(f\"📁 CTranslate2 directory: {DIRS['ct2_models']}\")\n",
    "print(\"✅ Directory structure ready\")\n",
    "\n",
    "# Check data availability\n",
    "splits_available = (DIRS['splits'] / 'train.csv').exists()\n",
    "michset_available = (DIRS['raw'] / 'michsethowusu').exists()\n",
    "\n",
    "print(f\"\\n🔍 Data Availability:\")\n",
    "print(f\"  Splits data: {'✅' if splits_available else '❌'}\")\n",
    "print(f\"  MichSet raw: {'✅' if michset_available else '❌'}\")\n",
    "\n",
    "@dataclass\n",
    "class OptimizedFasterWhisperConfig:\n",
    "    \"\"\"Optimized configuration for Faster-Whisper training and deployment.\"\"\"\n",
    "    \n",
    "    # Model selection\n",
    "    model_name: str = \"openai/whisper-small\"  # Base model for training\n",
    "    base_language: str = \"en\"  # Use English as base (Twi not supported)\n",
    "    target_language: str = \"twi\"  # Our actual target\n",
    "    task: str = \"transcribe\"\n",
    "    \n",
    "    # Training parameters\n",
    "    batch_size: int = 8  # Optimized for memory\n",
    "    gradient_accumulation_steps: int = 4  # Effective batch size = 32\n",
    "    learning_rate: float = 1e-5\n",
    "    warmup_steps: int = 500\n",
    "    max_steps: int = 3000  # Reasonable training steps\n",
    "    num_train_epochs: int = 10\n",
    "    \n",
    "    # Performance optimization\n",
    "    fp16: bool = True\n",
    "    gradient_checkpointing: bool = True\n",
    "    dataloader_num_workers: int = 2\n",
    "    \n",
    "    # Audio settings\n",
    "    sample_rate: int = 16000\n",
    "    max_duration: float = 30.0\n",
    "    min_duration: float = 0.5\n",
    "    \n",
    "    # CTranslate2 optimization settings\n",
    "    ct2_quantization: str = \"int8_float16\"  # Options: int8, int8_float16, float16\n",
    "    ct2_compute_type: str = \"int8_float16\"  # For inference\n",
    "    \n",
    "    # Evaluation and logging\n",
    "    eval_steps: int = 250\n",
    "    save_steps: int = 250\n",
    "    logging_steps: int = 50\n",
    "    save_total_limit: int = 3\n",
    "    \n",
    "    # Multi-dialect support\n",
    "    target_dialects: List[str] = None\n",
    "    \n",
    "    def __post_init__(self):\n",
    "        if self.target_dialects is None:\n",
    "            self.target_dialects = [\"twi\", \"asante_twi\", \"akuapem_twi\", \"fante\", \"ga\"]\n",
    "        \n",
    "        # Set output directories\n",
    "        self.output_dir = DIRS['checkpoints'] / f\"whisper-{self.target_language}-{int(time.time())}\"\n",
    "        self.final_model_dir = DIRS['models'] / f\"whisper-{self.target_language}-optimized\"\n",
    "        self.ct2_output_dir = DIRS['ct2_models'] / f\"whisper-{self.target_language}-ct2\"\n",
    "        \n",
    "        # Create directories\n",
    "        for dir_path in [self.output_dir, self.final_model_dir, self.ct2_output_dir]:\n",
    "            dir_path.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "config = OptimizedFasterWhisperConfig()\n",
    "print(f\"\\n📋 Optimized Faster-Whisper Configuration loaded\")\n",
    "print(f\"🎯 Base model: {config.model_name}\")\n",
    "print(f\"🗣️ Target dialects: {', '.join(config.target_dialects)}\")\n",
    "print(f\"📊 Effective batch size: {config.batch_size * config.gradient_accumulation_steps}\")\n",
    "print(f\"⚡ CTranslate2 quantization: {config.ct2_quantization}\")\n",
    "print(f\"💾 Final model: {config.final_model_dir}\")\n",
    "print(f\"🚀 CT2 model: {config.ct2_output_dir}\")"
   ]
