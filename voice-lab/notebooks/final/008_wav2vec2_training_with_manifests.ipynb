    "# Create vocabulary and tokenizer from manifests\n",
    "class TwiVocabularyBuilder:\n",
    "    \"\"\"Build Twi vocabulary from manifest data.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: Wav2Vec2ManifestConfig):\n",
    "        self.config = config\n",
    "        \n",
    "    def build_vocabulary_from_manifests(self, manifests: Dict[str, pd.DataFrame]) -> List[str]:\n",
    "        \"\"\"Extract vocabulary from manifest transcripts.\"\"\"\n",
    "        print(\"📝 Building Twi vocabulary from manifests...\")\n",
    "        \n",
    "        all_texts = []\n",
    "        for split_name, df in manifests.items():\n",
    "            if not df.empty and 'transcript' in df.columns:\n",
    "                all_texts.extend(df['transcript'].tolist())\n",
    "        \n",
    "        if not all_texts:\n",
    "            print(\"   ⚠️ No transcripts found, using default Twi alphabet\")\n",
    "            return self._get_default_twi_alphabet()\n",
    "        \n",
    "        print(f\"   📊 Processing {len(all_texts)} transcripts\")\n",
    "        \n",
    "        # Extract unique characters\n",
    "        vocab = set()\n",
    "        \n",
    "        for text in all_texts:\n",
    "            if isinstance(text, str):\n",
    "                # Clean text\n",
    "                cleaned_text = self._clean_text_for_vocab(text)\n",
    "                # Add characters to vocabulary\n",
    "                vocab.update(cleaned_text.lower())\n",
    "        \n",
    "        # Convert to sorted list\n",
    "        vocab_list = sorted(list(vocab))\n",
    "        \n",
    "        # Add special tokens\n",
    "        special_tokens = ['[PAD]', '[UNK]', '[CLS]', '[SEP]', '[MASK]']\n",
    "        vocab_list = special_tokens + vocab_list\n",
    "        \n",
    "        print(f\"   ✅ Built vocabulary with {len(vocab_list)} characters\")\n",
    "        print(f\"   📝 Sample characters: {vocab_list[5:15]}\")\n",
    "        \n",
    "        # Save vocabulary\n",
    "        vocab_path = self.config.vocab_dir / \"twi_vocab.json\"\n",
    "        vocab_dict = {char: i for i, char in enumerate(vocab_list)}\n",
    "        \n",
    "        with open(vocab_path, 'w', encoding='utf-8') as f:\n",
    "            json.dump(vocab_dict, f, ensure_ascii=False, indent=2)\n",
    "        \n",
    "        print(f\"   💾 Vocabulary saved to: {vocab_path}\")\n",
    "        \n",
    "        return vocab_list\n",
    "    \n",
    "    def _clean_text_for_vocab(self, text: str) -> str:\n",
    "        \"\"\"Clean text for vocabulary extraction.\"\"\"\n",
    "        import re\n",
    "        \n",
    "        # Remove unwanted characters but keep Twi-specific ones\n",
    "        # Keep: letters, Twi diacritics, spaces, common punctuation\n",
    "        text = re.sub(r'[^\\w\\sɛɔãẽĩõũáéíóúàèìòùŋ.,!?\\'\\-]', '', text)\n",
    "        \n",
    "        # Normalize whitespace\n",
    "        text = re.sub(r'\\s+', ' ', text)\n",
    "        \n",
    "        return text.strip()\n",
    "    \n",
    "    def _get_default_twi_alphabet(self) -> List[str]:\n",
    "        \"\"\"Get default Twi alphabet if no data available.\"\"\"\n",
    "        # Basic Latin alphabet\n",
    "        alphabet = list(\"abcdefghijklmnopqrstuvwxyz\")\n",
    "        \n",
    "        # Twi-specific characters\n",
    "        twi_chars = ['ɛ', 'ɔ', 'ŋ', 'ã', 'ẽ', 'ĩ', 'õ', 'ũ', 'á', 'é', 'í', 'ó', 'ú', 'à', 'è', 'ì', 'ò', 'ù']\n",
    "        alphabet.extend(twi_chars)\n",
    "        \n",
    "        # Common punctuation and symbols\n",
    "        punctuation = [' ', '.', ',', '!', '?', \"'\", '-']\n",
    "        alphabet.extend(punctuation)\n",
    "        \n",
    "        # Special tokens\n",
    "        special_tokens = ['[PAD]', '[UNK]', '[CLS]', '[SEP]', '[MASK]']\n",
    "        alphabet = special_tokens + alphabet\n",
    "        \n",
    "        return alphabet\n",
    "\n",
    "# Build vocabulary\n",
    "vocab_builder = TwiVocabularyBuilder(config)\n",
    "vocabulary = vocab_builder.build_vocabulary_from_manifests(manifests)\n",
    "\n",
    "print(f\"\\n📚 Vocabulary Summary:\")\n",
    "print(f\"   Total characters: {len(vocabulary)}\")\n",
    "print(f\"   Special tokens: {vocabulary[:5]}\")\n",
    "print(f\"   Twi characters: {[c for c in vocabulary if c in 'ɛɔŋãẽĩõũáéíóúàèìòù']}\")"
   ]
