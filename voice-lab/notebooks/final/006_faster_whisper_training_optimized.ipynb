    "class ProductionWhisperTrainer:\n",
    "    \"\"\"Production-ready Whisper trainer for Faster-Whisper deployment.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: OptimizedFasterWhisperConfig, processor):\n",
    "        self.config = config\n",
    "        self.processor = processor\n",
    "        self.model = None\n",
    "        self.trainer = None\n",
    "        \n",
    "    def initialize_model(self):\n",
    "        \"\"\"Initialize Whisper model with enhanced configuration.\"\"\"\n",
    "        print(f\"🚀 Loading enhanced {self.config.model_name}...\")\n",
    "        \n",
    "        try:\n",
    "            self.model = WhisperForConditionalGeneration.from_pretrained(\n",
    "                self.config.model_name,\n",
    "                cache_dir=DIRS['cache']\n",
    "            )\n",
    "            \n",
    "            # Resize token embeddings for added Twi tokens\n",
    "            self.model.resize_token_embeddings(len(self.processor.tokenizer))\n",
    "            \n",
    "            # Set language and task configuration\n",
    "            self.model.generation_config.language = self.config.base_language\n",
    "            self.model.generation_config.task = self.config.task\n",
    "            self.model.generation_config.forced_decoder_ids = None\n",
    "            \n",
    "            # Enable performance optimizations\n",
    "            if self.config.gradient_checkpointing:\n",
    "                self.model.gradient_checkpointing_enable()\n",
    "                print(\"✅ Gradient checkpointing enabled\")\n",
    "            \n",
    "            # Move to device\n",
    "            if torch.cuda.is_available():\n",
    "                self.model = self.model.to(DEVICE)\n",
    "                print(f\"🚀 Model moved to {DEVICE}\")\n",
    "            \n",
    "            total_params = sum(p.numel() for p in self.model.parameters())\n",
    "            trainable_params = sum(p.numel() for p in self.model.parameters() if p.requires_grad)\n",
    "            \n",
    "            print(f\"✅ Model loaded successfully\")\n",
    "            print(f\"📊 Total parameters: {total_params:,}\")\n",
    "            print(f\"📊 Trainable parameters: {trainable_params:,}\")\n",
    "            print(f\"📊 Vocabulary size: {len(self.processor.tokenizer):,}\")\n",
    "            \n",
    "            return self.model\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Model initialization failed: {e}\")\n",
    "            return None\n",
    "    \n",
    "    def setup_enhanced_training(self, train_dataset, eval_dataset):\n",
    "        \"\"\"Setup enhanced training configuration for production.\"\"\"\n",
    "        print(\"🔧 Setting up enhanced training configuration...\")\n",
    "        \n",
    "        # Enhanced training arguments\n",
    "        training_args = Seq2SeqTrainingArguments(\n",
    "            output_dir=str(self.config.output_dir),\n",
    "            \n",
    "            # Batch and gradient settings\n",
    "            per_device_train_batch_size=self.config.batch_size,\n",
    "            per_device_eval_batch_size=self.config.batch_size * 2,\n",
    "            gradient_accumulation_steps=self.config.gradient_accumulation_steps,\n",
    "            gradient_checkpointing=self.config.gradient_checkpointing,\n",
    "            \n",
    "            # Learning and optimization\n",
    "            learning_rate=self.config.learning_rate,\n",
    "            warmup_steps=self.config.warmup_steps,\n",
    "            max_steps=self.config.max_steps,\n",
    "            num_train_epochs=self.config.num_train_epochs,\n",
    "            \n",
    "            # Performance optimization\n",
    "            fp16=self.config.fp16 and torch.cuda.is_available(),\n",
    "            dataloader_num_workers=self.config.dataloader_num_workers,\n",
    "            \n",
    "            # Evaluation and saving\n",
    "            evaluation_strategy=\"steps\",\n",
    "            save_strategy=\"steps\",\n",
    "            eval_steps=self.config.eval_steps,\n",
    "            save_steps=self.config.save_steps,\n",
    "            logging_steps=self.config.logging_steps,\n",
    "            save_total_limit=self.config.save_total_limit,\n",
    "            \n",
    "            # Model selection\n",
    "            load_best_model_at_end=True,\n",
    "            metric_for_best_model=\"wer\",\n",
    "            greater_is_better=False,\n",
    "            \n",
    "            # Generation settings\n",
    "            predict_with_generate=True,\n",
    "            generation_max_length=225,\n",
    "            \n",
    "            # Logging and reporting\n",
    "            report_to=[\"tensorboard\"],\n",
    "            logging_dir=str(self.config.output_dir / \"logs\"),\n",
    "            \n",
    "            # Other settings\n",
    "            remove_unused_columns=False,\n",
    "            push_to_hub=False,\n",
    "            seed=42,\n",
    "        )\n",
    "        \n",
    "        # Enhanced data collator\n",
    "        data_collator = DataCollatorSpeechSeq2SeqWithPadding(\n",
    "            processor=self.processor,\n",
    "            decoder_start_token_id=self.model.config.decoder_start_token_id,\n",
    "        )\n",
    "        \n",
    "        # Enhanced metrics computation\n",
    "        def compute_enhanced_metrics(pred):\n",
    "            pred_ids = pred.predictions\n",
    "            label_ids = pred.label_ids\n",
    "            \n",
    "            # Replace -100 with pad token id\n",
    "            label_ids[label_ids == -100] = self.processor.tokenizer.pad_token_id\n",
    "            \n",
    "            # Decode predictions and references\n",
    "            pred_str = self.processor.tokenizer.batch_decode(pred_ids, skip_special_tokens=True)\n",
    "            label_str = self.processor.tokenizer.batch_decode(label_ids, skip_special_tokens=True)\n",
    "            \n",
    "            # Clean dialect markers for evaluation\n",
    "            def clean_text(text):\n",
    "                for marker in ['[ASANTE]', '[AKUAPEM]', '[FANTE]', '[GA]', '[TWI]']:\n",
    "                    text = text.replace(marker, '')\n",
    "                return text.strip()\n",
    "            \n",
    "            cleaned_pred = [clean_text(pred) for pred in pred_str]\n",
    "            cleaned_label = [clean_text(label) for label in label_str]\n",
    "            \n",
    "            # Compute metrics\n",
    "            wer_metric = evaluate.load(\"wer\")\n",
    "            cer_metric = evaluate.load(\"cer\")\n",
    "            \n",
    "            try:\n",
    "                wer = wer_metric.compute(predictions=cleaned_pred, references=cleaned_label)\n",
    "                cer = cer_metric.compute(predictions=cleaned_pred, references=cleaned_label)\n",
    "                \n",
    "                # Additional metrics\n",
    "                exact_matches = sum(1 for p, r in zip(cleaned_pred, cleaned_label) if p == r)\n",
    "                exact_match_rate = exact_matches / len(cleaned_pred) if cleaned_pred else 0\n",
    "                \n",
    "                return {\n",
    "                    \"wer\": wer * 100,  # Convert to percentage\n",
    "                    \"cer\": cer * 100,\n",
    "                    \"exact_match_rate\": exact_match_rate * 100\n",
    "                }\n",
    "            except Exception as e:\n",
    "                print(f\"⚠️ Metrics computation error: {e}\")\n",
    "                return {\"wer\": 100.0, \"cer\": 100.0, \"exact_match_rate\": 0.0}\n",
    "        \n",
    "        # Initialize enhanced trainer\n",
    "        self.trainer = Seq2SeqTrainer(\n",
    "            args=training_args,\n",
    "            model=self.model,\n",
    "            train_dataset=train_dataset,\n",
    "            eval_dataset=eval_dataset,\n",
    "            data_collator=data_collator,\n",
    "            compute_metrics=compute_enhanced_metrics,\n",
    "            tokenizer=self.processor.feature_extractor,\n",
    "            callbacks=[\n",
    "                EarlyStoppingCallback(\n",
    "                    early_stopping_patience=3,\n",
    "                    early_stopping_threshold=0.01\n",
    "                )\n",
    "            ]\n",
    "        )\n",
    "        \n",
    "        print(\"✅ Enhanced trainer initialized!\")\n",
    "        print(f\"📊 Training on {torch.cuda.device_count()} GPU(s)\")\n",
    "        print(f\"🎯 Target WER: <15%\")\n",
    "    \n",
    "    def train_production_model(self):\n",
    "        \"\"\"Execute production training with comprehensive monitoring.\"\"\"\n",
    "        print(f\"\\n🚀 Starting production Whisper training for Faster-Whisper...\")\n",
    "        print(f\"📊 Model: {self.model.__class__.__name__}\")\n",
    "        print(f\"📊 Vocabulary: {len(self.processor.tokenizer):,} tokens\")\n",
    "        print(f\"📊 Max training steps: {self.config.max_steps:,}\")\n",
    "        \n",
    "        # Start training\n",
    "        start_time = time.time()\n",
    "        train_result = self.trainer.train()\n",
    "        training_time = time.time() - start_time\n",
    "        \n",
    "        print(f\"\\n⏱️ Training completed in {training_time/60:.1f} minutes\")\n",
    "        print(f\"📊 Final training loss: {train_result.training_loss:.4f}\")\n",
    "        \n",
    "        # Save final model\n",
    "        self.trainer.save_model(str(self.config.final_model_dir))\n",
    "        self.processor.save_pretrained(str(self.config.final_model_dir))\n",
    "        \n",
    "        # Save training metrics\n",
    "        metrics_file = self.config.final_model_dir / \"training_metrics.json\"\n",
    "        training_metrics = {\n",
    "            **train_result.metrics,\n",
    "            'training_time_minutes': training_time / 60,\n",
    "            'model_config': {\n",
    "                'base_model': self.config.model_name,\n",
    "                'vocab_size': len(self.processor.tokenizer),\n",
    "                'target_dialects': self.config.target_dialects,\n",
    "                'ct2_ready': True\n",
    "            }\n",
    "        }\n",
    "        \n",
    "        with open(metrics_file, 'w', encoding='utf-8') as f:\n",
    "            json.dump(training_metrics, f, indent=2, ensure_ascii=False)\n",
    "        \n",
    "        print(f\"✅ Production training complete!\")\n",
    "        print(f\"💾 Model saved to: {self.config.final_model_dir}\")\n",
    "        print(f\"📊 Metrics saved to: {metrics_file}\")\n",
    "        print(f\"🔄 Ready for CTranslate2 conversion\")\n",
    "        \n",
    "        return train_result\n",
    "\n",
    "# Initialize production trainer\n",
    "if processor and datasets:\n",
    "    production_trainer = ProductionWhisperTrainer(config, processor)\n",
    "    model = production_trainer.initialize_model()\n",
    "    \n",
    "    if model:\n",
    "        print(\"🎯 Production Whisper trainer ready for Faster-Whisper pipeline!\")\n",
    "    else:\n",
    "        print(\"❌ Model initialization failed\")\n",
    "else:\n",
    "    print(\"❌ Prerequisites not met for trainer initialization\")"
   ]
  },
