# ChurchFlow Frontend Environment Variables
# Copy this file to .env and fill in the actual values

# API Configuration
# Development: https://dev-churchflow-api.ailabsafrica.com
# Production: https://churchflow-api.ailabsafrica.com
VITE_API_URL=https://dev-churchflow-api.ailabsafrica.com

# Supabase Configuration
# Get these from @apps/shared/.env or the Supabase dashboard
VITE_SUPABASE_URL=https://supabase-api.ailabsafrica.com
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Stripe Configuration
# Get these from Stripe Dashboard (https://dashboard.stripe.com/test/apikeys)
# Use test keys for development (pk_test_...) and live keys for production (pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
