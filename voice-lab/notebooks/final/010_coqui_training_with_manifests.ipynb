    "    --model xtts \\\\\n",
    "    --train_csv {dataset_path}/metadata_train.csv \\\\\n",
    "    --eval_csv {dataset_path}/metadata_val.csv \\\\\n",
    "    --dataset_path {dataset_path} \\\\\n",
