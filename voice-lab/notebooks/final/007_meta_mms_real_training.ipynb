    "# REAL data collator and metrics for production MMS training\n",
    "from dataclasses import dataclass\n",
    "from typing import Any, Dict, List, Union\n",
    "import torch\n",
    "\n",
    "@dataclass\n",
    "class RealMMSDataCollator:\n",
    "    \"\"\"REAL data collator for production MMS CTC training.\"\"\"\n",
    "    \n",
    "    processor: Wav2Vec2Processor\n",
    "    padding: Union[bool, str] = True\n",
    "    max_length: Optional[int] = None\n",
    "    max_length_labels: Optional[int] = None\n",
    "    pad_to_multiple_of: Optional[int] = None\n",
    "    pad_to_multiple_of_labels: Optional[int] = None\n",
    "    \n",
    "    def __call__(self, features: List[Dict[str, Union[List[int], torch.Tensor]]]) -> Dict[str, torch.Tensor]:\n",
    "        # Split input and label features\n",
    "        input_features = [{\"input_values\": feature[\"input_values\"]} for feature in features]\n",
    "        label_features = [{\"input_ids\": feature[\"labels\"]} for feature in features]\n",
    "        \n",
    "        # Pad input features\n",
    "        batch = self.processor.feature_extractor.pad(\n",
    "            input_features,\n",
    "            padding=self.padding,\n",
    "            max_length=self.max_length,\n",
    "            pad_to_multiple_of=self.pad_to_multiple_of,\n",
    "            return_tensors=\"pt\"\n",
    "        )\n",
    "        \n",
    "        # Pad label features\n",
    "        labels_batch = self.processor.tokenizer.pad(\n",
    "            label_features,\n",
    "            padding=self.padding,\n",
    "            max_length=self.max_length_labels,\n",
    "            pad_to_multiple_of=self.pad_to_multiple_of_labels,\n",
    "            return_tensors=\"pt\"\n",
    "        )\n",
    "        \n",
    "        # Replace padding with -100 for CTC loss computation\n",
    "        labels = labels_batch[\"input_ids\"].masked_fill(labels_batch.attention_mask.ne(1), -100)\n",
    "        \n",
    "        batch[\"labels\"] = labels\n",
    "        \n",
    "        return batch\n",
    "\n",
    "# Initialize REAL data collator\n",
    "real_data_collator = RealMMSDataCollator(\n",
    "    processor=real_processor,\n",
    "    padding=True,\n",
    "    max_length=config.sample_rate * config.max_audio_length,\n",
    "    max_length_labels=400\n",
    ")\n",
    "\n",
    "print(\"✅ REAL MMS data collator initialized for production training\")\n",
    "\n",
    "# REAL metrics computation for production evaluation\n",
    "def compute_real_mms_metrics(eval_pred):\n",
    "    \"\"\"Compute REAL WER and accuracy metrics for production MMS evaluation.\"\"\"\n",
    "    pred_logits = eval_pred.predictions\n",
    "    label_ids = eval_pred.label_ids\n",
    "    \n",
    "    # Get predicted IDs from logits\n",
    "    pred_ids = np.argmax(pred_logits, axis=-1)\n",
    "    \n",
    "    # Replace -100 with pad token for REAL decoding\n",
    "    label_ids[label_ids == -100] = real_processor.tokenizer.pad_token_id\n",
    "    \n",
    "    # Decode REAL predictions and labels\n",
    "    pred_str = real_processor.batch_decode(pred_ids)\n",
    "    label_str = real_processor.batch_decode(label_ids, group_tokens=False)\n",
    "    \n",
    "    # Clean predictions for REAL evaluation\n",
    "    pred_str = [pred.strip().lower() for pred in pred_str]\n",
    "    label_str = [label.strip().lower() for label in label_str]\n",
    "    \n",
    "    # Compute REAL WER\n",
    "    wer_metric = evaluate.load(\"wer\")\n",
    "    wer = wer_metric.compute(predictions=pred_str, references=label_str)\n",
    "    \n",
    "    # Additional REAL metrics\n",
    "    exact_match = sum([p == r for p, r in zip(pred_str, label_str)]) / len(pred_str)\n",
    "    \n",
    "    # Character-level accuracy\n",
    "    char_accuracy = sum([\n",
    "        sum(c1 == c2 for c1, c2 in zip(p, r)) / max(len(p), len(r), 1)\n",
    "        for p, r in zip(pred_str, label_str)\n",
    "    ]) / len(pred_str)\n",
    "    \n",
    "    # Log sample predictions for monitoring\n",
    "    if len(pred_str) > 0:\n",
    "        print(f\"\\n📊 Sample REAL MMS predictions:\")\n",
    "        for i in range(min(2, len(pred_str))):\n",
    "            print(f\"   Predicted: '{pred_str[i][:80]}'\")\n",
    "            print(f\"   Reference: '{label_str[i][:80]}'\")\n",
    "            print(\"   ---\")\n",
    "    \n",
    "    return {\n",
    "        \"wer\": wer,\n",
    "        \"exact_match\": exact_match,\n",
    "        \"char_accuracy\": char_accuracy\n",
    "    }\n",
    "\n",
    "print(\"✅ REAL MMS metrics computation setup complete\")"
   ]
