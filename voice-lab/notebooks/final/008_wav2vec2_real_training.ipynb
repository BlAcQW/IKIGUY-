    "# Real manifest loader for production Wav2Vec2 training\n",
    "class RealWav2Vec2ManifestLoader:\n",
    "    \"\"\"Load real ASR manifests for production Wav2Vec2 training.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: RealWav2Vec2Config):\n",
    "        self.config = config\n",
    "        \n",
    "    def load_real_manifests(self) -> Dict[str, pd.DataFrame]:\n",
    "        \"\"\"Load real Wav2Vec2 training manifests from enhanced processing pipeline.\"\"\"\n",
    "        print(\"📋 Loading REAL Wav2Vec2 ASR manifests for production training...\")\n",
    "        \n",
    "        manifests = {}\n",
    "        \n",
    "        # Primary manifest files for Wav2Vec2 (16kHz) - REAL DATA\n",
    "        wav2vec2_manifest_files = {\n",
    "            'train': self.config.manifest_dir / 'wav2vec2_train.csv',\n",
    "            'val': self.config.manifest_dir / 'wav2vec2_val.csv'\n",
    "        }\n",
    "        \n",
    "        # Fallback to other ASR manifests - REAL DATA\n",
    "        fallback_manifests = {\n",
    "            'train': [\n",
    "                self.config.manifest_dir / 'faster_whisper_train.csv',\n",
    "                self.config.manifest_dir / 'mms_train.csv',\n",
    "                self.config.data_dir / 'processed/manifests/asr_16k_dataset.csv'\n",
    "            ],\n",
    "            'val': [\n",
    "                self.config.manifest_dir / 'faster_whisper_val.csv',\n",
    "                self.config.manifest_dir / 'mms_val.csv',\n",
    "                self.config.data_dir / 'processed/manifests/asr_16k_dataset.csv'\n",
    "            ]\n",
    "        }\n",
    "        \n",
    "        for split_name in ['train', 'val']:\n",
    "            manifest_path = wav2vec2_manifest_files[split_name]\n",
    "            \n",
    "            if manifest_path.exists():\n",
    "                print(f\"   ✅ Found REAL Wav2Vec2 manifest: {manifest_path.name}\")\n",
    "                try:\n",
    "                    df = pd.read_csv(manifest_path)\n",
    "                    manifests[split_name] = self._validate_real_manifest(df, split_name)\n",
    "                except Exception as e:\n",
    "                    print(f\"   ❌ Error loading {manifest_path}: {e}\")\n",
    "                    manifests[split_name] = self._load_fallback_manifests(fallback_manifests[split_name], split_name)\n",
    "            else:\n",
    "                print(f\"   ⚠️ Wav2Vec2 manifest not found: {manifest_path.name}\")\n",
    "                print(f\"   🔄 Looking for REAL fallback manifests...\")\n",
    "                manifests[split_name] = self._load_fallback_manifests(fallback_manifests[split_name], split_name)\n",
    "        \n",
    "        # Validate we have REAL data for training\n",
    "        total_samples = sum(len(df) for df in manifests.values() if not df.empty)\n",
    "        \n",
    "        if total_samples < 100:\n",
    "            raise ValueError(f\"❌ Insufficient REAL training data: {total_samples} samples. Need at least 100 samples for meaningful training.\")\n",
    "            \n",
    "        print(f\"\\n✅ REAL manifest loading complete: {total_samples} total samples\")\n",
    "        return manifests\n",
    "    \n",
    "    def _load_fallback_manifests(self, fallback_paths: List[Path], split_name: str) -> pd.DataFrame:\n",
    "        \"\"\"Load REAL fallback manifests and combine them.\"\"\"\n",
    "        combined_df = pd.DataFrame()\n",
    "        \n",
    "        for fallback_path in fallback_paths:\n",
    "            if fallback_path.exists():\n",
    "                print(f\"   ✅ Using REAL fallback: {fallback_path.name}\")\n",
    "                try:\n",
    "                    df = pd.read_csv(fallback_path)\n",
    "                    # Split fallback data if needed\n",
    "                    if split_name == 'val' and 'train' not in str(fallback_path):\n",
    "                        # Take last 10% for validation\n",
    "                        split_idx = int(0.9 * len(df))\n",
    "                        df = df.iloc[split_idx:]\n",
    "                    elif split_name == 'train' and 'val' not in str(fallback_path):\n",
    "                        # Take first 90% for training\n",
    "                        split_idx = int(0.9 * len(df))\n",
    "                        df = df.iloc[:split_idx]\n",
    "                    \n",
    "                    combined_df = pd.concat([combined_df, df], ignore_index=True)\n",
    "                except Exception as e:\n",
    "                    print(f\"   ❌ Error loading {fallback_path}: {e}\")\n",
    "                    continue\n",
    "        \n",
    "        if combined_df.empty:\n",
    "            raise FileNotFoundError(f\"❌ No REAL manifests found for {split_name}. Cannot proceed with training.\")\n",
    "        \n",
    "        return self._validate_real_manifest(combined_df, split_name)\n",
    "    \n",
    "    def _validate_real_manifest(self, df: pd.DataFrame, split_name: str) -> pd.DataFrame:\n",
    "        \"\"\"Validate and format REAL manifest for production Wav2Vec2 training.\"\"\"\n",
    "        print(f\"   🔍 Validating REAL {split_name} manifest for production training...\")\n",
    "        \n",
    "        if df.empty:\n",
    "            raise ValueError(f\"❌ Empty manifest for {split_name}\")\n",
    "        \n",
    "        # Required columns for Wav2Vec2 ASR\n",
    "        required_columns = ['audio_path', 'transcript']\n",
    "        \n",
    "        # Map common column variations\n",
    "        column_mappings = {\n",
    "            'text': 'transcript',\n",
    "            'transcription': 'transcript',\n",
    "            'sentence': 'transcript',\n",
    "            'audio': 'audio_path',\n",
    "            'path': 'audio_path',\n",
    "            'file_path': 'audio_path',\n",
    "            'processed_audio_path': 'audio_path'\n",
    "        }\n",
    "        \n",
    "        for old_col, new_col in column_mappings.items():\n",
    "            if old_col in df.columns and new_col not in df.columns:\n",
    "                df = df.rename(columns={old_col: new_col})\n",
    "                print(f\"   🔄 Mapped {old_col} → {new_col}\")\n",
    "        \n",
    "        # Check required columns\n",
    "        missing_columns = set(required_columns) - set(df.columns)\n",
    "        if missing_columns:\n",
    "            raise ValueError(f\"❌ Missing required columns: {missing_columns}\")\n",
    "        \n",
    "        # Add optional columns\n",
    "        if 'duration' not in df.columns:\n",
    "            print(f\"   📊 Computing audio durations for {len(df)} files...\")\n",
    "            df['duration'] = df['audio_path'].apply(self._get_audio_duration)\n",
    "        if 'language' not in df.columns:\n",
    "            df['language'] = 'tw'\n",
    "        if 'speaker_id' not in df.columns:\n",
    "            df['speaker_id'] = df.index.astype(str)  # Use index as speaker ID\n",
    "        \n",
    "        # REAL data validation - check actual files exist\n",
    "        initial_count = len(df)\n",
    "        \n",
    "        print(f\"   📁 Validating {initial_count} REAL audio files exist...\")\n",
    "        df['audio_exists'] = df['audio_path'].apply(lambda x: Path(x).exists() if pd.notna(x) else False)\n",
    "        valid_audio_count = df['audio_exists'].sum()\n",
    "        \n",
    "        if valid_audio_count < initial_count * 0.8:  # Require at least 80% valid files\n",
    "            print(f\"   ⚠️ Only {valid_audio_count}/{initial_count} audio files exist ({valid_audio_count/initial_count*100:.1f}%)\")\n",
    "        \n",
    "        df = df[df['audio_exists']].drop(columns=['audio_exists'])\n",
    "        \n",
    "        # Filter valid transcripts\n",
    "        df = df[df['transcript'].str.len() > 0]\n",
    "        df = df[df['transcript'].str.len() < 300]  # Remove very long transcripts\n",
    "        \n",
    "        # Filter audio duration (Wav2Vec2 works best with shorter clips)\n",
    "        if 'duration' in df.columns:\n",
    "            df = df[\n",
    "                (df['duration'] >= self.config.min_audio_length) & \n",
    "                (df['duration'] <= self.config.max_audio_length)\n",
    "            ]\n",
    "        \n",
    "        # Clean transcripts for CTC training\n",
    "        df['transcript'] = df['transcript'].apply(self._clean_transcript_for_ctc)\n",
    "        \n",
    "        # Remove empty transcripts after cleaning\n",
    "        df = df[df['transcript'].str.len() > 0]\n",
    "        \n",
    "        final_count = len(df)\n",
    "        retention_rate = (final_count / initial_count * 100) if initial_count > 0 else 0\n",
    "        \n",
    "        if final_count < 10:\n",
    "            raise ValueError(f\"❌ Insufficient REAL data after validation: {final_count} samples\")\n",
    "        \n",
    "        print(f\"   📊 REAL {split_name}: {final_count}/{initial_count} samples retained ({retention_rate:.1f}%)\")\n",
    "        print(f\"     Duration range: {df['duration'].min():.1f}s - {df['duration'].max():.1f}s\")\n",
    "        print(f\"     Total duration: {df['duration'].sum()/60:.1f} minutes\")\n",
    "        print(f\"     Unique speakers: {df['speaker_id'].nunique()}\")\n",
    "        \n",
    "        return df\n",
    "    \n",
    "    def _clean_transcript_for_ctc(self, text: str) -> str:\n",
    "        \"\"\"Clean transcript for CTC training (remove punctuation, normalize).\"\"\"\n",
    "        if pd.isna(text):\n",
    "            return \"\"\n",
    "        \n",
    "        # Convert to lowercase\n",
    "        text = text.lower().strip()\n",
    "        \n",
    "        # Remove punctuation (keep spaces and letters)\n",
    "        import re\n",
    "        text = re.sub(r'[^a-zA-Zɛɔɲŋ\\s]', '', text)  # Keep Twi special characters\n",
    "        \n",
    "        # Normalize whitespace\n",
    "        text = re.sub(r'\\s+', ' ', text).strip()\n",
    "        \n",
    "        return text\n",
    "    \n",
    "    def _get_audio_duration(self, audio_path: str) -> float:\n",
    "        \"\"\"Get duration of REAL audio file.\"\"\"\n",
    "        try:\n",
    "            if Path(audio_path).exists():\n",
    "                info = sf.info(audio_path)\n",
    "                return info.duration\n",
    "            else:\n",
    "                return 0.0\n",
    "        except Exception:\n",
    "            return 0.0\n",
    "\n",
    "# Load REAL manifests\n",
    "manifest_loader = RealWav2Vec2ManifestLoader(config)\n",
    "real_manifests = manifest_loader.load_real_manifests()\n",
    "\n",
    "print(f\"\\n📊 REAL Wav2Vec2 Manifest Summary:\")\n",
    "total_duration = 0\n",
    "total_samples = 0\n",
    "for split_name, df in real_manifests.items():\n",
    "    print(f\"   {split_name}: {len(df)} samples\")\n",
    "    if not df.empty:\n",
    "        duration = df['duration'].sum()\n",
    "        total_duration += duration\n",
    "        total_samples += len(df)\n",
    "        print(f\"     Duration: {duration/60:.1f} minutes\")\n",
    "        print(f\"     Avg duration: {df['duration'].mean():.1f}s\")\n",
    "        print(f\"     Speakers: {df['speaker_id'].nunique()}\")\n",
    "        print(f\"     Sample transcripts: {df['transcript'].head(3).tolist()}\")\n",
    "        \n",
    "print(f\"\\n🎯 Total REAL training data: {total_samples} samples, {total_duration/60:.1f} minutes\")\n",
    "print(f\"   Estimated training time: {total_samples * 0.05 / 60:.1f} minutes per epoch\")"
   ]
