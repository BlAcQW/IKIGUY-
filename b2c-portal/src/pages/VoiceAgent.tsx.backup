        tts_voice: ttsVoice,
        llm_provider: llmProvider,
        llm_model: llmModel,
        language: language,
        country: country === 'All' ? '' : country, // Save empty string if "All" is selected
        first_message: firstMessage,
        system_prompt: systemPrompt,
        first_message_mode: firstMessageMode,
        // Add other configuration fields as needed
      };

      const response = await fetch(`${CORE_API_URL}/voice/assistants/${selectedAssistant.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(updatedConfig)
      });

      if (response.ok) {
        const data = await response.json();
        if (data.success) {
          // Update the selected assistant with new data
          setSelectedAssistant(data.assistant);
          setHasUnsavedChanges(false);
          console.log('Assistant configuration saved successfully');
          // You could add a toast notification here
        }
      } else {
        console.error('Failed to save assistant configuration:', response.status);
      }
    } catch (error) {
      console.error('Error saving assistant configuration:', error);
    }
  };

  // Update LLM provider and model when provider changes
  const handleLlmProviderChange = (providerName: string) => {
    setLlmProvider(providerName);
    const provider = getProviderByName(providerName);
    if (provider) {
      const providerModels = getModelsForProvider(provider.id);
      if (providerModels.length > 0) {
        // Set the default model for this provider, or the first available model
        const defaultModel = providerModels.find(m => m.is_default) || providerModels[0];
        setLlmModel(defaultModel.name);
      } else {
        setLlmModel('');
      }
    }
  };

  // Update TTS provider and voice when provider changes
  const handleTtsProviderChange = (providerName: string) => {
    setTtsProvider(providerName);
    const provider = getVoiceProviderByName(providerName);
    if (provider) {
      const providerVoices = getVoicesForProvider(provider.id);
      if (providerVoices.length > 0) {
        // Set the default voice for this provider, or the first available voice
        const defaultVoice = providerVoices.find(v => v.is_default) || providerVoices[0];
        setTtsVoice(defaultVoice.id);
        setSelectedVoice(defaultVoice);
      } else {
        setTtsVoice('');
        setSelectedVoice(null);
      }
    }
  };

  // Helper function to get performance color
  const getPerformanceColor = (value: string) => {
    switch (value.toLowerCase()) {
      case 'very_fast':
      case 'fast':
        return 'text-green-400';
      case 'medium':
        return 'text-yellow-400';
      case 'slow':
        return 'text-red-400';
      case 'high':
      case 'very_high':
      case 'highest':
        return 'text-green-400';
      default:
        return 'text-gray-400';
    }
  };

  // Calculate cost estimation
  useEffect(() => {
    if (selectedModel && userText) {
      const inputTokens = Math.ceil(userText.length / 4); // Rough estimation
      const outputTokens = Math.ceil(inputTokens * 1.5); // Assume 1.5x output
      const inputCost = (inputTokens / 1000) * selectedModel.input_cost_per_1k_tokens;
      const outputCost = (outputTokens / 1000) * selectedModel.output_cost_per_1k_tokens;
      
      setEstimatedCost(inputCost + outputCost);
      setEstimatedTokens(inputTokens + outputTokens);
    }
  }, [selectedModel, userText]);

  const createAgent = () => {
    setConfig({ sttProvider, sttModel, ttsProvider, ttsVoice, llmProvider, llmModel, language, country, detect });
  };

  // Twi Voice Agent Functions
  const startTwiConversation = async () => {
    if (!selectedAssistant) {
      toast({
        title: "No Assistant Selected",
        description: "Please select an assistant before starting a conversation.",
        variant: "destructive"
      });
      return;
    }

    setIsRecording(true);
    setIsProcessing(false);
    setIsSpeaking(false);
    
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const ctx = new AudioContext();
      const source = ctx.createMediaStreamSource(stream);
      const proc = ctx.createScriptProcessor(1024, 1, 1);
      const samples: number[] = [];
      let silentChunks = 0;

      const finish = async () => {
        if (!isRecording) return;
        setIsRecording(false);
        proc.disconnect();
        source.disconnect();
        stream.getTracks().forEach((t) => t.stop());
        
        if (samples.length > 0) {
          await processTwiAudio(samples, ctx);
        }
      };

      proc.onaudioprocess = async (e) => {
        const input = e.inputBuffer.getChannelData(0);
        const chunk = Array.from(input).map((v) => Math.round(v * 32767));
        samples.push(...chunk);
        
        try {
          const res = await fetch(`${CORE_API_URL}/voice/vad`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ samples: chunk }),
          });
          const data = await res.json();
          silentChunks = data.voice ? 0 : silentChunks + 1;
          if (silentChunks > 5) {
            finish();
          }
        } catch {
          // ignore
        }
      };

      source.connect(proc);
      proc.connect(ctx.destination);
    } catch (error) {
      console.error('Error starting Twi conversation:', error);
      setIsRecording(false);
      toast({
        title: "Error",
        description: "Failed to access microphone. Please check permissions.",
        variant: "destructive"
      });
    }
  };

  const processTwiAudio = async (samples: number[], ctx: AudioContext) => {
    setIsProcessing(true);
    
    try {
      // Step 1: Speech-to-Text with Twi language forcing
      const sttResponse = await fetch(`${CORE_API_URL}/voice/stt`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          samples,
          language: twiConfig.language,
          provider: selectedAssistant?.stt_provider || 'meta_mms',
          model: selectedAssistant?.stt_model || 'mms-1b-all'
        }),
      });

      if (!sttResponse.ok) {
        throw new Error('STT failed');
      }

      const sttData = await sttResponse.json();
      const userText = sttData.text || '';
      
      if (!userText.trim()) {
        setIsProcessing(false);
        return;
      }

      // Add user message to conversation
      const userMessage: ConversationMessage = {
        id: Date.now().toString(),
        type: 'user',
        text: userText,
        timestamp: new Date()
      };
      setChatMessages(prev => [...prev, userMessage]);

      // Step 2: LLM processing with Twi system prompt
      const systemPrompt = twiConfig.enableTwi ? TWI_SYSTEM_PROMPTS.twi : TWI_SYSTEM_PROMPTS.auto;
      
      const llmResponse = await fetch(`${CORE_API_URL}/voice/assistant/chat`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          user_text: userText,
          assistant_id: selectedAssistant?.id || '',
          system_prompt: systemPrompt,
          first_message: selectedAssistant?.first_message || '',
          llm_provider: selectedAssistant?.llm_provider || 'openai',
          llm_model: selectedAssistant?.llm_model || 'gpt-4o-mini',
          tts_provider: selectedAssistant?.tts_provider || 'meta_mms',
          tts_voice: twiConfig.voice,
          stt_provider: selectedAssistant?.stt_provider || 'meta_mms',
          stt_model: selectedAssistant?.stt_model || 'mms-1b-all',
          language: twiConfig.language,
          conversation_history: chatMessages.map(msg => ({
            type: msg.type,
            text: msg.text
          }))
        }),
      });

      if (!llmResponse.ok) {
        throw new Error('LLM processing failed');
      }

      const llmData = await llmResponse.json();
      const assistantReply = llmData.assistant_reply || '';

      // Add assistant message to conversation
      const assistantMessage: ConversationMessage = {
        id: (Date.now() + 1).toString(),
        type: 'assistant',
        text: assistantReply,
        timestamp: new Date()
      };
      setChatMessages(prev => [...prev, assistantMessage]);

      // Step 3: Text-to-Speech with Twi voice
      if (llmData.audio_samples && llmData.audio_samples.length > 0) {
        await playTwiAudio(llmData.audio_samples, ctx);
      }

    } catch (error) {
      console.error('Error processing Twi audio:', error);
      toast({
        title: "Error",
        description: "Failed to process audio. Please try again.",
        variant: "destructive"
      });
    } finally {
      setIsProcessing(false);
    }
  };

  const playTwiAudio = async (audioSamples: number[], ctx: AudioContext) => {
    setIsSpeaking(true);
    
    try {
      const buffer = ctx.createBuffer(1, audioSamples.length, ctx.sampleRate);
      const out = buffer.getChannelData(0);
      audioSamples.forEach((v: number, i: number) => {
        out[i] = v / 32767;
      });

      const player = ctx.createBufferSource();
      player.buffer = buffer;
      player.connect(ctx.destination);
      
      player.onended = () => {
        setIsSpeaking(false);
        setCurrentAudio(null);
      };
      
      player.start();
      setCurrentAudio(player as any);
    } catch (error) {
      console.error('Error playing Twi audio:', error);
      setIsSpeaking(false);
    }
  };

  const stopTwiConversation = () => {
    setIsRecording(false);
    setIsProcessing(false);
    setIsSpeaking(false);
    
    if (currentAudio) {
      try {
        // AudioBufferSourceNode can only be stopped once, so we just set state to false
        setCurrentAudio(null);
      } catch (error) {
        // Ignore errors when stopping audio
        setCurrentAudio(null);
      }
    }
  };

  const clearConversation = () => {
    setChatMessages([]);
    setConversationId('');
  };

  const updateTwiConfig = (updates: Partial<TwiVoiceConfig>) => {
    setTwiConfig(prev => ({ ...prev, ...updates }));
  };

  const start = async () => {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    audioCtx.current = new AudioContext();
    const source = audioCtx.current.createMediaStreamSource(stream);
    processor.current = audioCtx.current.createScriptProcessor(1024, 1, 1);
    processor.current.onaudioprocess = async (e) => {
      const input = e.inputBuffer.getChannelData(0);
      const samples = Array.from(input).map((v) => Math.round(v * 32767));
      try {
        const res = await fetch(`${CORE_API_URL}/voice/energy`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ samples }),
        });
        const data = await res.json();
        setLevel(data.energy || 0);
      } catch {
        /* ignore */
      }
    };
    source.connect(processor.current);
    processor.current.connect(audioCtx.current.destination);
    setActive(true);
  };

  const recordAndEcho = async () => {
    if (recording.current) return;
    recording.current = true;
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    const ctx = new AudioContext();
    const source = ctx.createMediaStreamSource(stream);
    const proc = ctx.createScriptProcessor(1024, 1, 1);
    const samples: number[] = [];
    let silent = 0;
    const finish = async () => {
      if (!recording.current) return;
      recording.current = false;
      proc.disconnect();
      source.disconnect();
      stream.getTracks().forEach((t) => t.stop());
      const res = await fetch(`${CORE_API_URL}/voice/echo`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ samples }),
      });
      const data = await res.json();
      const buffer = ctx.createBuffer(1, data.samples.length, ctx.sampleRate);
      const out = buffer.getChannelData(0);
      data.samples.forEach((v: number, i: number) => {
        out[i] = v / 32767;
      });
      const player = ctx.createBufferSource();
      player.buffer = buffer;
      player.connect(ctx.destination);
      player.start();
    };
    proc.onaudioprocess = async (e) => {
      const input = e.inputBuffer.getChannelData(0);
      const chunk = Array.from(input).map((v) => Math.round(v * 32767));
      samples.push(...chunk);
      try {
        const res = await fetch(`${CORE_API_URL}/voice/vad`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ samples: chunk }),
        });
        const data = await res.json();
        silent = data.voice ? 0 : silent + 1;
        if (silent > 5) finish();
      } catch {/* ignore */}
    };
    source.connect(proc);
    proc.connect(ctx.destination);
  };

  const recordAndLoop = async () => {
    if (recording.current) return;
    recording.current = true;
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    const ctx = new AudioContext();
    const source = ctx.createMediaStreamSource(stream);
    const proc = ctx.createScriptProcessor(1024, 1, 1);
    const samples: number[] = [];
    let silent = 0;
    const finish = async () => {
      if (!recording.current) return;
      recording.current = false;
      proc.disconnect();
      source.disconnect();
      stream.getTracks().forEach((t) => t.stop());
      const res = await fetch(`${CORE_API_URL}/voice/loop`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ samples }),
      });
      const data = await res.json();
      setPartials(data.partials);
      setUserText(data.text);
      const buffer = ctx.createBuffer(1, data.samples.length, ctx.sampleRate);
      const out = buffer.getChannelData(0);
      data.samples.forEach((v: number, i: number) => {
        out[i] = v / 32767;
      });
      const player = ctx.createBufferSource();
      player.buffer = buffer;
      player.connect(ctx.destination);
      player.start();
    };
    proc.onaudioprocess = async (e) => {
      const input = e.inputBuffer.getChannelData(0);
      const chunk = Array.from(input).map((v) => Math.round(v * 32767));
      samples.push(...chunk);
      try {
        const res = await fetch(`${CORE_API_URL}/voice/vad`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ samples: chunk }),
        });
        const data = await res.json();
        silent = data.voice ? 0 : silent + 1;
        if (silent > 5) finish();
      } catch {/* ignore */}
    };
    source.connect(proc);
    proc.connect(ctx.destination);
  };

  const startConversation = async () => {
    if (recording.current) return;
    
    // Check if assistant is selected
    if (!selectedAssistant) {
      alert('Please select an assistant first');
      return;
    }
    
    // Check if required configuration is set
    if (!llmProvider || !llmModel || !ttsProvider || !ttsVoice || !sttProvider || !sttModel) {
      alert('Please configure LLM, TTS, and STT settings before starting conversation');
      return;
    }
    
    // Initialize chat
    setIsChatActive(true);
    setChatMessages([]);
    setCurrentPartial('');
    setCallDuration(0);
    
    // Start call timer
    const timer = setInterval(() => {
      setCallDuration(prev => prev + 1);
    }, 1000);
    setCallTimer(timer);
    
    // Add initial assistant message if configured
    if (firstMessageMode === 'assistant_first' && firstMessage.trim()) {
      setChatMessages([{
        id: Date.now().toString(),
        type: 'assistant',
        text: firstMessage,
        timestamp: new Date()
      }]);
      
      // Play the first message
      try {
        const ttsRes = await fetch(`${CORE_API_URL}/voice/tts`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: firstMessage, voice: ttsVoice || 'akuapem_female' }),
        });
        
        if (!ttsRes.ok) {
          throw new Error(`TTS request failed: ${ttsRes.status} ${ttsRes.statusText}`);
        }
        
        const ttsData = await ttsRes.json();
        if (ttsData.samples) {
          playAudio(ttsData.samples);
        } else {
          console.warn('TTS response does not contain samples');
        }
      } catch (error) {
        console.error('Error playing first message:', error);
      }
    }
    
    recording.current = true;
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    const ctx = new AudioContext();
    const source = ctx.createMediaStreamSource(stream);
    const proc = ctx.createScriptProcessor(1024, 1, 1);
    const samples: number[] = [];
    let silent = 0;
    
    const finish = async () => {
      if (!recording.current) return;
      recording.current = false;
      proc.disconnect();
      source.disconnect();
      stream.getTracks().forEach((t) => t.stop());
      
      // Clear partial text
      setCurrentPartial('');
      
      // Use the new voice assistant endpoint
      try {
        const assistantRes = await fetch(`${CORE_API_URL}/voice/assistant/chat`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            user_text: userText,
            assistant_id: selectedAssistant.id,
            system_prompt: systemPrompt,
            first_message: firstMessage,
            llm_provider: llmProvider,
            llm_model: llmModel,
            tts_provider: ttsProvider,
            tts_voice: ttsVoice,
            stt_provider: sttProvider,
            stt_model: sttModel,
            language: language,
            conversation_history: chatMessages
          }),
        });
        
        if (!assistantRes.ok) {
          throw new Error(`Assistant chat failed: ${assistantRes.statusText}`);
        }
        
        const assistantData = await assistantRes.json();
        
        // Add assistant message to chat
        if (assistantData.assistant_reply.trim()) {
          setChatMessages(prev => [...prev, {
            id: Date.now().toString(),
            type: 'assistant',
            text: assistantData.assistant_reply,
            timestamp: new Date()
          }]);
        }
        
        // Play the assistant's response
        if (assistantData.audio_samples) {
          playAudio(assistantData.audio_samples);
        } else {
          console.warn('Assistant response does not contain audio samples');
        }
        
      } catch (error) {
        console.error('Error in voice assistant chat:', error);
        alert('Error communicating with assistant. Please try again.');
      }
    };
    
    proc.onaudioprocess = async (e) => {
      const input = e.inputBuffer.getChannelData(0);
      const chunk = Array.from(input).map((v) => Math.round(v * 32767));
      samples.push(...chunk);
      
      // Enhanced local Voice Activity Detection
      const vadResult = detectVoiceActivity(input, ctx.sampleRate);
      setVoiceActivity(vadResult.hasVoice);
      setAudioEnergy(vadResult.energy);
      
      // Update silence counter based on enhanced VAD
      if (vadResult.hasVoice) {
        silent = 0;
        console.log(`🎤 Voice detected: Energy=${vadResult.energy.toFixed(4)}, Confidence=${vadResult.confidence.toFixed(2)}, Spectral=${vadResult.spectralCentroid.toFixed(0)}Hz`);
      } else {
        silent += 1;
        if (silent > 8) { // Slightly longer silence for African languages (tonal pauses)
          console.log('🔇 Silence detected, finishing recording...');
          finish();
          return;
        }
      }
      
      // Use WebSocket streaming if available, otherwise fall back to HTTP
      if (streamingMode && wsConnection && wsConnection.readyState === WebSocket.OPEN) {
        // Send audio chunk via WebSocket for real-time processing
        sendAudioChunk(chunk);
        console.log('📡 Sent audio chunk via WebSocket');
      } else {
        // Fallback to HTTP-based processing
        await processAudioViaHTTP(chunk, vadResult, samples);
      }
    };

    // Separate function for HTTP-based audio processing
    const processAudioViaHTTP = async (chunk: number[], vadResult: any, samples: number[]) => {
      // Validate audio quality every few chunks to avoid performance impact
      if (samples.length % 5000 === 0 && samples.length > 0) {
        const validation = validateAudioSamples(samples);
        console.log(`🔍 Audio validation: Quality=${validation.quality}, Issues=${validation.issues.length}`, validation.metadata);
        
        if (!validation.isValid && validation.quality === 'unusable') {
          console.warn('⚠️ Audio quality is unusable, showing warning');
          toast({
            title: "Poor Audio Quality",
            description: validation.issues.join('. '),
            variant: "destructive"
          });
        } else if (validation.issues.length > 0 && samples.length > 10000) {
          // Only show warning after collecting significant audio
          console.log('📊 Audio quality issues detected:', validation.issues);
        }
      }
      // Update partial text for real-time display
      try {
        const partialRes = await fetch(`${CORE_API_URL}/voice/stt`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            samples: chunk,
            language: selectedAssistant?.language || 'auto',
            provider: sttProvider || 'meta_mms',
            model: sttModel || 'mms-1b-all'
          }),
        });
        const partialData = await partialRes.json();
        console.log('STT Response:', partialData);
        if (partialData.text) {
          setCurrentPartial(partialData.text);
          setUserText(partialData.text);
        }
      } catch (error) {
        console.error('STT Error:', error);
        // Fallback: Use local transcription simulation for testing
        if (vadResult.hasVoice && samples.length > 1000) {
          const mockText = selectedAssistant?.language === 'twi' ? 'Akwaaba! Ɛte sɛn?' : 'Hello, how are you?';
          setCurrentPartial(mockText);
          setUserText(mockText);
        }
      }
      
      // Fallback VAD using backend if local detection fails
      if (!vadResult.hasVoice && vadResult.energy > vadSensitivity * 2) {
        try {
          const res = await fetch(`${CORE_API_URL}/voice/vad`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ samples: chunk }),
          });
          const data = await res.json();
          if (data.voice && !vadResult.hasVoice) {
            console.log('📡 Backend VAD detected voice (local missed)');
            setVoiceActivity(true);
            silent = 0;
          }
        } catch (error) {
          console.log('⚠️ Backend VAD unavailable, using local only');
        }
      }
    };
    source.connect(proc);
    proc.connect(ctx.destination);
  };

  const endCall = () => {
    setIsChatActive(false);
    if (callTimer) {
      clearInterval(callTimer);
      setCallTimer(null);
    }
    setCallDuration(0);
    setCurrentPartial('');
    if (recording.current) {
      recording.current = false;
    }
  };

  const formatTime = (seconds: number) => {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  };

  // Helper function to play audio samples
  const playAudio = (samples: number[]) => {
    if (!samples || !Array.isArray(samples) || samples.length === 0) {
      console.warn('No audio samples provided to playAudio');
      return;
    }
    
    try {
      const ctx = new AudioContext();
      const buffer = ctx.createBuffer(1, samples.length, ctx.sampleRate);
      const out = buffer.getChannelData(0);
      samples.forEach((v: number, i: number) => {
        out[i] = v / 32767;
      });
      const player = ctx.createBufferSource();
      player.buffer = buffer;
      player.connect(ctx.destination);
      player.start();
    } catch (error) {
      console.error('Error playing audio:', error);
    }
  };

  // Template data
  const templates = [
    {
      id: 'blank',
      name: 'Blank Template',
      description: 'This blank slate template with minimal configurations. It\'s a starting point for creating your custom assistant.',
      icon: Plus
    },
    {
      id: 'customer_support',
      name: 'Customer Support Specialist',
      description: 'A comprehensive template for resolving customer inquiries and providing support.',
      icon: MessageCircle
    },
    {
      id: 'lead_qualification',
      name: 'Lead Qualification Specialist',
      description: 'A consultative template designed to qualify leads and gather information.',
      icon: Target
    },
    {
      id: 'appointment_scheduler',
      name: 'Appointment Scheduler',
      description: 'A specialized template for efficiently scheduling appointments and managing calendars.',
      icon: Calendar
    },
    {
      id: 'info_collector',
      name: 'Info Collector',
      description: 'A methodical template for gathering and organizing information from users.',
      icon: FileText
    },
    {
      id: 'care_coordinator',
      name: 'Care Coordinator',
      description: 'A compassionate template for scheduling and coordinating care services.',
      icon: Heart
    },
    {
      id: 'feedback_gatherer',
      name: 'Feedback Gatherer',
      description: 'An engaging template for conducting surveys and collecting feedback.',
      icon: BarChart3
    }
  ];

  // Filter assistants based on search query
  const filteredAssistants = assistants.filter(assistant => 
    assistant.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
    assistant.description?.toLowerCase().includes(searchQuery.toLowerCase()) ||
    assistant.user_id.toLowerCase().includes(searchQuery.toLowerCase())
  );

  const handleDeleteAssistant = async () => {
    if (!selectedAssistant) return;
    
    setDeletingAssistant(true);
    try {
      const response = await fetch(`${CORE_API_URL}/voice/assistants/${selectedAssistant.id}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
      });
      
      if (response.ok) {
        // Remove from assistants list
        setAssistants(prev => prev.filter(a => a.id !== selectedAssistant.id));
        
        // Clear current selection
        setSelectedAssistant(null);
        setAssistantName('');
        setAssistantId('');
        setAssistantStatus('draft');
        
        // Reset form fields
        setFirstMessage('');
        setSystemPrompt('');
        setFirstMessageMode('assistant_first');
        setHasUnsavedChanges(false);
        
        // Close confirmation dialog
        setShowDeleteConfirm(false);
        
        // Show success message
        toast({
          title: "Assistant deleted",
          description: `${selectedAssistant.name} has been deleted successfully.`,
          variant: "default"
        });
      } else {
        console.error('Failed to delete assistant');
        toast({
          title: "Error",
          description: "Failed to delete assistant. Please try again.",
          variant: "destructive"
        });
      }
    } catch (error) {
      console.error('Error deleting assistant:', error);
      toast({
        title: "Error",
        description: "An error occurred while deleting the assistant.",
        variant: "destructive"
      });
    } finally {
      setDeletingAssistant(false);
    }
  };

  const handleCreateAssistant = async () => {
    try {
      // Create assistant via API
      const response = await fetch(`${CORE_API_URL}/voice/assistants`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: newAssistantName,
          description: `Assistant created from ${selectedTemplate} template`,
          user_id: currentUserId,
          template_id: selectedTemplate
        })
      });
      
      if (response.ok) {
        const newAssistant = await response.json();
        
        // Update the assistants list
        setAssistants(prev => [newAssistant.assistant, ...prev]);
        
        // Set as current assistant
        setAssistantName(newAssistant.assistant.name);
        setAssistantId(newAssistant.assistant.id);
        setAssistantStatus(newAssistant.assistant.status);
        
        // Close modal and reset
        setShowCreateModal(false);
        setNewAssistantName('New Assistant');
        setSelectedTemplate('blank');
      } else {
        console.error('Failed to create assistant');
      }
    } catch (error) {
        console.error('Error creating assistant:', error);
    }
  };

  const handlePublishAssistant = async () => {
    try {
      // Get current configuration from form fields
      const configuration = {
        llm_provider: llmProvider,
        llm_model: llmModel,
        tts_provider: ttsProvider,
        tts_voice: ttsVoice,
        stt_provider: sttProvider,
        stt_model: sttModel,
        stt_language: sttLanguage,
        stt_country: sttCountry === 'All' ? '' : sttCountry,
        stt_detect: sttDetect,
        language: language,
        country: country === 'All' ? '' : country, // Save empty string if "All" is selected
        // Add other configuration fields as needed
      };

      // Publish assistant via API
      const response = await fetch(`${CORE_API_URL}/voice/assistants/${assistantId}/publish`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(configuration)
      });
      
      if (response.ok) {
        const publishedAssistant = await response.json();
        
        // Update assistant status
        setAssistantStatus(publishedAssistant.assistant.status);
        
        // Update assistants list
        setAssistants(prev => 
          prev.map(assistant => 
            assistant.id === assistantId 
              ? { ...assistant, status: publishedAssistant.assistant.status }
              : assistant
          )
        );
        
        console.log('Assistant published successfully');
      } else {
        console.error('Failed to publish assistant');
      }
    } catch (error) {
      console.error('Error publishing assistant:', error);
    }
  };

  const tabs = [
    { id: 'model', label: 'Model', icon: Brain },
    { id: 'voice', label: 'Voice', icon: Volume2 },
    { id: 'transcriber', label: 'Transcriber', icon: BarChart3 },
    { id: 'twi-conversation', label: 'Twi Chat', icon: MessageCircle },
    { id: 'tools', label: 'Tools', icon: Wrench },
    { id: 'analysis', label: 'Analysis', icon: TrendingUp },
    { id: 'advanced', label: 'Advanced', icon: Settings },
    { id: 'widget', label: 'Widget', icon: Code },
  ];

  const renderTabContent = () => {
    // Show loading state if assistant details are being loaded
    if (selectedAssistantLoading) {
      return (
        <div className="flex items-center justify-center py-12">
          <div className="text-center">
            <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500 mx-auto mb-4"></div>
            <div className="text-gray-400">Loading assistant configuration...</div>
          </div>
        </div>
      );
    }

    // Show message if no assistant is selected
    if (!selectedAssistant) {
      return (
        <div className="text-center py-12">
          <div className="text-gray-400 text-lg mb-4">Select an assistant from the left panel to view its configuration</div>
          <div className="text-gray-500 text-sm">The configuration tabs will show the selected assistant's settings</div>
        </div>
      );
    }

    switch (activeTab) {
      case 'twi-conversation':
        return (
          <div className="space-y-6">
            {/* Twi Conversation Header */}
            <div className="bg-gray-800 rounded-lg p-4 border-l-4 border-green-500">
              <div className="flex items-center justify-between">
                <div>
                  <h3 className="text-lg font-semibold text-white">Twi Voice Conversation</h3>
                  <p className="text-sm text-gray-400">Speak naturally in Twi and get instant responses</p>
                  <div className="flex items-center space-x-2 mt-2">
                    <span className="px-2 py-1 rounded-full text-xs font-medium bg-green-600 text-white">
                      Twi Enabled
                    </span>
                    <span className="text-xs text-gray-400">Voice: {twiConfig.voice}</span>
                  </div>
                </div>
                <div className="flex items-center space-x-2">
                  <button
                    onClick={clearConversation}
                    className="px-3 py-1 bg-gray-600 hover:bg-gray-500 text-white rounded text-sm"
                  >
                    Clear Chat
                  </button>
                </div>
              </div>
            </div>

            {/* Twi Configuration */}
            <div className="bg-gray-800 rounded-lg p-4">
              <h4 className="text-md font-medium text-gray-300 mb-4">Twi Settings</h4>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-gray-400 mb-2">Voice</label>
                  <select
                    value={twiConfig.voice}
                    onChange={(e) => updateTwiConfig({ voice: e.target.value })}
                    className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm"
                  >
                    <option value="asante_male">Asante Male</option>
                    <option value="asante_female">Asante Female</option>
                    <option value="akuapem_male">Akuapem Male</option>
                    <option value="akuapem_female">Akuapem Female</option>
                  </select>
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-400 mb-2">Speed</label>
                  <input
                    type="range"
                    min="0.5"
                    max="2.0"
                    step="0.1"
                    value={twiConfig.speed}
                    onChange={(e) => updateTwiConfig({ speed: parseFloat(e.target.value) })}
                    className="w-full"
                  />
                  <span className="text-xs text-gray-400">{twiConfig.speed}x</span>
                </div>
              </div>
            </div>

            {/* Conversation Interface */}
            <div className="bg-gray-800 rounded-lg p-4">
              <div className="flex items-center justify-between mb-4">
                <h4 className="text-md font-medium text-gray-300">Conversation</h4>
                <div className="flex items-center space-x-2">
                  {isRecording && (
                    <div className="flex items-center space-x-2">
                      <div className="w-3 h-3 bg-red-500 rounded-full animate-pulse"></div>
                      <span className="text-sm text-red-400">Recording...</span>
                    </div>
                  )}
                  {isProcessing && (
                    <div className="flex items-center space-x-2">
                      <div className="w-4 h-4 border-2 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
                      <span className="text-sm text-blue-400">Processing...</span>
                    </div>
                  )}
                  {isSpeaking && (
                    <div className="flex items-center space-x-2">
                      <div className="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                      <span className="text-sm text-green-400">Speaking...</span>
                    </div>
                  )}
                </div>
              </div>

              {/* Conversation Messages */}
              <div className="h-96 overflow-y-auto space-y-4 mb-4 p-4 bg-gray-900 rounded-lg">
                {chatMessages.length === 0 ? (
                  <div className="text-center text-gray-500 py-8">
                    <MessageCircle className="w-12 h-12 mx-auto mb-4 opacity-50" />
                    <p>Start a conversation by clicking the microphone button</p>
                    <p className="text-sm mt-2">Speak in Twi or English</p>
                  </div>
                ) : (
                  chatMessages.map((message) => (
                    <div
                      key={message.id}
                      className={`flex ${message.type === 'user' ? 'justify-end' : 'justify-start'}`}
                    >
                      <div
                        className={`max-w-xs lg:max-w-md px-4 py-3 rounded-lg ${
                          message.type === 'user'
                            ? 'bg-blue-600 text-white'
                            : 'bg-gray-700 text-gray-300'
                        }`}
                      >
                        <p className="text-sm leading-relaxed">{message.text}</p>
                        <p className="text-xs opacity-75 mt-2">
                          {message.timestamp.toLocaleTimeString()}
                        </p>
                      </div>
                    </div>
                  ))
                )}
              </div>

              {/* Voice Controls */}
              <div className="flex items-center justify-center space-x-4">
                {!isRecording && !isProcessing && !isSpeaking ? (
                  <button
                    onClick={startTwiConversation}
                    disabled={!selectedAssistant}
                    className={`p-4 rounded-full ${
                      selectedAssistant
                        ? 'bg-green-600 hover:bg-green-700 text-white'
                        : 'bg-gray-600 text-gray-400 cursor-not-allowed'
                    } transition-colors`}
                  >
                    <Mic className="w-6 h-6" />
                  </button>
                ) : (
                  <button
                    onClick={stopTwiConversation}
                    className="p-4 rounded-full bg-red-600 hover:bg-red-700 text-white transition-colors"
                  >
                    <StopCircle className="w-6 h-6" />
                  </button>
                )}
              </div>

              {!selectedAssistant && (
                <div className="text-center mt-4">
                  <p className="text-sm text-yellow-400">
                    Please select an assistant from the left panel to start a conversation
                  </p>
                </div>
              )}
            </div>
          </div>
        );

      case 'model':
        return (
          <div className="space-y-6">
            {/* Assistant Info Header */}
            <div className="bg-gray-800 rounded-lg p-4 border-l-4 border-blue-500">
              <div className="flex items-center justify-between">
                <div>
                  <h3 className="text-lg font-semibold text-white">{selectedAssistant.name}</h3>
                  <p className="text-sm text-gray-400">ID: {selectedAssistant.id}</p>
                  <div className="flex items-center space-x-2 mt-2">
                    <span className={`px-2 py-1 rounded-full text-xs font-medium ${
                      selectedAssistant.status === 'published' 
                        ? 'bg-green-600 text-white' 
                        : 'bg-yellow-600 text-white'
                    }`}>
                      {selectedAssistant.status}
                    </span>
                    <span className="text-xs text-gray-400">Created by {selectedAssistant.user_id}</span>
                  </div>
                </div>
                <div className="flex items-center space-x-4">
                  <div className="text-right">
                    <p className="text-sm text-gray-400">Template</p>
                    <p className="text-sm text-white">{selectedAssistant.template_id}</p>
                  </div>
                  <button
                    onClick={saveAssistantConfiguration}
                    disabled={!hasUnsavedChanges}
                    className={`px-4 py-2 rounded-md text-sm font-medium transition-colors ${
                      hasUnsavedChanges 
                        ? 'bg-green-600 hover:bg-green-700 text-white' 
                        : 'bg-gray-600 text-gray-400 cursor-not-allowed'
                    }`}
                  >
                    {hasUnsavedChanges ? 'Save Changes' : 'No Changes'}
                  </button>
                </div>
              </div>
            </div>

            {/* Model Configuration */}
            <div className="bg-gray-800 rounded-lg p-4">
              <div className="flex items-center justify-between mb-4">
                <div className="flex items-center space-x-2">
                  <Brain className="w-5 h-5 text-gray-400" />
                  <span className="text-sm font-medium text-gray-300">MODEL</span>
                  <HelpIcon 
                    tooltipText="Configure the AI model behavior"
                    dialogTitle="AI Model Configuration"
                    dialogContent={`Large Language Model (LLM) Configuration:

What is an LLM:
• AI models that understand and generate human-like text
• Processes conversation context and generates responses
• Powers the intelligence of your voice assistant
• Handles reasoning, knowledge, and conversation flow

Available Providers:
• OpenAI: GPT-4, GPT-3.5-turbo (high performance)
• Anthropic: Claude-3, Claude-2 (safety-focused)
• Google: Gemini Pro, PaLM (multimodal capabilities)
• Meta: Llama models (open source)
• Local: Self-hosted models (privacy-focused)

Model Selection:
• Choose based on performance needs and cost
• Larger models = better reasoning, higher cost
• Smaller models = faster response, lower cost
• Consider context length for long conversations

First Message Mode:
• Assistant speaks first: AI initiates conversation
• User speaks first: Waits for user input
• Wait for user: Passive mode until triggered

First Message:
• Sets the initial greeting or context
• Establishes the assistant's personality
• Can include instructions or constraints`}
                  />
                </div>
                <ChevronDown className="w-4 h-4 text-gray-400" />
              </div>
              <div className="text-sm text-gray-400 mb-4">Configure the behavior of the assistant.</div>
               
               <div className="space-y-4">
                 {/* Provider Selection */}
                 <div>
                   <div className="text-xs text-gray-500 mb-2">
                     Debug: {llmProviders.length} providers available, selected: {llmProvider}
                   </div>
                   <div className="flex items-center space-x-2 mb-2">
                     <label className="block text-sm font-medium text-gray-300">
                       Provider
                     </label>
                     <HelpIcon 
                       tooltipText="Choose your AI model provider"
                       dialogTitle="AI Model Providers"
                       dialogContent={`Available AI Model Providers:

OpenAI:
• GPT-4: Most capable model, best reasoning
• GPT-3.5-turbo: Fast and cost-effective
• GPT-4-turbo: Balanced performance and cost
• Best for: General AI applications

Anthropic:
• Claude-3: Advanced reasoning and safety
• Claude-2: Reliable and consistent
• Claude-instant: Fast and efficient
• Best for: Safety-critical applications

Google:
• Gemini Pro: Multimodal capabilities
• PaLM: Large-scale language model
• Best for: Multimodal and research applications

Meta:
• Llama-2: Open source models
• Llama-3: Latest generation
• Best for: Self-hosted and customization

Local Models:
• Self-hosted for privacy
• Custom fine-tuning possible
• Best for: Data-sensitive applications

Consider factors:
• Performance requirements
• Cost constraints
• Privacy needs
• Integration complexity`}
                     />
                   </div>
                   <select 
                     value={llmProvider} 
                     onChange={(e) => handleLlmProviderChange(e.target.value)} 
                     className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   >
                     <option value="">Select Provider</option>
                     {llmProviders.map((provider) => (
                       <option key={provider.id} value={provider.name}>
                         {provider.display_name}
                       </option>
                     ))}
                   </select>
                 </div>

                 {/* Model Selection */}
                 <div>
                   <div className="text-xs text-gray-500 mb-2">
                     Debug: {llmModels.length} models available, selected: {llmModel}
                   </div>
                   <div className="flex items-center space-x-2 mb-2">
                     <label className="block text-sm font-medium text-gray-300">
                       Model
                     </label>
                     <HelpIcon 
                       tooltipText="Choose your AI model"
                       dialogTitle="AI Models"
                       dialogContent={`AI Model Selection:

Model Types:
• Large models: Better reasoning, higher cost (GPT-4, Claude-3)
• Medium models: Balanced performance (GPT-3.5-turbo, Claude-2)
• Small models: Fast and efficient (GPT-3.5-turbo-instruct)

Key Considerations:
• Context Length: How much conversation history to remember
• Token Limits: Maximum input/output length
• Performance: Speed vs capability trade-off
• Cost: Per-token pricing varies significantly

Popular Models:
• GPT-4: 8K-128K context, best reasoning
• GPT-3.5-turbo: 4K-16K context, cost-effective
• Claude-3: 200K context, safety-focused
• Claude-2: 100K context, reliable
• Gemini Pro: 32K context, multimodal

Context Length Impact:
• Longer context = better conversation memory
• Higher cost per conversation
• Slower response times
• Better for complex tasks

Choose based on:
• Conversation complexity needs
• Budget constraints
• Response time requirements
• Integration requirements`}
                     />
                   </div>
                   <select 
                     value={llmModel} 
                     onChange={(e) => setLlmModel(e.target.value)} 
                     className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   >
                     <option value="">Select Model</option>
                     {(() => {
                       if (llmProvider) {
                         const provider = getProviderByName(llmProvider);
                         if (provider) {
                           const providerModels = getModelsForProvider(provider.id);
                           return providerModels.map((model) => (
                             <option key={model.id} value={model.name}>
                               {model.display_name} {model.is_default && '(Default)'}
                             </option>
                           ));
                         }
                       }
                       return [];
                     })()}
                   </select>
                 </div>

                 {/* First Message Mode */}
                 <div>
                   <div className="flex items-center space-x-2 mb-2">
                     <label className="block text-sm font-medium text-gray-300">
                       First Message Mode
                     </label>
                     <HelpIcon 
                       tooltipText="Configure how the conversation starts"
                       dialogTitle="First Message Mode"
                       dialogContent={`First Message Mode Configuration:

Assistant Speaks First:
• AI initiates the conversation
• Useful for proactive customer service
• Sets the tone and context immediately
• Example: "Hello, I'm here to help you today!"

User Speaks First:
• Waits for user to start speaking
• More natural conversation flow
• Good for reactive assistance
• User controls the conversation start

Wait for User:
• Completely passive until triggered
• Good for background assistants
• Requires explicit activation
• Saves resources until needed

Use Cases:
• Customer Service: Assistant speaks first
• Personal Assistant: User speaks first
• Background Helper: Wait for user
• Interactive Kiosk: Assistant speaks first

Consider your use case:
• Proactive vs reactive service
• User experience preferences
• Resource optimization needs
• Conversation flow requirements`}
                     />
                   </div>
                   <select 
                     value={firstMessageMode}
                     onChange={(e) => handleFirstMessageModeChange(e.target.value)}
                     className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   >
                     <option value="assistant_first">Assistant speaks first</option>
                     <option value="user_first">User speaks first</option>
                     <option value="wait_for_user">Wait for user</option>
                   </select>
                 </div>

                 {/* First Message */}
                 <div>
                   <div className="flex items-center space-x-2 mb-2">
                     <label className="block text-sm font-medium text-gray-300">
                       First Message
                     </label>
                     <HelpIcon 
                       tooltipText="Set the initial greeting or context"
                       dialogTitle="First Message"
                       dialogContent={`First Message Configuration:

Purpose:
• Sets the initial greeting when conversation starts
• Establishes the assistant's personality and role
• Provides context for the conversation
• Can include instructions or constraints

Examples:
• "Hello, I'm Amafrom S.I.C Life Insurance. How are you today?"
• "Hi! I'm your AI assistant. How can I help you?"
• "Welcome to our customer service. I'm here to assist you."

Best Practices:
• Keep it friendly and professional
• Include your company/brand name
• Set clear expectations
• Make it conversational
• Consider cultural context

Advanced Usage:
• Include system instructions
• Set conversation boundaries
• Define response style
• Specify language preferences
• Add safety constraints

Tips:
• Test with different user types
• Consider multilingual support
• Keep it concise but informative
• Align with brand voice
• Update based on user feedback`}
                     />
                   </div>
                   <input 
                     type="text" 
                     placeholder="Hello, I'm Amafrom S.I.C Life Insurance. How are you today?"
                     value={firstMessage}
                     onChange={(e) => handleFirstMessageChange(e.target.value)}
                     className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   />
                 </div>

                 {/* System Prompt */}
                 <div>
                   <div className="flex items-center justify-between mb-2">
                     <label className="block text-sm font-medium text-gray-300">
                       System Prompt
                       <Info className="inline w-4 h-4 text-gray-400 ml-1" />
                     </label>
                     <button className="flex items-center space-x-1 px-2 py-1 bg-green-600 text-white rounded text-xs">
                       <div className="w-3 h-3 bg-white rounded-sm"></div>
                       <span>Generate</span>
                     </button>
                   </div>
                   <textarea 
                     rows={8}
                     placeholder="You are Ama, the friendly and knowledgeable virtual sales person for S.I.C Life Insurance..."
                     value={systemPrompt}
                     onChange={(e) => handleSystemPromptChange(e.target.value)}
                     className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"
                   />
                    <div className="flex justify-end mt-1">
                      <div className="w-4 h-4 text-gray-400">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                          <path d="M7 17L17 7M17 7H7M17 7V17"/>
                        </svg>
                      </div>
                    </div>
                  </div>

                  {/* Files - Knowledge Base */}
                  <div>
                    <div className="flex items-center justify-between mb-2">
                      <label className="block text-sm font-medium text-gray-300">
                        Files
                        <Info className="inline w-4 h-4 text-gray-400 ml-1" />
                      </label>
                      <button className="flex items-center space-x-1 px-2 py-1 bg-blue-600 text-white rounded text-xs">
                        <Plus className="w-3 h-3" />
                        <span>Upload</span>
                      </button>
                    </div>
                    <p className="text-xs text-gray-400 mb-3">
                      Upload knowledge base files to provide context and information for your assistant. Supported formats: PDF, DOCX, TXT, CSV.
                    </p>
                    
                    {/* File Upload Area */}
                    <div className="border-2 border-dashed border-gray-600 rounded-lg p-6 text-center hover:border-gray-500 transition-colors cursor-pointer">
                      <div className="flex flex-col items-center space-y-2">
                        <div className="w-12 h-12 bg-gray-700 rounded-full flex items-center justify-center">
                          <FileText className="w-6 h-6 text-gray-400" />
                        </div>
                        <div>
                          <p className="text-sm text-gray-300 font-medium">Drop files here or click to upload</p>
                          <p className="text-xs text-gray-500 mt-1">Maximum file size: 10MB per file</p>
                        </div>
                      </div>
                    </div>

                    {/* Uploaded Files List */}
                    <div className="mt-4 space-y-2">
                      <div className="flex items-center justify-between p-3 bg-gray-700 rounded-lg">
                        <div className="flex items-center space-x-3">
                          <div className="w-8 h-8 bg-blue-600 rounded flex items-center justify-center">
                            <FileText className="w-4 h-4 text-white" />
                          </div>
                          <div>
                            <p className="text-sm text-white font-medium">SIC_Life_Insurance_Products.pdf</p>
                            <p className="text-xs text-gray-400">2.3 MB • Uploaded 2 hours ago</p>
                          </div>
                        </div>
                        <div className="flex items-center space-x-2">
                          <span className="text-xs px-2 py-1 bg-green-600 text-white rounded-full">Processed</span>
                          <button className="text-gray-400 hover:text-red-400">
                            <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                          </button>
                        </div>
                      </div>

                      <div className="flex items-center justify-between p-3 bg-gray-700 rounded-lg">
                        <div className="flex items-center space-x-3">
                          <div className="w-8 h-8 bg-green-600 rounded flex items-center justify-center">
                            <FileText className="w-4 h-4 text-white" />
                          </div>
                          <div>
                            <p className="text-sm text-white font-medium">Company_Policies.docx</p>
                            <p className="text-xs text-gray-400">1.7 MB • Uploaded 1 day ago</p>
                          </div>
                        </div>
                        <div className="flex items-center space-x-2">
                          <span className="text-xs px-2 py-1 bg-green-600 text-white rounded-full">Processed</span>
                          <button className="text-gray-400 hover:text-red-400">
                            <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                          </button>
                        </div>
                      </div>

                      <div className="flex items-center justify-between p-3 bg-gray-700 rounded-lg">
                        <div className="flex items-center space-x-3">
                          <div className="w-8 h-8 bg-yellow-600 rounded flex items-center justify-center">
                            <FileText className="w-4 h-4 text-white" />
                          </div>
                          <div>
                            <p className="text-sm text-white font-medium">Sales_Scripts.txt</p>
                            <p className="text-xs text-gray-400">0.8 MB • Uploaded 3 days ago</p>
                          </div>
                        </div>
                        <div className="flex items-center space-x-2">
                          <span className="text-xs px-2 py-1 bg-yellow-600 text-white rounded-full">Processing</span>
                          <button className="text-gray-400 hover:text-red-400">
                            <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                          </button>
                        </div>
                      </div>
                    </div>

                    {/* File Statistics */}
                    <div className="mt-4 p-3 bg-gray-800 rounded-lg">
                      <div className="flex items-center justify-between text-sm">
                        <span className="text-gray-400">Total Files:</span>
                        <span className="text-white font-medium">3</span>
                      </div>
                      <div className="flex items-center justify-between text-sm mt-1">
                        <span className="text-gray-400">Total Size:</span>
                        <span className="text-white font-medium">4.8 MB</span>
                      </div>
                      <div className="flex items-center justify-between text-sm mt-1">
                        <span className="text-gray-400">Processing Status:</span>
                        <span className="text-green-400 font-medium">2/3 Complete</span>
                      </div>
                    </div>
                  </div>
               </div>
             </div>

             {/* Model Information */}
             {selectedModel && (
               <div className="bg-gray-800 rounded-lg p-4">
                 <div className="flex items-center justify-between mb-4">
                   <div className="flex items-center space-x-2">
                     <Info className="w-5 h-5 text-gray-400" />
                     <span className="text-sm font-medium text-gray-300">MODEL INFORMATION</span>
                   </div>
                 </div>
                 
                                   <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
                    {/* Model Details */}
                    <div className="space-y-3">
                     <div>
                       <span className="text-xs text-gray-500">Description</span>
                       <p className="text-sm text-gray-300">{selectedModel.description}</p>
                     </div>
                     <div>
                       <span className="text-xs text-gray-500">Context Length</span>
                       <p className="text-sm text-gray-300">{selectedModel.context_length.toLocaleString()} tokens</p>
                     </div>
                     <div>
                       <span className="text-xs text-gray-500">Model Type</span>
                       <p className="text-sm text-gray-300 capitalize">{selectedModel.model_type}</p>
                     </div>
                   </div>

                   {/* Performance Metrics */}
                   <div className="space-y-3">
                     <div>
                       <span className="text-xs text-gray-500">Performance</span>
                       <div className="flex flex-wrap gap-2 mt-1">
                         {Object.entries(selectedModel.performance_metrics).map(([key, value]) => (
                           <span key={key} className={`text-xs px-2 py-1 rounded-full bg-gray-700 ${getPerformanceColor(value)}`}>
                             {key}: {value}
                           </span>
                         ))}
                       </div>
                     </div>
                     <div>
                       <span className="text-xs text-gray-500">Capabilities</span>
                       <div className="flex flex-wrap gap-1 mt-1">
                         {selectedModel.capabilities.map((capability) => (
                           <span key={capability} className="text-xs px-2 py-1 rounded-full bg-blue-600 text-white">
                             {capability}
                           </span>
                         ))}
                       </div>
                     </div>
                   </div>
                 </div>
               </div>
             )}

             {/* Cost Estimation */}
             {selectedModel && (
               <div className="bg-gray-800 rounded-lg p-4">
                 <div className="flex items-center justify-between mb-4">
                   <div className="flex items-center space-x-2">
                     <DollarSign className="w-5 h-5 text-gray-400" />
                     <span className="text-sm font-medium text-gray-300">COST ESTIMATION</span>
                   </div>
                 </div>
                 
                                   <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div className="text-center">
                      <div className="text-xl lg:text-2xl font-semibold text-white">${selectedModel.input_cost_per_1k_tokens.toFixed(4)}</div>
                      <div className="text-xs text-gray-400">Input per 1K tokens</div>
                    </div>
                    <div className="text-center">
                      <div className="text-xl lg:text-2xl font-semibold text-white">${selectedModel.output_cost_per_1k_tokens.toFixed(4)}</div>
                      <div className="text-xs text-gray-400">Output per 1K tokens</div>
                    </div>
                    <div className="text-center sm:col-span-2 lg:col-span-1">
                      <div className="text-xl lg:text-2xl font-semibold text-green-500">${estimatedCost.toFixed(6)}</div>
                      <div className="text-xs text-gray-400">Estimated cost</div>
                    </div>
                  </div>
                 
                 {estimatedTokens > 0 && (
                   <div className="mt-4 text-center">
                     <div className="text-sm text-gray-400">
                       Estimated tokens: {estimatedTokens.toLocaleString()}
                     </div>
                   </div>
                 )}
               </div>
             )}

             {/* Language Support */}
             {selectedModel && (
               <div className="bg-gray-800 rounded-lg p-4">
                 <div className="flex items-center justify-between mb-4">
                   <div className="flex items-center space-x-2">
                     <Languages className="w-5 h-5 text-gray-400" />
                     <span className="text-sm font-medium text-gray-300">LANGUAGE SUPPORT</span>
                   </div>
                 </div>
                 
                 <div className="flex flex-wrap gap-2">
                   {selectedModel.supported_languages.slice(0, 10).map((lang) => (
                     <span key={lang} className="text-xs px-2 py-1 rounded-full bg-gray-700 text-gray-300">
                       {lang}
                     </span>
                   ))}
                   {selectedModel.supported_languages.length > 10 && (
                     <span className="text-xs px-2 py-1 rounded-full bg-gray-700 text-gray-400">
                       +{selectedModel.supported_languages.length - 10} more
                     </span>
                   )}
                 </div>
               </div>
             )}
           </div>
         );
      case 'voice':
        return (
          <div className="space-y-6">
            {/* Voice Configuration */}
            <div className="bg-gray-800 rounded-lg p-4">
              <div className="flex items-center justify-between mb-4">
                <div className="flex items-center space-x-2">
                  <Volume2 className="w-5 h-5 text-gray-400" />
                  <span className="text-sm font-medium text-gray-300">VOICE CONFIGURATION</span>
                  <HelpIcon 
                    tooltipText="Configure text-to-speech settings"
                    dialogTitle="Voice Configuration"
                    dialogContent={`Text-to-Speech (TTS) Configuration:

What is TTS:
• Converts written text into spoken audio
• Input: Text content
• Output: Natural-sounding speech
• Use Case: Voice assistants, audiobooks, accessibility

Available Providers:
• ElevenLabs: High-quality, natural-sounding voices
• OpenAI TTS: Fast, reliable text-to-speech
• Azure Speech: Microsoft's enterprise TTS platform
• Google Cloud TTS: Google's speech synthesis
• Meta MMS TTS: Multilingual text-to-speech

Voice Selection:
• Choose from available voices for your selected provider
• Each voice has different characteristics (gender, accent, style)
• Some voices are optimized for specific languages
• Default voices are recommended for general use

Language & Country:
• Select the target language for speech synthesis
• Country selection filters available languages
• Ensures proper pronunciation and accent matching
• Supports regional language variants`}
                  />
                </div>
                <ChevronDown className="w-4 h-4 text-gray-400" />
              </div>
              <div className="text-sm text-gray-400 mb-4">Configure text-to-speech settings and voice selection.</div>
              
              <div className="space-y-4">
                {/* TTS Provider Selection */}
                <div>
                  <div className="flex items-center space-x-2 mb-2">
                    <label className="block text-sm font-medium text-gray-300">TTS Provider</label>
                    <HelpIcon 
                      tooltipText="Choose your text-to-speech provider"
                      dialogTitle="TTS Providers"
                      dialogContent={`Text-to-Speech Providers:

ElevenLabs:
• High-quality, natural-sounding voices
• Voice cloning and customization
• Multiple voice styles and emotions
• Best for: Premium voice applications

OpenAI TTS:
• Fast and reliable synthesis
• Multiple voice options (alloy, echo, fable, onyx, nova, shimmer)
• Good balance of quality and speed
• Best for: General applications

Azure Speech Service:
• Enterprise-grade TTS platform
• Neural voices with natural intonation
• Custom voice training capabilities
• Best for: Business applications

Google Cloud TTS:
• Google's advanced speech synthesis
• WaveNet and Neural2 voices
• Multiple languages and accents
• Best for: Multilingual applications

Meta MMS TTS:
• Multilingual text-to-speech
• Supports 1,100+ languages
• Open source and free
• Best for: Language diversity needs`}
                    />
                  </div>
                  <select 
                    value={ttsProvider} 
                    onChange={(e) => handleTtsProviderChange(e.target.value)} 
                    className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                  >
                    {Object.keys(opts.tts).map((provider) => (
                      <option key={provider} value={provider}>
                        {ttsProviders.find(p => p.name === provider)?.display_name || provider}
                      </option>
                    ))}
                  </select>
                </div>

                {/* Voice Selection */}
                <div>
                  <div className="flex items-center space-x-2 mb-2">
                    <label className="block text-sm font-medium text-gray-300">Voice</label>
                    <HelpIcon 
                      tooltipText="Select the voice for your assistant"
                      dialogTitle="Voice Selection"
                      dialogContent={`Voice Selection Guide:

African Language Voices Available:
• Twi (Akan): Native Ghanaian pronunciation
  - Asante dialect (Male/Female)
  - Akuapem dialect (Male/Female)
• Yorùbá: Standard Nigerian pronunciation
  - Natural intonation patterns
  - Proper tonal pronunciation
• Swahili: East African variants
  - Kenyan Standard
  - Tanzanian variants
• Xhosa: South African pronunciation
• Ewe: Ghanaian/Togolese variants
• Ga: Greater Accra pronunciation

Best Practices:
• Test voices with native speakers
• Consider regional preferences
• Match voice to your target audience
• Ensure proper pronunciation of key terms
• Consider cultural appropriateness

Provider Recommendations:
• Meta MMS: Best for African languages
• Azure: Good for Swahili
• Coqui: Custom training available`}
                    />
                  </div>
                  
                  <select 
                    value={ttsVoice} 
                    onChange={(e) => setTtsVoice(e.target.value)} 
                    className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                  >
                    <option value="">Select Voice</option>
                    {opts.tts[ttsProvider]?.map((voiceName) => {
                      const voice = voices.find(v => v.name === voiceName);
                      return (
                        <option key={voiceName} value={voiceName}>
                          {voice ? `${voice.display_name} (${voice.language_name}, ${voice.gender})` : voiceName}
                          {voice?.is_default && ' - Recommended'}
                        </option>
                      );
                    }) || []}
                  </select>

                  {/* African Language Voice Recommendations */}
                  {selectedAssistant && ['twi', 'yo', 'sw', 'xh', 'ee', 'gaa'].includes(selectedAssistant.language) && (
                    <div className="mt-3 p-3 bg-gradient-to-r from-orange-800 to-green-800 rounded-md">
                      <div className="flex items-center space-x-2 mb-2">
                        <Languages className="w-4 h-4 text-orange-400" />
                        <span className="text-sm font-medium text-white">African Language Voices</span>
                      </div>
                      <p className="text-xs text-gray-300 mb-2">
                        Recommended voices for {getLanguageDisplayName(selectedAssistant.language)}:
                      </p>
                      <div className="flex flex-wrap gap-2">
                        {selectedAssistant.language === 'twi' && (
                          <>
                            <button 
                              type="button"
                              className="px-2 py-1 bg-orange-600 hover:bg-orange-700 text-white rounded text-xs transition-colors"
                              onClick={() => {
                                setTtsProvider('meta_mms');
                                setTtsVoice('asante_female');
                              }}
                            >
                              🇬🇭 Asante Female
                            </button>
                            <button 
                              type="button"
                              className="px-2 py-1 bg-orange-700 hover:bg-orange-800 text-white rounded text-xs transition-colors"
                              onClick={() => {
                                setTtsProvider('meta_mms');
                                setTtsVoice('asante_male');
                              }}
                            >
                              🇬🇭 Asante Male
                            </button>
                            <button 
                              type="button"
                              className="px-2 py-1 bg-yellow-600 hover:bg-yellow-700 text-white rounded text-xs transition-colors"
                              onClick={() => {
                                setTtsProvider('coqui');
                                setTtsVoice('asante_twi_female');
                              }}
                            >
                              🎤 Coqui Twi
                            </button>
                          </>
                        )}
                        {selectedAssistant.language === 'yo' && (
                          <button 
                            type="button"
                            className="px-2 py-1 bg-green-600 hover:bg-green-700 text-white rounded text-xs transition-colors"
                            onClick={() => {
                              setTtsProvider('meta_mms');
                              setTtsVoice('yoruba_female');
                            }}
                          >
                            🇳🇬 Yorùbá Female
                          </button>
                        )}
                        {selectedAssistant.language === 'sw' && (
                          <>
                            <button 
                              type="button"
                              className="px-2 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs transition-colors"
                              onClick={() => {
                                setTtsProvider('azure');
                                setTtsVoice('sw-KE-ZuriNeural');
                              }}
                            >
                              🇰🇪 Azure Swahili
                            </button>
                            <button 
                              type="button"
                              className="px-2 py-1 bg-blue-700 hover:bg-blue-800 text-white rounded text-xs transition-colors"
                              onClick={() => {
                                setTtsProvider('meta_mms');
                                setTtsVoice('swahili_female');
                              }}
                            >
                              🌍 MMS Swahili
                            </button>
                          </>
                        )}
                        {selectedAssistant.language === 'xh' && (
                          <button 
                            type="button"
                            className="px-2 py-1 bg-purple-600 hover:bg-purple-700 text-white rounded text-xs transition-colors"
                            onClick={() => {
                              setTtsProvider('meta_mms');
                              setTtsVoice('xhosa_female');
                            }}
                          >
                            🇿🇦 Xhosa Female
                          </button>
                        )}
                      </div>
                    </div>
                  )}
                </div>

                                 {/* Language and Country Selection */}
                 <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-gray-300 mb-2">Country</label>
                    <select 
                      value={country} 
                      onChange={(e) => {
                        const newCountry = e.target.value;
                        setCountry(newCountry);
                        // Reset language if it's not available in the new country
                        const availableLanguages = filterLanguagesByCountryAndProvider(newCountry, opts.languages);
                        if (!availableLanguages.includes(language)) {
                          setLanguage(availableLanguages[0] || '');
                        }
                      }} 
                      className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                    >
                      {getAvailableCountries().map((c) => (
                        <option key={c} value={c}>{c}</option>
                      ))}
                    </select>
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-300 mb-2">Language</label>
                    <select 
                      value={language} 
                      onChange={(e) => setLanguage(e.target.value)} 
                      className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                    >
                      {filterLanguagesByCountryAndProvider(country, opts.languages).map((lang) => (
                        <option key={lang} value={lang}>
                          {getLanguageDisplayName(lang)}
                        </option>
                      ))}
                    </select>
                  </div>
                </div>
              </div>
            </div>

                         {/* Additional Configuration */}
             <div className="bg-gray-800 rounded-lg p-4">
               <div className="flex items-center justify-between mb-4">
                 <div className="flex items-center space-x-2">
                   <Settings className="w-5 h-5 text-gray-400" />
                   <span className="text-sm font-medium text-gray-300">ADDITIONAL CONFIGURATION</span>
                   <HelpIcon 
                     tooltipText="Configure advanced voice settings"
                     dialogTitle="Additional Configuration"
                     dialogContent={`Advanced Voice Configuration:

Background Sound:
• Adds ambient audio to voice responses
• Creates more immersive experience
• Options: Default, None, Custom URL
• Use for: Call centers, ambient environments

Input Min Characters:
• Minimum characters before processing
• Prevents processing of very short inputs
• Reduces unnecessary API calls
• Recommended: 30-50 characters

Punctuation Boundaries:
• Controls when voice synthesis starts
• Improves natural speech flow
• Options: Period, Comma, Question Mark, etc.
• Helps with streaming text-to-speech

Voice Parameters:
• Stability: Consistency vs expressiveness
• Similarity: Voice cloning accuracy
• Style: Emotional expression level
• Use Boost: Enhances voice characteristics

Advanced Features:
• Real-time voice synthesis
• Streaming text processing
• Voice cloning capabilities
• Emotional expression control

Best Practices:
• Test with different content types
• Balance quality vs performance
• Consider user experience
• Monitor API usage and costs`}
                   />
                 </div>
                 <ChevronDown className="w-4 h-4 text-gray-400" />
               </div>
               <div className="text-sm text-gray-400 mb-4">Configure additional settings for the voice of your assistant.</div>
               
               <div className="space-y-4">
                 {/* Background Sound Configuration */}
                 <div className="space-y-3">
                   <div>
                     <div className="flex items-center space-x-2 mb-2">
                       <label className="block text-sm font-medium text-gray-300">
                         Background Sound
                       </label>
                       <HelpIcon 
                         tooltipText="Add ambient audio to voice responses"
                         dialogTitle="Background Sound"
                         dialogContent={`Background Sound Configuration:

Purpose:
• Adds ambient audio to voice responses
• Creates more immersive experience
• Masks background noise
• Improves call center experience

Options:
• Default: Standard ambient sound
• None: No background audio
• Custom: Custom audio URL

Use Cases:
• Call Centers: Office ambience
• Customer Service: Professional environment
• Interactive Kiosks: Public space audio
• Accessibility: Audio cues and feedback

Best Practices:
• Keep volume low (10-20% of voice)
• Use non-distracting sounds
• Test with different content
• Consider user preferences
• Ensure accessibility compliance

Custom URLs:
• Must be publicly accessible
• Supported formats: MP3, WAV, OGG
• Recommended: 10-30 second loops
• Test loading times and reliability`}
                       />
                     </div>
                     <select 
                       value={selectedAssistant.background_sound || "default"}
                       className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                     >
                       <option value="default">Default</option>
                       <option value="none">None</option>
                       <option value="custom">Custom</option>
                     </select>
                   </div>
                   
                   <div>
                     <label className="block text-sm font-medium text-gray-300 mb-2">
                       Background Sound URL
                       <Info className="inline w-4 h-4 text-gray-400 ml-1" />
                     </label>
                     <input 
                       type="text" 
                       placeholder="https://www.soundjay.com/amb"
                       defaultValue={selectedAssistant.background_sound_url || "https://www.soundjay.com/amb"}
                       className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                     />
                   </div>
                   
                   <div>
                     <label className="block text-sm font-medium text-gray-300 mb-2">
                       Input Min Characters
                       <Info className="inline w-4 h-4 text-gray-400 ml-1" />
                     </label>
                     <input 
                       type="number" 
                       defaultValue={selectedAssistant.input_min_characters || 30}
                       className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                     />
                   </div>
                 </div>

                 {/* Punctuation Boundaries */}
                 <div>
                   <div className="flex items-center space-x-2 mb-2">
                     <label className="block text-sm font-medium text-gray-300">Punctuation Boundaries</label>
                     <HelpIcon 
                       tooltipText="Control when voice synthesis starts"
                       dialogTitle="Punctuation Boundaries"
                       dialogContent={`Punctuation Boundaries Configuration:

Purpose:
• Controls when voice synthesis starts during streaming
• Improves natural speech flow and timing
• Prevents choppy or unnatural speech patterns
• Optimizes real-time text-to-speech performance

How it works:
• Text is processed in chunks as it streams from the LLM
• Voice synthesis starts at punctuation boundaries
• Creates more natural speech patterns
• Reduces latency and improves user experience

Available Boundaries:
• Period (.): Complete sentences
• Comma (,): Natural pauses
• Question Mark (?): Questions and queries
• Exclamation Mark (!): Emphasis and excitement
• Semicolon (;): Related clauses
• Colon (:): Lists and explanations

Best Practices:
• Use period for most natural speech
• Add comma for conversational flow
• Include question mark for interactive responses
• Test with different content types
• Balance responsiveness vs naturalness

Technical Benefits:
• Reduces streaming latency
• Improves voice quality
• Better resource utilization
• More predictable timing`}
                     />
                   </div>
                   <p className="text-xs text-gray-400 mb-2">
                     These are the punctuations that are considered valid boundaries or delimiters. This helps decides the chunks that are sent to the voice provider for the voice generation as the LLM tokens are streaming in.
                   </p>
                   <select 
                     value={selectedAssistant.punctuation_boundaries || ""}
                     className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   >
                     <option value="">No Punctuation Boundaries Added</option>
                     <option value="period">Period (.)</option>
                     <option value="comma">Comma (,)</option>
                     <option value="question">Question Mark (?)</option>
                     <option value="exclamation">Exclamation Mark (!)</option>
                     <option value="semicolon">Semicolon (;)</option>
                     <option value="colon">Colon (:)</option>
                   </select>
                 </div>

                 {/* Voice Parameter Sliders */}
                 <div className="space-y-4">
                   <h4 className="text-sm font-medium text-gray-300">Voice Parameters</h4>
                   
                   {/* Stability */}
                   <div>
                     <div className="flex items-center justify-between mb-2">
                       <label className="text-sm text-gray-300">Stability</label>
                       <span className="text-sm text-gray-400">{selectedAssistant.stability || 0.5}</span>
                     </div>
                     <div className="flex items-center space-x-2 mb-1">
                       <span className="text-xs text-gray-400">More Variable</span>
                       <Info className="w-3 h-3 text-gray-400" />
                     </div>
                     <input 
                       type="range" 
                       min="0" 
                       max="1" 
                       step="0.1" 
                       defaultValue={selectedAssistant.stability || 0.5}
                       className="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider"
                     />
                     <div className="flex items-center justify-end space-x-2 mt-1">
                       <Info className="w-3 h-3 text-gray-400" />
                       <span className="text-xs text-gray-400">More Stable</span>
                     </div>
                   </div>

                   {/* Clarity + Similarity */}
                   <div>
                     <div className="flex items-center justify-between mb-2">
                       <label className="text-sm text-gray-300">Clarity + Similarity</label>
                       <span className="text-sm text-gray-400">{selectedAssistant.clarity_similarity || 0.75}</span>
                     </div>
                     <div className="flex items-center space-x-2 mb-1">
                       <span className="text-xs text-gray-400">Low</span>
                       <Info className="w-3 h-3 text-gray-400" />
                     </div>
                     <input 
                       type="range" 
                       min="0" 
                       max="1" 
                       step="0.1" 
                       defaultValue={selectedAssistant.clarity_similarity || 0.75}
                       className="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider"
                     />
                     <div className="flex items-center justify-end space-x-2 mt-1">
                       <Info className="w-3 h-3 text-gray-400" />
                       <span className="text-xs text-gray-400">High</span>
                     </div>
                   </div>

                   {/* Speed */}
                   <div>
                     <div className="flex items-center justify-between mb-2">
                       <label className="text-sm text-gray-300">Speed</label>
                       <span className="text-sm text-gray-400">{selectedAssistant.speed || 1}</span>
                     </div>
                     <div className="flex items-center space-x-2 mb-1">
                       <span className="text-xs text-gray-400">Slower</span>
                     </div>
                     <input 
                       type="range" 
                       min="0.5" 
                       max="2" 
                       step="0.1" 
                       defaultValue={selectedAssistant.speed || 1}
                       className="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider"
                     />
                     <div className="flex items-center justify-end space-x-2 mt-1">
                       <span className="text-xs text-gray-400">Faster</span>
                     </div>
                   </div>

                   {/* Style Exaggeration */}
                   <div>
                     <div className="flex items-center justify-between mb-2">
                       <label className="text-sm text-gray-300">Style Exaggeration</label>
                       <span className="text-sm text-gray-400">{selectedAssistant.style_exaggeration || 0}</span>
                     </div>
                     <div className="flex items-center space-x-2 mb-1">
                       <span className="text-xs text-gray-400">None (Fastest)</span>
                     </div>
                     <input 
                       type="range" 
                       min="0" 
                       max="1" 
                       step="0.1" 
                       defaultValue={selectedAssistant.style_exaggeration || 0}
                       className="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider"
                     />
                     <div className="flex items-center justify-end space-x-2 mt-1">
                       <Info className="w-3 h-3 text-gray-400" />
                       <span className="text-xs text-gray-400">Exaggerated</span>
                     </div>
                   </div>

                   {/* Optimize Streaming Latency */}
                   <div>
                     <div className="flex items-center justify-between mb-2">
                       <label className="text-sm text-gray-300">Optimize Streaming Latency</label>
                       <span className="text-sm text-gray-400">{selectedAssistant.optimize_streaming_latency || 0}</span>
                     </div>
                     <div className="flex items-center space-x-2 mb-1">
                       <span className="text-xs text-gray-400">More Latency</span>
                     </div>
                     <input 
                       type="range" 
                       min="0" 
                       max="1" 
                       step="0.1" 
                       defaultValue={selectedAssistant.optimize_streaming_latency || 0}
                       className="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider"
                     />
                     <div className="flex items-center justify-end space-x-2 mt-1">
                       <span className="text-xs text-gray-400">Less Latency</span>
                     </div>
                   </div>
                 </div>
               </div>
             </div>

             {/* Voice Information */}
             {selectedVoice && (
               <div className="bg-gray-800 rounded-lg p-4">
                 <div className="flex items-center justify-between mb-4">
                   <div className="flex items-center space-x-2">
                     <Info className="w-5 h-5 text-gray-400" />
                     <span className="text-sm font-medium text-gray-300">VOICE INFORMATION</span>
                   </div>
                 </div>
                 
                                   <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
                    {/* Voice Details */}
                    <div className="space-y-3">
                     <div>
                       <span className="text-xs text-gray-500">Description</span>
                       <p className="text-sm text-gray-300">{selectedVoice.description}</p>
                     </div>
                     <div>
                       <span className="text-xs text-gray-500">Gender</span>
                       <p className="text-sm text-gray-300 capitalize">{selectedVoice.gender}</p>
                     </div>
                     <div>
                       <span className="text-xs text-gray-500">Language</span>
                       <p className="text-sm text-gray-300">{selectedVoice.language_name} ({selectedVoice.language})</p>
                     </div>
                     <div>
                       <span className="text-xs text-gray-500">Country</span>
                       <p className="text-sm text-gray-300">{selectedVoice.country_name} ({selectedVoice.country})</p>
                     </div>
                   </div>

                   {/* Voice Specifications */}
                   <div className="space-y-3">
                     <div>
                       <span className="text-xs text-gray-500">Voice Type</span>
                       <p className="text-sm text-gray-300 capitalize">{selectedVoice.voice_type}</p>
                     </div>
                     <div>
                       <span className="text-xs text-gray-500">Sample Rate</span>
                       <p className="text-sm text-gray-300">{selectedVoice.sample_rate} Hz</p>
                     </div>
                     <div>
                       <span className="text-xs text-gray-500">Quality</span>
                       <p className="text-sm text-gray-300 capitalize">{selectedVoice.quality}</p>
                     </div>
                     <div>
                       <span className="text-xs text-gray-500">Features</span>
                       <div className="flex flex-wrap gap-1 mt-1">
                         {selectedVoice.features.map((feature) => (
                           <span key={feature} className="text-xs px-2 py-1 rounded-full bg-blue-600 text-white">
                             {feature}
                           </span>
                         ))}
                       </div>
                     </div>
                   </div>
                 </div>
               </div>
             )}

            {/* Provider Information */}
            {ttsProvider && (
              <div className="bg-gray-800 rounded-lg p-4">
                <div className="flex items-center justify-between mb-4">
                  <div className="flex items-center space-x-2">
                    <Headphones className="w-5 h-5 text-gray-400" />
                    <span className="text-sm font-medium text-gray-300">PROVIDER INFORMATION</span>
                  </div>
                </div>
                
                {(() => {
                  const provider = getVoiceProviderByName(ttsProvider);
                  if (!provider) return null;
                  
                  return (
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                      {/* Provider Details */}
                      <div className="space-y-3">
                        <div>
                          <span className="text-xs text-gray-500">Description</span>
                          <p className="text-sm text-gray-300">{provider.description}</p>
                        </div>
                        <div>
                          <span className="text-xs text-gray-500">Provider Type</span>
                          <p className="text-sm text-gray-300">{provider.provider_type}</p>
                        </div>
                        <div>
                          <span className="text-xs text-gray-500">Pricing Model</span>
                          <p className="text-sm text-gray-300">{provider.pricing_model}</p>
                        </div>
                        <div>
                          <span className="text-xs text-gray-500">Website</span>
                          <a href={provider.website} target="_blank" rel="noopener noreferrer" className="text-sm text-blue-400 hover:text-blue-300">
                            {provider.website}
                          </a>
                        </div>
                      </div>

                      {/* Provider Capabilities */}
                      <div className="space-y-3">
                        <div>
                          <span className="text-xs text-gray-500">Features</span>
                          <div className="flex flex-wrap gap-1 mt-1">
                            {provider.features.map((feature) => (
                              <span key={feature} className="text-xs px-2 py-1 rounded-full bg-green-600 text-white">
                                {feature}
                              </span>
                            ))}
                          </div>
                        </div>
                        <div>
                          <span className="text-xs text-gray-500">Supported Languages</span>
                          <div className="flex flex-wrap gap-1 mt-1">
                            {provider.supported_languages.slice(0, 8).map((lang) => (
                              <span key={lang} className="text-xs px-2 py-1 rounded-full bg-gray-700 text-gray-300">
                                {lang}
                              </span>
                            ))}
                            {provider.supported_languages.length > 8 && (
                              <span className="text-xs px-2 py-1 rounded-full bg-gray-700 text-gray-400">
                                +{provider.supported_languages.length - 8} more
                              </span>
                            )}
                          </div>
                        </div>
                        <div className="grid grid-cols-2 gap-4">
                          <div>
                            <span className="text-xs text-gray-500">Supported Voices</span>
                            <p className="text-sm text-gray-300">{provider.supported_voices.toLocaleString()}</p>
                          </div>
                          <div>
                            <span className="text-xs text-gray-500">Latency</span>
                            <p className="text-sm text-gray-300">{provider.latency_ms}ms</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  );
                })()}
              </div>
            )}

            {/* Available Voices Overview */}
            <div className="bg-gray-800 rounded-lg p-4">
              <div className="flex items-center justify-between mb-4">
                <div className="flex items-center space-x-2">
                  <Mic className="w-5 h-5 text-gray-400" />
                  <span className="text-sm font-medium text-gray-300">AVAILABLE VOICES</span>
                </div>
              </div>
              
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {ttsProviders.slice(0, 6).map((provider) => (
                  <div key={provider.id} className="bg-gray-700 rounded-lg p-3">
                    <div className="flex items-center justify-between mb-2">
                      <h4 className="text-sm font-medium text-white">{provider.display_name}</h4>
                      {provider.is_default && (
                        <span className="text-xs px-2 py-1 rounded-full bg-green-600 text-white">Default</span>
                      )}
                    </div>
                    <p className="text-xs text-gray-400 mb-2">{provider.description}</p>
                    <div className="flex items-center justify-between text-xs text-gray-500">
                      <span>{provider.supported_voices} voices</span>
                      <span>{provider.latency_ms}ms</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        );
             case 'transcriber':
         return (
           <div className="space-y-6">
             {/* Transcriber Configuration */}
             <div className="bg-gray-800 rounded-lg p-4">
               <div className="flex items-center justify-between mb-4">
                 <div className="flex items-center space-x-2">
                   <BarChart3 className="w-5 h-5 text-gray-400" />
                   <span className="text-sm font-medium text-gray-300">TRANSCRIBER</span>
                   <HelpIcon 
                     tooltipText="Configure speech recognition settings"
                     dialogTitle="Transcriber Configuration"
                     dialogContent={`Speech Recognition vs Language Detection:

Speech Recognition (STT):
• Converts spoken audio into written text
• Input: Audio recording of someone speaking
• Output: Transcribed text in the language that was spoken
• Example: Audio saying "Hello, how are you?" → Text: "Hello, how are you?"
• Use Case: Transcribing conversations, voice commands, dictation

Language Detection (LID):
• Identifies which language is being spoken in audio
• Input: Audio recording of someone speaking
• Output: Language code (e.g., "en", "twi", "ewe", "ga")
• Example: Audio saying "Hello, how are you?" → Language: "en" (English)
• Use Case: Determining the language before processing, routing to appropriate models

Meta MMS Models:
• mms-1b-all: Main speech recognition model (1,100+ languages)
• mms-lid-126/256/512/1024/2048/4017: Language detection models with different coverage
• Each model is optimized for specific use cases and language coverage needs.`}
                   />
                 </div>
                 <ChevronDown className="w-4 h-4 text-gray-400" />
               </div>
               <div className="text-sm text-gray-400 mb-4">This section allows you to configure the transcription settings for the assistant.</div>
               
               <div className="space-y-4">
                 {/* Provider Selection */}
                 <div>
                   <div className="text-xs text-gray-500 mb-2">
                     Debug: {sttProviders.length} STT providers available, selected: {sttProvider}
                   </div>
                   <div className="flex items-center space-x-2 mb-2">
                     <label className="block text-sm font-medium text-gray-300">Provider</label>
                     <HelpIcon 
                       tooltipText="Choose your speech recognition provider"
                       dialogTitle="Speech Recognition Providers"
                       dialogContent={`Available Providers:

Meta MMS:
• Supports 1,100+ languages including Ghanaian languages
• Open source and free to use
• Models: mms-1b-all (speech recognition), mms-lid-* (language detection)

OpenAI Whisper:
• High accuracy speech recognition
• Supports 99+ languages
• Models: whisper-tiny, whisper-base, whisper-small, whisper-medium, whisper-large-v3

Google Cloud Speech:
• Enterprise-grade speech recognition
• Real-time processing capabilities
• Advanced features like speaker diarization

Azure Speech Service:
• Microsoft's speech recognition platform
• HD voices and custom voice training
• Multi-talker voice support

Deepgram:
• Specialized speech-to-text platform
• Nova-3 model with 53.4% reduction in word error rate
• Real-time transcription capabilities`}
                     />
                   </div>
                   <select 
                     value={sttProvider} 
                     onChange={async (e) => { 
                       const newProvider = e.target.value;
                       setSttProvider(newProvider); 
                       setSttModel(opts.stt[newProvider][0]); 
                       
                       // If Meta MMS is selected, fetch languages for current country
                       if (newProvider === 'meta_mms') {
                         await fetchMetaMmsLanguages(sttCountry);
                       }
                     }} 
                     className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   >
                     {Object.keys(opts.stt).map((p) => (
                       <option key={p} value={p}>
                         {sttProviders.find(provider => provider.name === p)?.display_name || p}
                       </option>
                     ))}
                   </select>
                 </div>

                 {/* Model Selection */}
                 <div>
                   <div className="text-xs text-gray-500 mb-2">
                     Debug: {opts.stt[sttProvider]?.length || 0} models available for {sttProvider}, selected: {sttModel}
                   </div>
                   <div className="flex items-center space-x-2 mb-2">
                     <label className="block text-sm font-medium text-gray-300">Model</label>
                     <HelpIcon 
                       tooltipText="Choose your speech recognition model"
                       dialogTitle="Speech Recognition Models"
                       dialogContent={`Meta MMS Models:

Speech Recognition Models:
• mms-1b-all: Main model supporting 1,100+ languages
• mms-1b-fl102: Optimized for specific language families

Language Detection Models:
• mms-lid-126: Supports 126 languages
• mms-lid-256: Supports 256 languages  
• mms-lid-512: Supports 512 languages
• mms-lid-1024: Supports 1,024 languages
• mms-lid-2048: Supports 2,048 languages
• mms-lid-4017: Supports 4,017 languages

Whisper Models:
• whisper-tiny: Fastest, 39M parameters
• whisper-base: Balanced, 74M parameters
• whisper-small: High quality, 244M parameters
• whisper-medium: Professional, 769M parameters
• whisper-large-v3: Highest accuracy, 1550M parameters

Choose based on your needs:
• Speed vs Accuracy trade-off
• Language coverage requirements
• Resource constraints`}
                     />
                   </div>
                   <select 
                     value={sttModel} 
                     onChange={(e) => setSttModel(e.target.value)} 
                     className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   >
                     {opts.stt[sttProvider]?.map((m) => (
                       <option key={m} value={m}>{m}</option>
                     ))}
                   </select>
                 </div>

                 {/* Country and Language Selection */}
                 <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                   <div>
                     <label className="block text-sm font-medium text-gray-300 mb-2">Country</label>
                     <select 
                       value={sttCountry} 
                       onChange={async (e) => {
                         const newCountry = e.target.value;
                         setSttCountry(newCountry);
                         
                         // If Meta MMS is selected, fetch specific languages for the country
                         if (sttProvider === 'meta_mms') {
                           await fetchMetaMmsLanguages(newCountry);
                         }
                         
                         // Reset language if it's not available in the new country
                         const availableLanguages = filterLanguagesByCountryAndProvider(newCountry, opts.languages);
                         if (!availableLanguages.includes(sttLanguage)) {
                           setSttLanguage(availableLanguages[0] || '');
                         }
                       }} 
                       className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                     >
                       {getAvailableCountries().map((c) => (
                         <option key={c} value={c}>{c}</option>
                       ))}
                     </select>
                   </div>
                   <div>
                     <div className="text-xs text-gray-500 mb-2">
                       Debug: Provider={sttProvider}, STT Languages={sttLanguages.length}, Regular Languages={filterLanguagesByCountryAndProvider(sttCountry, opts.languages).length}
                     </div>
                     <label className="block text-sm font-medium text-gray-300 mb-2">Language</label>
                     <select 
                       value={sttLanguage} 
                       onChange={(e) => setSttLanguage(e.target.value)} 
                       className="w-full bg-gray-700 border border-gray-600 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                     >
                       {(sttProvider === 'meta_mms' && sttLanguages.length > 0 
                         ? sttLanguages 
                         : filterLanguagesByCountryAndProvider(sttCountry, opts.languages)
                       ).map((lang) => (
                         <option key={lang} value={lang}>
                           {getLanguageDisplayName(lang)}
                         </option>
                       ))}
                     </select>
                   </div>
                 </div>

                 {/* Language Detection Toggle */}
                 <div className="flex items-center space-x-2">
                   <input 
                     id="stt-detect" 
                     type="checkbox" 
                     checked={sttDetect}
                     onChange={(e) => setSttDetect(e.target.checked)}
                     className="w-4 h-4 text-blue-600 bg-gray-700 border-gray-600 rounded focus:ring-blue-500"
                   />
                   <div className="flex items-center space-x-2">
                     <label htmlFor="stt-detect" className="text-sm text-gray-300">Enable Language Detection</label>
                     <HelpIcon 
                       tooltipText="Automatically detect spoken language"
                       dialogTitle="Language Detection"
                       dialogContent={`Language Detection Feature:

What it does:
• Automatically identifies which language is being spoken
• Works in real-time during transcription
• Supports multiple languages in the same conversation

How it works:
• Analyzes audio patterns and linguistic features
• Compares against known language models
• Returns confidence scores for detected languages

Benefits:
• No need to manually specify language
• Handles code-switching between languages
• Improves transcription accuracy for multilingual speakers

Use cases:
• Multilingual customer support
• International business meetings
• Language learning applications
• Content localization

Note: Works best with Meta MMS LID models or Whisper models that support language detection.`}
                     />
                   </div>
                 </div>
                 <p className="text-xs text-gray-400 ml-6">Automatically detect the language being spoken during transcription.</p>

                 {/* Background Denoising */}
                 <div className="flex items-center space-x-2">
                   <input 
                     id="background-denoising" 
                     type="checkbox" 
                     className="w-4 h-4 text-blue-600 bg-gray-700 border-gray-600 rounded focus:ring-blue-500"
                   />
                   <label htmlFor="background-denoising" className="text-sm text-gray-300">Background Denoising Enabled</label>
                 </div>
                 <p className="text-xs text-gray-400 ml-6">Filter background noise while the user is talking.</p>

                 {/* Confidence Threshold */}
                 <div>
                   <label className="block text-sm font-medium text-gray-300 mb-2">Confidence Threshold</label>
                   <p className="text-xs text-gray-400 mb-2">Transcripts with a confidence score below this threshold will be filtered out.</p>
                   <div className="flex items-center space-x-3">
                     <input 
                       type="range" 
                       min="0" 
                       max="1" 
                       step="0.1" 
                       defaultValue="0.4"
                       className="flex-1 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider"
                     />
                     <input 
                       type="number" 
                       min="0" 
                       max="1" 
                       step="0.1" 
                       defaultValue="0.4"
                       className="w-16 bg-gray-700 border border-gray-600 rounded-md px-2 py-1 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                     />
                   </div>
                 </div>

                 {/* Enhanced Voice Activity Detection */}
                 <div className="border-t border-gray-700 pt-4">
                   <label className="block text-sm font-medium text-gray-300 mb-2">🎤 Voice Activity Detection</label>
                   <p className="text-xs text-gray-400 mb-3">Enhanced VAD optimized for African languages with tonal characteristics.</p>
                   
                   <div className="space-y-4">
                     {/* VAD Sensitivity */}
                     <div>
                       <label className="block text-sm font-medium text-gray-300 mb-2">VAD Sensitivity</label>
                       <p className="text-xs text-gray-400 mb-2">Lower values detect quieter speech (better for soft-spoken languages like Twi).</p>
                       <div className="flex items-center space-x-3">
                         <input 
                           type="range" 
                           min="0.001" 
                           max="0.02" 
                           step="0.001" 
                           value={vadSensitivity}
                           onChange={(e) => setVadSensitivity(parseFloat(e.target.value))}
                           className="flex-1 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer slider"
                         />
                         <input 
                           type="number" 
                           min="0.001" 
                           max="0.02" 
                           step="0.001" 
                           value={vadSensitivity}
                           onChange={(e) => setVadSensitivity(parseFloat(e.target.value))}
                           className="w-20 bg-gray-700 border border-gray-600 rounded-md px-2 py-1 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                         />
                       </div>
                     </div>

                     {/* Current Voice Activity Status */}
                     <div className="bg-gray-800/50 rounded-lg p-3 border border-gray-700">
                       <div className="flex items-center justify-between text-sm">
                         <span className="text-gray-300">Current Status:</span>
                         <span className={voiceActivity ? 'text-green-400 font-semibold' : 'text-gray-500'}>
                           {voiceActivity ? '🟢 Voice Active' : '⚫ Listening'}
                         </span>
                       </div>
                       <div className="flex items-center justify-between text-xs text-gray-400 mt-1">
                         <span>Audio Energy:</span>
                         <span>{(audioEnergy * 1000).toFixed(2)} (Threshold: {(vadSensitivity * 1000).toFixed(2)})</span>
                       </div>
                       <div className="mt-2">
                         <div className="w-full bg-gray-700 rounded-full h-1.5">
                           <div 
                             className={`h-1.5 rounded-full transition-all duration-300 ${
                               voiceActivity ? 'bg-green-500' : 'bg-blue-400'
                             }`}
                             style={{ width: `${Math.min(100, (audioEnergy / vadSensitivity) * 100)}%` }}
                           />
                         </div>
                       </div>
                     </div>

                     {/* Quick VAD Presets */}
                     <div>
                       <label className="block text-sm font-medium text-gray-300 mb-2">Quick Presets</label>
                       <div className="grid grid-cols-3 gap-2">
                         <button
                           onClick={() => setVadSensitivity(0.002)}
                           className={`px-3 py-2 rounded text-xs font-medium transition-colors ${
                             Math.abs(vadSensitivity - 0.002) < 0.0001 
                               ? 'bg-blue-600 text-white' 
                               : 'bg-gray-700 text-gray-300 hover:bg-gray-600'
                           }`}
                         >
                           🇬🇭 Twi Sensitive
                         </button>
                         <button
                           onClick={() => setVadSensitivity(0.005)}
                           className={`px-3 py-2 rounded text-xs font-medium transition-colors ${
                             Math.abs(vadSensitivity - 0.005) < 0.0001 
                               ? 'bg-blue-600 text-white' 
                               : 'bg-gray-700 text-gray-300 hover:bg-gray-600'
                           }`}
                         >
                           ⚖️ Balanced
                         </button>
                         <button
                           onClick={() => setVadSensitivity(0.01)}
                           className={`px-3 py-2 rounded text-xs font-medium transition-colors ${
                             Math.abs(vadSensitivity - 0.01) < 0.0001 
                               ? 'bg-blue-600 text-white' 
                               : 'bg-gray-700 text-gray-300 hover:bg-gray-600'
                           }`}
                         >
                           🔊 High Threshold
                         </button>
                       </div>
                     </div>
                   </div>
                 </div>

                 {/* Audio Quality Validation */}
                 <div className="border-t border-gray-700 pt-4">
                   <label className="block text-sm font-medium text-gray-300 mb-2">🔍 Audio Quality Validation</label>
                   <p className="text-xs text-gray-400 mb-3">Comprehensive audio diagnostics and quality monitoring for African languages.</p>
                   
                   <div className="space-y-3">
                     {/* Diagnostics Button */}
                     <button
                       onClick={performAudioDiagnostics}
                       className="w-full flex items-center justify-center space-x-2 px-4 py-3 bg-blue-600/80 hover:bg-blue-600 text-white rounded-lg transition-colors font-medium text-sm"
                     >
                       <span>🔧</span>
                       <span>Run Audio Diagnostics</span>
                     </button>

                     {/* Audio Quality Tips */}
                     <div className="bg-gray-800/50 rounded-lg p-3 border border-gray-700">
                       <h4 className="text-sm font-medium text-gray-200 mb-2">💡 Audio Tips for African Languages</h4>
                       <ul className="text-xs text-gray-400 space-y-1">
                         <li>• Use a quality microphone for tonal languages like Twi</li>
                         <li>• Speak clearly and avoid background noise</li>
                         <li>• Maintain consistent distance from microphone</li>
                         <li>• Test with "Akwaaba! Ɛte sɛn?" for Twi validation</li>
                         <li>• Check for audio clipping (red indicator)</li>
                       </ul>
                     </div>

                     {/* Validation Status for Current Assistant */}
                     {selectedAssistant && (
                       <div className="bg-gray-800/50 rounded-lg p-3 border border-gray-700">
                         <div className="flex items-center justify-between text-sm mb-2">
                           <span className="text-gray-300">Language Optimization:</span>
                           <span className="text-green-400 font-medium">
                             {selectedAssistant.language === 'twi' ? '🇬🇭 Twi Ready' :
                              selectedAssistant.language === 'yoruba' ? '🇳🇬 Yorùbá Ready' :
                              selectedAssistant.language === 'swahili' ? '🇰🇪 Swahili Ready' :
                              `${selectedAssistant.language} Ready`}
                           </span>
                         </div>
                         <div className="text-xs text-gray-400">
                           {selectedAssistant.language === 'twi' && 'Optimized for Akan tonal patterns and pronunciation'}
                           {selectedAssistant.language === 'yoruba' && 'Configured for Yorùbá tone detection and accents'}
                           {selectedAssistant.language === 'swahili' && 'Tuned for Swahili phonetics and rhythm'}
                           {!['twi', 'yoruba', 'swahili'].includes(selectedAssistant.language) && 'Standard audio processing enabled'}
                         </div>
                       </div>
                     )}
                   </div>
                 </div>

                 {/* Use Numerals */}
                 <div className="flex items-center space-x-2">
                   <input 
                     id="use-numerals" 
                     type="checkbox" 
                     className="w-4 h-4 text-blue-600 bg-gray-700 border-gray-600 rounded focus:ring-blue-500"
                   />
                   <label htmlFor="use-numerals" className="text-sm text-gray-300">Use Numerals</label>
                 </div>
                 <p className="text-xs text-gray-400 ml-6">Convert numbers from words to digits in transcription.</p>
               </div>
             </div>

             {/* Cost and Latency Metrics */}
             <div className="grid grid-cols-2 gap-4">
               <div className="bg-gray-800 rounded-lg p-4">
                 <div className="flex items-center justify-between mb-2">
                   <span className="text-sm text-gray-300">Cost</span>
                   <Info className="w-4 h-4 text-gray-400" />
                 </div>
                 <div className="text-2xl font-semibold text-white">~$0.14 /min</div>
                 <div className="mt-2 flex space-x-1">
                   <div className="h-2 bg-green-500 rounded flex-1"></div>
                   <div className="h-2 bg-orange-500 rounded flex-1"></div>
                   <div className="h-2 bg-yellow-500 rounded flex-1"></div>
                   <div className="h-2 bg-blue-500 rounded flex-1"></div>
                   <div className="h-2 bg-purple-500 rounded flex-1"></div>
                 </div>
               </div>
               <div className="bg-gray-800 rounded-lg p-4">
                 <div className="flex items-center justify-between mb-2">
                   <span className="text-sm text-gray-300">Latency</span>
                   <Info className="w-4 h-4 text-gray-400" />
                 </div>
                 <div className="text-2xl font-semibold text-white">~1200 ms</div>
                 <div className="mt-2 flex space-x-1">
                   <div className="h-2 bg-green-500 rounded flex-1"></div>
                   <div className="h-2 bg-orange-500 rounded flex-1"></div>
                   <div className="h-2 bg-yellow-500 rounded flex-1"></div>
                   <div className="h-2 bg-blue-500 rounded flex-1"></div>
                   <div className="h-2 bg-purple-500 rounded flex-1"></div>
                 </div>
               </div>
             </div>
           </div>
         );
      default:
        return (
          <div className="text-center py-12">
            <div className="text-gray-400 text-lg">Configuration for {activeTab} coming soon...</div>
          </div>
        );
    }
  };

  return (
    <div className="flex h-screen bg-background text-foreground">
      <DashboardSidebar />
      <div className="flex-1 flex flex-col">
        {/* Top Header */}
        <div className="bg-card border-b border-border px-4 lg:px-6 py-4">
          <div className="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div className="flex items-center justify-between lg:justify-start">
              <div className="flex items-center space-x-4 lg:space-x-6">
                <div className="text-xl lg:text-2xl font-bold text-primary">Kasa AI</div>
                <button className="text-muted-foreground hover:text-foreground text-sm">Docs</button>
              </div>
            </div>
            
            <div className="flex flex-col lg:flex-row items-center gap-4">
              <div className="text-center lg:text-left">
                <div className="text-base lg:text-lg font-semibold">{assistantName}</div>
                <div className="text-xs text-muted-foreground hidden lg:block">{assistantId}</div>
              </div>
              
              <div className="flex flex-wrap items-center gap-2">
               <button className="flex items-center space-x-1 px-3 py-1 text-muted-foreground hover:text-foreground text-sm">
                 <Code className="w-4 h-4" />
                 <span>Code</span>
               </button>
               <button className="flex items-center space-x-1 px-3 py-1 text-muted-foreground hover:text-foreground text-sm">
                 <Play className="w-4 h-4" />
                 <span>Test</span>
               </button>
               <button 
                 onClick={startConversation}
                 className="flex items-center space-x-1 px-3 py-1 bg-primary hover:bg-primary/90 text-primary-foreground text-sm rounded-md transition-colors"
               >
                 <MessageCircle className="w-4 h-4" />
                 <span>Talk to Assistant</span>
               </button>
