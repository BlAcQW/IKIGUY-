    "# Initialize REAL MMS model and processor\n",
    "class RealMMSTrainer:\n",
    "    \"\"\"REAL MMS trainer for production model training.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: RealMMSConfig):\n",
    "        self.config = config\n",
    "        self.model = None\n",
    "        self.processor = None\n",
    "        self.training_start_time = None\n",
    "        \n",
    "    def load_real_model_and_processor(self):\n",
    "        \"\"\"Load REAL MMS model and processor for production training.\"\"\"\n",
    "        print(f\"🚀 Loading REAL Meta MMS model for production training: {self.config.model_name}\")\n",
    "        \n",
    "        try:\n",
    "            # Load processor first\n",
    "            print(f\"   🔄 Loading MMS processor...\")\n",
    "            self.processor = Wav2Vec2Processor.from_pretrained(\n",
    "                self.config.model_name,\n",
    "                target_lang=self.config.language\n",
    "            )\n",
    "            print(f\"   ✅ Processor loaded for language: {self.config.language}\")\n",
    "            \n",
    "            # Load pre-trained MMS model\n",
    "            print(f\"   🔄 Loading MMS model (this may take a while for 1B parameters)...\")\n",
    "            self.model = Wav2Vec2ForCTC.from_pretrained(\n",
    "                self.config.model_name,\n",
    "                target_lang=self.config.language,\n",
    "                ctc_loss_reduction=\"mean\",\n",
    "                pad_token_id=self.processor.tokenizer.pad_token_id,\n",
    "                vocab_size=len(self.processor.tokenizer),\n",
    "                torch_dtype=torch.float16 if self.config.fp16 else torch.float32,\n",
    "                ignore_mismatched_sizes=True  # Allow vocab size adjustments\n",
    "            )\n",
    "            \n",
    "            # Move to GPU if available\n",
    "            device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "            self.model = self.model.to(device)\n",
    "            print(f\"   ✅ Model loaded on {device}: {self.config.model_name}\")\n",
    "            \n",
    "            # Freeze feature encoder for stable fine-tuning (optional)\n",
    "            # self.model.freeze_feature_extractor()  # Uncomment to freeze\n",
    "            \n",
    "            # Model summary\n",
    "            param_count = sum(p.numel() for p in self.model.parameters())\n",
    "            trainable_params = sum(p.numel() for p in self.model.parameters() if p.requires_grad)\n",
    "            \n",
    "            print(f\"\\n📊 REAL MMS Model Summary:\")\n",
    "            print(f\"   Total parameters: {param_count:,}\")\n",
    "            print(f\"   Trainable parameters: {trainable_params:,}\")\n",
    "            print(f\"   Target language: {self.config.language}\")\n",
    "            print(f\"   Vocabulary size: {len(self.processor.tokenizer)}\")\n",
    "            print(f\"   Device: {next(self.model.parameters()).device}\")\n",
    "            print(f\"   Data type: {next(self.model.parameters()).dtype}\")\n",
    "            \n",
    "            return self.model, self.processor\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Error loading REAL MMS model: {e}\")\n",
    "            print(f\"   Trying alternative approach...\")\n",
    "            \n",
    "            # Fallback: Load base model and adapt\n",
    "            try:\n",
    "                print(f\"   🔄 Loading base MMS model...\")\n",
    "                self.processor = Wav2Vec2Processor.from_pretrained(\"facebook/mms-1b\")\n",
    "                self.model = Wav2Vec2ForCTC.from_pretrained(\n",
    "                    \"facebook/mms-1b\",\n",
