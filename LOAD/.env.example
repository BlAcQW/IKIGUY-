# Database
DATABASE_URL=postgresql://load:load_password@localhost:5432/load_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Twilio (optional — for Twilio-managed phone numbers)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Asterisk ARI (optional — for SIP trunk telephony)
ASTERISK_ARI_URL=http://localhost:8088
ASTERISK_ARI_USERNAME=load
ASTERISK_ARI_PASSWORD=load_ari_password
ASTERISK_ARI_APP=load

# Additional Providers (optional)
DEEPGRAM_API_KEY=your-deepgram-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# Webhook
WEBHOOK_SECRET=your-webhook-signing-secret
