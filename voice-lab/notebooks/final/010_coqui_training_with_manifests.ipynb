    "\n",
    "def validate_dataset_quality():\n",
    "    \"\"\"Validate the quality of the prepared dataset.\"\"\"\n",
    "    print(\"🔍 Validating dataset quality...\")\n",
    "    \n",
    "    if not coqui_dataset_path or not coqui_dataset_path.exists():\n",
    "        print(\"   ❌ Dataset path not available\")\n",
    "        return\n",
    "    \n",
    "    # Check dataset structure\n",
    "    wavs_dir = coqui_dataset_path / \"wavs\"\n",
    "    train_metadata = coqui_dataset_path / \"metadata_train.csv\"\n",
    "    val_metadata = coqui_dataset_path / \"metadata_val.csv\"\n",
    "    \n",
    "    print(f\"   📁 Dataset structure:\")\n",
