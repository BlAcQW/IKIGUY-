# Vapi TTS Service Configuration
# Copy this file to .env and update with your values

# Service Configuration
PORT=30035
ENVIRONMENT=production

# Vapi Configuration
VAPI_API_KEY=your-vapi-api-key-here

# Rate Limiting
VAPI_USER_RPM=30          # Requests per minute per user
VAPI_USER_RPH=500         # Requests per hour per user
VAPI_ORG_RPM=100          # Requests per minute per organization
VAPI_ORG_RPH=2000         # Requests per hour per organization

# TTS Configuration
VAPI_TIMEOUT=30           # Request timeout in seconds

# TTS-WebUI Configuration (shared service)
TTSWEBUI_WEBUI_ENDPOINT=https://tts-webui.ailabsafrica.com
TTSWEBUI_API_ENDPOINT=https://tts-webui.ailabsafrica.com/api
TTSWEBUI_API_KEY=        # Optional API key for TTS-WebUI

# Logging
LOG_LEVEL=INFO
