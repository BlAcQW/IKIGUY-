    "    else:\n",
    "        print(\"❌ Failed to prepare Kokoro dataset\")\n",
    "        kokoro_dataset_path = None\n",
    "else:\n",
    "    print(\"⚠️ No processed manifests available for dataset preparation\")\n",
    "    kokoro_dataset_path = None"
   ]
