    "# OpenVoice components for voice cloning\n",
    "class SpeakerEncoder(nn.Module):\n",
    "    \"\"\"Speaker encoder for voice cloning.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: RealOpenVoiceConfig):\n",
    "        super().__init__()\n",
    "        self.config = config\n",
    "        \n",
    "        # Mel spectrogram encoder\n",
    "        self.mel_encoder = nn.Sequential(\n",
    "            nn.Conv1d(config.n_mels, 128, kernel_size=3, padding=1),\n",
    "            nn.BatchNorm1d(128),\n",
    "            nn.ReLU(),\n",
    "            nn.Conv1d(128, 256, kernel_size=3, padding=1),\n",
    "            nn.BatchNorm1d(256),\n",
    "            nn.ReLU(),\n",
    "            nn.AdaptiveAvgPool1d(1)\n",
    "        )\n",
    "        \n",
    "        # Speaker embedding projection\n",
    "        self.speaker_projection = nn.Sequential(\n",
    "            nn.Linear(256, config.speaker_encoder_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(config.speaker_encoder_dim, config.speaker_encoder_dim)\n",
    "        )\n",
    "    \n",
    "    def forward(self, mel_spec):\n",
    "        \"\"\"Extract speaker embedding from mel spectrogram.\"\"\"\n",
    "        # mel_spec: (B, T, n_mels) -> (B, n_mels, T)\n",
    "        mel_spec = mel_spec.transpose(1, 2)\n",
    "        \n",
    "        # Encode mel spectrogram\n",
    "        encoded = self.mel_encoder(mel_spec)  # (B, 256, 1)\n",
    "        encoded = encoded.squeeze(-1)  # (B, 256)\n",
    "        \n",
    "        # Project to speaker embedding\n",
    "        speaker_emb = self.speaker_projection(encoded)  # (B, speaker_encoder_dim)\n",
    "        \n",
    "        # Normalize\n",
    "        speaker_emb = F.normalize(speaker_emb, p=2, dim=-1)\n",
    "        \n",
    "        return speaker_emb\n",
    "\n",
    "class StyleEncoder(nn.Module):\n",
    "    \"\"\"Style encoder for prosody and emotion.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: RealOpenVoiceConfig):\n",
    "        super().__init__()\n",
    "        self.config = config\n",
    "        \n",
    "        # Reference audio encoder\n",
    "        self.ref_encoder = nn.Sequential(\n",
    "            nn.Conv1d(config.n_mels, 64, kernel_size=5, stride=2, padding=2),\n",
    "            nn.BatchNorm1d(64),\n",
    "            nn.ReLU(),\n",
    "            nn.Conv1d(64, 128, kernel_size=5, stride=2, padding=2),\n",
    "            nn.BatchNorm1d(128),\n",
    "            nn.ReLU(),\n",
    "            nn.Conv1d(128, config.style_encoder_dim, kernel_size=5, stride=2, padding=2),\n",
    "            nn.BatchNorm1d(config.style_encoder_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.AdaptiveAvgPool1d(1)\n",
    "        )\n",
    "    \n",
    "    def forward(self, reference_mel):\n",
    "        \"\"\"Extract style embedding from reference mel spectrogram.\"\"\"\n",
    "        # reference_mel: (B, T, n_mels) -> (B, n_mels, T)\n",
    "        reference_mel = reference_mel.transpose(1, 2)\n",
    "        \n",
    "        # Encode reference\n",
    "        style_emb = self.ref_encoder(reference_mel)  # (B, style_encoder_dim, 1)\n",
    "        style_emb = style_emb.squeeze(-1)  # (B, style_encoder_dim)\n",
    "        \n",
    "        return style_emb\n",
    "\n",
    "class RealOpenVoiceModel(nn.Module):\n",
    "    \"\"\"Real OpenVoice model for instant voice cloning.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: RealOpenVoiceConfig, vocab_size: int):\n",
    "        super().__init__()\n",
    "        self.config = config\n",
    "        self.vocab_size = vocab_size\n",
    "        \n",
    "        # Text encoder\n",
    "        self.text_embedding = nn.Embedding(vocab_size, config.hidden_dim)\n",
    "        self.text_encoder = nn.TransformerEncoder(\n",
    "            nn.TransformerEncoderLayer(\n",
    "                d_model=config.hidden_dim,\n",
    "                nhead=config.num_heads,\n",
    "                dim_feedforward=config.hidden_dim * 4,\n",
    "                dropout=0.1,\n",
    "                batch_first=True\n",
    "            ),\n",
    "            num_layers=6\n",
    "        )\n",
    "        \n",
    "        # Speaker and style encoders\n",
    "        self.speaker_encoder = SpeakerEncoder(config)\n",
    "        self.style_encoder = StyleEncoder(config)\n",
    "        \n",
    "        # Duration predictor\n",
    "        self.duration_predictor = nn.Sequential(\n",
    "            nn.Linear(config.hidden_dim + config.speaker_encoder_dim, config.hidden_dim // 2),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.1),\n",
    "            nn.Linear(config.hidden_dim // 2, 1),\n",
    "            nn.Softplus()  # Ensure positive durations\n",
    "        )\n",
    "        \n",
    "        # Attention mechanism for alignment\n",
    "        self.attention = nn.MultiheadAttention(\n",
    "            embed_dim=config.hidden_dim,\n",
    "            num_heads=config.num_heads,\n",
    "            batch_first=True\n",
    "        )\n",
    "        \n",
    "        # Decoder for mel generation\n",
    "        decoder_input_dim = config.hidden_dim + config.speaker_encoder_dim + config.style_encoder_dim\n",
    "        self.mel_decoder = nn.Sequential(\n",
    "            nn.Linear(decoder_input_dim, config.hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.1),\n",
    "            nn.Linear(config.hidden_dim, config.hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.1),\n",
    "            nn.Linear(config.hidden_dim, config.n_mels)\n",
    "        )\n",
    "        \n",
    "        # Postnet for mel refinement\n",
    "        self.postnet = nn.Sequential(\n",
    "            nn.Conv1d(config.n_mels, 512, kernel_size=5, padding=2),\n",
    "            nn.BatchNorm1d(512),\n",
    "            nn.Tanh(),\n",
    "            nn.Dropout(0.5),\n",
    "            nn.Conv1d(512, 512, kernel_size=5, padding=2),\n",
    "            nn.BatchNorm1d(512),\n",
    "            nn.Tanh(),\n",
    "            nn.Dropout(0.5),\n",
    "            nn.Conv1d(512, config.n_mels, kernel_size=5, padding=2)\n",
    "        )\n",
    "    \n",
    "    def encode_text(self, text_ids):\n",
    "        \"\"\"Encode text sequence.\"\"\"\n",
    "        text_emb = self.text_embedding(text_ids)  # (B, T, D)\n",
    "        text_enc = self.text_encoder(text_emb)  # (B, T, D)\n",
    "        return text_enc\n",
    "    \n",
    "    def length_regulate(self, text_enc, durations, max_len=None):\n",
    "        \"\"\"Expand text encoding based on predicted durations.\"\"\"\n",
    "        batch_size, text_len, hidden_dim = text_enc.shape\n",
    "        \n",
    "        if max_len is None:\n",
    "            max_len = int(durations.sum(dim=1).max().item())\n",
    "        \n",
    "        outputs = []\n",
    "        for i in range(batch_size):\n",
    "            output = []\n",
    "            for j in range(text_len):\n",
    "                duration = max(1, int(durations[i, j].item()))\n",
    "                frame = text_enc[i, j:j+1].expand(duration, -1)\n",
    "                output.append(frame)\n",
    "            \n",
    "            output = torch.cat(output, dim=0)\n",
    "            \n",
    "            # Pad or truncate to max length\n",
    "            if len(output) > max_len:\n",
    "                output = output[:max_len]\n",
    "            elif len(output) < max_len:\n",
    "                padding = output[-1:].expand(max_len - len(output), -1)\n",
    "                output = torch.cat([output, padding], dim=0)\n",
    "            \n",
    "            outputs.append(output.unsqueeze(0))\n",
    "        \n",
    "        return torch.cat(outputs, dim=0)\n",
    "    \n",
    "    def forward(self, text_ids, reference_mel, target_mel=None):\n",
    "        \"\"\"Forward pass for training or inference.\"\"\"\n",
    "        batch_size = text_ids.shape[0]\n",
    "        \n",
    "        # Encode text\n",
    "        text_enc = self.encode_text(text_ids)  # (B, T_text, D)\n",
    "        \n",
    "        # Extract speaker and style embeddings from reference\n",
    "        speaker_emb = self.speaker_encoder(reference_mel)  # (B, speaker_dim)\n",
    "        style_emb = self.style_encoder(reference_mel)  # (B, style_dim)\n",
    "        \n",
    "        # Add speaker embedding to text encoding\n",
    "        speaker_emb_expanded = speaker_emb.unsqueeze(1).expand(-1, text_enc.shape[1], -1)\n",
    "        text_speaker = torch.cat([text_enc, speaker_emb_expanded], dim=-1)\n",
    "        \n",
    "        # Predict durations\n",
    "        durations = self.duration_predictor(text_speaker).squeeze(-1)  # (B, T_text)\n",
    "        \n",
    "        if target_mel is not None:\n",
    "            # Training mode - use target length\n",
    "            target_len = target_mel.shape[1]\n",
    "            upsampled_text = self.length_regulate(text_enc, durations, target_len)\n",
    "        else:\n",
    "            # Inference mode - use predicted durations\n",
    "            upsampled_text = self.length_regulate(text_enc, durations)\n",
    "        \n",
    "        # Add speaker and style information\n",
    "        mel_len = upsampled_text.shape[1]\n",
    "        speaker_emb_mel = speaker_emb.unsqueeze(1).expand(-1, mel_len, -1)\n",
    "        style_emb_mel = style_emb.unsqueeze(1).expand(-1, mel_len, -1)\n",
    "        \n",
    "        # Combine all features\n",
    "        decoder_input = torch.cat([\n",
    "            upsampled_text,\n",
    "            speaker_emb_mel,\n",
    "            style_emb_mel\n",
    "        ], dim=-1)\n",
    "        \n",
    "        # Generate mel spectrogram\n",
    "        mel_pred = self.mel_decoder(decoder_input)  # (B, T_mel, n_mels)\n",
    "        \n",
    "        # Apply postnet for refinement\n",
    "        mel_pred_post = mel_pred.transpose(1, 2)  # (B, n_mels, T_mel)\n",
    "        mel_residual = self.postnet(mel_pred_post)\n",
    "        mel_pred_refined = mel_pred_post + mel_residual\n",
    "        mel_pred_refined = mel_pred_refined.transpose(1, 2)  # (B, T_mel, n_mels)\n",
    "        \n",
    "        return {\n",
    "            'mel_pred': mel_pred,\n",
    "            'mel_pred_refined': mel_pred_refined,\n",
    "            'durations': durations,\n",
    "            'speaker_emb': speaker_emb,\n",
    "            'style_emb': style_emb\n",
    "        }\n",
    "\n",
    "print(f\"✅ OpenVoice voice cloning components implemented\")"
   ]
