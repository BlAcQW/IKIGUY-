# African Language Community Platform Environment Configuration
# Copy this file to .env and update values for your environment

# Application Settings
PROJECT_NAME="African Language Community Platform"
VERSION="1.0.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG="True"
SECRET_KEY="your-secret-key-change-in-production"

# Server Configuration
HOST="0.0.0.0"
PORT=8001

# CORS Settings (comma-separated list)
ALLOWED_ORIGINS="http://localhost:3000,https://language-community.ailabsafrica.com,https://kasaai.ailabsafrica.com,https://api.ailabsafrica.com"

# Database Configuration
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="african_language_community"

# Authentication (Supabase)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""

# Redis for caching and background tasks
REDIS_URL="redis://localhost:6379"

# File Storage Configuration
STORAGE_TYPE="local"  # local, s3, minio
STORAGE_PATH="/opt/kasaai/data/community"

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="african-language-data"

# MinIO Configuration (if using MinIO)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET_NAME="african-language-data"

# External API Keys
GOOGLE_TRANSLATE_API_KEY=""
HUGGINGFACE_API_TOKEN=""

# File Upload Limits
MAX_FILE_SIZE_MB=100
SUPPORTED_AUDIO_FORMATS=".wav,.mp3,.m4a,.flac,.ogg"
SUPPORTED_TEXT_FORMATS=".txt,.md,.pdf"

# Hetzner Storage Box Configuration
HETZNER_STORAGE_HOST="u497034-sub1.your-storagebox.de"
HETZNER_STORAGE_USERNAME="u497034-sub1"
HETZNER_STORAGE_PASSWORD="AILabsAdm1n123%"
HETZNER_STORAGE_PORT="23"
HETZNER_STORAGE_BASE_PATH="/african-languages"