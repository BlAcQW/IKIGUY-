interface VoiceOptions {
  stt: Record<string, string[]>;
  tts: Record<string, string[]>;
  llm: Record<string, string[]>;
  languages: string[];
  countries: string[];
}

interface LLMProvider {
  id: string;
  name: string;
  display_name: string;
  description: string;
  website: string;
  api_base_url: string;
  pricing_model: string;
  features: string[];
  supported_languages: string[];
  max_context_length: number;
  is_active: boolean;
}

interface LLMModel {
  id: string;
  provider_id: string;
  name: string;
  display_name: string;
  description: string;
  model_type: string;
  context_length: number;
  input_cost_per_1k_tokens: number;
  output_cost_per_1k_tokens: number;
  capabilities: string[];
  supported_languages: string[];
  performance_metrics: Record<string, string>;
  is_active: boolean;
  is_default: boolean;
}

interface VoiceProvider {
  id: string;
  name: string;
  display_name: string;
  description: string;
  website: string;
  api_base_url: string;
  provider_type: string;
  pricing_model: string;
  features: string[];
  supported_languages: string[];
  supported_voices: number;
  max_audio_length: number;
  latency_ms: number;
  is_active: boolean;
  is_default: boolean;
}

interface Voice {
  id: string;
  provider_id: string;
  name: string;
  display_name: string;
  description: string;
  gender: string;
  language: string;
  language_name: string;
  country: string;
  country_name: string;
  voice_type: string;
  sample_rate: number;
  quality: string;
  features: string[];
  is_active: boolean;
  is_default: boolean;
}

interface Assistant {
  id: string;
  name: string;
  description: string;
  user_id: string;
  template_id: string;
  status: 'draft' | 'published';
  llm_provider: string;
  llm_model: string;
  first_message_mode: string;
  first_message: string;
  system_prompt: string;
  tts_provider: string;
  tts_voice: string;
  language: string;
  country: string;
  background_sound: string;
  background_sound_url: string;
  input_min_characters: number;
  punctuation_boundaries: string;
  stability: number;
  clarity_similarity: number;
  speed: number;
  style_exaggeration: number;
  optimize_streaming_latency: number;
  stt_provider: string;
  stt_model: string;
  background_denoising: boolean;
  confidence_threshold: number;
  use_numerals: boolean;
  knowledge_base_files: string[];
  metadata: Record<string, unknown>;
  created_at: string;
  updated_at: string;
}

interface VoiceAgentConfig {
  stt_providers: VoiceProvider[];
  tts_providers: VoiceProvider[];
  voice_providers: VoiceProvider[];
  voices: Voice[];
  llm_providers: LLMProvider[];
  llm_models: LLMModel[];
  languages: string[];
  countries: string[];
  default_config: Record<string, string>;
}

// Add new interfaces for conversation
interface ConversationMessage {
  id: string;
  type: 'user' | 'assistant';
  text: string;
  timestamp: Date;
  audioUrl?: string;
  isPlaying?: boolean;
}

interface TwiVoiceConfig {
  language: string;
  voice: string;
  speed: number;
  pitch: number;
  enableTwi: boolean;
  autoDetectLanguage: boolean;
}

const CORE_API_URL = import.meta.env.VITE_CORE_API_URL || 'https://api.ailabsafrica.com';

// Twi Language Configuration
const TWI_CONFIG: TwiVoiceConfig = {
  language: 'twi',
  voice: 'asante_male',
  speed: 1.0,
  pitch: 1.0,
  enableTwi: true,
  autoDetectLanguage: true
};

// Twi-specific system prompts
const TWI_SYSTEM_PROMPTS = {
  twi: "You are a helpful assistant that speaks Twi (Akan). Always respond in Twi unless the user specifically asks you to use English. Be polite, respectful, and culturally appropriate for Ghanaian users.",
  english: "You are a helpful assistant. Respond in the same language as the user's message.",
  auto: "You are a helpful assistant. Detect the language of the user's message and respond in the same language. If the user speaks Twi, respond in Twi. If they speak English, respond in English."
};

// Help Icon Component with Tooltip and Dialog
const HelpIcon = ({ 
  tooltipText, 
  dialogTitle, 
  dialogContent, 
  className = "w-4 h-4 text-muted-foreground hover:text-foreground cursor-help" 
}: {
  tooltipText: string;
  dialogTitle: string;
  dialogContent: string;
  className?: string;
}) => {
  return (
    <TooltipProvider>
      <Dialog>
        <Tooltip>
          <TooltipTrigger asChild>
            <DialogTrigger asChild>
              <HelpCircle className={className} />
            </DialogTrigger>
          </TooltipTrigger>
          <TooltipContent>
            <p>{tooltipText}</p>
          </TooltipContent>
        </Tooltip>
        <DialogContent className="max-w-2xl">
          <DialogHeader>
            <DialogTitle>{dialogTitle}</DialogTitle>
            <DialogDescription className="whitespace-pre-line">
              {dialogContent}
            </DialogDescription>
          </DialogHeader>
        </DialogContent>
      </Dialog>
    </TooltipProvider>
  );
};

const VoiceAgent = () => {
  const navigate = useNavigate();
  // Add CSS for custom slider styling
  useEffect(() => {
    const style = document.createElement('style');
    style.textContent = `
      .slider {
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
        cursor: pointer;
      }
      
      .slider::-webkit-slider-track {
        background: #374151;
        height: 8px;
        border-radius: 4px;
      }
      
      .slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        background: #10B981;
        height: 16px;
        width: 16px;
        border-radius: 50%;
        cursor: pointer;
      }
      
      .slider::-moz-range-track {
        background: #374151;
        height: 8px;
        border-radius: 4px;
        border: none;
      }
      
      .slider::-moz-range-thumb {
        background: #10B981;
        height: 16px;
        width: 16px;
        border-radius: 50%;
        cursor: pointer;
        border: none;
      }
    `;
    document.head.appendChild(style);
    
    return () => {
      document.head.removeChild(style);
    };
  }, []);
  const [opts, setOpts] = useState<VoiceOptions>({ stt: {}, tts: {}, llm: {}, languages: [], countries: [] });
  const [agentConfig, setAgentConfig] = useState<VoiceAgentConfig | null>(null);
  const [sttProvider, setSttProvider] = useState('');
  const [sttModel, setSttModel] = useState('');
  const [sttLanguage, setSttLanguage] = useState('');
  const [sttCountry, setSttCountry] = useState('All');
  const [sttDetect, setSttDetect] = useState(true);
  const [sttLanguages, setSttLanguages] = useState<string[]>([]);
  const [ttsProvider, setTtsProvider] = useState('');
  const [ttsVoice, setTtsVoice] = useState('');
  const [llmProvider, setLlmProvider] = useState('');
  const [llmModel, setLlmModel] = useState('');
  const [language, setLanguage] = useState('');
  const [country, setCountry] = useState('All');
  const [detect, setDetect] = useState(true);
  const [config, setConfig] = useState<{
    sttProvider: string;
    sttModel: string;
    ttsProvider: string;
    ttsVoice: string;
    llmProvider: string;
    llmModel: string;
    language: string;
    country: string;
    detect: boolean;
  } | null>(null);
  const [userText, setUserText] = useState('');
  const [assistantText, setAssistantText] = useState('');
  const [level, setLevel] = useState(0);
  const [active, setActive] = useState(false);
  const [partials, setPartials] = useState<string[]>([]);
  const [activeTab, setActiveTab] = useState('model');
  const [assistantName, setAssistantName] = useState('New Assistant');
  const [assistantId, setAssistantId] = useState('bcb77003-5e8a-4d13-b825-6fee6687114c');
  const [assistantStatus, setAssistantStatus] = useState<'draft' | 'published'>('draft');
  
  // Chat state
  const [isChatActive, setIsChatActive] = useState(false);
  const [chatMessages, setChatMessages] = useState<ConversationMessage[]>([]);
  const [currentPartial, setCurrentPartial] = useState('');
  const [callDuration, setCallDuration] = useState(0);
  const [callTimer, setCallTimer] = useState<NodeJS.Timeout | null>(null);
  
  // Create Assistant Modal state
  const [showCreateModal, setShowCreateModal] = useState(false);
  const [newAssistantName, setNewAssistantName] = useState('New Assistant');
  const [selectedTemplate, setSelectedTemplate] = useState('blank');
  
  // LLM data state
  const [llmProviders, setLlmProviders] = useState<LLMProvider[]>([]);
  const [llmModels, setLlmModels] = useState<LLMModel[]>([]);
  const [selectedModel, setSelectedModel] = useState<LLMModel | null>(null);
  const [estimatedCost, setEstimatedCost] = useState(0);
  const [estimatedTokens, setEstimatedTokens] = useState(0);
  
  // Voice data state
  const [voiceProviders, setVoiceProviders] = useState<VoiceProvider[]>([]);
  const [sttProviders, setSttProviders] = useState<VoiceProvider[]>([]);
  const [ttsProviders, setTtsProviders] = useState<VoiceProvider[]>([]);
  const [voices, setVoices] = useState<Voice[]>([]);
  const [selectedVoice, setSelectedVoice] = useState<Voice | null>(null);
  
  const recording = useRef(false);
  const audioCtx = useRef<AudioContext>();
  const processor = useRef<ScriptProcessorNode>();

  // Real assistants data from API
  const [assistants, setAssistants] = useState<Assistant[]>([]);
  const [assistantsLoading, setAssistantsLoading] = useState(true);
  const [currentUserId] = useState('user-123'); // In a real app, this would come from auth
  
  // Selected assistant state
  const [selectedAssistant, setSelectedAssistant] = useState<Assistant | null>(null);
  const [selectedAssistantLoading, setSelectedAssistantLoading] = useState(false);
  
  // Form state for editable fields
  const [firstMessage, setFirstMessage] = useState('');
  const [systemPrompt, setSystemPrompt] = useState('');
  const [firstMessageMode, setFirstMessageMode] = useState('assistant_first');
  const [hasUnsavedChanges, setHasUnsavedChanges] = useState(false);
  
  // Search state
  const [searchQuery, setSearchQuery] = useState('');
  
  // Dropdown and delete state
  const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);
  const [deletingAssistant, setDeletingAssistant] = useState(false);
  
  // Twi Voice Agent State
  const [twiConfig, setTwiConfig] = useState<TwiVoiceConfig>(TWI_CONFIG);
  const [isRecording, setIsRecording] = useState(false);
  const [isProcessing, setIsProcessing] = useState(false);
  const [isSpeaking, setIsSpeaking] = useState(false);
  const [currentAudio, setCurrentAudio] = useState<AudioBufferSourceNode | null>(null);
  const [conversationId, setConversationId] = useState<string>('');
  
  // Enhanced VAD State
  const [voiceActivity, setVoiceActivity] = useState(false);
  const [audioEnergy, setAudioEnergy] = useState(0);
  const [vadSensitivity, setVadSensitivity] = useState(0.005); // Threshold for African languages
  
  // WebSocket Streaming State
  const [wsConnection, setWsConnection] = useState<WebSocket | null>(null);
  const [streamingMode, setStreamingMode] = useState(false);
  const [connectionStatus, setConnectionStatus] = useState<'disconnected' | 'connecting' | 'connected' | 'error'>('disconnected');
  const [streamingLatency, setStreamingLatency] = useState(0);
  
  const { toast } = useToast();

  // Enhanced Voice Activity Detection functions
  const calculateRMSEnergy = (samples: Float32Array): number => {
    let sum = 0;
    for (let i = 0; i < samples.length; i++) {
      sum += samples[i] * samples[i];
    }
    return Math.sqrt(sum / samples.length);
  };

  const calculateSpectralCentroid = (samples: Float32Array, sampleRate: number): number => {
    const fftSize = 512;
    const fft = new Array(fftSize).fill(0);
    const windowSize = Math.min(samples.length, fftSize);
    
    // Apply Hann window and copy samples
    for (let i = 0; i < windowSize; i++) {
      const window = 0.5 * (1 - Math.cos(2 * Math.PI * i / (windowSize - 1)));
      fft[i] = samples[i] * window;
    }
    
    // Simple spectral centroid approximation (focus on higher frequencies for speech)
    let numerator = 0;
    let denominator = 0;
    const nyquist = sampleRate / 2;
    
    for (let i = 1; i < windowSize / 2; i++) {
      const freq = (i * nyquist) / (windowSize / 2);
      const magnitude = Math.abs(fft[i]);
      numerator += freq * magnitude;
      denominator += magnitude;
    }
    
    return denominator > 0 ? numerator / denominator : 0;
  };

  const detectVoiceActivity = (samples: Float32Array, sampleRate: number): { 
    hasVoice: boolean; 
    energy: number; 
    confidence: number;
    spectralCentroid: number;
  } => {
    const energy = calculateRMSEnergy(samples);
    const spectralCentroid = calculateSpectralCentroid(samples, sampleRate);
    
    // Enhanced criteria for African language detection
    const energyThreshold = vadSensitivity;
    const spectralThreshold = 1000; // Hz, typical for speech
    const spectralUpperLimit = 4000; // Hz, avoid noise
    
    // African languages often have different tonal characteristics
    const tonalLanguageBoost = selectedAssistant?.language && 
      ['twi', 'yoruba', 'igbo', 'ewe'].includes(selectedAssistant.language.toLowerCase()) ? 0.8 : 1.0;
    
    const energyScore = Math.min(energy / (energyThreshold * tonalLanguageBoost), 1.0);
    const spectralScore = (spectralCentroid > spectralThreshold && spectralCentroid < spectralUpperLimit) ? 1.0 : 0.3;
    
    const confidence = (energyScore * 0.7 + spectralScore * 0.3);
    const hasVoice = confidence > 0.5;
    
    return {
      hasVoice,
      energy,
      confidence,
      spectralCentroid
    };
  };

  // WebSocket streaming functions
  const connectWebSocket = async (): Promise<boolean> => {
    if (wsConnection && wsConnection.readyState === WebSocket.OPEN) {
      console.log('🔗 WebSocket already connected');
      return true;
    }

    try {
      setConnectionStatus('connecting');
      
      // Try WebSocket connection first, fallback to secure WebSocket
      const wsUrl = CORE_API_URL.replace('http://', 'ws://').replace('https://', 'wss://');
      const fullWsUrl = `${wsUrl}/voice/stream`;
      
      console.log(`🔄 Connecting to WebSocket: ${fullWsUrl}`);
      
      const ws = new WebSocket(fullWsUrl);
      const startTime = Date.now();
      
      return new Promise((resolve) => {
        const timeout = setTimeout(() => {
          console.log('⏰ WebSocket connection timeout');
          ws.close();
          setConnectionStatus('error');
          resolve(false);
        }, 5000);

        ws.onopen = () => {
          clearTimeout(timeout);
          const latency = Date.now() - startTime;
          setStreamingLatency(latency);
          setWsConnection(ws);
          setConnectionStatus('connected');
          console.log(`✅ WebSocket connected in ${latency}ms`);
          
          // Send initial configuration
          ws.send(JSON.stringify({
            type: 'config',
            language: selectedAssistant?.language || 'en',
            stt_provider: sttProvider || 'meta_mms',
            tts_provider: ttsProvider || 'meta_mms',
            assistant_id: selectedAssistant?.id
          }));
          
          resolve(true);
        };

        ws.onerror = (error) => {
          clearTimeout(timeout);
          console.error('❌ WebSocket error:', error);
          setConnectionStatus('error');
          resolve(false);
        };

        ws.onclose = (event) => {
          console.log(`🔌 WebSocket closed: ${event.code} ${event.reason}`);
          setConnectionStatus('disconnected');
          setWsConnection(null);
        };

        ws.onmessage = (event) => {
          try {
            const data = JSON.parse(event.data);
            handleWebSocketMessage(data);
          } catch (error) {
            console.error('❌ Error parsing WebSocket message:', error);
          }
        };
      });
      
    } catch (error) {
      console.error('❌ WebSocket connection failed:', error);
      setConnectionStatus('error');
      return false;
    }
  };

  const handleWebSocketMessage = (data: any) => {
    switch (data.type) {
      case 'partial_transcript':
        setCurrentPartial(data.text);
        console.log('📝 Partial transcript:', data.text);
        break;
        
      case 'final_transcript':
        setUserText(data.text);
        setChatMessages(prev => [...prev, {
          id: Date.now().toString(),
          type: 'user',
          text: data.text,
          timestamp: new Date()
        }]);
        console.log('✅ Final transcript:', data.text);
        break;
        
      case 'assistant_response':
        setChatMessages(prev => [...prev, {
          id: Date.now().toString(),
          type: 'assistant',
          text: data.text,
          timestamp: new Date()
        }]);
        console.log('🤖 Assistant response:', data.text);
        break;
        
      case 'audio_chunk':
        if (data.samples && Array.isArray(data.samples)) {
          playAudioChunk(data.samples);
        }
        break;
        
      case 'voice_activity':
        setVoiceActivity(data.active);
        setAudioEnergy(data.energy || 0);
        break;
        
      case 'error':
        console.error('🚨 WebSocket error:', data.message);
        toast({
          title: "Streaming Error",
          description: data.message,
          variant: "destructive"
        });
        break;
        
      default:
        console.log('📨 Unknown WebSocket message type:', data.type);
    }
  };

  const disconnectWebSocket = () => {
    if (wsConnection) {
      console.log('🔌 Disconnecting WebSocket...');
      wsConnection.close();
      setWsConnection(null);
      setConnectionStatus('disconnected');
    }
  };

  const sendAudioChunk = (samples: number[]) => {
    if (wsConnection && wsConnection.readyState === WebSocket.OPEN) {
      wsConnection.send(JSON.stringify({
        type: 'audio_chunk',
        samples: samples,
        timestamp: Date.now()
      }));
    }
  };

  const playAudioChunk = (samples: number[]) => {
    try {
      const ctx = new AudioContext();
      const buffer = ctx.createBuffer(1, samples.length, ctx.sampleRate);
      const out = buffer.getChannelData(0);
      samples.forEach((v: number, i: number) => {
        out[i] = v / 32767;
      });
      const player = ctx.createBufferSource();
      player.buffer = buffer;
      player.connect(ctx.destination);
      player.start();
    } catch (error) {
      console.error('❌ Error playing audio chunk:', error);
    }
  };

  // Auto-connect WebSocket when assistant is selected and streaming mode is enabled
  useEffect(() => {
    if (streamingMode && selectedAssistant && connectionStatus === 'disconnected') {
      connectWebSocket();
    } else if (!streamingMode && wsConnection) {
      disconnectWebSocket();
    }
  }, [streamingMode, selectedAssistant]);

  // Cleanup WebSocket on component unmount
  useEffect(() => {
    return () => {
      if (wsConnection) {
        wsConnection.close();
      }
    };
  }, []);

  // Comprehensive Audio Validation Functions
  const validateAudioSamples = (samples: number[] | Float32Array): {
    isValid: boolean;
    issues: string[];
    quality: 'excellent' | 'good' | 'poor' | 'unusable';
    metadata: {
      sampleCount: number;
      avgEnergy: number;
      peakLevel: number;
      silenceRatio: number;
      dynamicRange: number;
      clippingDetected: boolean;
    };
  } => {
    const issues: string[] = [];
    let quality: 'excellent' | 'good' | 'poor' | 'unusable' = 'excellent';

    if (!samples || samples.length === 0) {
      return {
        isValid: false,
        issues: ['No audio samples provided'],
        quality: 'unusable',
        metadata: {
          sampleCount: 0,
          avgEnergy: 0,
          peakLevel: 0,
          silenceRatio: 1,
          dynamicRange: 0,
          clippingDetected: false
        }
      };
    }

    const sampleCount = samples.length;
    let sumSquares = 0;
    let maxLevel = 0;
    let minLevel = 0;
    let silentSamples = 0;
    let clippedSamples = 0;

    // Convert to normalized float values for analysis
    const normalizedSamples = Array.from(samples).map(sample => {
      const normalized = typeof sample === 'number' && Math.abs(sample) > 1 
        ? sample / 32768 // Convert from int16 to float
        : sample;
      return Math.max(-1, Math.min(1, normalized)); // Clamp to valid range
    });

    // Analyze audio properties
    for (let i = 0; i < normalizedSamples.length; i++) {
      const sample = normalizedSamples[i];
      const absSample = Math.abs(sample);
      
      sumSquares += sample * sample;
      maxLevel = Math.max(maxLevel, absSample);
      minLevel = i === 0 ? absSample : Math.min(minLevel, absSample);
      
      // Check for silence (very low energy)
      if (absSample < 0.001) {
        silentSamples++;
      }
      
      // Check for clipping (near maximum values)
      if (absSample > 0.95) {
        clippedSamples++;
      }
    }

    const avgEnergy = Math.sqrt(sumSquares / sampleCount);
    const silenceRatio = silentSamples / sampleCount;
    const dynamicRange = maxLevel - minLevel;
    const clippingDetected = clippedSamples > sampleCount * 0.01; // More than 1% clipped

    // Quality assessment
    if (sampleCount < 500) {
      issues.push('Audio sample too short for reliable processing');
      quality = 'poor';
    }

    if (avgEnergy < 0.001) {
      issues.push('Audio level too low - check microphone');
      quality = quality === 'excellent' ? 'poor' : quality;
    } else if (avgEnergy > 0.8) {
      issues.push('Audio level too high - possible clipping');
      quality = quality === 'excellent' ? 'good' : quality;
    }

    if (silenceRatio > 0.8) {
      issues.push('Too much silence detected');
      quality = quality === 'excellent' ? 'poor' : quality;
    }

    if (clippingDetected) {
      issues.push('Audio clipping detected - reduce input gain');
      quality = 'poor';
    }

    if (dynamicRange < 0.1) {
      issues.push('Poor audio dynamic range - check audio source');
      quality = quality === 'excellent' ? 'good' : quality;
    }

    // African language specific checks
    if (selectedAssistant?.language && ['twi', 'yoruba', 'igbo', 'ewe'].includes(selectedAssistant.language.toLowerCase())) {
      // Tonal languages need better dynamic range
      if (dynamicRange < 0.2) {
        issues.push(`${selectedAssistant.language} requires better tonal clarity - improve microphone quality`);
        quality = quality === 'excellent' ? 'good' : quality;
      }
      
      // Check for appropriate frequency content (simplified)
      if (avgEnergy < 0.005) {
        issues.push(`Low audio energy may affect ${selectedAssistant.language} tone recognition`);
      }
    }

    const isValid = quality !== 'unusable' && issues.length < 3;

    return {
      isValid,
      issues,
      quality,
      metadata: {
        sampleCount,
        avgEnergy,
        peakLevel: maxLevel,
        silenceRatio,
        dynamicRange,
        clippingDetected
      }
    };
  };

  const validateMicrophoneAccess = async (): Promise<{
    hasAccess: boolean;
    permissions: string;
    audioDevices: MediaDeviceInfo[];
    issues: string[];
  }> => {
    const issues: string[] = [];
    let hasAccess = false;
    let permissions = 'denied';
    let audioDevices: MediaDeviceInfo[] = [];

    try {
      // Check microphone permissions
      const permissionStatus = await navigator.permissions.query({ name: 'microphone' as PermissionName });
      permissions = permissionStatus.state;

      if (permissions === 'denied') {
        issues.push('Microphone access denied - please enable in browser settings');
      }

      // Get available audio devices
      const devices = await navigator.mediaDevices.enumerateDevices();
      audioDevices = devices.filter(device => device.kind === 'audioinput');

      if (audioDevices.length === 0) {
        issues.push('No microphone devices found');
      } else {
        console.log(`🎤 Found ${audioDevices.length} audio input devices`);
      }

      // Test microphone access
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ 
          audio: {
            echoCancellation: true,
            noiseSuppression: true,
            autoGainControl: true,
            sampleRate: 16000 // Optimal for speech recognition
          } 
        });
        
        hasAccess = true;
        permissions = 'granted';
        
        // Test audio quality briefly
        const audioContext = new AudioContext();
        const source = audioContext.createMediaStreamSource(stream);
        const analyser = audioContext.createAnalyser();
        source.connect(analyser);
        
        const bufferLength = analyser.frequencyBinCount;
        const dataArray = new Uint8Array(bufferLength);
        analyser.getByteFrequencyData(dataArray);
        
        // Clean up test resources
        stream.getTracks().forEach(track => track.stop());
        audioContext.close();
        
        console.log('✅ Microphone test successful');
        
      } catch (error: any) {
        console.error('❌ Microphone access failed:', error);
        issues.push(`Microphone access error: ${error.message}`);
        hasAccess = false;
      }

    } catch (error: any) {
      console.error('❌ Audio validation error:', error);
      issues.push(`Audio system error: ${error.message}`);
    }

    return {
      hasAccess,
      permissions,
      audioDevices,
      issues
    };
  };

  const performAudioDiagnostics = async (): Promise<void> => {
    console.log('🔍 Running comprehensive audio diagnostics...');
    
    try {
      const micValidation = await validateMicrophoneAccess();
      
      toast({
        title: "Audio Diagnostics",
        description: micValidation.hasAccess 
          ? `✅ Audio system ready (${micValidation.audioDevices.length} devices)` 
          : `❌ Audio issues found: ${micValidation.issues.join(', ')}`,
        variant: micValidation.hasAccess ? "default" : "destructive"
      });

      // Log detailed results
      console.log('🎤 Audio Diagnostics Results:', {
        hasAccess: micValidation.hasAccess,
        permissions: micValidation.permissions,
        deviceCount: micValidation.audioDevices.length,
        issues: micValidation.issues
      });

    } catch (error) {
      console.error('❌ Audio diagnostics failed:', error);
      toast({
        title: "Diagnostics Error",
        description: "Failed to run audio diagnostics",
        variant: "destructive"
      });
    }
  };


  // Fetch assistants from API with comprehensive error handling
  useEffect(() => {
    const fetchAssistants = async () => {
      setAssistantsLoading(true);
