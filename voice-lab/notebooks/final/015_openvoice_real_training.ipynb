    "# Real dataset and training setup for OpenVoice\n",
    "class RealOpenVoiceDataset(torch.utils.data.Dataset):\n",
    "    \"\"\"REAL dataset for production OpenVoice training.\"\"\"\n",
    "    \n",
    "    def __init__(self, manifest_df: pd.DataFrame, config: RealOpenVoiceConfig, \n",
    "                 audio_processor: RealOpenVoiceAudioProcessor, text_processor: RealOpenVoiceTextProcessor):\n",
    "        self.manifest_df = manifest_df\n",
    "        self.config = config\n",
    "        self.audio_processor = audio_processor\n",
    "        self.text_processor = text_processor\n",
    "        \n",
    "        # Group by speaker for voice cloning training\n",
    "        self.speaker_groups = self.manifest_df.groupby('speaker_id').groups\n",
    "        self.speakers = list(self.speaker_groups.keys())\n",
    "        \n",
    "        # Filter valid samples\n",
    "        self.valid_samples = self._filter_valid_samples()\n",
    "        print(f\"   📊 Valid samples: {len(self.valid_samples)}/{len(manifest_df)}\")\n",
    "        print(f\"   🎭 Unique speakers: {len(self.speakers)}\")\n",
    "    \n",
    "    def _filter_valid_samples(self):\n",
    "        \"\"\"Filter samples that can be processed successfully.\"\"\"\n",
    "        valid_indices = []\n",
    "        \n",
    "        for idx, row in self.manifest_df.iterrows():\n",
    "            # Check audio file exists\n",
    "            if not Path(row['audio_path']).exists():\n",
    "                continue\n",
    "                \n",
    "            # Check text is valid\n",
    "            if pd.isna(row['transcript']) or len(row['transcript'].strip()) == 0:\n",
    "                continue\n",
    "            \n",
    "            # Check text length\n",
    "            if len(row['transcript']) > self.config.max_text_length:\n",
    "                continue\n",
    "            \n",
    "            # Check speaker has enough samples for reference\n",
    "            speaker_samples = self.speaker_groups.get(row['speaker_id'], [])\n",
    "            if len(speaker_samples) < 2:  # Need at least 2 samples (reference + target)\n",
    "                continue\n",
    "            \n",
    "            valid_indices.append(idx)\n",
    "        \n",
    "        return valid_indices\n",
    "    \n",
    "    def __len__(self):\n",
    "        return len(self.valid_samples)\n",
    "    \n",
    "    def __getitem__(self, idx):\n",
    "        \"\"\"Get a training sample with reference audio for voice cloning.\"\"\"\n",
    "        sample_idx = self.valid_samples[idx]\n",
    "        row = self.manifest_df.iloc[sample_idx]\n",
    "        \n",
    "        try:\n",
    "            # Get target sample\n",
    "            target_mel = self.audio_processor.extract_mel_spectrogram(row['audio_path'])\n",
    "            text_sequence = self.text_processor.text_to_sequence(row['transcript'])\n",
    "            \n",
    "            # Get reference sample from same speaker\n",
    "            speaker_samples = self.speaker_groups[row['speaker_id']]\n",
    "            \n",
    "            # Choose a different sample from the same speaker as reference\n",
    "            available_refs = [s for s in speaker_samples if s != sample_idx]\n",
    "            if available_refs:\n",
    "                ref_idx = np.random.choice(available_refs)\n",
    "                ref_row = self.manifest_df.iloc[ref_idx]\n",
    "                reference_mel = self.audio_processor.extract_reference_mel(ref_row['audio_path'])\n",
    "            else:\n",
    "                # Use same sample as reference if no alternatives\n",
    "                reference_mel = self.audio_processor.extract_reference_mel(row['audio_path'])\n",
    "            \n",
    "            return {\n",
    "                'text_ids': torch.tensor(text_sequence, dtype=torch.long),\n",
    "                'target_mel': torch.tensor(target_mel, dtype=torch.float),\n",
    "                'reference_mel': torch.tensor(reference_mel, dtype=torch.float),\n",
    "                'text': row['transcript'],\n",
    "                'speaker_id': row['speaker_id'],\n",
    "                'audio_path': row['audio_path']\n",
    "            }\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error processing sample {idx}: {e}\")\n",
    "            # Return dummy sample\n",
    "            return {\n",
    "                'text_ids': torch.tensor([2, 3], dtype=torch.long),  # <start><end>\n",
    "                'target_mel': torch.zeros((50, self.config.n_mels), dtype=torch.float),\n",
    "                'reference_mel': torch.zeros((30, self.config.n_mels), dtype=torch.float),\n",
    "                'text': \"dummy\",\n",
    "                'speaker_id': \"dummy\",\n",
    "                'audio_path': \"dummy\"\n",
    "            }\n",
    "\n",
    "def openvoice_collate_fn(batch):\n",
    "    \"\"\"Collate function for OpenVoice batching.\"\"\"\n",
    "    # Sort by text length for efficiency\n",
    "    batch = sorted(batch, key=lambda x: len(x['text_ids']), reverse=True)\n",
    "    \n",
    "    # Get maximum lengths\n",
    "    max_text_len = max(len(item['text_ids']) for item in batch)\n",
    "    max_target_len = max(item['target_mel'].shape[0] for item in batch)\n",
    "    max_ref_len = max(item['reference_mel'].shape[0] for item in batch)\n",
    "    \n",
    "    # Initialize tensors\n",
    "    batch_size = len(batch)\n",
    "    mel_dim = batch[0]['target_mel'].shape[1]\n",
    "    \n",
    "    text_ids = torch.zeros(batch_size, max_text_len, dtype=torch.long)\n",
    "    target_mels = torch.zeros(batch_size, max_target_len, mel_dim, dtype=torch.float)\n",
    "    reference_mels = torch.zeros(batch_size, max_ref_len, mel_dim, dtype=torch.float)\n",
    "    \n",
    "    text_lengths = torch.zeros(batch_size, dtype=torch.long)\n",
    "    target_lengths = torch.zeros(batch_size, dtype=torch.long)\n",
    "    reference_lengths = torch.zeros(batch_size, dtype=torch.long)\n",
    "    \n",
    "    texts = []\n",
    "    speaker_ids = []\n",
    "    audio_paths = []\n",
    "    \n",
    "    # Fill tensors\n",
    "    for i, item in enumerate(batch):\n",
    "        text_len = len(item['text_ids'])\n",
    "        target_len = item['target_mel'].shape[0]\n",
    "        ref_len = item['reference_mel'].shape[0]\n",
    "        \n",
    "        text_ids[i, :text_len] = item['text_ids']\n",
    "        target_mels[i, :target_len] = item['target_mel']\n",
    "        reference_mels[i, :ref_len] = item['reference_mel']\n",
    "        \n",
    "        text_lengths[i] = text_len\n",
    "        target_lengths[i] = target_len\n",
    "        reference_lengths[i] = ref_len\n",
    "        \n",
    "        texts.append(item['text'])\n",
    "        speaker_ids.append(item['speaker_id'])\n",
    "        audio_paths.append(item['audio_path'])\n",
    "    \n",
    "    return {\n",
    "        'text_ids': text_ids,\n",
    "        'target_mels': target_mels,\n",
    "        'reference_mels': reference_mels,\n",
    "        'text_lengths': text_lengths,\n",
    "        'target_lengths': target_lengths,\n",
    "        'reference_lengths': reference_lengths,\n",
    "        'texts': texts,\n",
    "        'speaker_ids': speaker_ids,\n",
    "        'audio_paths': audio_paths\n",
    "    }\n",
    "\n",
    "# Create datasets\n",
    "print(\"🔄 Creating REAL OpenVoice datasets for production training...\")\n",
    "\n",
    "train_dataset = RealOpenVoiceDataset(\n",
    "    real_manifests['train'], config, audio_processor, text_processor\n",
    ")\n",
    "\n",
    "val_dataset = RealOpenVoiceDataset(\n",
    "    real_manifests['val'], config, audio_processor, text_processor\n",
    ")\n",
    "\n",
    "# Create data loaders\n",
    "train_loader = torch.utils.data.DataLoader(\n",
    "    train_dataset,\n",
    "    batch_size=config.batch_size,\n",
    "    shuffle=True,\n",
    "    collate_fn=openvoice_collate_fn,\n",
    "    num_workers=2,\n",
    "    pin_memory=torch.cuda.is_available()\n",
    ")\n",
    "\n",
    "val_loader = torch.utils.data.DataLoader(\n",
    "    val_dataset,\n",
    "    batch_size=config.batch_size,\n",
    "    shuffle=False,\n",
    "    collate_fn=openvoice_collate_fn,\n",
    "    num_workers=2,\n",
    "    pin_memory=torch.cuda.is_available()\n",
    ")\n",
    "\n",
    "print(f\"\\n✅ REAL OpenVoice datasets created successfully!\")\n",
    "print(f\"   Training samples: {len(train_dataset)}\")\n",
    "print(f\"   Validation samples: {len(val_dataset)}\")\n",
    "print(f\"   Training speakers: {len(train_dataset.speakers)}\")\n",
    "print(f\"   Validation speakers: {len(val_dataset.speakers)}\")\n",
    "print(f\"   Batch size: {config.batch_size}\")\n",
    "print(f\"   Training batches per epoch: {len(train_loader)}\")\n",
    "print(f\"   Validation batches: {len(val_loader)}\")"
   ]
