# API Configuration
VITE_API_BASE_URL=https://language-community-api.ailabsafrica.com/api/v1

# WebSocket Configuration
VITE_WS_URL=wss://language-community-api.ailabsafrica.com/ws

# Supabase Configuration - Required for authentication and user management
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Note: Never commit actual credentials to version control
# Copy this file to .env and fill in your actual values