   "source": [
    "# Real OpenVoice trainer with voice cloning loss\n",
    "import torch.optim as optim\n",
    "from torch.optim.lr_scheduler import StepLR\n",
    "from torch.utils.tensorboard import SummaryWriter\n",
    "\n",
    "class RealOpenVoiceTrainer:\n",
    "    \"\"\"REAL trainer for production OpenVoice training.\"\"\"\n",
    "    \n",
    "    def __init__(self, model, config, train_loader, val_loader):\n",
    "        self.model = model\n",
    "        self.config = config\n",
    "        self.train_loader = train_loader\n",
    "        self.val_loader = val_loader\n",
    "        self.device = next(model.parameters()).device\n",
    "        \n",
    "        # Loss functions\n",
    "        self.mel_loss = nn.L1Loss()  # L1 loss for mel spectrogram\n",
    "        self.duration_loss = nn.MSELoss()\n",
    "        self.speaker_loss = nn.CosineSimilarity(dim=-1)  # Speaker similarity loss\n",
    "        \n",
    "        # Optimizer\n",
    "        self.optimizer = optim.AdamW(\n",
    "            model.parameters(),\n",
    "            lr=config.learning_rate,\n",
    "            betas=(0.9, 0.999),\n",
    "            weight_decay=1e-4\n",
    "        )\n",
    "        \n",
    "        # Scheduler\n",
    "        self.scheduler = StepLR(\n",
    "            self.optimizer,\n",
    "            step_size=config.max_steps // 4,\n",
    "            gamma=0.5\n",
    "        )\n",
    "        \n",
    "        # Logging\n",
    "        self.writer = SummaryWriter(log_dir=config.logs_dir)\n",
    "        \n",
    "        # Training state\n",
    "        self.global_step = 0\n",
    "        self.best_val_loss = float('inf')\n",
    "        self.patience_counter = 0\n",
    "    \n",
    "    def compute_loss(self, batch, outputs):\n",
    "        \"\"\"Compute voice cloning training loss.\"\"\"\n",
    "        target_mel = batch['target_mels'].to(self.device)\n",
    "        reference_mel = batch['reference_mels'].to(self.device)\n",
    "        \n",
    "        mel_pred = outputs['mel_pred']\n",
    "        mel_pred_refined = outputs['mel_pred_refined']\n",
    "        durations_pred = outputs['durations']\n",
    "        speaker_emb = outputs['speaker_emb']\n",
    "        \n",
    "        # Mel spectrogram reconstruction loss\n",
    "        min_len = min(target_mel.shape[1], mel_pred.shape[1])\n",
    "        mel_loss_basic = self.mel_loss(\n",
    "            mel_pred[:, :min_len],\n",
    "            target_mel[:, :min_len]\n",
    "        )\n",
    "        \n",
    "        # Refined mel loss\n",
    "        mel_loss_refined = self.mel_loss(\n",
    "            mel_pred_refined[:, :min_len],\n",
    "            target_mel[:, :min_len]\n",
    "        )\n",
    "        \n",
    "        # Duration loss\n",
    "        text_lengths = batch['text_lengths'].to(self.device).float()\n",
    "        target_lengths = batch['target_lengths'].to(self.device).float()\n",
    "        \n",
    "        # Target duration per character\n",
    "        target_durations = (target_lengths.unsqueeze(1) / text_lengths.unsqueeze(1))\n",
    "        target_durations = target_durations.expand(-1, durations_pred.shape[1])\n",
    "        \n",
    "        # Mask for valid positions\n",
    "        duration_mask = torch.arange(durations_pred.shape[1]).unsqueeze(0).to(self.device)\n",
    "        duration_mask = duration_mask < text_lengths.unsqueeze(1)\n",
    "        \n",
    "        if duration_mask.sum() > 0:\n",
    "            duration_loss = self.duration_loss(\n",
    "                durations_pred[duration_mask],\n",
    "                target_durations[duration_mask]\n",
    "            )\n",
    "        else:\n",
    "            duration_loss = torch.tensor(0.0).to(self.device)\n",
    "        \n",
    "        # Speaker consistency loss (same speaker should have similar embeddings)\n",
    "        ref_speaker_emb = self.model.speaker_encoder(reference_mel)\n",
    "        speaker_similarity = self.speaker_loss(speaker_emb, ref_speaker_emb).mean()\n",
    "        speaker_loss = 1.0 - speaker_similarity  # Convert similarity to loss\n",
    "        \n",
    "        # Combined loss\n",
    "        total_loss = (\n",
    "            mel_loss_basic + \n",
    "            mel_loss_refined + \n",
    "            0.1 * duration_loss + \n",
    "            0.2 * speaker_loss\n",
    "        )\n",
    "        \n",
    "        return {\n",
    "            'total_loss': total_loss,\n",
    "            'mel_loss_basic': mel_loss_basic,\n",
    "            'mel_loss_refined': mel_loss_refined,\n",
    "            'duration_loss': duration_loss,\n",
    "            'speaker_loss': speaker_loss,\n",
    "            'speaker_similarity': speaker_similarity\n",
    "        }\n",
    "    \n",
    "    def train_epoch(self):\n",
    "        \"\"\"Train for one epoch.\"\"\"\n",
    "        self.model.train()\n",
    "        epoch_losses = {\n",
    "            'total': 0, 'mel_basic': 0, 'mel_refined': 0, \n",
    "            'duration': 0, 'speaker': 0, 'similarity': 0\n",
    "        }\n",
    "        \n",
    "        for batch_idx, batch in enumerate(self.train_loader):\n",
    "            # Move batch to device\n",
    "            text_ids = batch['text_ids'].to(self.device)\n",
    "            reference_mels = batch['reference_mels'].to(self.device)\n",
    "            target_mels = batch['target_mels'].to(self.device)\n",
    "            \n",
    "            # Forward pass\n",
    "            outputs = self.model(text_ids, reference_mels, target_mels)\n",
    "            \n",
    "            # Compute loss\n",
    "            losses = self.compute_loss(batch, outputs)\n",
    "            \n",
    "            # Backward pass\n",
    "            self.optimizer.zero_grad()\n",
    "            losses['total_loss'].backward()\n",
    "            \n",
    "            # Gradient clipping\n",
    "            torch.nn.utils.clip_grad_norm_(self.model.parameters(), max_norm=1.0)\n",
    "            \n",
    "            self.optimizer.step()\n",
    "            self.scheduler.step()\n",
    "            \n",
    "            # Update running losses\n",
    "            epoch_losses['total'] += losses['total_loss'].item()\n",
    "            epoch_losses['mel_basic'] += losses['mel_loss_basic'].item()\n",
    "            epoch_losses['mel_refined'] += losses['mel_loss_refined'].item()\n",
    "            epoch_losses['duration'] += losses['duration_loss'].item()\n",
    "            epoch_losses['speaker'] += losses['speaker_loss'].item()\n",
    "            epoch_losses['similarity'] += losses['speaker_similarity'].item()\n",
    "            \n",
    "            # Logging\n",
    "            if self.global_step % self.config.logging_steps == 0:\n",
    "                current_lr = self.scheduler.get_last_lr()[0]\n",
    "                self.writer.add_scalar('train/total_loss', losses['total_loss'].item(), self.global_step)\n",
    "                self.writer.add_scalar('train/mel_loss_basic', losses['mel_loss_basic'].item(), self.global_step)\n",
    "                self.writer.add_scalar('train/mel_loss_refined', losses['mel_loss_refined'].item(), self.global_step)\n",
    "                self.writer.add_scalar('train/duration_loss', losses['duration_loss'].item(), self.global_step)\n",
    "                self.writer.add_scalar('train/speaker_loss', losses['speaker_loss'].item(), self.global_step)\n",
    "                self.writer.add_scalar('train/speaker_similarity', losses['speaker_similarity'].item(), self.global_step)\n",
    "                self.writer.add_scalar('train/learning_rate', current_lr, self.global_step)\n",
    "                \n",
    "                print(f\"Step {self.global_step}: Total={losses['total_loss'].item():.4f}, \"\n",
    "                      f\"Mel={losses['mel_loss_basic'].item():.4f}, \"\n",
    "                      f\"Speaker_Sim={losses['speaker_similarity'].item():.3f}, LR={current_lr:.2e}\")\n",
    "            \n",
    "            self.global_step += 1\n",
    "            \n",
    "            # Early stopping check\n",
    "            if self.global_step >= self.config.max_steps:\n",
    "                break\n",
    "        \n",
    "        # Average losses\n",
    "        num_batches = len(self.train_loader)\n",
    "        for key in epoch_losses:\n",
    "            epoch_losses[key] /= num_batches\n",
    "        \n",
    "        return epoch_losses\n",
    "    \n",
    "    def validate(self):\n",
    "        \"\"\"Validate the model.\"\"\"\n",
    "        self.model.eval()\n",
    "        val_losses = {\n",
    "            'total': 0, 'mel_basic': 0, 'mel_refined': 0, \n",
    "            'duration': 0, 'speaker': 0, 'similarity': 0\n",
    "        }\n",
    "        \n",
    "        with torch.no_grad():\n",
    "            for batch in self.val_loader:\n",
    "                # Move batch to device\n",
    "                text_ids = batch['text_ids'].to(self.device)\n",
    "                reference_mels = batch['reference_mels'].to(self.device)\n",
    "                target_mels = batch['target_mels'].to(self.device)\n",
    "                \n",
    "                # Forward pass\n",
    "                outputs = self.model(text_ids, reference_mels, target_mels)\n",
    "                \n",
    "                # Compute loss\n",
    "                losses = self.compute_loss(batch, outputs)\n",
    "                \n",
    "                val_losses['total'] += losses['total_loss'].item()\n",
    "                val_losses['mel_basic'] += losses['mel_loss_basic'].item()\n",
    "                val_losses['mel_refined'] += losses['mel_loss_refined'].item()\n",
    "                val_losses['duration'] += losses['duration_loss'].item()\n",
    "                val_losses['speaker'] += losses['speaker_loss'].item()\n",
    "                val_losses['similarity'] += losses['speaker_similarity'].item()\n",
    "        \n",
    "        # Average losses\n",
    "        num_batches = len(self.val_loader)\n",
    "        for key in val_losses:\n",
    "            val_losses[key] /= num_batches\n",
    "        \n",
    "        return val_losses\n",
    "    \n",
    "    def save_checkpoint(self, epoch, val_loss):\n",
    "        \"\"\"Save model checkpoint.\"\"\"\n",
    "        checkpoint = {\n",
    "            'epoch': epoch,\n",
    "            'global_step': self.global_step,\n",
    "            'model_state_dict': self.model.state_dict(),\n",
    "            'optimizer_state_dict': self.optimizer.state_dict(),\n",
    "            'scheduler_state_dict': self.scheduler.state_dict(),\n",
    "            'val_loss': val_loss,\n",
    "            'config': self.config\n",
    "        }\n",
    "        \n",
    "        checkpoint_path = self.config.checkpoints_dir / f'checkpoint_step_{self.global_step}.pt'\n",
    "        torch.save(checkpoint, checkpoint_path)\n",
    "        \n",
    "        # Save best model\n",
    "        if val_loss < self.best_val_loss:\n",
    "            self.best_val_loss = val_loss\n",
    "            best_path = self.config.output_dir / 'best_openvoice_model.pt'\n",
    "            torch.save(checkpoint, best_path)\n",
    "            self.patience_counter = 0\n",
    "        else:\n",
    "            self.patience_counter += 1\n",
    "    \n",
    "    def train(self):\n",
    "        \"\"\"Full training loop.\"\"\"\n",
    "        print(f\"\\n🚀 Starting REAL OpenVoice training...\")\n",
    "        \n",
    "        for epoch in range(self.config.num_train_epochs):\n",
    "            if self.global_step >= self.config.max_steps:\n",
    "                break\n",
    "            \n",
    "            print(f\"\\n📊 Epoch {epoch + 1}/{self.config.num_train_epochs}\")\n",
    "            \n",
    "            # Train\n",
    "            train_losses = self.train_epoch()\n",
    "            print(f\"   Train - Total: {train_losses['total']:.4f}, Mel: {train_losses['mel_basic']:.4f}, \"\n",
    "                  f\"Speaker_Sim: {train_losses['similarity']:.3f}\")\n",
    "            \n",
    "            # Validate\n",
    "            if epoch % 2 == 0:  # Validate every 2 epochs\n",
    "                val_losses = self.validate()\n",
    "                print(f\"   Val - Total: {val_losses['total']:.4f}, Mel: {val_losses['mel_basic']:.4f}, \"\n",
    "                      f\"Speaker_Sim: {val_losses['similarity']:.3f}\")\n",
    "                \n",
    "                # Log validation losses\n",
    "                self.writer.add_scalar('val/total_loss', val_losses['total'], self.global_step)\n",
    "                self.writer.add_scalar('val/mel_loss_basic', val_losses['mel_basic'], self.global_step)\n",
    "                self.writer.add_scalar('val/speaker_similarity', val_losses['similarity'], self.global_step)\n",
    "                \n",
    "                # Save checkpoint\n",
    "                self.save_checkpoint(epoch, val_losses['total'])\n",
    "                \n",
    "                # Early stopping\n",
    "                if self.patience_counter >= self.config.early_stopping_patience:\n",
    "                    print(f\"\\n⚠️ Early stopping triggered after {self.patience_counter} epochs without improvement\")\n",
    "                    break\n",
    "        \n",
    "        print(f\"\\n✅ Training completed!\")\n",
    "        print(f\"   Total steps: {self.global_step}\")\n",
    "        print(f\"   Best validation loss: {self.best_val_loss:.4f}\")\n",
    "        \n",
    "        self.writer.close()\n",
    "\n",
    "# Initialize trainer\n",
    "trainer = RealOpenVoiceTrainer(openvoice_model, config, train_loader, val_loader)\n",
    "\n",
    "print(f\"\\n✅ REAL OpenVoice trainer initialized!\")\n",
    "print(f\"   Training samples: {len(train_dataset)}\")\n",
