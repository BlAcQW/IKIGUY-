    {
      "parameters": {
        "jsCode": "// Wait for call completion and extract booking results\nconst callId = $input.first().json.id;\nconst maxWaitTime = 600000; // 10 minutes\nconst checkInterval = 15000; // 15 seconds\nlet totalWaitTime = 0;\n\nwhile (totalWaitTime < maxWaitTime) {\n  await new Promise(resolve => setTimeout(resolve, checkInterval));\n  totalWaitTime += checkInterval;\n  \n  // Check call status\n  const response = await $http.request({\n    method: 'GET',\n    url: `https://api.vapi.ai/call/${callId}`,\n    headers: {\n      'Authorization': 'Bearer 42cf1e7c-2ef9-4bd7-ba30-52f2813605a2'\n    }\n  });\n  \n  if (response.status === 'ended') {\n    return [{\n      json: {\n        call_id: callId,\n        call_duration: response.duration,\n        booking_outcome: response.analysis?.structuredData?.booking_outcome || 'no_booking',\n        appointment_type: response.analysis?.structuredData?.appointment_type || 'unknown',\n        scheduled_datetime: response.analysis?.structuredData?.scheduled_datetime || null,\n        customer_satisfaction: response.analysis?.structuredData?.customer_satisfaction || 'neutral',\n        special_requirements: response.analysis?.structuredData?.special_requirements || [],\n        booking_efficiency: response.analysis?.structuredData?.booking_efficiency || 5,\n        follow_up_needed: response.analysis?.structuredData?.follow_up_needed || false,\n        appointment_value_estimate: response.analysis?.structuredData?.appointment_value_estimate || 0,\n        call_summary: response.analysis?.summary || 'No summary available',\n        transcript: response.transcript || ''\n      }\n    }];\n  }\n}\n\n// Timeout reached\nreturn [{\n  json: {\n    call_id: callId,\n    booking_outcome: 'timeout',\n    error: 'Call monitoring timed out after 10 minutes'\n  }\n}];"
      },
      "id": "monitor-booking-call",
      "name": "Monitor Booking Call Completion",
      "type": "n8n-nodes-base.code",
