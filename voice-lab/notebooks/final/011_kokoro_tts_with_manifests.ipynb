    "                        clean_word = re.sub(r'[^\\w]', '', word)\n",
    "                        if len(clean_word) > 2:\n",
    "                            word_counts[clean_word] = word_counts.get(clean_word, 0) + 1\n",
    "        \n",
    "        # Add most common words to pronunciation dictionary\n",
