    "\n",
    "def benchmark_performance():\n",
    "    \"\"\"Benchmark Coqui TTS performance.\"\"\"\n",
    "    print(\"⚡ Benchmarking Coqui TTS performance...\")\n",
    "    \n",
    "    if not TTS_AVAILABLE:\n",
    "        print(\"   ❌ TTS library not available for benchmarking\")\n",
    "        return\n",
    "    \n",
    "    try:\n",
    "        # Load model\n",
    "        tts = TTS(\"tts_models/multilingual/multi-dataset/xtts_v2\", gpu=torch.cuda.is_available())\n",
    "        \n",
    "        # Test cases\n",
    "        test_cases = [\n",
    "            {\"text\": \"Short test.\", \"expected_duration\": 1.5},\n",
    "            {\"text\": \"This is a medium length sentence for testing.\", \"expected_duration\": 3.0},\n",
    "            {\"text\": \"This is a longer sentence that should take more time to synthesize and will test the performance of the TTS system.\", \"expected_duration\": 6.0}\n",
    "        ]\n",
    "        \n",
    "        if coqui_dataset_path:\n",
    "            wavs_dir = coqui_dataset_path / \"wavs\"\n",
    "            audio_files = list(wavs_dir.glob(\"*.wav\"))\n",
    "            \n",
    "            if audio_files:\n",
    "                reference_audio = str(audio_files[0])\n",
    "                \n",
    "                results = []\n",
    "                \n",
    "                for i, case in enumerate(test_cases):\n",
    "                    print(f\"   🔄 Testing case {i+1}: '{case['text'][:30]}...'\")\n",
    "                    \n",
    "                    start_time = time.time()\n",
    "                    output_path = config.output_dir / f\"benchmark_{i}.wav\"\n",
    "                    \n",
    "                    tts.tts_to_file(\n",
    "                        text=case[\"text\"],\n",
    "                        speaker_wav=reference_audio,\n",
    "                        language=\"en\",\n",
    "                        file_path=str(output_path)\n",
    "                    )\n",
    "                    \n",
    "                    synthesis_time = time.time() - start_time\n",
    "                    \n",
    "                    if output_path.exists():\n",
    "                        info = sf.info(str(output_path))\n",
    "                        actual_duration = info.duration\n",
    "                        rtf = synthesis_time / actual_duration  # Real-time factor\n",
    "                        \n",
    "                        results.append({\n",
    "                            'case': i+1,\n",
    "                            'synthesis_time': synthesis_time,\n",
    "                            'audio_duration': actual_duration,\n",
    "                            'rtf': rtf\n",
    "                        })\n",
    "                        \n",
    "                        print(f\"     ✅ Synthesis: {synthesis_time:.2f}s, Audio: {actual_duration:.2f}s, RTF: {rtf:.2f}x\")\n",
    "                    else:\n",
    "                        print(f\"     ❌ Failed to generate audio\")\n",
    "                \n",
    "                # Summary\n",
    "                if results:\n",
    "                    avg_rtf = np.mean([r['rtf'] for r in results])\n",
    "                    print(f\"\\n   📊 Performance Summary:\")\n",
    "                    print(f\"     Average RTF: {avg_rtf:.2f}x\")\n",
    "                    print(f\"     {'✅ Faster than real-time' if avg_rtf < 1.0 else '⚠️ Slower than real-time'}\")\n",
    "            else:\n",
    "                print(\"   ⚠️ No reference audio available for benchmarking\")\n",
    "        else:\n",
    "            print(\"   ⚠️ No dataset available for benchmarking\")\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f\"   ❌ Benchmarking failed: {e}\")\n",
    "\n",
    "print(\"\\n🎯 Testing and Validation Functions Ready:\")\n",
    "print(\"# test_coqui_setup()\")\n",
