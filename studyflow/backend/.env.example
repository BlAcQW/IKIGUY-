# StudyFlow Backend Configuration

# Environment
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="StudyFlow API"

# AI Provider - Using Gemini 2.5 Flash (Latest, fastest, cheapest)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Alternative: OpenAI (not recommended, 2x more expensive)
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Database - MongoDB (Main database)
MONGODB_URL=mongodb://admin:password@localhost:27017/studyflow?authSource=admin
MONGODB_DATABASE=studyflow

# Database - PostgreSQL with pgvector (For RAG/embeddings)
POSTGRES_HOST=db.ljzbzjgvwzivpmlmuxhx.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=postgres

# Supabase (Authentication)
SUPABASE_URL=https://ljzbzjgvwzivpmlmuxhx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payment Gateways
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
MTN_MOMO_API_KEY=your-mtn-momo-key

# Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://studyflow.ailabsafrica.com

# RAG Configuration
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_RETRIEVAL_K=3
RAG_SIMILARITY_THRESHOLD=0.3
RAG_CONFIDENCE_THRESHOLD=0.7

# Pricing (in GHS - Ghana Cedis)
FREE_TRIAL_MINUTES=30
PAY_AS_YOU_LEARN_PRICE=0.20  # ₵20 = 100 minutes
MONTHLY_PRICE=50.00
SCHOOL_PRICE_PER_STUDENT=30.00

# Features
ENABLE_VOICE=true
ENABLE_IMAGE_UPLOAD=true
ENABLE_DOCUMENT_PROCESSING=true
ENABLE_SPEECH_TO_TEXT=true

# n8n Workflow Automation
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=your-n8n-api-key

# Monitoring
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_ENABLED=false
