[Unit]
Description=African Language Community Platform API
After=network.target mongod.service
Wants=network-online.target
Requires=mongod.service

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/opt/kasaai/apps/community/backend
Environment=PATH=/opt/kasaai/apps/community/backend/venv/bin
Environment=PYTHONPATH=/opt/kasaai/apps/community/backend
Environment=ENVIRONMENT=production
Environment=LOG_LEVEL=info
Environment=DATABASE_URL=mongodb://localhost:27017/language_community
Environment=JWT_SECRET_KEY=your_production_jwt_secret_here
Environment=STORAGE_PATH=/opt/kasaai/data/community
Environment=MAX_UPLOAD_SIZE=100MB
Environment=CORS_ORIGINS=https://language-community.ailabsafrica.com
Environment=SUPABASE_URL=your_supabase_url
Environment=SUPABASE_ANON_KEY=your_supabase_anon_key
ExecStart=/opt/kasaai/apps/community/backend/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8001 --workers 4
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StartLimitInterval=60s
StartLimitBurst=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=language-community-api

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kasaai/data/community /tmp /var/log
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target