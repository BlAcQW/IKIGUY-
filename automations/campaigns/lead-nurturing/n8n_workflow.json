    {
      "parameters": {
        "jsCode": "// Wait for call completion and extract results\nconst callId = $input.first().json.id;\nconst maxWaitTime = 600000; // 10 minutes\nconst checkInterval = 15000; // 15 seconds\nlet totalWaitTime = 0;\n\nwhile (totalWaitTime < maxWaitTime) {\n  await new Promise(resolve => setTimeout(resolve, checkInterval));\n  totalWaitTime += checkInterval;\n  \n  // Check call status\n  const response = await $http.request({\n    method: 'GET',\n    url: `https://api.vapi.ai/call/${callId}`,\n    headers: {\n      'Authorization': 'Bearer 42cf1e7c-2ef9-4bd7-ba30-52f2813605a2'\n    }\n  });\n  \n  if (response.status === 'ended') {\n    return [{\n      json: {\n        call_id: callId,\n        call_duration: response.duration,\n        call_outcome: response.analysis?.structuredData?.call_outcome || 'unknown',\n        lead_qualification_score: response.analysis?.structuredData?.lead_qualification_score || 0,\n        buying_signals: response.analysis?.structuredData?.buying_signals_identified || [],\n        pain_points: response.analysis?.structuredData?.pain_points_discovered || [],\n        decision_timeline: response.analysis?.structuredData?.decision_timeline || 'unclear',\n        conversion_probability: response.analysis?.structuredData?.conversion_probability || 0,\n        next_action: response.analysis?.structuredData?.next_action_required || 'follow_up',\n        call_summary: response.analysis?.summary || 'No summary available',\n        transcript: response.transcript || ''\n      }\n    }];\n  }\n}\n\n// Timeout reached\nreturn [{\n  json: {\n    call_id: callId,\n    call_outcome: 'timeout',\n    error: 'Call monitoring timed out after 10 minutes'\n  }\n}];"
      },
