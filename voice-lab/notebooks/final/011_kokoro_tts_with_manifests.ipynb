    "# Text processing and phonemization for Kokoro TTS\n",
    "class KokoroTextProcessor:\n",
    "    \"\"\"Enhanced text processing for Kokoro TTS with Twi support.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: KokoroManifestConfig):\n",
    "        self.config = config\n",
    "        \n",
    "    def process_manifest_text(self, manifests: Dict[str, pd.DataFrame]) -> Dict[str, pd.DataFrame]:\n",
    "        \"\"\"Process text in manifests for Kokoro TTS training.\"\"\"\n",
    "        print(\"📝 Processing text for Kokoro TTS...\")\n",
    "        \n",
    "        processed_manifests = {}\n",
    "        \n",
    "        for split_name, df in manifests.items():\n",
    "            if df.empty:\n",
    "                processed_manifests[split_name] = df\n",
    "                continue\n",
    "            \n",
    "            print(f\"   🔄 Processing {split_name}: {len(df)} samples\")\n",
    "            \n",
    "            processed_texts = []\n",
    "            phonemes = []\n",
    "            \n",
    "            for text in tqdm(df['text'], desc=f\"Processing {split_name} text\", leave=False):\n",
    "                # Clean and normalize text\n",
    "                cleaned_text = self._clean_text_for_kokoro(text)\n",
    "                processed_texts.append(cleaned_text)\n",
    "                \n",
    "                # Generate phonemes if phonemizer is available\n",
    "                if PHONEMIZER_AVAILABLE and cleaned_text:\n",
    "                    try:\n",
    "                        # Try to phonemize (may not work perfectly for Twi)\n",
    "                        phoneme = phonemize(\n",
    "                            cleaned_text,\n",
    "                            language='en-us',  # Fallback to English phonemes\n",
    "                            backend='espeak',\n",
    "                            strip=True,\n",
    "                            preserve_punctuation=True\n",
    "                        )\n",
    "                        phonemes.append(phoneme)\n",
    "                    except:\n",
    "                        # Fallback to original text\n",
    "                        phonemes.append(cleaned_text)\n",
    "                else:\n",
    "                    # Use original text as phonemes\n",
    "                    phonemes.append(cleaned_text)\n",
    "            \n",
    "            # Update dataframe\n",
    "            df = df.copy()\n",
    "            df['processed_text'] = processed_texts\n",
    "            df['phonemes'] = phonemes\n",
    "            \n",
    "            # Filter out empty processed texts\n",
    "            df = df[df['processed_text'].str.len() > 0]\n",
    "            \n",
    "            processed_manifests[split_name] = df\n",
    "            \n",
    "            print(f\"   ✅ {split_name}: {len(df)} samples after text processing\")\n",
    "        \n",
    "        return processed_manifests\n",
    "    \n",
    "    def _clean_text_for_kokoro(self, text: str) -> str:\n",
    "        \"\"\"Clean text specifically for Kokoro TTS training.\"\"\"\n",
    "        if not isinstance(text, str):\n",
    "            return \"\"\n",
    "        \n",
    "        # Basic cleaning\n",
    "        text = text.strip()\n",
    "        \n",
    "        # Remove or normalize problematic characters\n",
    "        import re\n",
    "        \n",
    "        # Keep Twi characters and basic punctuation\n",
    "        text = re.sub(r'[^\\w\\sɛɔãẽĩõũáéíóúàèìòùŋ.,!?\\'\\-]', '', text)\n",
    "        \n",
    "        # Normalize quotation marks\n",
    "        text = re.sub(r'["""]', '\"', text)\n",
    "        text = re.sub(r'[''']', \"'\", text)\n",
    "        \n",
    "        # Normalize dashes\n",
    "        text = re.sub(r'[—–−]', '-', text)\n",
    "        \n",
    "        # Remove excessive punctuation\n",
    "        text = re.sub(r'[.]{2,}', '.', text)\n",
    "        text = re.sub(r'[!]{2,}', '!', text)\n",
    "        text = re.sub(r'[?]{2,}', '?', text)\n",
    "        \n",
    "        # Normalize whitespace\n",
    "        text = re.sub(r'\\s+', ' ', text)\n",
    "        \n",
    "        # Ensure text ends with punctuation for better prosody\n",
    "        if text and text[-1] not in '.!?':\n",
    "            text += '.'\n",
    "        \n",
    "        return text.strip()\n",
    "    \n",
