    "# Create vocabulary and tokenizer for REAL Wav2Vec2 training\n",
    "class RealWav2Vec2VocabularyBuilder:\n",
    "    \"\"\"Build vocabulary and tokenizer for REAL Wav2Vec2 CTC training.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: RealWav2Vec2Config):\n",
    "        self.config = config\n",
    "        \n",
    "    def build_vocabulary(self, manifests: Dict[str, pd.DataFrame]) -> Dict[str, str]:\n",
    "        \"\"\"Build vocabulary from REAL training transcripts.\"\"\"\n",
    "        print(\"📚 Building vocabulary from REAL training data...\")\n",
    "        \n",
    "        # Collect all transcripts\n",
    "        all_transcripts = []\n",
    "        for split_name, df in manifests.items():\n",
    "            if not df.empty:\n",
    "                all_transcripts.extend(df['transcript'].tolist())\n",
    "        \n",
    "        print(f\"   📊 Processing {len(all_transcripts)} transcripts...\")\n",
    "        \n",
    "        # Extract unique characters\n",
    "        vocab_set = set()\n",
    "        for transcript in all_transcripts:\n",
    "            if isinstance(transcript, str):\n",
    "                vocab_set.update(list(transcript.lower()))\n",
    "        \n",
    "        # Remove whitespace from vocab (will be handled separately)\n",
    "        vocab_set.discard(' ')\n",
    "        \n",
    "        # Sort vocabulary for consistency\n",
    "        vocab_list = sorted(list(vocab_set))\n",
    "        \n",
    "        # Create vocabulary mapping\n",
    "        vocab_dict = {self.config.pad_token: 0, self.config.unk_token: 1}\n",
    "        \n",
    "        # Add characters\n",
    "        for i, char in enumerate(vocab_list):\n",
    "            vocab_dict[char] = i + 2\n",
    "        \n",
    "        # Add word boundary token (important for CTC)\n",
    "        vocab_dict[\"|\"] = len(vocab_dict)\n",
    "        \n",
    "        print(f\"   📚 Vocabulary size: {len(vocab_dict)} characters\")\n",
    "        print(f\"   📝 Characters: {', '.join(vocab_list[:20])}{'...' if len(vocab_list) > 20 else ''}\")\n",
    "        \n",
    "        # Save vocabulary\n",
    "        vocab_file = self.config.output_dir / \"vocab.json\"\n",
    "        with open(vocab_file, 'w', encoding='utf-8') as f:\n",
    "            json.dump(vocab_dict, f, ensure_ascii=False, indent=2)\n",
    "        \n",
    "        print(f\"   ✅ Vocabulary saved to: {vocab_file}\")\n",
    "        \n",
    "        return vocab_dict\n",
    "    \n",
    "    def create_processor(self, vocab_dict: Dict[str, str]) -> Wav2Vec2Processor:\n",
    "        \"\"\"Create REAL Wav2Vec2 processor with custom vocabulary.\"\"\"\n",
    "        print(\"🔧 Creating REAL Wav2Vec2 processor...\")\n",
    "        \n",
    "        # Create tokenizer with custom vocabulary\n",
    "        tokenizer = Wav2Vec2CTCTokenizer(\n",
    "            vocab_file=None,\n",
    "            vocab_dict=vocab_dict,\n",
    "            unk_token=self.config.unk_token,\n",
    "            pad_token=self.config.pad_token,\n",
    "            word_delimiter_token=\"|\"\n",
    "        )\n",
    "        \n",
    "        # Create feature extractor\n",
    "        feature_extractor = Wav2Vec2FeatureExtractor(\n",
    "            sampling_rate=self.config.sample_rate,\n",
    "            feature_size=1,\n",
    "            padding_value=0.0,\n",
    "            do_normalize=True,\n",
    "            return_attention_mask=True\n",
