# TTS Deployment Environment Configuration

# Storage Configuration
STORAGE_TYPE=local
STORAGE_BASE_PATH=/app/outputs

# Local GPU Configuration
LOCAL_GPU_DEVICE=0
LOCAL_GPU_MEMORY_FRACTION=0.9

# RunPod Configuration
# IMPORTANT: Only update RUNPOD_POD_ID when you create a new pod
# The pod ID stays constant across restarts and is used for stable SSH connections

# Pod Identifier (get from RunPod console)
# Format: {random-id}-{8-char-hash}
RUNPOD_POD_ID=jzfmzviw26huka-644113c7

# Connection Method: proxy (recommended), direct, or auto
# - proxy: Uses ssh.runpod.io (stable, survives port changes)
# - direct: Uses IP:port directly (faster, but port may change)
# - auto: Tries proxy first, falls back to direct
RUNPOD_CONNECTION_METHOD=proxy

# Direct TCP Configuration (only needed if using direct/auto mode)
# NOTE: This IP and port may change when pod restarts!
RUNPOD_DIRECT_HOST=194.68.245.121
RUNPOD_DIRECT_PORT=22130
RUNPOD_DIRECT_USER=root

# SSH Key Path
SSH_KEY_PATH=/home/dev/.ssh/id_ed25519

# RunPod API Key (optional, for auto-discovery of connection details)
# Get from: https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=rpa_0AGD99DG0R237PDY5XPGVA887USJWOVCWCUFMSF91g3y2o

# Service Ports - Local GPU
MELOTTS_PORT=8001
OPENVOICE_PORT=8003
CHATTERBOX_PORT=8004
COQUI_PORT=8005
CRAWL4AI_PORT=8009
KOKORO_PORT=8010

# Service Ports - RunPod GPU (via SSH tunnels)
F5TTS_PORT=8002
STYLETTS2_PORT=8006
KYUTAI_PORT=8008

# Domains
MELOTTS_DOMAIN=melotts.ailabsafrica.com
OPENVOICE_DOMAIN=openvoice.ailabsafrica.com
CHATTERBOX_DOMAIN=chatterbox.ailabsafrica.com
COQUI_DOMAIN=coqui.ailabsafrica.com
F5TTS_DOMAIN=f5tts.ailabsafrica.com
STYLETTS2_DOMAIN=styletts.ailabsafrica.com
KYUTAI_DOMAIN=kyutai.ailabsafrica.com
CRAWL4AI_DOMAIN=crawl4ai.ailabsafrica.com
KOKORO_DOMAIN=kokoro.ailabsafrica.com

# Logging
LOG_LEVEL=info

# API Configuration
MAX_TEXT_LENGTH=5000
DEFAULT_AUDIO_FORMAT=wav
AUDIO_SAMPLE_RATE=24000

# Cleanup Settings
AUTO_CLEANUP_ENABLED=true
AUTO_CLEANUP_INTERVAL_HOURS=24
MAX_FILE_AGE_HOURS=48

# Docker Hub (for RunPod templates)
DOCKER_HUB_USERNAME=ailabsafrica
DOCKER_HUB_TOKEN=dckr_pat_ReBluOQjSQK_KtR4fGKBJ75kaS4

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Performance
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT_SECONDS=300
