    ></vapi-widget>

    <!-- Vapi Chat Widget -->
    <vapi-widget
        public-key="0c22dcea-0d6c-4fc0-8fb2-93292d8575e8"
        assistant-id="baa69b3a-8944-4557-9ef9-3a5aa6956eb3"
        mode="chat"
        theme="dark"
        base-bg-color="#000000"
        accent-color="#14B8A6"
        cta-button-color="#000000"
        cta-button-text-color="#ffffff"
        border-radius="large"
        size="full"
        position="bottom-left"
        title="Chat with Ama for information on all facilities covered by Premier Health Services nationwide"
        start-button-text="Start"
        end-button-text="End Chat"
