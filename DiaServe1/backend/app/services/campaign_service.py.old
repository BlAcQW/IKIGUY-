"""
Campaign Service for EstateFlow.

Unified campaign management across all channels (Voice, SMS, WhatsApp, Email).
"""

from motor.motor_asyncio import AsyncIOMotorDatabase
from typing import List, Optional, Dict, Any
from datetime import datetime
import logging
import sys
import asyncio

# Add shared to path
sys.path.insert(0, "/opt/kasaai/apps")

from app.models.campaign import (
    Campaign,
    CampaignCreate,
    CampaignUpdate,
    CampaignType,
    CampaignStatus,
    CampaignMessage,
    CampaignMessageStatus,
    SegmentFilter
)
from app.services.contact_service import ContactService

# Import shared campaign services
from shared.services.sms_campaign_service import SMSCampaignService
from shared.services.whatsapp_campaign_service import WhatsAppCampaignService
from shared.services.unified_email_service import get_email_service
from shared.services.vapi_campaign_service import VapiCampaignService

logger = logging.getLogger(__name__)


class CampaignService:
    """Service for managing multi-channel campaigns."""

    def __init__(self, database: AsyncIOMotorDatabase):
        """
        Initialize campaign service.

        Args:
            database: MongoDB database instance
        """
        self.db = database
        self.campaigns_collection = database["campaigns"]
        self.messages_collection = database["campaign_messages"]
        self.contact_service = ContactService(database)

        # Initialize shared services
        try:
            # SMS Service (will use Arkesel provider by default from env)
            self.sms_service = SMSCampaignService(db=database)
            logger.info("SMS campaign service initialized")
        except Exception as e:
            logger.warning(f"Failed to initialize SMS service: {str(e)}")
            self.sms_service = None

        try:
            # WhatsApp Service (will use WhatsApp Business API from env)
            self.whatsapp_service = WhatsAppCampaignService(db=database)
            logger.info("WhatsApp campaign service initialized")
        except Exception as e:
            logger.warning(f"Failed to initialize WhatsApp service: {str(e)}")
            self.whatsapp_service = None

        try:
            # Email Service (iRedMail via UnifiedEmailService)
            self.email_service = get_email_service()
            logger.info("Email service initialized (iRedMail)")
        except Exception as e:
            logger.warning(f"Failed to initialize email service: {str(e)}")
            self.email_service = None

        try:
            # Vapi Voice Service
            self.vapi_service = VapiCampaignService(db=database)
            logger.info("Vapi campaign service initialized")
        except Exception as e:
            logger.warning(f"Failed to initialize Vapi service: {str(e)}")
            self.vapi_service = None

    async def create_campaign(
        self,
        campaign_data: CampaignCreate,
        organization_id: str,
        user_id: str
    ) -> Campaign:
        """
        Create a new campaign.

        Args:
            campaign_data: Campaign creation data
            organization_id: Organization ID
            user_id: User ID creating the campaign

        Returns:
            Created campaign
        """
        from bson import ObjectId

        # Generate ID
        campaign_id = str(ObjectId())

        # Build campaign document
        campaign_dict = campaign_data.dict()

        # Ensure schedule_config is a dict, not None
        if campaign_dict.get("schedule_config") is None:
            campaign_dict["schedule_config"] = {}

        campaign_dict.update({
            "id": campaign_id,
            "organization_id": organization_id,
            "user_id": user_id,
            "status": CampaignStatus.DRAFT.value,
            "target_count": 0,
            "sent_count": 0,
            "delivered_count": 0,
            "opened_count": 0,
            "clicked_count": 0,
            "failed_count": 0,
            "total_cost": 0.0,
            "created_at": datetime.utcnow(),
            "updated_at": datetime.utcnow(),
            "started_at": None,
            "completed_at": None,
            "external_campaign_id": None
        })

        # Insert into database
        await self.campaigns_collection.insert_one(campaign_dict)

        logger.info(f"Created {campaign_data.campaign_type} campaign {campaign_id} for organization {organization_id}")

        return Campaign(**campaign_dict)

    async def get_campaign(
        self,
        campaign_id: str,
        organization_id: str
    ) -> Optional[Campaign]:
        """
        Get a campaign by ID.

        Args:
            campaign_id: Campaign ID
            organization_id: Organization ID for access control

        Returns:
            Campaign if found, None otherwise
        """
        campaign_doc = await self.campaigns_collection.find_one({
            "id": campaign_id,
            "organization_id": organization_id
        })

        if not campaign_doc:
            return None

        # Remove MongoDB _id
        campaign_doc.pop("_id", None)

        return Campaign(**campaign_doc)

    async def list_campaigns(
        self,
        organization_id: str,
        campaign_type: Optional[CampaignType] = None,
        status: Optional[CampaignStatus] = None,
        limit: int = 50,
        offset: int = 0
    ) -> tuple[List[Campaign], int]:
        """
        List campaigns for an organization.

        Args:
            organization_id: Organization ID
            campaign_type: Optional filter by campaign type
            status: Optional filter by status
            limit: Maximum number of campaigns to return
            offset: Number of campaigns to skip

        Returns:
            Tuple of (campaigns list, total count)
        """
        # Build query
        query = {"organization_id": organization_id}

        if campaign_type:
            query["campaign_type"] = campaign_type.value

        if status:
            query["status"] = status.value

        # Get total count
        total = await self.campaigns_collection.count_documents(query)

        # Get campaigns with pagination
        cursor = self.campaigns_collection.find(query).skip(offset).limit(limit).sort("created_at", -1)
        campaigns_docs = await cursor.to_list(length=limit)

        campaigns = []
        for doc in campaigns_docs:
            doc.pop("_id", None)
            campaigns.append(Campaign(**doc))

        return campaigns, total

    async def update_campaign(
        self,
        campaign_id: str,
        updates: CampaignUpdate,
        organization_id: str
    ) -> Optional[Campaign]:
        """
        Update a campaign (DRAFT only).

        Args:
            campaign_id: Campaign ID
            updates: Update data
            organization_id: Organization ID for access control

        Returns:
            Updated campaign if found, None otherwise

        Raises:
            ValueError: If campaign is not in DRAFT status
        """
        # Check campaign status
        campaign = await self.get_campaign(campaign_id, organization_id)
        if not campaign:
            return None

        if campaign.status != CampaignStatus.DRAFT:
            raise ValueError(f"Cannot update campaign in {campaign.status} status. Only DRAFT campaigns can be updated.")

        # Build update document
        update_dict = {k: v for k, v in updates.dict().items() if v is not None}
        update_dict["updated_at"] = datetime.utcnow()

        # Update in database
        await self.campaigns_collection.update_one(
            {"id": campaign_id, "organization_id": organization_id},
            {"$set": update_dict}
        )

        # Return updated campaign
        return await self.get_campaign(campaign_id, organization_id)

    async def delete_campaign(
        self,
        campaign_id: str,
        organization_id: str
    ) -> bool:
        """
        Delete a campaign (DRAFT only).

        Args:
            campaign_id: Campaign ID
            organization_id: Organization ID for access control

        Returns:
            True if deleted, False if not found

        Raises:
            ValueError: If campaign is not in DRAFT status
        """
        # Check campaign status
        campaign = await self.get_campaign(campaign_id, organization_id)
        if not campaign:
            return False

        if campaign.status != CampaignStatus.DRAFT:
            raise ValueError(f"Cannot delete campaign in {campaign.status} status. Only DRAFT campaigns can be deleted.")

        # Delete campaign
        result = await self.campaigns_collection.delete_one({
            "id": campaign_id,
            "organization_id": organization_id
        })

        # Delete associated messages
        await self.messages_collection.delete_many({
            "campaign_id": campaign_id,
            "organization_id": organization_id
        })

        return result.deleted_count > 0

    async def preview_segment(
        self,
        segment_filter: SegmentFilter,
        organization_id: str,
        campaign_type: CampaignType
    ) -> Dict[str, Any]:
        """
        Preview contacts that would be targeted by a segment filter.

        Args:
            segment_filter: Filter criteria
            organization_id: Organization ID
            campaign_type: Campaign type for opt-out filtering

        Returns:
            Dictionary with contact count, sample contacts, and estimated cost
        """
        # Get all matching contacts
        contacts = await self.contact_service.apply_segment_filter(
            segment_filter=segment_filter,
            organization_id=organization_id,
            campaign_type=campaign_type,
            limit=None
        )

        # Get sample (first 10)
        sample_contacts = contacts[:10]

        # Calculate estimated cost
        contact_count = len(contacts)
        estimated_cost = self._estimate_campaign_cost(campaign_type, contact_count)

        return {
            "contact_count": contact_count,
            "sample_contacts": sample_contacts,
            "estimated_cost": estimated_cost
        }

    def _estimate_campaign_cost(
        self,
        campaign_type: CampaignType,
        contact_count: int
    ) -> float:
        """
        Estimate campaign cost based on type and contact count.

        Args:
            campaign_type: Campaign type
            contact_count: Number of contacts

        Returns:
            Estimated cost in USD
        """
        # Cost per message (estimates)
        cost_per_message = {
            CampaignType.SMS: 0.05,  # ~GHS 0.05 per SMS
            CampaignType.WHATSAPP: 0.10,  # ~GHS 0.10 per WhatsApp
            CampaignType.VOICE: 0.52,  # TTS (~$0.50) + Call (~$0.02/min)
            CampaignType.EMAIL: 0.01  # ~GHS 0.01 per email
        }

        return cost_per_message.get(campaign_type, 0.0) * contact_count

    async def launch_campaign(
        self,
        campaign_id: str,
        organization_id: str
    ) -> Campaign:
        """
        Launch a campaign.

        Args:
            campaign_id: Campaign ID
            organization_id: Organization ID for access control

        Returns:
            Updated campaign

        Raises:
            ValueError: If campaign cannot be launched
        """
        # Get campaign
        campaign = await self.get_campaign(campaign_id, organization_id)
        if not campaign:
            raise ValueError(f"Campaign {campaign_id} not found")

        # Validate status
        if campaign.status not in [CampaignStatus.DRAFT, CampaignStatus.PAUSED]:
            raise ValueError(f"Cannot launch campaign in {campaign.status} status")

        # Get target contacts
        if campaign.segment_filter:
            contacts = await self.contact_service.apply_segment_filter(
                segment_filter=campaign.segment_filter,
                organization_id=organization_id,
                campaign_type=campaign.campaign_type,
                limit=None
            )
        else:
            # All contacts
            contacts, _ = await self.contact_service.list_contacts(
                organization_id=organization_id,
                limit=10000  # Max limit
            )

        if not contacts:
            raise ValueError("No contacts match the campaign criteria")

        # Update campaign with target count
        await self.campaigns_collection.update_one(
            {"id": campaign_id},
            {
                "$set": {
                    "target_count": len(contacts),
                    "status": CampaignStatus.RUNNING.value,
                    "started_at": datetime.utcnow(),
                    "updated_at": datetime.utcnow()
                }
            }
        )

        # Dispatch to appropriate channel
        if campaign.campaign_type == CampaignType.SMS:
            await self._launch_sms_campaign(campaign, contacts, organization_id)
        elif campaign.campaign_type == CampaignType.WHATSAPP:
            await self._launch_whatsapp_campaign(campaign, contacts, organization_id)
        elif campaign.campaign_type == CampaignType.VOICE:
            await self._launch_voice_campaign(campaign, contacts, organization_id)
        elif campaign.campaign_type == CampaignType.EMAIL:
            await self._launch_email_campaign(campaign, contacts, organization_id)

        # Return updated campaign
        return await self.get_campaign(campaign_id, organization_id)

    async def _launch_sms_campaign(
        self,
        campaign: Campaign,
        contacts: List,
        organization_id: str
    ):
        """Launch SMS campaign using shared SMS service."""
        logger.info(f"Launching SMS campaign {campaign.id} with {len(contacts)} contacts")

        if not self.sms_service:
            logger.error("SMS service not initialized")
            raise ValueError("SMS service not available")

        # Create recipients list with phone numbers only
        recipients = []
        contact_map = {}  # Map phone to contact for tracking

        for contact in contacts:
            if contact.phone:
                recipients.append({
                    "phone": contact.phone,
                    "name": contact.name or "Customer",
                    "data": {
                        "name": contact.name or "Customer",
                        "contact_id": contact.id
                    }
                })
                contact_map[contact.phone] = contact

        if not recipients:
            logger.warning(f"No valid phone numbers found for campaign {campaign.id}")
            return

        logger.info(f"SMS campaign {campaign.id}: {len(recipients)} recipients with phone numbers")

        # Create SMS campaign in shared service
        try:
            # Get message template text
            message_template = campaign.message_template.text_content or ""

            # Create SMS campaign
            sms_campaign = await self.sms_service.create_campaign(
                name=f"{campaign.name} (EstateFlow)",
                organization_id=organization_id,
                user_id=campaign.user_id,
                template_content=message_template,
                config={
                    "send_rate_per_second": 2.0,  # 2 SMS per second
                    "batch_size": 100,
                    "retry_failed": True,
                    "max_retries": 2
                },
                sms_provider="arkesel"  # Use Arkesel for Ghana
            )

            logger.info(f"Created SMS campaign in shared service: {sms_campaign.id}")

            # Update campaign with external ID
            await self.campaigns_collection.update_one(
                {"id": campaign.id},
                {"$set": {"external_campaign_id": sms_campaign.id}}
            )

            # TODO: Send bulk SMS via shared service
            # This would involve calling sms_service.send_bulk() with recipients
            # For now, we'll log the action
            logger.info(f"SMS campaign {campaign.id} created. Manual trigger needed for actual sending.")

        except Exception as e:
            logger.error(f"Error launching SMS campaign: {str(e)}")
            raise

    async def _launch_whatsapp_campaign(
        self,
        campaign: Campaign,
        contacts: List,
        organization_id: str
    ):
        """Launch WhatsApp campaign using shared WhatsApp service."""
        logger.info(f"Launching WhatsApp campaign {campaign.id} with {len(contacts)} contacts")

        if not self.whatsapp_service:
            logger.error("WhatsApp service not initialized")
            raise ValueError("WhatsApp service not available")

        # Create recipients list
        recipients = []
        contact_map = {}

        for contact in contacts:
            if contact.phone:
                recipients.append({
                    "phone": contact.phone,
                    "name": contact.name or "Customer",
                    "data": {
                        "name": contact.name or "Customer",
                        "contact_id": contact.id
                    }
                })
                contact_map[contact.phone] = contact

        if not recipients:
            logger.warning(f"No valid phone numbers found for WhatsApp campaign {campaign.id}")
            return

        logger.info(f"WhatsApp campaign {campaign.id}: {len(recipients)} recipients prepared")

        try:
            # Get message template text
            message_template = campaign.message_template.text_content or ""

            # Create WhatsApp campaign in shared service
            whatsapp_campaign = await self.whatsapp_service.create_campaign(
                name=f"{campaign.name} (EstateFlow)",
                organization_id=organization_id,
                user_id=campaign.user_id,
                template_content=message_template,
                config={
                    "send_rate_per_second": 1.0,  # 1 WhatsApp per second (rate limited)
                    "batch_size": 50,
                    "retry_failed": True,
                    "max_retries": 2
                }
            )

            logger.info(f"Created WhatsApp campaign in shared service: {whatsapp_campaign.id}")

            # Update campaign with external ID
            await self.campaigns_collection.update_one(
                {"id": campaign.id},
                {"$set": {"external_campaign_id": whatsapp_campaign.id}}
            )

            # TODO: Send bulk WhatsApp messages via shared service
            logger.info(f"WhatsApp campaign {campaign.id} created. Manual trigger needed for actual sending.")

        except Exception as e:
            logger.error(f"Error launching WhatsApp campaign: {str(e)}")
            raise

    async def _launch_voice_campaign(
        self,
        campaign: Campaign,
        contacts: List,
        organization_id: str
    ):
        """Launch Voice campaign using Vapi assistant."""
        logger.info(f"Launching Voice campaign {campaign.id} with {len(contacts)} contacts")

        if not self.vapi_service:
            logger.error("Vapi service not initialized")
            raise ValueError("Vapi service not available")

        # Get Vapi assistant ID from campaign message template
        vapi_assistant_id = campaign.message_template.voice_id
        if not vapi_assistant_id:
            raise ValueError("Vapi assistant ID required for voice campaigns")

        # Create recipients list with phone numbers
        recipients = []
        contact_map = {}

        for contact in contacts:
            if contact.phone:
                recipients.append({
                    "phone": contact.phone,
                    "name": contact.name or "Customer",
                    "contact_id": contact.id,
                    "data": {
                        "name": contact.name or "Customer",
                        "contact_id": contact.id,
                        "property_type_preferences": contact.property_type_preferences or [],
                        "location_preferences": contact.location_preferences or [],
                        "budget_min": contact.budget_min,
                        "budget_max": contact.budget_max
                    }
                })
                contact_map[contact.phone] = contact

        if not recipients:
            logger.warning(f"No valid phone numbers found for voice campaign {campaign.id}")
            return

        logger.info(f"Voice campaign {campaign.id}: {len(recipients)} recipients prepared")

        try:
            # Create Vapi campaign in shared service
            vapi_campaign = await self.vapi_service.create_campaign(
                name=f"{campaign.name} (EstateFlow)",
                organization_id=organization_id,
                user_id=campaign.user_id,
                assistant_id=vapi_assistant_id,
                phone_number_id=None,  # Will use Vapi's default phone number
                config={
                    "max_concurrent_calls": 3,  # Vapi concurrent call limit
                    "call_delay_seconds": 30,
                    "max_retries": 2,
                    "retry_on_no_answer": True,
                    "assistant_id": vapi_assistant_id
                }
            )

            logger.info(f"Created Vapi campaign in shared service: {vapi_campaign.id}")

            # Update campaign with external ID
            await self.campaigns_collection.update_one(
                {"id": campaign.id},
                {"$set": {"external_campaign_id": vapi_campaign.id}}
            )

            # Start the Vapi campaign
            await self.vapi_service.start_campaign(
                campaign_id=vapi_campaign.id,
                contacts=recipients
            )

            logger.info(f"Voice campaign {campaign.id} started via Vapi")

        except Exception as e:
            logger.error(f"Error launching voice campaign: {str(e)}")
            raise

    async def _launch_email_campaign(
        self,
        campaign: Campaign,
        contacts: List,
        organization_id: str
    ):
        """Launch Email campaign using iRedMail via UnifiedEmailService."""
        logger.info(f"Launching Email campaign {campaign.id} with {len(contacts)} contacts")

        if not self.email_service:
            logger.error("Email service not initialized")
            raise ValueError("Email service not available")

        # Create recipients list
        recipients = []
        contact_map = {}

        for contact in contacts:
            if contact.email:
                recipients.append({
                    "email": contact.email,
                    "name": contact.name or "Customer",
                    "contact_id": contact.id
                })
                contact_map[contact.email] = contact

        if not recipients:
            logger.warning(f"No valid email addresses found for campaign {campaign.id}")
            return

        logger.info(f"Email campaign {campaign.id}: {len(recipients)} recipients prepared")

        try:
            # Get email content
            subject = campaign.message_template.subject or f"{campaign.name}"
            html_body = campaign.message_template.html_content
            text_body = campaign.message_template.text_content or ""

            # If no HTML provided, create basic HTML from text
            if not html_body and text_body:
                html_body = f"<html><body><p>{text_body}</p></body></html>"

            # Send emails (batch processing for reliability)
            sent_count = 0
            failed_count = 0

            for recipient in recipients:
                try:
                    # Personalize content (basic placeholder replacement)
                    personalized_subject = subject.replace("{{name}}", recipient["name"])
                    personalized_body = (html_body or text_body).replace("{{name}}", recipient["name"])

                    # Send email via iRedMail
                    result = await self.email_service.send_email(
                        to=recipient["email"],
                        subject=personalized_subject,
                        body=personalized_body if not html_body else text_body,
                        html_body=personalized_body if html_body else None,
                        from_email="noreply@ailabsafrica.com",
                        from_name="EstateFlow"
                    )

                    if result.get("success"):
                        sent_count += 1
                        logger.debug(f"Email sent to {recipient['email']}")
                    else:
                        failed_count += 1
                        logger.warning(f"Failed to send email to {recipient['email']}: {result.get('error')}")

                    # Small delay to avoid overwhelming SMTP server
                    await asyncio.sleep(0.1)

                except Exception as e:
                    failed_count += 1
                    logger.error(f"Error sending email to {recipient['email']}: {str(e)}")

            # Update campaign counters
            await self.campaigns_collection.update_one(
                {"id": campaign.id},
                {
                    "$set": {
                        "sent_count": sent_count,
                        "failed_count": failed_count,
                        "updated_at": datetime.utcnow()
                    }
                }
            )

            logger.info(
                f"Email campaign {campaign.id} completed: "
                f"{sent_count} sent, {failed_count} failed"
            )

        except Exception as e:
            logger.error(f"Error launching email campaign: {str(e)}")
            raise

    async def pause_campaign(
        self,
        campaign_id: str,
        organization_id: str
    ) -> Campaign:
        """
        Pause a running campaign.

        Args:
            campaign_id: Campaign ID
            organization_id: Organization ID for access control

        Returns:
            Updated campaign

        Raises:
            ValueError: If campaign cannot be paused
        """
        campaign = await self.get_campaign(campaign_id, organization_id)
        if not campaign:
            raise ValueError(f"Campaign {campaign_id} not found")

        if campaign.status != CampaignStatus.RUNNING:
            raise ValueError(f"Cannot pause campaign in {campaign.status} status")

        # Update status
        await self.campaigns_collection.update_one(
            {"id": campaign_id},
            {
                "$set": {
                    "status": CampaignStatus.PAUSED.value,
                    "updated_at": datetime.utcnow()
                }
            }
        )

        return await self.get_campaign(campaign_id, organization_id)

    async def get_campaign_analytics(
        self,
        campaign_id: str,
        organization_id: str
    ) -> Dict[str, Any]:
        """
        Get campaign analytics.

        Args:
            campaign_id: Campaign ID
            organization_id: Organization ID for access control

        Returns:
            Analytics data
        """
        campaign = await self.get_campaign(campaign_id, organization_id)
        if not campaign:
            raise ValueError(f"Campaign {campaign_id} not found")

        # Get message statistics
        pipeline = [
            {"$match": {"campaign_id": campaign_id, "organization_id": organization_id}},
            {
                "$group": {
                    "_id": "$status",
                    "count": {"$sum": 1}
                }
            }
        ]

        message_stats = {}
        async for doc in self.messages_collection.aggregate(pipeline):
            message_stats[doc["_id"]] = doc["count"]

        # Calculate metrics
        total_sent = campaign.sent_count
        delivery_rate = (campaign.delivered_count / total_sent * 100) if total_sent > 0 else 0
        failure_rate = (campaign.failed_count / total_sent * 100) if total_sent > 0 else 0

        return {
            "campaign_id": campaign_id,
            "status": campaign.status,
            "target_count": campaign.target_count,
            "sent_count": campaign.sent_count,
            "delivered_count": campaign.delivered_count,
            "opened_count": campaign.opened_count,
            "clicked_count": campaign.clicked_count,
            "failed_count": campaign.failed_count,
            "total_cost": campaign.total_cost,
            "delivery_rate": round(delivery_rate, 2),
            "failure_rate": round(failure_rate, 2),
            "message_stats": message_stats,
            "started_at": campaign.started_at,
            "completed_at": campaign.completed_at
        }
