      "webhookId": "premier-health-vapi-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Extract and validate VAPI call data\nconst items = $input.all();\nconst callData = items[0].json;\n\n// Extract call information\nconst extractedData = {\n  call_id: callData.call?.id || 'unknown',\n  phone_number: callData.call?.phoneNumberId || callData.phoneNumber,\n  customer_number: callData.call?.customer?.number || callData.customer?.number,\n  transcript: callData.transcript || '',\n  assistant_message: callData.message?.content || '',\n  call_status: callData.call?.status || 'unknown',\n  timestamp: new Date().toISOString(),\n  \n  // Extract healthcare search intent from transcript or assistant message\n  search_query: callData.message?.content || callData.transcript || '',\n  \n  // VAPI function call data if present\n  function_call: callData.message?.function_call || null,\n  \n  // Call metadata\n  call_duration: callData.call?.duration || 0,\n  call_direction: callData.call?.type || 'inbound',\n  \n  // Customer contact preferences\n  customer_email: callData.customer?.email || null,\n  customer_wants_email: false,\n  customer_wants_sms: false\n};\n\n// Check if customer requested email or SMS\nconst messageContent = (callData.message?.content || '').toLowerCase();\nif (messageContent.includes('email') || messageContent.includes('send me')) {\n  extractedData.customer_wants_email = true;\n}\nif (messageContent.includes('sms') || messageContent.includes('text') || messageContent.includes('message')) {\n  extractedData.customer_wants_sms = true;\n}\n\n// Log the received data for debugging\nconsole.log('VAPI Call Data Received:', JSON.stringify(extractedData, null, 2));\n\nreturn [{ json: extractedData }];"
      },
      "id": "a7b3f1e8-2c5d-4f9a-8b6e-1d4c7a9f3b2e",
      "name": "Extract VAPI Call Data",
