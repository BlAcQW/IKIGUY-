      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 300]
    },
    {
      "parameters": {
        "jsCode": "// Wait for call completion and extract results\nconst callId = $input.first().json.id;\nconst maxWaitTime = 300000; // 5 minutes\nconst checkInterval = 10000; // 10 seconds\nlet totalWaitTime = 0;\n\nwhile (totalWaitTime < maxWaitTime) {\n  await new Promise(resolve => setTimeout(resolve, checkInterval));\n  totalWaitTime += checkInterval;\n  \n  // Check call status\n  const response = await $http.request({\n    method: 'GET',\n    url: `https://api.vapi.ai/call/${callId}`,\n    headers: {\n      'Authorization': 'Bearer 42cf1e7c-2ef9-4bd7-ba30-52f2813605a2'\n    }\n  });\n  \n  if (response.status === 'ended') {\n    return [{\n      json: {\n        call_id: callId,\n        call_duration: response.duration,\n        call_outcome: response.analysis?.structuredData?.call_outcome || 'unknown',\n        customer_interest_level: response.analysis?.structuredData?.customer_interest_level || 'unknown',\n        reactivation_likelihood: response.analysis?.structuredData?.reactivation_likelihood || 0,\n        objections_raised: response.analysis?.structuredData?.objections_raised || [],\n        next_action_required: response.analysis?.structuredData?.next_action_required || 'none',\n        call_summary: response.analysis?.summary || 'No summary available',\n        transcript: response.transcript || ''\n      }\n    }];\n  }\n}\n\n// Timeout reached\nreturn [{\n  json: {\n    call_id: callId,\n    call_outcome: 'timeout',\n    error: 'Call monitoring timed out after 5 minutes'\n  }\n}];"
      },
      "id": "monitor-call-completion",
      "name": "Monitor Call Completion",
