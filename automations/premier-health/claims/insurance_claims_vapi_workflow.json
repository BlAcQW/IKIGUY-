                  "claimId": "={{ $json.claimId }}",
                  "claimStatus": "={{ $json.status }}",
                  "customerName": "={{ $json.customerName }}"
                }
              }
            }
          ]
        },
        "options": {}
      },
      "id": "vapi_outbound_call",
      "name": "Vapi - Initiate Claim Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [750, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "vapiCredentials",
          "name": "Vapi API"
        }
      }
    },
    {
      "parameters": {
        "path": "vapi-webhook",
        "responseMode": "responseNode",
        "options": {
          "responseCode": 200
        }
      },
      "id": "webhook_vapi_events",
      "name": "Webhook - Vapi Events",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 500],
      "webhookId": "vapi-events-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.type }}",
              "operation": "equals",
              "value2": "call-ended"
            }
          ]
        }
      },
      "id": "if_call_ended",
      "name": "IF - Call Ended",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 500]
    },
    {
      "parameters": {
        "operation": "insert",
        "collection": "insurance_claims",
        "fields": {
          "claimId": "={{ $json.claimId }}",
          "customerName": "={{ $json.customerName }}",
          "customerPhone": "={{ $json.customerPhone }}",
          "claimType": "={{ $json.claimType }}",
          "description": "={{ $json.description }}",
          "amount": "={{ $json.amount }}",
          "status": "submitted",
          "submittedAt": "={{ $now }}",
          "vapiCallId": "={{ $json.vapiCallId }}",
          "transcription": "={{ $json.transcript }}",
          "recordingUrl": "={{ $json.recordingUrl }}"
        }
