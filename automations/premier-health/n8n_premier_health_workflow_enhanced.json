    {
      "parameters": {
        "jsCode": "// Prepare healthcare search parameters from VAPI function call\nconst items = $input.all();\nconst callData = items[0].json;\n\nlet searchParams = {\n  query: 'general search',\n  max_results: 5,\n  location: null,\n  specialty: null,\n  provider_type: null\n};\n\n// Extract function call parameters if available\nif (callData.function_call && callData.function_call.arguments) {\n  const args = typeof callData.function_call.arguments === 'string' \n    ? JSON.parse(callData.function_call.arguments)\n    : callData.function_call.arguments;\n    \n  searchParams.query = args.query || callData.search_query || 'general search';\n  searchParams.max_results = args.max_results || 5;\n  searchParams.location = args.location || null;\n  searchParams.specialty = args.specialty || null;\n  searchParams.provider_type = args.provider_type || null;\n}\n\n// Prepare the complete call context\nconst enhancedData = {\n  ...callData,\n  search_params: searchParams,\n  api_endpoint: '/premier-health/search',\n  request_timestamp: new Date().toISOString()\n};\n\nconsole.log('Prepared Search Parameters:', JSON.stringify(searchParams, null, 2));\n\nreturn [{ json: enhancedData }];"
      },
      "id": "d9f5a3b8-4c7e-2f6a-8d9b-3e5c7a1f4b8d",
      "name": "Prepare Healthcare Search",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "postgresApi",
        "operation": "executeQuery",
        "query": "SELECT p.id, p.name, p.phone, p.location, p.address, p.specialty, p.provider_type, p.latitude, p.longitude, p.rating, p.verified, p.created_at FROM phi_service_providers p WHERE p.active = true AND (p.name ILIKE '%{{ $json.search_params.query }}%' OR p.specialty ILIKE '%{{ $json.search_params.query }}%' OR p.location ILIKE '%{{ $json.search_params.query }}%') {{ $json.search_params.location ? \"AND p.location ILIKE '%\" + $json.search_params.location + \"%'\" : \"\" }} {{ $json.search_params.specialty ? \"AND p.specialty ILIKE '%\" + $json.search_params.specialty + \"%'\" : \"\" }} {{ $json.search_params.provider_type ? \"AND p.provider_type ILIKE '%\" + $json.search_params.provider_type + \"%'\" : \"\" }} ORDER BY p.rating DESC, p.verified DESC LIMIT {{ $json.search_params.max_results || 5 }}",
        "additionalFields": {
          "mode": "independently"
        }
      },
