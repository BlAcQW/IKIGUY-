                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-segmentation",
      "name": "Check Segmentation Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "mode": "parallel",
        "jsCode": "// Process each customer segment for personalized outreach\nconst segmentedCustomers = $node['Customer Segmentation'].json.segmented_customers;\nconst productData = $node['Validate Launch Data'].json;\n\nconst results = [];\n\nfor (const segment of segmentedCustomers) {\n  for (const customer of segment.customers) {\n    results.push({\n      json: {\n        customer_id: customer.customer_id,\n        customer_name: customer.name,\n        customer_email: customer.email,\n        customer_phone: customer.phone,\n        customer_segment: segment.segment_name,\n        product_id: productData.product_id,\n        product_name: productData.product_name,\n        campaign_id: productData.campaign_id,\n        personalization_data: {\n          segment: segment.segment_name,\n          purchase_history: customer.purchase_history || [],\n          interests: customer.interests || [],\n          engagement_score: customer.engagement_score || 5,\n          customer_value: customer.customer_value || 'medium'\n        },\n        launch_message_priority: segment.priority || 'normal',\n        preferred_contact_time: customer.preferred_contact_time || 'business_hours'\n      }\n    });\n  }\n}\n\nreturn results;"
      },
