    "# Audio processing and text utilities for OpenVoice\n",
    "class RealOpenVoiceAudioProcessor:\n",
    "    \"\"\"Real audio processing for production OpenVoice training.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: RealOpenVoiceConfig):\n",
    "        self.config = config\n",
    "        \n",
    "    def extract_mel_spectrogram(self, audio_path: str) -> np.ndarray:\n",
    "        \"\"\"Extract mel spectrogram from REAL audio file.\"\"\"\n",
    "        try:\n",
    "            # Load audio at target sample rate\n",
    "            audio, sr = librosa.load(audio_path, sr=self.config.sample_rate)\n",
    "            \n",
    "            # Ensure audio is not too long\n",
    "            max_samples = int(self.config.max_audio_length * self.config.sample_rate)\n",
    "            if len(audio) > max_samples:\n",
    "                audio = audio[:max_samples]\n",
    "            \n",
    "            # Extract mel spectrogram\n",
    "            mel_spec = librosa.feature.melspectrogram(\n",
    "                y=audio,\n",
    "                sr=self.config.sample_rate,\n",
    "                n_fft=self.config.n_fft,\n",
    "                hop_length=self.config.hop_length,\n",
    "                n_mels=self.config.n_mels,\n",
    "                fmin=0,\n",
    "                fmax=self.config.sample_rate // 2\n",
    "            )\n",
    "            \n",
    "            # Convert to log scale\n",
    "            mel_spec = librosa.power_to_db(mel_spec, ref=np.max)\n",
    "            \n",
    "            # Normalize to [-1, 1] range\n",
    "            mel_spec = 2 * (mel_spec - mel_spec.min()) / (mel_spec.max() - mel_spec.min()) - 1\n",
    "            \n",
    "            return mel_spec.T  # Transpose to (time, mels)\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error processing {audio_path}: {e}\")\n",
    "            # Return dummy mel spectrogram\n",
    "            return np.zeros((100, self.config.n_mels))\n",
    "    \n",
    "    def extract_reference_mel(self, audio_path: str) -> np.ndarray:\n",
    "        \"\"\"Extract reference mel spectrogram for voice cloning.\"\"\"\n",
    "        try:\n",
    "            # Load audio\n",
    "            audio, sr = librosa.load(audio_path, sr=self.config.sample_rate)\n",
    "            \n",
    "            # Use first few seconds as reference\n",
    "            ref_samples = int(self.config.reference_length * self.config.sample_rate)\n",
    "            if len(audio) > ref_samples:\n",
    "                audio = audio[:ref_samples]\n",
    "            \n",
    "            # Extract mel spectrogram\n",
    "            mel_spec = librosa.feature.melspectrogram(\n",
    "                y=audio,\n",
    "                sr=self.config.sample_rate,\n",
    "                n_fft=self.config.n_fft,\n",
    "                hop_length=self.config.hop_length,\n",
    "                n_mels=self.config.n_mels,\n",
    "                fmin=0,\n",
    "                fmax=self.config.sample_rate // 2\n",
    "            )\n",
    "            \n",
    "            # Convert to log scale and normalize\n",
    "            mel_spec = librosa.power_to_db(mel_spec, ref=np.max)\n",
    "            mel_spec = 2 * (mel_spec - mel_spec.min()) / (mel_spec.max() - mel_spec.min()) - 1\n",
    "            \n",
    "            return mel_spec.T  # Transpose to (time, mels)\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error processing reference {audio_path}: {e}\")\n",
    "            return np.zeros((50, self.config.n_mels))\n",
    "\n",
    "class RealOpenVoiceTextProcessor:\n",
    "    \"\"\"Real text processing for production OpenVoice training.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: RealOpenVoiceConfig):\n",
    "        self.config = config\n",
    "        self.vocab = self._build_vocab()\n",
    "        \n",
    "    def _build_vocab(self) -> Dict[str, int]:\n",
    "        \"\"\"Build character vocabulary for Twi TTS with prosody markers.\"\"\"\n",
    "        # Extended character set for Twi with prosody\n",
    "        chars = list('abcdefghijklmnopqrstuvwxyzɛɔɲŋ .,!?-;:()')\n",
    "        \n",
    "        # Add prosody and emotion markers for OpenVoice\n",
    "        prosody_markers = ['<PAUSE>', '<STRESS>', '<RISE>', '<FALL>', '<HAPPY>', '<SAD>', '<EXCITED>']\n",
    "        \n",
    "        vocab = {'<pad>': 0, '<unk>': 1, '<start>': 2, '<end>': 3}\n",
    "        \n",
    "        for i, char in enumerate(chars + prosody_markers):\n",
    "            vocab[char] = i + 4\n",
    "        \n",
    "        return vocab\n",
    "    \n",
    "    def text_to_sequence(self, text: str) -> List[int]:\n",
    "        \"\"\"Convert text to sequence of token IDs with prosody.\"\"\"\n",
    "        text = text.lower().strip()\n",
    "        \n",
    "        # Simple prosody insertion (in practice, use proper G2P and emotion detection)\n",
    "        text = text.replace(',', ' <PAUSE> ')\n",
    "        text = text.replace('.', ' <PAUSE> ')\n",
    "        text = text.replace('!', ' <STRESS> <EXCITED> ')\n",
    "        text = text.replace('?', ' <RISE> ')\n",
    "        text = text.replace(';', ' <PAUSE> ')\n",
    "        \n",
    "        sequence = [self.vocab['<start>']]\n",
    "        \n",
    "        words = text.split()\n",
    "        for word in words:\n",
    "            if word in self.vocab:\n",
    "                sequence.append(self.vocab[word])\n",
    "            else:\n",
    "                for char in word:\n",
    "                    sequence.append(self.vocab.get(char, self.vocab['<unk>']))\n",
    "            \n",
    "            # Add space between words\n",
    "            if word != words[-1]:\n",
    "                sequence.append(self.vocab.get(' ', self.vocab['<unk>']))\n",
    "        \n",
    "        sequence.append(self.vocab['<end>'])\n",
    "        \n",
    "        return sequence\n",
    "    \n",
    "    def sequence_to_text(self, sequence: List[int]) -> str:\n",
    "        \"\"\"Convert sequence of token IDs back to text.\"\"\"\n",
    "        id_to_char = {v: k for k, v in self.vocab.items()}\n",
    "        text = ' '.join([id_to_char.get(id, '<unk>') for id in sequence])\n",
    "        \n",
    "        # Clean up special tokens\n",
    "        text = text.replace('<pad>', '')\n",
    "        text = text.replace('<unk>', '')\n",
    "        text = text.replace('<start>', '')\n",
    "        text = text.replace('<end>', '')\n",
    "        \n",
    "        # Clean up prosody markers\n",
    "        text = text.replace('<PAUSE>', ',')\n",
    "        text = text.replace('<STRESS>', '!')\n",
    "        text = text.replace('<RISE>', '?')\n",
    "        text = text.replace('<FALL>', '.')\n",
    "        text = text.replace('<HAPPY>', '')\n",
    "        text = text.replace('<SAD>', '')\n",
    "        text = text.replace('<EXCITED>', '')\n",
    "        \n",
    "        return text.strip()\n",
    "\n",
    "# Initialize processors\n",
    "audio_processor = RealOpenVoiceAudioProcessor(config)\n",
    "text_processor = RealOpenVoiceTextProcessor(config)\n",
    "\n",
    "# Initialize model\n",
    "openvoice_model = RealOpenVoiceModel(config, len(text_processor.vocab))\n",
    "\n",
    "# Move to GPU if available\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "openvoice_model = openvoice_model.to(device)\n",
    "\n",
    "# Model summary\n",
    "param_count = sum(p.numel() for p in openvoice_model.parameters())\n",
    "trainable_params = sum(p.numel() for p in openvoice_model.parameters() if p.requires_grad)\n",
    "\n",
    "print(f\"\\n📊 REAL OpenVoice Model Summary:\")\n",
    "print(f\"   Total parameters: {param_count:,}\")\n",
    "print(f\"   Trainable parameters: {trainable_params:,}\")\n",
    "print(f\"   Vocabulary size: {len(text_processor.vocab)}\")\n",
    "print(f\"   Speaker encoder dim: {config.speaker_encoder_dim}\")\n",
    "print(f\"   Style encoder dim: {config.style_encoder_dim}\")\n",
    "print(f\"   Device: {next(openvoice_model.parameters()).device}\")\n",
    "\n",
    "print(f\"\\n✅ REAL OpenVoice processors and model initialized!\")\n",
    "print(f\"   Audio processor: 24kHz, {config.n_mels} mel channels\")\n",
    "print(f\"   Text processor: {len(text_processor.vocab)} vocab size with prosody and emotion\")\n",
    "print(f\"   Reference length: {config.reference_length}s\")\n",
    "print(f\"   Voice cloning: Instant adaptation from reference audio\")"
   ]
