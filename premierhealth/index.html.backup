<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Premier Health Insurance - Your Bridge to Premier Healthcare</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        .hero {
            background: linear-gradient(135deg, #003366 0%, #006699 50%, #0099cc 100%);
            color: white;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600"><path d="M0,300 Q300,100 600,300 T1200,300 L1200,600 L0,600 Z" fill="rgba(255,255,255,0.05)"/></svg>') no-repeat bottom;
            background-size: cover;
        }

        .hero-content {
            position: relative;
            z-index: 1;
        }

        .service-card {
            transition: all 0.3s ease-in-out;
            border: 1px solid #e5e7eb;
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            border-color: #14B8A6;
        }

        .service-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #14B8A6 0%, #0d9488 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            transition: transform 0.3s ease;
        }

        .service-card:hover .service-icon {
            transform: scale(1.1) rotate(5deg);
        }

        .assistant-section {
            background: linear-gradient(to bottom, #f9fafb 0%, #ffffff 100%);
            border-top: 1px solid #e5e7eb;
            border-bottom: 1px solid #e5e7eb;
        }

        .assistant-card {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .assistant-card:hover {
            border-color: #14B8A6;
            box-shadow: 0 20px 25px -5px rgba(20, 184, 166, 0.1), 0 10px 10px -5px rgba(20, 184, 166, 0.04);
        }

        .assistant-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #14B8A6 0%, #0d9488 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            box-shadow: 0 10px 15px -3px rgba(20, 184, 166, 0.3);
        }

        .pulse-ring {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: .5;
            }
        }

        .cta-button {
            background: linear-gradient(135deg, #14B8A6 0%, #0d9488 100%);
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px -1px rgba(20, 184, 166, 0.3);
        }

        .cta-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(20, 184, 166, 0.4);
        }

        .feature-badge {
            display: inline-block;
            background: rgba(20, 184, 166, 0.1);
            color: #0d9488;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.875rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #14B8A6 0%, #0d9488 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Vapi Widget Customization */
        #vapi-widget-container {
            z-index: 9999 !important;
        }

        .floating-action {
            position: fixed;
            bottom: 30px;
            right: 30px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            z-index: 998;
        }

        .floating-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #14B8A6 0%, #0d9488 100%);
            box-shadow: 0 10px 20px rgba(20, 184, 166, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .floating-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 15px 30px rgba(20, 184, 166, 0.4);
        }
    </style>
</head>
<body class="bg-gray-50">

    <!-- Header -->
    <header class="bg-white shadow-md sticky top-0 z-50">
        <div class="container mx-auto py-4 px-6">
            <nav class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <div class="w-10 h-10 bg-gradient-to-br from-teal-500 to-teal-600 rounded-lg flex items-center justify-center">
                        <i class="fas fa-heartbeat text-white text-xl"></i>
                    </div>
                    <a href="#" class="text-2xl font-bold text-blue-700">Premier Health Insurance</a>
                </div>
                <div class="hidden md:flex space-x-6">
                    <a href="#about" class="text-gray-700 hover:text-teal-600 transition">About Us</a>
                    <a href="#plans" class="text-gray-700 hover:text-teal-600 transition">Plans</a>
                    <a href="#assistants" class="text-gray-700 hover:text-teal-600 transition">AI Assistants</a>
                    <a href="#contact" class="text-gray-700 hover:text-teal-600 transition">Contact</a>
                </div>
                <button class="md:hidden text-gray-700">
                    <i class="fas fa-bars text-2xl"></i>
                </button>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero py-20 md:py-32">
        <div class="container mx-auto text-center hero-content px-6">
            <div class="feature-badge">
                <i class="fas fa-shield-alt"></i> Ghana's Trusted Health Insurance Provider
            </div>
            <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">Your Bridge to<br/>Premier Healthcare</h1>
            <p class="text-lg md:text-xl mb-10 max-w-2xl mx-auto opacity-90">
                Comprehensive and affordable healthcare solutions powered by AI technology.
                Get instant support from Ama, our intelligent health assistant.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="#plans" class="cta-button text-white font-bold py-4 px-8 rounded-lg inline-flex items-center justify-center">
                    <i class="fas fa-clipboard-list mr-2"></i>
                    Explore Our Plans
                </a>
                <a href="#assistants" class="bg-white text-teal-600 font-bold py-4 px-8 rounded-lg inline-flex items-center justify-center hover:bg-gray-50 transition">
                    <i class="fas fa-comments mr-2"></i>
                    Talk to Ama
                </a>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="py-12 bg-white">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <div class="stat-card">
                    <div class="stat-number">50K+</div>
                    <p class="text-gray-600 font-medium">Happy Members</p>
                </div>
                <div class="stat-card">
                    <div class="stat-number">200+</div>
                    <p class="text-gray-600 font-medium">Partner Hospitals</p>
                </div>
                <div class="stat-card">
                    <div class="stat-number">24/7</div>
                    <p class="text-gray-600 font-medium">AI Support</p>
                </div>
                <div class="stat-card">
                    <div class="stat-number">98%</div>
                    <p class="text-gray-600 font-medium">Satisfaction Rate</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="py-16 md:py-20" id="about">
        <div class="container mx-auto px-6">
            <div class="text-center mb-12">
                <span class="feature-badge">Our Services</span>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mt-2">Why Choose Premier Health?</h2>
                <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
                    We provide comprehensive healthcare coverage with cutting-edge AI support to ensure you get the best care possible.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="service-card bg-white rounded-2xl p-6">
                    <div class="service-icon">
                        <i class="fas fa-hospital text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold mb-3 text-gray-800">Comprehensive Coverage</h3>
                    <p class="text-gray-600">Access a wide range of medical services, including consultations, hospital stays, surgeries, and medications.</p>
                </div>
                <div class="service-card bg-white rounded-2xl p-6">
                    <div class="service-icon">
                        <i class="fas fa-dollar-sign text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold mb-3 text-gray-800">Affordable Plans</h3>
                    <p class="text-gray-600">Choose from various flexible plans tailored to your budget and healthcare needs starting from GH₵ 50/month.</p>
                </div>
                <div class="service-card bg-white rounded-2xl p-6">
                    <div class="service-icon">
                        <i class="fas fa-robot text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold mb-3 text-gray-800">AI-Powered Support</h3>
                    <p class="text-gray-600">Get instant answers from Ama, our AI assistant, available 24/7 via voice or chat in English and Twi.</p>
                </div>
                <div class="service-card bg-white rounded-2xl p-6">
                    <div class="service-icon">
                        <i class="fas fa-map-marked-alt text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold mb-3 text-gray-800">Nationwide Network</h3>
                    <p class="text-gray-600">Access 200+ healthcare providers across Ghana through our extensive network of hospitals and clinics.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- AI Assistants Section -->
    <section class="assistant-section py-16 md:py-20" id="assistants">
        <div class="container mx-auto px-6">
            <div class="text-center mb-12">
                <span class="feature-badge">
                    <i class="fas fa-magic"></i> AI-Powered Assistance
                </span>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mt-2">Meet Ama, Your Health Assistant</h2>
                <p class="text-gray-600 mt-4 max-w-3xl mx-auto">
                    Premier Apomoden (Premier Health Helper) - Get instant answers about our insurance plans,
                    find nearby hospitals, check coverage, and more. Available in English and Twi.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
                <!-- Voice Assistant -->
                <div class="assistant-card">
                    <div class="assistant-icon pulse-ring">
                        <i class="fas fa-phone-alt text-white text-3xl"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-800 text-center mb-3">Voice Assistant</h3>
                    <p class="text-gray-600 text-center mb-6">
                        Talk to Ama like you're speaking to a real person. Ask questions in English or Twi and get instant voice responses.
                    </p>
                    <div class="space-y-3 mb-6">
                        <div class="flex items-start space-x-3">
                            <i class="fas fa-check-circle text-teal-500 mt-1"></i>
                            <span class="text-gray-700">Natural voice conversations</span>
                        </div>
                        <div class="flex items-start space-x-3">
                            <i class="fas fa-check-circle text-teal-500 mt-1"></i>
                            <span class="text-gray-700">Bilingual support (English & Twi)</span>
                        </div>
                        <div class="flex items-start space-x-3">
                            <i class="fas fa-check-circle text-teal-500 mt-1"></i>
                            <span class="text-gray-700">Find hospitals and check coverage</span>
                        </div>
                        <div class="flex items-start space-x-3">
                            <i class="fas fa-check-circle text-teal-500 mt-1"></i>
                            <span class="text-gray-700">Get plan recommendations</span>
                        </div>
                    </div>
                    <button onclick="triggerVapiVoice()" class="cta-button w-full text-white font-bold py-4 px-6 rounded-lg inline-flex items-center justify-center">
                        <i class="fas fa-phone-volume mr-2"></i>
                        Start Voice Call
                    </button>
                </div>

                <!-- Chat Assistant -->
                <div class="assistant-card">
                    <div class="assistant-icon pulse-ring" style="animation-delay: 1s;">
                        <i class="fas fa-comments text-white text-3xl"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-800 text-center mb-3">Chat Assistant</h3>
                    <p class="text-gray-600 text-center mb-6">
                        Prefer texting? Chat with Ama through our text interface. Type your questions and get detailed responses instantly.
                    </p>
                    <div class="space-y-3 mb-6">
                        <div class="flex items-start space-x-3">
                            <i class="fas fa-check-circle text-teal-500 mt-1"></i>
                            <span class="text-gray-700">Quick text-based support</span>
                        </div>
                        <div class="flex items-start space-x-3">
                            <i class="fas fa-check-circle text-teal-500 mt-1"></i>
                            <span class="text-gray-700">Detailed plan comparisons</span>
                        </div>
                        <div class="flex items-start space-x-3">
                            <i class="fas fa-check-circle text-teal-500 mt-1"></i>
                            <span class="text-gray-700">Search hospital database</span>
                        </div>
                        <div class="flex items-start space-x-3">
                            <i class="fas fa-check-circle text-teal-500 mt-1"></i>
                            <span class="text-gray-700">Save conversation history</span>
                        </div>
                    </div>
                    <button onclick="triggerVapiChat()" class="cta-button w-full text-white font-bold py-4 px-6 rounded-lg inline-flex items-center justify-center">
                        <i class="fas fa-comment-dots mr-2"></i>
                        Start Chat
                    </button>
                </div>
            </div>

            <!-- Example Questions -->
            <div class="mt-12 bg-white rounded-2xl p-8 max-w-4xl mx-auto shadow-lg">
                <h4 class="text-xl font-bold text-gray-800 mb-4 text-center">
                    <i class="fas fa-lightbulb text-yellow-500 mr-2"></i>
                    Try Asking Ama:
                </h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                        <i class="fas fa-question-circle text-teal-500"></i>
                        <span class="text-gray-700">"Which hospitals accept Platinum Plus in Accra?"</span>
                    </div>
                    <div class="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                        <i class="fas fa-question-circle text-teal-500"></i>
                        <span class="text-gray-700">"What does the Mercury plan cover?"</span>
                    </div>
                    <div class="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                        <i class="fas fa-question-circle text-teal-500"></i>
                        <span class="text-gray-700">"Find doctors in Kumasi who accept my plan"</span>
                    </div>
                    <div class="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                        <i class="fas fa-question-circle text-teal-500"></i>
                        <span class="text-gray-700">"Compare all available plans for me"</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Plans Section -->
    <section class="py-16 md:py-20 bg-white" id="plans">
        <div class="container mx-auto px-6">
            <div class="text-center mb-12">
                <span class="feature-badge">Our Plans</span>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mt-2">Choose Your Perfect Plan</h2>
                <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
                    Flexible healthcare coverage options designed to meet your needs and budget
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
                <!-- Regular Plan -->
                <div class="bg-white border-2 border-gray-200 rounded-2xl p-8 hover:border-teal-500 transition">
                    <h3 class="text-2xl font-bold text-gray-800 mb-2">Regular</h3>
                    <p class="text-gray-600 mb-6">Essential coverage for everyday healthcare needs</p>
                    <div class="text-4xl font-bold text-gray-800 mb-6">
                        GH₵ 50<span class="text-lg text-gray-600">/month</span>
                    </div>
                    <ul class="space-y-3 mb-8">
                        <li class="flex items-center">
                            <i class="fas fa-check text-teal-500 mr-2"></i>
                            <span>Basic consultations</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-check text-teal-500 mr-2"></i>
                            <span>Generic medications</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-check text-teal-500 mr-2"></i>
                            <span>Selected clinics</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-check text-teal-500 mr-2"></i>
                            <span>AI assistant access</span>
                        </li>
                    </ul>
                    <button class="w-full bg-gray-100 text-gray-800 font-bold py-3 px-6 rounded-lg hover:bg-gray-200 transition">
                        Learn More
                    </button>
                </div>

                <!-- Mercury Plan -->
                <div class="bg-gradient-to-br from-teal-500 to-teal-600 text-white rounded-2xl p-8 transform scale-105 shadow-2xl">
                    <div class="bg-white text-teal-600 px-3 py-1 rounded-full text-sm font-bold inline-block mb-4">
                        MOST POPULAR
                    </div>
                    <h3 class="text-2xl font-bold mb-2">Mercury</h3>
                    <p class="opacity-90 mb-6">Enhanced coverage for comprehensive care</p>
                    <div class="text-4xl font-bold mb-6">
                        GH₵ 120<span class="text-lg opacity-90">/month</span>
                    </div>
                    <ul class="space-y-3 mb-8">
                        <li class="flex items-center">
                            <i class="fas fa-check mr-2"></i>
                            <span>Everything in Regular</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-check mr-2"></i>
                            <span>Specialist consultations</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-check mr-2"></i>
                            <span>Diagnostic tests</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-check mr-2"></i>
                            <span>150+ partner facilities</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-check mr-2"></i>
                            <span>Minor surgeries covered</span>
                        </li>
                    </ul>
                    <button class="w-full bg-white text-teal-600 font-bold py-3 px-6 rounded-lg hover:bg-gray-50 transition">
                        Get Started
                    </button>
                </div>

                <!-- Platinum Plus Plan -->
                <div class="bg-white border-2 border-gray-200 rounded-2xl p-8 hover:border-teal-500 transition">
                    <h3 class="text-2xl font-bold text-gray-800 mb-2">Platinum Plus</h3>
                    <p class="text-gray-600 mb-6">Premium coverage with VIP benefits</p>
                    <div class="text-4xl font-bold text-gray-800 mb-6">
                        GH₵ 250<span class="text-lg text-gray-600">/month</span>
                    </div>
                    <ul class="space-y-3 mb-8">
                        <li class="flex items-center">
                            <i class="fas fa-check text-teal-500 mr-2"></i>
                            <span>Everything in Mercury</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-check text-teal-500 mr-2"></i>
                            <span>All major surgeries</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-check text-teal-500 mr-2"></i>
                            <span>200+ premium hospitals</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-check text-teal-500 mr-2"></i>
                            <span>International coverage</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-check text-teal-500 mr-2"></i>
                            <span>VIP hospital rooms</span>
                        </li>
                    </ul>
                    <button class="w-full bg-gray-100 text-gray-800 font-bold py-3 px-6 rounded-lg hover:bg-gray-200 transition">
                        Learn More
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gradient-to-r from-blue-600 to-teal-600 py-16 text-white" id="contact">
        <div class="container mx-auto text-center px-6">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready to Get Started?</h2>
            <p class="text-lg md:text-xl mb-8 opacity-90 max-w-2xl mx-auto">
                Join thousands of Ghanaians who trust Premier Health Insurance for their healthcare needs.
                Talk to Ama now to find your perfect plan!
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <button onclick="triggerVapiVoice()" class="bg-white text-teal-600 font-bold py-4 px-8 rounded-lg inline-flex items-center justify-center hover:bg-gray-100 transition">
                    <i class="fas fa-phone-alt mr-2"></i>
                    Call Ama Now
                </button>
                <a href="#assistants" class="bg-transparent border-2 border-white text-white font-bold py-4 px-8 rounded-lg inline-flex items-center justify-center hover:bg-white hover:text-teal-600 transition">
                    <i class="fas fa-info-circle mr-2"></i>
                    Learn More
                </a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white py-12">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                <div>
                    <div class="flex items-center space-x-2 mb-4">
                        <div class="w-10 h-10 bg-gradient-to-br from-teal-500 to-teal-600 rounded-lg flex items-center justify-center">
                            <i class="fas fa-heartbeat text-white"></i>
                        </div>
                        <span class="text-xl font-bold">Premier Health</span>
                    </div>
                    <p class="text-gray-400">Your Bridge to Premier Healthcare across Ghana</p>
                </div>
                <div>
                    <h4 class="font-bold mb-4">Quick Links</h4>
                    <ul class="space-y-2 text-gray-400">
                        <li><a href="#about" class="hover:text-teal-400 transition">About Us</a></li>
                        <li><a href="#plans" class="hover:text-teal-400 transition">Plans & Pricing</a></li>
                        <li><a href="#assistants" class="hover:text-teal-400 transition">AI Assistants</a></li>
                        <li><a href="#contact" class="hover:text-teal-400 transition">Contact</a></li>
                    </ul>
                </div>
