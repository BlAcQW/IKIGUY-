    "# Enhanced manifest loader for Coqui TTS\n",
    "class CoquiManifestLoader:\n",
    "    \"\"\"Load TTS manifests optimized for Coqui XTTS training.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: CoquiManifestConfig):\n",
    "        self.config = config\n",
    "        \n",
    "    def load_coqui_manifests(self) -> Dict[str, pd.DataFrame]:\n",
    "        \"\"\"Load Coqui TTS manifests from enhanced processing pipeline.\"\"\"\n",
    "        print(\"📋 Loading Coqui TTS manifests...\")\n",
    "        \n",
    "        manifests = {}\n",
    "        \n",
    "        # Primary manifest files for Coqui (22kHz TTS)\n",
    "        coqui_manifest_files = {\n",
    "            'train': self.config.manifest_dir / 'coqui_xtts_train.txt',\n",
    "            'val': self.config.manifest_dir / 'coqui_xtts_val.txt'\n",
    "        }\n",
    "        \n",
    "        # Alternative CSV format manifests\n",
    "        csv_manifest_files = {\n",
    "            'train': self.config.manifest_dir / 'coqui_xtts_train.csv',\n",
    "            'val': self.config.manifest_dir / 'coqui_xtts_val.csv'\n",
    "        }\n",
    "        \n",
    "        # Fallback to other TTS manifests (22kHz)\n",
    "        fallback_manifests = {\n",
    "            'train': [\n",
    "                self.config.data_dir / 'processed/manifests/tts_22k_dataset.csv',\n",
    "                self.config.manifest_dir / 'melo_tts_train.csv'\n",
    "            ],\n",
    "            'val': [\n",
    "                self.config.data_dir / 'processed/manifests/tts_22k_dataset.csv',\n",
    "                self.config.manifest_dir / 'melo_tts_val.csv'\n",
    "            ]\n",
    "        }\n",
    "        \n",
    "        for split_name in ['train', 'val']:\n",
    "            # Try Coqui TXT format first\n",
    "            txt_path = coqui_manifest_files[split_name]\n",
    "            csv_path = csv_manifest_files[split_name]\n",
    "            \n",
    "            if txt_path.exists():\n",
    "                print(f\"   ✅ Found Coqui TXT manifest: {txt_path.name}\")\n",
    "                try:\n",
    "                    df = self._load_coqui_txt_manifest(txt_path)\n",
    "                    manifests[split_name] = self._validate_coqui_manifest(df, split_name)\n",
    "                except Exception as e:\n",
    "                    print(f\"   ⚠️ Error loading {txt_path}: {e}\")\n",
    "                    manifests[split_name] = pd.DataFrame()\n",
    "            elif csv_path.exists():\n",
    "                print(f\"   ✅ Found Coqui CSV manifest: {csv_path.name}\")\n",
    "                try:\n",
    "                    df = pd.read_csv(csv_path)\n",
    "                    manifests[split_name] = self._validate_coqui_manifest(df, split_name)\n",
    "                except Exception as e:\n",
    "                    print(f\"   ⚠️ Error loading {csv_path}: {e}\")\n",
    "                    manifests[split_name] = pd.DataFrame()\n",
    "            else:\n",
    "                print(f\"   ⚠️ Coqui manifest not found: {txt_path.name} or {csv_path.name}\")\n",
    "                print(f\"   🔄 Looking for fallback manifests...\")\n",
    "                \n",
    "                # Try fallback manifests\n",
    "                fallback_df = self._load_fallback_manifests(fallback_manifests[split_name])\n",
    "                \n",
    "                if not fallback_df.empty:\n",
    "                    # Split fallback data if needed\n",
    "                    if split_name == 'val':\n",
    "                        train_size = int(0.9 * len(fallback_df))\n",
    "                        if split_name == 'train':\n",
    "                            fallback_df = fallback_df.iloc[:train_size]\n",
    "                        else:\n",
    "                            fallback_df = fallback_df.iloc[train_size:]\n",
    "                    \n",
    "                    manifests[split_name] = self._validate_coqui_manifest(fallback_df, split_name)\n",
    "                else:\n",
    "                    print(f\"   ❌ No valid manifests found for {split_name}\")\n",
    "                    manifests[split_name] = self._create_dummy_coqui_manifest()\n",
    "        \n",
    "        return manifests\n",
    "    \n",
    "    def _load_coqui_txt_manifest(self, txt_path: Path) -> pd.DataFrame:\n",
    "        \"\"\"Load Coqui TXT format manifest (wavs/file.wav|text|speaker).\"\"\"\n",
    "        data = []\n",
    "        \n",
    "        with open(txt_path, 'r', encoding='utf-8') as f:\n",
    "            for line in f:\n",
    "                line = line.strip()\n",
    "                if line and '|' in line:\n",
    "                    parts = line.split('|')\n",
    "                    if len(parts) >= 3:\n",
    "                        audio_path = parts[0]\n",
    "                        text = parts[1]\n",
    "                        speaker_id = parts[2]\n",
    "                        \n",
    "                        # Convert relative path to absolute\n",
    "                        if audio_path.startswith('wavs/'):\n",
    "                            # Remove 'wavs/' prefix and find actual file\n",
    "                            filename = audio_path[5:]\n",
    "                            # Look in processed audio directories\n",
    "                            possible_paths = [\n",
    "                                self.config.data_dir / 'processed/processed_audio/tts_22k' / filename,\n",
    "                                self.config.coqui_dataset_dir / 'wavs' / filename,\n",
    "                                Path(audio_path)  # If it's already a valid path\n",
    "                            ]\n",
    "                            \n",
    "                            for possible_path in possible_paths:\n",
    "                                if possible_path.exists():\n",
    "                                    audio_path = str(possible_path)\n",
    "                                    break\n",
    "                        \n",
    "                        data.append({\n",
    "                            'audio_path': audio_path,\n",
    "                            'text': text,\n",
    "                            'speaker_id': speaker_id\n",
    "                        })\n",
    "        \n",
    "        return pd.DataFrame(data)\n",
    "    \n",
    "    def _load_fallback_manifests(self, fallback_paths: List[Path]) -> pd.DataFrame:\n",
    "        \"\"\"Load fallback manifests and combine them.\"\"\"\n",
    "        combined_df = pd.DataFrame()\n",
    "        \n",
    "        for fallback_path in fallback_paths:\n",
    "            if fallback_path.exists():\n",
    "                print(f\"   ✅ Using fallback: {fallback_path.name}\")\n",
    "                try:\n",
    "                    df = pd.read_csv(fallback_path)\n",
    "                    combined_df = pd.concat([combined_df, df], ignore_index=True)\n",
    "                except Exception as e:\n",
    "                    print(f\"   ⚠️ Error loading {fallback_path}: {e}\")\n",
    "                    continue\n",
    "        \n",
    "        return combined_df\n",
    "    \n",
    "    def _validate_coqui_manifest(self, df: pd.DataFrame, split_name: str) -> pd.DataFrame:\n",
    "        \"\"\"Validate and format manifest for Coqui XTTS training.\"\"\"\n",
    "        print(f\"   🔍 Validating {split_name} manifest for Coqui XTTS...\")\n",
    "        \n",
    "        if df.empty:\n",
    "            return df\n",
    "        \n",
    "        # Required columns for Coqui TTS\n",
    "        required_columns = ['audio_path', 'text', 'speaker_id']\n",
    "        \n",
    "        # Map common column variations\n",
    "        column_mappings = {\n",
    "            'transcript': 'text',\n",
    "            'transcription': 'text',\n",
    "            'sentence': 'text',\n",
    "            'audio': 'audio_path',\n",
    "            'path': 'audio_path',\n",
    "            'file_path': 'audio_path',\n",
    "            'processed_audio_path': 'audio_path',\n",
    "            'speaker': 'speaker_id'\n",
    "        }\n",
    "        \n",
    "        for old_col, new_col in column_mappings.items():\n",
    "            if old_col in df.columns and new_col not in df.columns:\n",
    "                df = df.rename(columns={old_col: new_col})\n",
    "                print(f\"   🔄 Mapped {old_col} → {new_col}\")\n",
    "        \n",
    "        # Check required columns\n",
    "        missing_columns = set(required_columns) - set(df.columns)\n",
    "        if missing_columns:\n",
    "            print(f\"   ❌ Missing required columns: {missing_columns}\")\n",
    "            \n",
    "            # Add default values for missing columns\n",
    "            if 'speaker_id' in missing_columns:\n",
    "                df['speaker_id'] = 'unknown_speaker'\n",
    "                missing_columns.remove('speaker_id')\n",
    "            \n",
    "            if missing_columns:\n",
    "                print(f\"   ❌ Cannot proceed without: {missing_columns}\")\n",
    "                return pd.DataFrame()\n",
    "        \n",
    "        # Add optional columns\n",
    "        if 'duration' not in df.columns:\n",
    "            print(f\"   📊 Adding duration information...\")\n",
    "            durations = []\n",
    "            for audio_path in df['audio_path']:\n",
    "                try:\n",
    "                    if Path(audio_path).exists():\n",
    "                        info = sf.info(audio_path)\n",
    "                        durations.append(info.duration)\n",
    "                    else:\n",
    "                        durations.append(5.0)  # Default\n",
    "                except:\n",
    "                    durations.append(5.0)  # Default\n",
    "            df['duration'] = durations\n",
    "        \n",
    "        if 'language' not in df.columns:\n",
    "            df['language'] = 'tw'\n",
    "        \n",
    "        # Quality filtering for TTS\n",
    "        initial_count = len(df)\n",
    "        \n",
    "        # Filter valid audio files\n",
    "        df['audio_exists'] = df['audio_path'].apply(lambda x: Path(x).exists() if pd.notna(x) else False)\n",
    "        df = df[df['audio_exists']].drop(columns=['audio_exists'])\n",
    "        \n",
    "        # Filter valid text\n",
    "        df = df[df['text'].str.len() > 0]\n",
    "        df = df[df['text'].str.len() <= self.config.max_text_length]\n",
    "        \n",
    "        # Filter audio duration (TTS works best with moderate length audio)\n",
    "        df = df[\n",
    "            (df['duration'] >= self.config.min_audio_length) &\n",
    "            (df['duration'] <= self.config.max_audio_length)\n",
    "        ]\n",
    "        \n",
    "        # Ensure minimum samples per speaker for voice cloning\n",
    "        speaker_counts = df['speaker_id'].value_counts()\n",
    "        valid_speakers = speaker_counts[speaker_counts >= 3].index  # At least 3 samples per speaker\n",
    "        df = df[df['speaker_id'].isin(valid_speakers)]\n",
    "        \n",
    "        final_count = len(df)\n",
    "        retention_rate = (final_count / initial_count * 100) if initial_count > 0 else 0\n",
    "        \n",
    "        print(f\"   📊 {split_name}: {final_count}/{initial_count} samples retained ({retention_rate:.1f}%)\")\n",
    "        if final_count > 0:\n",
    "            print(f\"     Unique speakers: {df['speaker_id'].nunique()}\")\n",
    "            print(f\"     Average duration: {df['duration'].mean():.1f}s\")\n",
    "        \n",
    "        return df\n",
    "    \n",
    "    def _create_dummy_coqui_manifest(self) -> pd.DataFrame:\n",
    "        \"\"\"Create dummy manifest for Coqui testing.\"\"\"\n",
    "        print(\"   📝 Creating dummy Coqui manifest...\")\n",
    "        \n",
    "        dummy_dir = self.config.data_dir / 'dummy_audio_coqui'\n",
    "        dummy_dir.mkdir(parents=True, exist_ok=True)\n",
    "        \n",
    "        # Create varied samples for different speakers\n",
    "        samples = [\n",
    "            # Speaker 1 - Male voice\n",
    "            (\"Wo ho te sɛn? Me ho yɛ.\", \"male_speaker_01\"),\n",
    "            (\"Me ma wo akye.\", \"male_speaker_01\"),\n",
    "            (\"Nante yie.\", \"male_speaker_01\"),\n",
    "            \n",
    "            # Speaker 2 - Female voice\n",
    "            (\"Me da wo ase.\", \"female_speaker_01\"),\n",
    "            (\"Ɛyɛ dɛn?\", \"female_speaker_01\"),\n",
    "            (\"Mepɛ aduane.\", \"female_speaker_01\"),\n",
    "            \n",
    "            # Speaker 3 - Young voice\n",
    "            (\"Me kɔ sukuu.\", \"young_speaker_01\"),\n",
    "            (\"Ɛyɛ anɔpa anum.\", \"young_speaker_01\"),\n",
    "            (\"Me frɛ wo.\", \"young_speaker_01\")\n",
    "        ]\n",
    "        \n",
    "        dummy_data = []\n",
    "        for i, (text, speaker) in enumerate(samples):\n",
    "            audio_file = dummy_dir / f\"coqui_{speaker}_{i:03d}.wav\"\n",
    "            \n",
    "            if not audio_file.exists():\n",
    "                # Create varied duration audio (3-8 seconds) with different characteristics per speaker\n",
    "                duration = np.random.uniform(3.0, 8.0)\n",
    "                \n",
    "                # Add some variation based on speaker\n",
    "                if 'male' in speaker:\n",
    "                    # Lower frequency components for male voice\n",
    "                    dummy_audio = np.random.normal(0, 0.08, int(22050 * duration)).astype(np.float32)\n",
    "                elif 'female' in speaker:\n",
    "                    # Higher frequency components for female voice\n",
    "                    dummy_audio = np.random.normal(0, 0.12, int(22050 * duration)).astype(np.float32)\n",
    "                else:\n",
    "                    # Young voice\n",
    "                    dummy_audio = np.random.normal(0, 0.10, int(22050 * duration)).astype(np.float32)\n",
    "                \n",
    "                sf.write(audio_file, dummy_audio, 22050)\n",
    "            \n",
    "            dummy_data.append({\n",
    "                'audio_path': str(audio_file),\n",
    "                'text': text,\n",
    "                'speaker_id': speaker,\n",
    "                'duration': sf.info(str(audio_file)).duration,\n",
    "                'language': 'tw',\n",
    "                'dataset': 'dummy_coqui'\n",
    "            })\n",
    "        \n",
    "        return pd.DataFrame(dummy_data)\n",
    "\n",
    "# Load manifests\n",
    "manifest_loader = CoquiManifestLoader(config)\n",
    "manifests = manifest_loader.load_coqui_manifests()\n",
    "\n",
    "print(f\"\\n📊 Coqui Manifest Summary:\")\n",
    "for split_name, df in manifests.items():\n",
    "    print(f\"   {split_name}: {len(df)} samples\")\n",
    "    if not df.empty:\n",
    "        print(f\"     Unique speakers: {df['speaker_id'].nunique()}\")\n",
    "        print(f\"     Total duration: {df['duration'].sum()/60:.1f} minutes\")\n",
    "        print(f\"     Average duration: {df['duration'].mean():.1f}s\")\n",
    "        print(f\"     Languages: {df['language'].unique()}\")\n",
    "        print(f\"     Sample speakers: {df['speaker_id'].unique()[:3]}\")"
   ]
