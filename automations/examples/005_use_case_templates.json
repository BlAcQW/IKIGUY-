    "description": "Pre-configured templates for different business use cases",
    "templates": {
      "sales_assistant": {
        "name": "Sales Assistant",
        "description": "AI sales representative for lead qualification and opportunity management",
        "recommended_integrations": [
          "hubspot_crm",
          "resend_email",
          "calendly_scheduling",
          "tavily_search",
          "supabase_database"
        ],
        "personality": "professional",
        "industry_focus": ["technology", "consulting", "finance"],
        "sample_configuration": {
          "useCase": "sales",
          "organizationName": "TechCorp Solutions",
          "industry": "technology",
          "primaryContactEmail": "sales@techcorp.com",
          "supportEmail": "support@techcorp.com",
          "targetLocationRegion": "North America",
          "activeIntegrations": "hubspot_crm,resend_email,calendly_scheduling,tavily_search",
          "voicePersonality": "professional",
          "hipaaComplianceRequired": "No"
        },
        "conversation_flows": [
          {
            "scenario": "Inbound Lead Qualification",
            "steps": [
              "Greet caller and identify their interest",
              "Qualify budget, authority, need, timeline (BANT)",
              "Capture contact information using save_contact_to_crm",
              "Schedule demo using schedule_appointment",
              "Send follow-up information using send_email_notification"
            ]
          },
          {
            "scenario": "Product Information Request",
            "steps": [
              "Understand specific product interests",
              "Search for current information using search_web_information",
              "Provide relevant details",
              "Capture lead information using save_contact_to_crm",
              "Send detailed brochure using send_email_notification"
            ]
          }
        ],
        "kpis": [
          "Lead conversion rate",
          "Appointment booking rate",
          "Information capture completeness",
          "Follow-up email delivery rate"
        ]
      },

