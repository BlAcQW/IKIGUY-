          )}
        </div>
      </div>

      {/* Main Content */}
      <div className="flex-1 flex flex-col">
                 {/* Top Header */}
         <div className="bg-gray-900 border-b border-gray-800 px-4 lg:px-6 py-4">
           <div className="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
             <div className="flex items-center justify-between lg:justify-start">
               <div className="flex items-center space-x-4 lg:space-x-6">
                 <div className="text-xl lg:text-2xl font-bold text-blue-500">Kasa AI</div>
                 <button className="text-gray-300 hover:text-white text-sm">Docs</button>
               </div>
             </div>
             
             <div className="flex flex-col lg:flex-row items-center gap-4">
               <div className="text-center lg:text-left">
                 <div className="text-base lg:text-lg font-semibold">{assistantName}</div>
                 <div className="text-xs text-gray-400 hidden lg:block">{assistantId}</div>
               </div>
               
               <div className="flex flex-wrap items-center gap-2">
                <button className="flex items-center space-x-1 px-3 py-1 text-gray-300 hover:text-white text-sm">
                  <Code className="w-4 h-4" />
                  <span>Code</span>
                </button>
                <button className="flex items-center space-x-1 px-3 py-1 text-gray-300 hover:text-white text-sm">
                  <Play className="w-4 h-4" />
                  <span>Test</span>
                </button>
                <button className="flex items-center space-x-1 px-3 py-1 text-gray-300 hover:text-white text-sm">
                  <MessageCircle className="w-4 h-4" />
                  <span>Chat</span>
                </button>
                                 {/* Streaming Mode Toggle */}
                 <div className="flex items-center space-x-2">
                   <button
                     onClick={() => setStreamingMode(!streamingMode)}
                     className={`flex items-center space-x-1 px-2 py-1 rounded text-xs font-medium transition-colors ${
                       streamingMode 
                         ? 'bg-purple-600 text-white' 
                         : 'bg-gray-700 text-gray-300 hover:bg-gray-600'
                     }`}
                   >
                     <span>🔄</span>
                     <span>{streamingMode ? 'Streaming' : 'HTTP'}</span>
                   </button>
                   
                   {streamingMode && (
                     <div className={`flex items-center space-x-1 text-xs ${
                       connectionStatus === 'connected' ? 'text-green-400' :
                       connectionStatus === 'connecting' ? 'text-yellow-400' :
                       connectionStatus === 'error' ? 'text-red-400' : 'text-gray-500'
                     }`}>
                       <div className={`w-2 h-2 rounded-full ${
                         connectionStatus === 'connected' ? 'bg-green-400' :
                         connectionStatus === 'connecting' ? 'bg-yellow-400 animate-pulse' :
                         connectionStatus === 'error' ? 'bg-red-400' : 'bg-gray-500'
                       }`} />
                       <span>
                         {connectionStatus === 'connected' ? `${streamingLatency}ms` :
                          connectionStatus === 'connecting' ? 'Connecting...' :
                          connectionStatus === 'error' ? 'Error' : 'Disconnected'}
                       </span>
                     </div>
                   )}
                 </div>

                 <button 
                   onClick={startConversation}
                   className="flex items-center space-x-1 px-3 py-1 bg-green-600 text-white rounded-md text-sm"
                 >
                   <Phone className="w-4 h-4" />
                   <span>Talk to Assistant</span>
                 </button>
                                 <button 
                   onClick={handlePublishAssistant}
                   className="px-3 py-1 bg-green-600 text-white rounded-md text-sm font-medium"
                 >
                   {assistantStatus === 'published' ? 'Published' : 'Publish'}
                 </button>
                <DropdownMenu>
                  <DropdownMenuTrigger asChild>
                    <button className="p-1 text-gray-400 hover:text-white">
                      <MoreVertical className="w-4 h-4" />
                    </button>
                  </DropdownMenuTrigger>
                  <DropdownMenuContent align="end" className="w-48">
                    <DropdownMenuItem className="flex items-center gap-2">
                      <History className="w-4 h-4" />
                      Version History
                    </DropdownMenuItem>
                    <DropdownMenuItem className="flex items-center gap-2">
                      <BookOpen className="w-4 h-4" />
                      Call Logs
                    </DropdownMenuItem>
                    <DropdownMenuItem className="flex items-center gap-2">
                      <Copy className="w-4 h-4" />
                      Duplicate
                    </DropdownMenuItem>
                    <DropdownMenuSeparator />
                    <DropdownMenuItem 
                      className="flex items-center gap-2 text-red-600 focus:text-red-600"
                      onClick={() => setShowDeleteConfirm(true)}
                    >
                      <Trash2 className="w-4 h-4" />
                      Delete
                    </DropdownMenuItem>
                  </DropdownMenuContent>
                </DropdownMenu>
              </div>
            </div>
          </div>
        </div>

                 {/* Main Content Area */}
         <div className="flex-1 flex flex-col lg:flex-row">
           {/* Left Panel - Assistant List */}
           <div className="w-full lg:w-80 bg-gray-900 border-r border-gray-800 p-4 lg:p-6 flex-shrink-0">
             <div className="flex items-center justify-between mb-4">
               <h2 className="text-lg font-semibold">Assistants</h2>
             </div>
             
                           <button 
                onClick={() => setShowCreateModal(true)}
                className="w-full bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-md text-sm font-medium mb-4 transition-colors"
              >
                + Create Assistant
              </button>
             
             <div className="space-y-3 mb-4">
               <div className="relative">
                 <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" />
                 <input 
                   type="text" 
                   placeholder="Search Assistants" 
                   value={searchQuery}
                   onChange={(e) => setSearchQuery(e.target.value)}
                   className="w-full bg-gray-800 border border-gray-700 rounded-md pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                 />
               </div>
               
               {/* African Languages Quick Filter */}
               <div className="flex flex-wrap gap-2">
                 <button 
                   onClick={() => setSearchQuery('')}
                   className="px-2 py-1 text-xs bg-gray-700 hover:bg-gray-600 rounded-md transition-colors"
                 >
                   All
                 </button>
                 <button 
                   onClick={() => setSearchQuery('twi')}
                   className="px-2 py-1 text-xs bg-orange-600 hover:bg-orange-500 text-white rounded-md transition-colors"
                 >
                   🇬🇭 Twi
                 </button>
                 <button 
                   onClick={() => setSearchQuery('yoruba')}
                   className="px-2 py-1 text-xs bg-green-600 hover:bg-green-500 text-white rounded-md transition-colors"
                 >
                   🇳🇬 Yorùbá
                 </button>
                 <button 
                   onClick={() => setSearchQuery('swahili')}
                   className="px-2 py-1 text-xs bg-blue-600 hover:bg-blue-500 text-white rounded-md transition-colors"
                 >
                   🇰🇪 Swahili
                 </button>
               </div>
               
               {/* Statistics */}
               <div className="text-xs text-gray-400 flex justify-between">
                 <span>{filteredAssistants.length} of {assistants.length} assistants</span>
                 <span>{assistants.filter(a => a.status === 'published').length} published</span>
               </div>
             </div>
             
             <div className="space-y-2 max-h-96 overflow-y-auto">
               {assistantsLoading ? (
                 <div className="flex items-center justify-center py-8">
                   <div className="text-center">
                     <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500 mx-auto mb-4"></div>
                     <div className="text-gray-400 text-sm">Loading assistants...</div>
                   </div>
                 </div>
               ) : (
                 Array.isArray(filteredAssistants) && filteredAssistants.length > 0 ? (
                   filteredAssistants.map((assistant) => (
                     <div 
                       key={assistant.id} 
                       className={`p-3 rounded-md cursor-pointer transition-colors border ${
                         selectedAssistant?.id === assistant.id
                           ? 'bg-blue-600 text-white border-blue-400 shadow-lg' 
                           : 'hover:bg-gray-800 text-gray-300 border-gray-700 hover:border-gray-600'
                       }`}
                       onClick={() => {
                         if (hasUnsavedChanges) {
                           const confirmed = window.confirm('You have unsaved changes. Are you sure you want to switch assistants? Your changes will be lost.');
                           if (!confirmed) return;
                         }
                         setAssistantName(assistant.name);
                         loadAssistantDetails(assistant.id);
                       }}
                     >
                       <div className="flex items-start justify-between">
                         <div className="flex-1 min-w-0">
                           <div className="font-medium truncate">{assistant.name}</div>
                           <div className="text-xs opacity-75 truncate mt-1">{assistant.description || 'No description'}</div>
                           <div className="flex items-center space-x-2 mt-2">
                             <span className="text-xs px-2 py-1 rounded-full bg-gray-600 text-gray-300">
                               {getLanguageDisplayName(assistant.language) || assistant.language}
                             </span>
                             <span className="text-xs text-gray-400">
                               {assistant.country}
                             </span>
                           </div>
                           <div className="flex items-center space-x-2 mt-1">
                             <div className="text-xs text-gray-400">
                               STT: <span className="text-gray-300">{assistant.stt_provider}</span>
                             </div>
                             <div className="text-xs text-gray-400">•</div>
                             <div className="text-xs text-gray-400">
                               TTS: <span className="text-gray-300">{assistant.tts_provider}</span>
                             </div>
                           </div>
                         </div>
                         <div className="flex flex-col items-end space-y-1 ml-2">
                           {assistant.status === 'published' ? (
                             <CheckCircle className="w-4 h-4 text-green-500" />
                           ) : (
                             <div className="w-4 h-4 bg-yellow-500 rounded-full" title="Draft" />
                           )}
                         </div>
                       </div>
                       <div className="mt-2 text-xs text-gray-400">
                         Updated: {new Date(assistant.updated_at).toLocaleDateString()}
                       </div>
                     </div>
                   ))
                 ) : (
                   <div className="text-center py-8">
                     <div className="text-gray-400">
                       {searchQuery ? 'No assistants match your search' : 'No assistants found'}
                     </div>
                     <div className="text-gray-500 text-sm mt-2">
                       {searchQuery ? 'Try adjusting your search query' : 'Create your first assistant to get started'}
                     </div>
                   </div>
                 )
               )}
             </div>
           </div>

           {/* Center Panel - Configuration */}
           <div className="flex-1 bg-gray-900 p-4 lg:p-6 min-w-0">
            {/* Configuration Tabs */}
            <div className="flex flex-wrap gap-4 lg:gap-8 border-b border-gray-800 mb-6 pb-4">
              {tabs.map((tab) => (
                <button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id)}
                  className={`flex items-center space-x-2 pb-4 px-1 border-b-2 transition-colors ${
                    activeTab === tab.id
                      ? 'border-green-500 text-green-500'
                      : 'border-transparent text-gray-400 hover:text-gray-300'
                  }`}
                >
                  <tab.icon className="w-4 h-4" />
                  <span className="text-sm font-medium">{tab.label}</span>
                </button>
              ))}
            </div>

                         {/* Tab Content */}
             <div className="space-y-6">
               {renderTabContent()}
             </div>
           </div>

                       
          </div>
       </div>

               {/* Create Assistant Modal */}
        {showCreateModal && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div className="bg-gray-900 rounded-lg p-6 w-full max-w-2xl mx-4">
              {/* Modal Header */}
              <div className="flex items-center space-x-2 mb-6">
                <Search className="w-6 h-6 text-gray-400" />
                <h2 className="text-2xl font-bold text-white">Create Assistant</h2>
              </div>

              {/* Choose Template Section */}
              <div className="mb-6">
                <h3 className="text-lg font-semibold text-white mb-2">Choose a template.</h3>
                <p className="text-gray-400 mb-4">
                  Here's a few templates to get you started, or you can create your own template and use it to create a new assistant.
                </p>

                {/* Assistant Name Input */}
                <div className="mb-6">
                  <label className="block text-sm font-medium text-gray-300 mb-2">
                    Assistant Name
                    <span className="text-orange-400 ml-1">(This can be adjusted at any time after creation.)</span>
                  </label>
                  <input
                    type="text"
                    value={newAssistantName}
                    onChange={(e) => setNewAssistantName(e.target.value)}
                    className="w-full bg-gray-800 border border-blue-500 rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>

                {/* Template Selection */}
                <div className="space-y-4">
                  {/* Blank Template (Selected) */}
                  <div 
                    className={`p-4 rounded-lg border-2 cursor-pointer transition-colors ${
                      selectedTemplate === 'blank' 
                        ? 'border-blue-500 bg-blue-500 bg-opacity-10' 
                        : 'border-gray-700 hover:border-gray-600'
                    }`}
                    onClick={() => setSelectedTemplate('blank')}
                  >
                    <div className="flex items-center space-x-3">
                      <Plus className="w-6 h-6 text-gray-400" />
                      <div>
                        <h4 className="text-white font-medium">Blank Template</h4>
                        <p className="text-gray-400 text-sm">This blank slate template with minimal configurations. It's a starting point for creating your custom assistant.</p>
                      </div>
                    </div>
                  </div>

                  {/* Quickstart Templates */}
                  <div>
                    <div className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">QUICKSTART</div>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                      {templates.slice(1).map((template) => (
                        <div
                          key={template.id}
                          className={`p-3 rounded-lg border cursor-pointer transition-colors ${
                            selectedTemplate === template.id 
                              ? 'border-blue-500 bg-blue-500 bg-opacity-10' 
                              : 'border-gray-700 hover:border-gray-600'
                          }`}
                          onClick={() => setSelectedTemplate(template.id)}
                        >
                          <div className="flex items-center space-x-2">
                            <template.icon className="w-4 h-4 text-gray-400" />
                            <div>
                              <h5 className="text-white text-sm font-medium">{template.name}</h5>
                              <p className="text-gray-400 text-xs">{template.description}</p>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              {/* Modal Footer */}
              <div className="flex justify-end space-x-3">
                <button
                  onClick={() => setShowCreateModal(false)}
                  className="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-md text-sm font-medium transition-colors"
                >
                  Close
                </button>
                <button
                  onClick={handleCreateAssistant}
                  className="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white rounded-md text-sm font-medium transition-colors"
                >
                  Create Assistant
                </button>
              </div>
            </div>
          </div>
        )}

        {/* Chat Modal */}
        {isChatActive && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div className="bg-gray-900 rounded-lg w-full max-w-4xl mx-4 h-[80vh] flex flex-col">
              {/* Chat Header */}
              <div className="p-4 border-b border-gray-800 flex-shrink-0">
                <div className="flex items-center justify-between">
                  <div className="flex items-center space-x-3">
                    <Phone className="w-6 h-6 text-green-500" />
                    <h3 className="text-xl font-semibold">Call Transcript</h3>
                  </div>
                  <div className="flex items-center space-x-3">
                    <div className="flex items-center space-x-2">
                      <div className="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
                      <span className="text-sm text-gray-400">Call in progress</span>
                    </div>
                    <div className="text-sm text-gray-400 font-mono">{formatTime(callDuration)}</div>
                    <button 
                      onClick={endCall}
                      className="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-md text-sm font-medium transition-colors"
                    >
                      End Call
                    </button>
                  </div>
                </div>
              </div>

              {/* Chat Messages */}
              <div className="flex-1 overflow-y-auto p-6 space-y-4 min-h-0">
                {chatMessages.map((message) => (
                  <div 
                    key={message.id} 
                    className={`flex ${message.type === 'user' ? 'justify-end' : 'justify-start'}`}
                  >
                    <div 
                      className={`max-w-md px-4 py-3 rounded-lg ${
                        message.type === 'user' 
                          ? 'bg-blue-600 text-white' 
                          : 'bg-gray-700 text-gray-300'
                      }`}
                    >
                      <p className="text-sm leading-relaxed">{message.text}</p>
                      <p className="text-xs opacity-75 mt-2">
                        {message.timestamp.toLocaleTimeString()}
                      </p>
                    </div>
                  </div>
                ))}
                
                {/* Current Partial Text */}
                {currentPartial && (
                  <div className="flex justify-end">
                    <div className="max-w-md px-4 py-3 rounded-lg bg-blue-600 text-white">
                      <p className="text-sm italic leading-relaxed">{currentPartial}</p>
                      <p className="text-xs opacity-75 mt-2">Typing...</p>
                    </div>
                  </div>
                )}
              </div>

              {/* Enhanced Voice Activity Indicator */}
              <div className="p-6 border-t border-gray-800 flex-shrink-0">
                <div className="flex items-center justify-center">
                  <div className="relative">
                    <div className={`w-20 h-20 rounded-full flex items-center justify-center transition-all duration-300 ${
                      voiceActivity 
                        ? 'bg-green-500 animate-pulse shadow-lg shadow-green-500/50' 
                        : 'bg-blue-500 animate-pulse'
                    }`}>
                      <Mic className="w-10 h-10 text-white" />
                    </div>
                    {voiceActivity && (
                      <div className="absolute inset-0 w-20 h-20 bg-green-400 rounded-full animate-ping opacity-75"></div>
                    )}
                    {/* Audio Energy Visualization */}
                    <div className="absolute -inset-2">
                      <div 
                        className="w-24 h-24 border-2 border-white/20 rounded-full transition-all duration-100"
                        style={{
                          transform: `scale(${1 + (audioEnergy * 100)})`,
                          opacity: audioEnergy > 0 ? 0.6 : 0.2
                        }}
                      />
                    </div>
                  </div>
                </div>
                <div className="text-center mt-3 space-y-1">
                  <p className={`text-sm transition-colors duration-300 ${
                    voiceActivity ? 'text-green-400 font-semibold' : 'text-gray-400'
                  }`}>
                    {voiceActivity ? '🎤 Voice Detected!' : '👂 Listening...'}
                  </p>
                  {selectedAssistant?.language && (
                    <p className="text-xs text-gray-500">
                      {selectedAssistant.language === 'twi' ? '🇬🇭 Twi Mode' : 
                       selectedAssistant.language === 'yoruba' ? '🇳🇬 Yorùbá Mode' :
                       selectedAssistant.language === 'swahili' ? '🇰🇪 Swahili Mode' :
                       `${selectedAssistant.language} Mode`}
                    </p>
                  )}
                  <div className="flex items-center justify-center space-x-2 text-xs text-gray-500">
                    <span>Energy: {(audioEnergy * 1000).toFixed(1)}</span>
                    <span>•</span>
                    <span>Threshold: {(vadSensitivity * 1000).toFixed(1)}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Delete Confirmation Modal */}
        {showDeleteConfirm && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div className="bg-gray-900 rounded-lg p-6 w-full max-w-md mx-4">
              <div className="flex items-center space-x-3 mb-4">
                <div className="w-10 h-10 bg-red-600 rounded-full flex items-center justify-center">
                  <Trash2 className="w-5 h-5 text-white" />
                </div>
                <div>
                  <h3 className="text-lg font-semibold text-white">Delete Assistant</h3>
                  <p className="text-sm text-gray-400">This action cannot be undone.</p>
                </div>
              </div>
              
              <p className="text-gray-300 mb-6">
                Are you sure you want to delete <span className="font-semibold text-white">{selectedAssistant?.name}</span>? 
                This will permanently remove the assistant and all its configurations.
              </p>
              
              <div className="flex justify-end space-x-3">
                <button
                  onClick={() => setShowDeleteConfirm(false)}
                  className="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-md text-sm font-medium transition-colors"
                  disabled={deletingAssistant}
                >
                  Cancel
                </button>
                <button
                  onClick={handleDeleteAssistant}
                  className="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-md text-sm font-medium transition-colors flex items-center space-x-2"
                  disabled={deletingAssistant}
                >
                  {deletingAssistant && (
                    <div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                  )}
                  <span>{deletingAssistant ? 'Deleting...' : 'Delete Assistant'}</span>
                </button>
              </div>
            </div>
          </div>
        )}
     </div>
   );
 };

export default VoiceAgent;