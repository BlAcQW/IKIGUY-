# Supabase Configuration
# Copy this file to .env and fill in your values

# Database Password
SUPABASE_DB_PASSWORD=your_secure_database_password_here

# JWT Secret (must be at least 32 characters)
# Generate with: openssl rand -base64 32
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters

# API Keys (these are examples, generate your own)
# Anon key (public, can be exposed to clients)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxvY2FsIiwicm9sZSI6ImFub24iLCJpYXQiOjE2ODI5MjI4MDAsImV4cCI6MTg0MDY4OTIwMH0.your_anon_key

# Service role key (private, server-side only)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxvY2FsIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTY4MjkyMjgwMCwiZXhwIjoxODQwNjg5MjAwfQ.your_service_key

# SMTP Configuration (for email auth)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_ADMIN_EMAIL=admin@ailabsafrica.com

# Public URLs
SUPABASE_PUBLIC_URL=https://supabase.ailabsafrica.com
SUPABASE_API_URL=https://supabase-api.ailabsafrica.com
