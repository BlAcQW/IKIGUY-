    "                    missing_files.append(row['audio_path'])\n",
    "            \n",
    "            if missing_files:\n",
    "                print(f\"   ⚠️ Found {len(missing_files)} missing audio files in {split_name}\")\n",
    "                df = df[df['audio_path'].apply(lambda x: Path(x).exists())]\n",
    "                print(f\"   📊 After filtering: {len(df)} samples\")\n",
