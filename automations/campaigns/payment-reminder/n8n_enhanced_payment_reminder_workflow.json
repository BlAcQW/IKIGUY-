              "value": "={{ {\n  account_number: $('Payment Reminder Webhook').item.json.account_number,\n  interaction_date: new Date().toISOString(),\n  interaction_type: 'voice_call',\n  compliance_checks: $('Compliance Check').item.json.compliance_status,\n  call_recording_id: $('VAPI Payment Collection Call').item.json.call_id,\n  agent_id: 'ai_agent_payment_reminder',\n  customer_response: $('VAPI Payment Collection Call').item.json.call_result.customer_response,\n  outcome: $('VAPI Payment Collection Call').item.json.call_result.outcome,\n  fdcpa_compliant: true,\n  tcpa_compliant: $('Compliance Check').item.json.compliance_status.tcpa_compliant,\n  state_regulations_followed: true,\n  documentation_complete: true\n} }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "compliance-documentation",
      "name": "Compliance Documentation",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [2220, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "analytics-data",
              "name": "collection_metrics",
              "value": "={{ {\n  campaign_id: $('Payment Reminder Webhook').item.json.campaign_id,\n  account_number: $('Payment Reminder Webhook').item.json.account_number,\n  call_date: new Date().toISOString(),\n  risk_segment: $('Customer Segmentation').item.json.risk_level,\n  call_duration: $('VAPI Payment Collection Call').item.json.call_duration_seconds,\n  call_outcome: $('VAPI Payment Collection Call').item.json.call_result.outcome,\n  payment_made: $('VAPI Payment Collection Call').item.json.call_result.payment_made || false,\n  payment_amount: $('VAPI Payment Collection Call').item.json.call_result.payment_amount || 0,\n  dispute_raised: $('VAPI Payment Collection Call').item.json.call_result.dispute_raised || false,\n  settlement_offered: $node['Settlement Eligibility'].json.length > 0,\n  compliance_score: 100, // Based on compliance checks\n  cost_per_contact: 2.50, // Estimated cost\n  recovery_rate: $('VAPI Payment Collection Call').item.json.call_result.payment_made ? 1 : 0\n} }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "analytics-tracking",
      "name": "Analytics Tracking",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [2220, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
