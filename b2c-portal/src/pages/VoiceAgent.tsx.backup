          // Set legacy options for backward compatibility
          setOpts({
            stt: config.stt_providers.reduce((acc: Record<string, string[]>, provider: VoiceProvider) => {
              // Get models for this STT provider
              const providerModels = config.voices
                .filter(voice => (voice.provider_id === provider.id || voice.provider_id === provider.name) && voice.voice_type === 'speech_recognition')
                .map(voice => voice.name);
              acc[provider.name] = providerModels;
              return acc;
            }, {}),
            tts: config.tts_providers.reduce((acc: Record<string, string[]>, provider: VoiceProvider) => {
              const providerVoices = config.voices
                .filter(voice => voice.provider_id === provider.id || voice.provider_id === provider.name)
                .map(voice => voice.name);
              acc[provider.name] = providerVoices;
              return acc;
            }, {}),
            llm: config.llm_providers.reduce((acc: Record<string, string[]>, provider: LLMProvider) => {
              const providerModels = config.llm_models
                .filter(model => model.provider_id === provider.id)
                .map(model => model.name);
              acc[provider.name] = providerModels;
              return acc;
            }, {}),
            languages: config.languages || [],
            countries: config.countries || []
          });
        }
      } catch (error) {
        console.error('Failed to fetch agent configuration:', error);
