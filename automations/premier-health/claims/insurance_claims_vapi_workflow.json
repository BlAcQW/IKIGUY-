    {
      "parameters": {
        "content": "## Response to Vapi",
        "outputKey": "response"
      },
      "id": "respond_to_vapi",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 700]
    },
    {
      "parameters": {
        "jsCode": "// Process transcription and extract claim details using AI\nconst transcript = $input.item.json.transcript;\nconst callData = $input.item.json;\n\n// Extract key information from transcript\n// This would typically use an AI service for NLP\nconst extractedData = {\n  claimType: detectClaimType(transcript),\n  urgency: detectUrgency(transcript),\n  estimatedAmount: extractAmount(transcript),\n  documentsmentioned: extractDocuments(transcript)\n};\n\nfunction detectClaimType(text) {\n  const types = ['auto', 'home', 'health', 'life', 'property'];\n  for (const type of types) {\n    if (text.toLowerCase().includes(type)) {\n      return type;\n    }\n  }\n  return 'general';\n}\n\nfunction detectUrgency(text) {\n  const urgentKeywords = ['urgent', 'emergency', 'immediate', 'asap', 'critical'];\n  return urgentKeywords.some(keyword => text.toLowerCase().includes(keyword));\n}\n\nfunction extractAmount(text) {\n  const amountMatch = text.match(/\\$([0-9,]+)/);;\n  if (amountMatch) {\n    return parseFloat(amountMatch[1].replace(',', ''));\n  }\n  return null;\n}\n\nfunction extractDocuments(text) {\n  const docs = [];\n  const docTypes = ['police report', 'medical report', 'photos', 'receipts', 'invoices'];\n  docTypes.forEach(doc => {\n    if (text.toLowerCase().includes(doc)) {\n      docs.push(doc);\n    }\n  });\n  return docs;\n}\n\nreturn {\n  json: {\n    ...callData,\n    ...extractedData,\n    processedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "code_process_transcript",
      "name": "Code - Process Call Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [750, 500]
    },
