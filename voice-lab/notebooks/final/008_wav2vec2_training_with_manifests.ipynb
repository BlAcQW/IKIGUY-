    "# Initialize Wav2Vec2 model, tokenizer, and processor\n",
    "class Wav2Vec2ManifestTrainer:\n",
    "    \"\"\"Wav2Vec2 trainer using manifest-based data loading.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: Wav2Vec2ManifestConfig, vocabulary: List[str]):\n",
    "        self.config = config\n",
    "        self.vocabulary = vocabulary\n",
    "        self.model = None\n",
    "        self.processor = None\n",
    "        self.tokenizer = None\n",
    "        self.feature_extractor = None\n",
    "        \n",
    "    def setup_tokenizer_and_processor(self):\n",
    "        \"\"\"Setup tokenizer and processor for Twi.\"\"\"\n",
    "        print(\"🔧 Setting up Twi tokenizer and processor...\")\n",
    "        \n",
    "        # Create tokenizer from vocabulary\n",
    "        vocab_dict = {char: i for i, char in enumerate(self.vocabulary)}\n",
    "        vocab_path = self.config.vocab_dir / \"twi_vocab.json\"\n",
    "        \n",
    "        self.tokenizer = Wav2Vec2CTCTokenizer(\n",
    "            vocab_file=str(vocab_path),\n",
    "            unk_token=\"[UNK]\",\n",
    "            pad_token=\"[PAD]\",\n",
    "            word_delimiter_token=\" \"\n",
    "        )\n",
    "        \n",
    "        # Load feature extractor\n",
    "        self.feature_extractor = Wav2Vec2FeatureExtractor.from_pretrained(\n",
    "            self.config.model_name,\n",
    "            return_attention_mask=True,\n",
    "            padding_value=0.0,\n",
    "            sampling_rate=self.config.sample_rate\n",
    "        )\n",
    "        \n",
    "        # Create processor\n",
    "        self.processor = Wav2Vec2Processor(\n",
    "            feature_extractor=self.feature_extractor,\n",
    "            tokenizer=self.tokenizer\n",
    "        )\n",
    "        \n",
    "        print(f\"   ✅ Tokenizer setup complete\")\n",
    "        print(f\"   📚 Vocabulary size: {len(self.vocabulary)}\")\n",
    "        \n",
    "        return self.tokenizer, self.processor\n",
    "        \n",
    "    def load_and_configure_model(self):\n",
    "        \"\"\"Load and configure Wav2Vec2 model for Twi.\"\"\"\n",
    "        print(f\"🚀 Loading Wav2Vec2 model: {self.config.model_name}\")\n",
    "        \n",
    "        # Load model\n",
    "        self.model = Wav2Vec2ForCTC.from_pretrained(\n",
    "            self.config.model_name,\n",
    "            attention_dropout=0.1,\n",
    "            hidden_dropout=0.1,\n",
    "            feat_proj_dropout=0.0,\n",
    "            mask_time_prob=self.config.mask_time_prob,\n",
    "            layerdrop=self.config.layerdrop,\n",
    "            ctc_loss_reduction=\"mean\",\n",
    "            pad_token_id=self.processor.tokenizer.pad_token_id,\n",
    "            vocab_size=len(self.vocabulary)\n",
    "        )\n",
    "        \n",
    "        # Freeze feature encoder if configured\n",
    "        if self.config.freeze_feature_encoder:\n",
    "            self.model.freeze_feature_encoder()\n",
    "            print(\"   ❄️ Feature encoder frozen\")\n",
    "        \n",
    "        # Enable gradient checkpointing\n",
    "        if self.config.gradient_checkpointing:\n",
    "            self.model.gradient_checkpointing_enable()\n",
    "            print(\"   ✅ Gradient checkpointing enabled\")\n",
    "        \n",
    "        print(f\"\\n📊 Model Summary:\")\n",
    "        print(f\"   Total parameters: {self.model.num_parameters():,}\")\n",
    "        print(f\"   Vocabulary size: {len(self.vocabulary)}\")\n",
    "        print(f\"   Sample rate: {self.config.sample_rate}Hz\")\n",
    "        \n",
    "        return self.model\n",
    "        \n",
    "    def prepare_datasets(self, manifests: Dict[str, pd.DataFrame]) -> DatasetDict:\n",
    "        \"\"\"Convert manifests to Wav2Vec2 datasets.\"\"\"\n",
    "        print(\"🔄 Preparing Wav2Vec2 datasets from manifests...\")\n",
    "        \n",
    "        datasets = {}\n",
    "        \n",
    "        for split_name, df in manifests.items():\n",
    "            if df.empty:\n",
    "                continue\n",
    "            \n",
    "            print(f\"   📊 Processing {split_name}: {len(df)} samples\")\n",
    "            \n",
    "            # Convert to HuggingFace dataset\n",
    "            dataset = Dataset.from_pandas(df)\n",
    "            \n",
    "            # Add audio column\n",
    "            dataset = dataset.cast_column(\"audio_path\", Audio(sampling_rate=self.config.sample_rate))\n",
    "            dataset = dataset.rename_column(\"audio_path\", \"audio\")\n",
    "            \n",
    "            datasets[split_name] = dataset\n",
    "        \n",
    "        # Ensure train/validation split\n",
    "        if 'train' in datasets and 'val' not in datasets:\n",
    "            print(\"   🔄 Creating validation split from training data\")\n",
    "            train_val_split = datasets['train'].train_test_split(test_size=0.1, seed=42)\n",
    "            datasets['train'] = train_val_split['train']\n",
    "            datasets['val'] = train_val_split['test']\n",
    "        \n",
    "        dataset_dict = DatasetDict(datasets)\n",
    "        \n",
    "        # Apply preprocessing\n",
    "        dataset_dict = dataset_dict.map(\n",
    "            self._prepare_batch,\n",
    "            batched=True,\n",
    "            batch_size=8,\n",
    "            remove_columns=dataset_dict[\"train\"].column_names\n",
    "        )\n",
    "        \n",
    "        print(f\"\\n✅ Dataset preparation complete:\")\n",
    "        for split_name, dataset in dataset_dict.items():\n",
    "            print(f\"   {split_name}: {len(dataset)} samples\")\n",
    "        \n",
    "        return dataset_dict\n",
    "    \n",
    "    def _prepare_batch(self, batch):\n",
    "        \"\"\"Prepare batch for Wav2Vec2 training.\"\"\"\n",
    "        # Process audio\n",
    "        audio_arrays = [x[\"array\"] for x in batch[\"audio\"]]\n",
    "        \n",
    "        # Process audio features\n",
    "        inputs = self.processor(\n",
    "            audio_arrays,\n",
    "            sampling_rate=self.config.sample_rate,\n",
    "            return_tensors=\"pt\",\n",
    "            padding=True,\n",
    "            truncation=True\n",
    "        )\n",
    "        \n",
    "        # Process text labels\n",
    "        with self.processor.as_target_processor():\n",
    "            labels = self.processor(\n",
    "                batch[\"transcript\"],\n",
    "                return_tensors=\"pt\",\n",
    "                padding=True,\n",
    "                truncation=True\n",
    "            )\n",
    "        \n",
    "        return {\n",
    "            \"input_values\": inputs.input_values,\n",
    "            \"attention_mask\": inputs.attention_mask,\n",
    "            \"labels\": labels.input_ids\n",
    "        }\n",
    "\n",
    "# Initialize trainer\n",
    "wav2vec2_trainer = Wav2Vec2ManifestTrainer(config, vocabulary)\n",
    "tokenizer, processor = wav2vec2_trainer.setup_tokenizer_and_processor()\n",
    "model = wav2vec2_trainer.load_and_configure_model()\n",
    "\n",
    "# Prepare datasets if manifests are available\n",
    "if manifests['train'] is not None and not manifests['train'].empty:\n",
    "    datasets = wav2vec2_trainer.prepare_datasets(manifests)\n",
    "    print(\"✅ Wav2Vec2 datasets prepared successfully!\")\n",
    "else:\n",
    "    print(\"❌ No training manifests available\")\n",
    "    datasets = None"
