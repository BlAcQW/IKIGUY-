# EventFlow Frontend Environment Variables

# API Configuration
# For local development, use: http://localhost:30032/api/v1
# For production, use: https://eventflow-api.ailabsafrica.com/api/v1
# For dev server, use: https://dev-eventflow-api.ailabsafrica.com/api/v1
VITE_API_BASE_URL=http://localhost:30032/api/v1
VITE_APP_NAME=EventFlow

# Supabase Configuration
# Get these from @apps/shared/.env or the Supabase dashboard
VITE_SUPABASE_URL=https://supabase-api.ailabsafrica.com
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
