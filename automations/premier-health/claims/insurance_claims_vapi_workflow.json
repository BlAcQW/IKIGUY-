    {
      "parameters": {
        "url": "https://api.vapi.ai/assistant/{{ $env.VAPI_CLAIMS_ASSISTANT_ID }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
