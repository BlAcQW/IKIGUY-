              title={sidebarCollapsed ? "Settings" : ""}
            >
              <Settings className="w-4 h-4" />
              {!sidebarCollapsed && <span className="text-sm">Settings</span>}
            </div>
          </div>

          {!sidebarCollapsed && <div className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2 mt-6">OBSERVE</div>}
          <div className="space-y-1">
            <div 
              className={`flex items-center ${sidebarCollapsed ? 'justify-center' : 'space-x-2'} px-2 py-2 rounded-md text-gray-300 hover:bg-gray-800 cursor-pointer`}
              title={sidebarCollapsed ? "Metrics" : ""}
            >
              <TrendingUp className="w-4 h-4" />
              {!sidebarCollapsed && <span className="text-sm">Metrics</span>}
            </div>
            <div 
              className={`flex items-center ${sidebarCollapsed ? 'justify-center' : 'space-x-2'} px-2 py-2 rounded-md text-gray-300 hover:bg-gray-800 cursor-pointer`}
