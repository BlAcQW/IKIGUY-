    "class ComprehensiveFasterWhisperEvaluator:\n",
    "    \"\"\"Comprehensive evaluation framework for Faster-Whisper models.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: OptimizedFasterWhisperConfig, processor):\n",
    "        self.config = config\n",
    "        self.processor = processor\n",
    "        self.results = {}\n",
    "        \n",
    "    def evaluate_standard_whisper(self, model_path: Path, test_dataset) -> Dict:\n",
    "        \"\"\"Evaluate standard Transformers Whisper model.\"\"\"\n",
    "        print(\"📊 Evaluating standard Whisper model...\")\n",
    "        \n",
    "        try:\n",
    "            # Load model\n",
    "            model = WhisperForConditionalGeneration.from_pretrained(model_path)\n",
    "            model.eval()\n",
    "            \n",
    "            if torch.cuda.is_available():\n",
    "                model = model.cuda()\n",
    "            \n",
    "            predictions = []\n",
    "            references = []\n",
    "            inference_times = []\n",
    "            \n",
    "            with torch.no_grad():\n",
    "                for item in tqdm(test_dataset, desc=\"Evaluating standard Whisper\"):\n",
    "                    # Load audio\n",
    "                    audio_path = item.get('audio')\n",
    "                    if not audio_path or not Path(audio_path).exists():\n",
    "                        continue\n",
    "                    \n",
    "                    audio, _ = librosa.load(audio_path, sr=16000)\n",
    "                    \n",
    "                    # Prepare input\n",
    "                    inputs = self.processor(\n",
    "                        audio,\n",
    "                        sampling_rate=16000,\n",
    "                        return_tensors=\"pt\"\n",
    "                    ).input_features\n",
    "                    \n",
    "                    if torch.cuda.is_available():\n",
    "                        inputs = inputs.cuda()\n",
    "                    \n",
    "                    # Generate\n",
    "                    start_time = time.time()\n",
    "                    predicted_ids = model.generate(inputs, max_length=225)\n",
    "                    inference_time = time.time() - start_time\n",
    "                    \n",
    "                    transcription = self.processor.batch_decode(\n",
    "                        predicted_ids,\n",
    "                        skip_special_tokens=True\n",
    "                    )[0]\n",
    "                    \n",
    "                    predictions.append(transcription)\n",
    "                    references.append(item.get('text', ''))\n",
    "                    inference_times.append(inference_time)\n",
    "            \n",
    "            # Calculate metrics\n",
    "            results = self._calculate_comprehensive_metrics(\n",
    "                predictions, references, inference_times, \"standard_whisper\"\n",
    "            )\n",
    "            \n",
    "            print(f\"✅ Standard Whisper - WER: {results['wer']:.2f}%, Avg time: {results['avg_inference_time']:.3f}s\")\n",
    "            return results\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Standard Whisper evaluation failed: {e}\")\n",
    "            return {'error': str(e)}\n",
    "    \n",
    "    def evaluate_faster_whisper(self, ct2_model_path: Path, test_dataset) -> Dict:\n",
    "        \"\"\"Evaluate Faster-Whisper (CTranslate2) model.\"\"\"\n",
    "        if not FASTER_WHISPER_AVAILABLE:\n",
    "            print(\"⚠️ Faster-Whisper not available\")\n",
    "            return {'error': 'faster-whisper not available'}\n",
    "        \n",
    "        print(\"⚡ Evaluating Faster-Whisper model...\")\n",
    "        \n",
    "        try:\n",
    "            # Load Faster-Whisper model\n",
    "            model = WhisperModel(\n",
    "                str(ct2_model_path),\n",
    "                device=DEVICE,\n",
    "                compute_type=self.config.ct2_compute_type\n",
    "            )\n",
    "            \n",
    "            predictions = []\n",
    "            references = []\n",
    "            inference_times = []\n",
    "            \n",
    "            for item in tqdm(test_dataset, desc=\"Evaluating Faster-Whisper\"):\n",
    "                # Load audio\n",
    "                audio_path = item.get('audio')\n",
    "                if not audio_path or not Path(audio_path).exists():\n",
    "                    continue\n",
    "                \n",
    "                audio, _ = librosa.load(audio_path, sr=16000)\n",
    "                \n",
    "                # Transcribe\n",
    "                start_time = time.time()\n",
    "                segments, info = model.transcribe(\n",
    "                    audio,\n",
    "                    beam_size=3,\n",
    "                    language=self.config.base_language,\n",
    "                    task=self.config.task\n",
    "                )\n",
    "                inference_time = time.time() - start_time\n",
    "                \n",
    "                transcription = \" \".join([segment.text for segment in segments])\n",
    "                \n",
    "                predictions.append(transcription)\n",
    "                references.append(item.get('text', ''))\n",
    "                inference_times.append(inference_time)\n",
    "            \n",
    "            # Calculate metrics\n",
    "            results = self._calculate_comprehensive_metrics(\n",
    "                predictions, references, inference_times, \"faster_whisper\"\n",
    "            )\n",
    "            \n",
    "            print(f\"✅ Faster-Whisper - WER: {results['wer']:.2f}%, Avg time: {results['avg_inference_time']:.3f}s\")\n",
    "            return results\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Faster-Whisper evaluation failed: {e}\")\n",
    "            return {'error': str(e)}\n",
    "    \n",
    "    def _calculate_comprehensive_metrics(self, predictions: List[str], references: List[str], \n",
    "                                      inference_times: List[float], model_name: str) -> Dict:\n",
    "        \"\"\"Calculate comprehensive evaluation metrics.\"\"\"\n",
    "        # Clean dialect markers\n",
    "        def clean_text(text):\n",
    "            for marker in ['[ASANTE]', '[AKUAPEM]', '[FANTE]', '[GA]', '[TWI]']:\n",
    "                text = text.replace(marker, '')\n",
    "            return text.strip()\n",
    "        \n",
    "        cleaned_pred = [clean_text(pred) for pred in predictions]\n",
    "        cleaned_ref = [clean_text(ref) for ref in references]\n",
    "        \n",
    "        # Calculate metrics\n",
    "        wer_metric = evaluate.load(\"wer\")\n",
    "        cer_metric = evaluate.load(\"cer\")\n",
    "        \n",
    "        try:\n",
    "            wer = wer_metric.compute(predictions=cleaned_pred, references=cleaned_ref)\n",
    "            cer = cer_metric.compute(predictions=cleaned_pred, references=cleaned_ref)\n",
    "        except:\n",
    "            wer = 1.0\n",
    "            cer = 1.0\n",
    "        \n",
    "        # Additional metrics\n",
    "        exact_matches = sum(1 for p, r in zip(cleaned_pred, cleaned_ref) if p.strip() == r.strip())\n",
    "        exact_match_rate = exact_matches / len(cleaned_pred) if cleaned_pred else 0\n",
    "        \n",
    "        # Performance metrics\n",
    "        avg_inference_time = np.mean(inference_times) if inference_times else 0\n",
    "        std_inference_time = np.std(inference_times) if inference_times else 0\n",
    "        \n",
    "        # Calculate real-time factor (assuming 1s audio ~ 1s)\n",
    "        rtf = avg_inference_time  # Simplified RTF calculation\n",
    "        \n",
    "        results = {\n",
    "            'model_name': model_name,\n",
    "            'wer': wer * 100,\n",
    "            'cer': cer * 100,\n",
    "            'exact_match_rate': exact_match_rate * 100,\n",
    "            'avg_inference_time': avg_inference_time,\n",
    "            'std_inference_time': std_inference_time,\n",
    "            'real_time_factor': rtf,\n",
    "            'total_samples': len(predictions),\n",
    "            'sample_predictions': list(zip(cleaned_ref[:3], cleaned_pred[:3]))  # First 3 samples\n",
    "        }\n",
    "        \n",
    "        return results\n",
    "    \n",
    "    def compare_all_models(self, standard_model_path: Path, ct2_models: Dict[str, Path], test_dataset) -> Dict:\n",
    "        \"\"\"Compare all model variants comprehensively.\"\"\"\n",
    "        print(\"🔄 Running comprehensive model comparison...\")\n",
    "        \n",
    "        all_results = {}\n",
    "        \n",
    "        # Evaluate standard Whisper\n",
    "        if standard_model_path.exists():\n",
    "            all_results['standard_whisper'] = self.evaluate_standard_whisper(standard_model_path, test_dataset)\n",
    "        \n",
    "        # Evaluate CTranslate2 variants\n",
    "        for variant_name, ct2_path in ct2_models.items():\n",
    "            if ct2_path and ct2_path.exists():\n",
    "                all_results[f'faster_whisper_{variant_name}'] = self.evaluate_faster_whisper(ct2_path, test_dataset)\n",
    "        \n",
    "        # Create comparison summary\n",
    "        summary = self._create_comparison_summary(all_results)\n",
    "        all_results['comparison_summary'] = summary\n",
    "        \n",
    "        # Save results\n",
    "        results_file = DIRS['metrics'] / \"comprehensive_evaluation_results.json\"\n",
    "        with open(results_file, 'w', encoding='utf-8') as f:\n",
    "            json.dump(all_results, f, indent=2, ensure_ascii=False)\n",
    "        \n",
    "        print(f\"\\n📊 Comprehensive Evaluation Complete!\")\n",
    "        print(f\"💾 Results saved: {results_file}\")\n",
    "        \n",
    "        # Print summary\n",
    "        self._print_comparison_summary(summary)\n",
    "        \n",
    "        return all_results\n",
    "    \n",
    "    def _create_comparison_summary(self, results: Dict) -> Dict:\n",
    "        \"\"\"Create comparison summary from all results.\"\"\"\n",
    "        summary = {\n",
    "            'best_wer': None,\n",
    "            'fastest_inference': None,\n",
    "            'best_accuracy': None,\n",
    "            'speedup_analysis': {},\n",
    "            'accuracy_analysis': {}\n",
    "        }\n",
    "        \n",
    "        valid_results = {k: v for k, v in results.items() if isinstance(v, dict) and 'wer' in v}\n",
    "        \n",
    "        if not valid_results:\n",
    "            return summary\n",
    "        \n",
    "        # Find best models\n",
    "        best_wer_model = min(valid_results.items(), key=lambda x: x[1]['wer'])\n",
    "        fastest_model = min(valid_results.items(), key=lambda x: x[1]['avg_inference_time'])\n",
    "        best_accuracy_model = max(valid_results.items(), key=lambda x: x[1]['exact_match_rate'])\n",
    "        \n",
    "        summary['best_wer'] = {'model': best_wer_model[0], 'wer': best_wer_model[1]['wer']}\n",
    "        summary['fastest_inference'] = {'model': fastest_model[0], 'time': fastest_model[1]['avg_inference_time']}\n",
    "        summary['best_accuracy'] = {'model': best_accuracy_model[0], 'rate': best_accuracy_model[1]['exact_match_rate']}\n",
    "        \n",
    "        # Calculate speedups relative to standard Whisper\n",
    "        if 'standard_whisper' in valid_results:\n",
    "            baseline_time = valid_results['standard_whisper']['avg_inference_time']\n",
    "            for model_name, result in valid_results.items():\n",
    "                if model_name != 'standard_whisper':\n",
    "                    speedup = baseline_time / result['avg_inference_time']\n",
    "                    summary['speedup_analysis'][model_name] = speedup\n",
    "        \n",
    "        return summary\n",
    "    \n",
    "    def _print_comparison_summary(self, summary: Dict):\n",
    "        \"\"\"Print comparison summary in readable format.\"\"\"\n",
    "        print(\"\\n\" + \"=\" * 60)\n",
    "        print(\"📊 MODEL COMPARISON SUMMARY\")\n",
    "        print(\"=\" * 60)\n",
    "        \n",
    "        if summary['best_wer']:\n",
    "            print(f\"🏆 Best WER: {summary['best_wer']['model']} ({summary['best_wer']['wer']:.2f}%)\")\n",
    "        \n",
    "        if summary['fastest_inference']:\n",
    "            print(f\"⚡ Fastest: {summary['fastest_inference']['model']} ({summary['fastest_inference']['time']:.3f}s)\")\n",
    "        \n",
    "        if summary['best_accuracy']:\n",
    "            print(f\"🎯 Best Accuracy: {summary['best_accuracy']['model']} ({summary['best_accuracy']['rate']:.1f}%)\")\n",
    "        \n",
    "        if summary['speedup_analysis']:\n",
    "            print(\"\\n⚡ Speedup Analysis (vs Standard Whisper):\")\n",
    "            for model, speedup in summary['speedup_analysis'].items():\n",
    "                print(f\"  {model}: {speedup:.2f}x faster\")\n",
    "        \n",
    "        print(\"=\" * 60)\n",
    "\n",
    "# Initialize evaluator\n",
    "if processor:\n",
    "    evaluator = ComprehensiveFasterWhisperEvaluator(config, processor)\n",
    "    print(\"🎯 Comprehensive Faster-Whisper evaluator ready!\")\n",
    "    print(\"💡 After training and conversion, use evaluator.compare_all_models()\")\n",
    "else:\n",
    "    print(\"⚠️ Evaluator requires processor initialization\")"
   ]
