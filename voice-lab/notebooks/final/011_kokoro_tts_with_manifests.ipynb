    "            'medaase': 'me-da-se',\n",
    "            'medawo': 'me-da-wo',\n",
    "            'nante': 'nan-te',\n",
    "            \n",
    "            # Question words\n",
    "            'dɛn': 'den',\n",
    "            'sɛn': 'sen',\n",
    "            'hena': 'he-na',\n",
    "            'ɛhe': 'e-he',\n",
    "            \n",
    "            # Time expressions\n",
    "            'anɔpa': 'a-no-pa',\n",
    "            'awiɛ': 'a-wie',\n",
    "            'anadwo': 'a-na-dwo',\n",
    "            \n",
    "            # Common verbs\n",
    "            'kɔ': 'ko',\n",
    "            'ba': 'ba',\n",
    "            'yɛ': 'ye',\n",
    "            'pɛ': 'pe',\n",
    "            \n",
    "            # Numbers\n",
    "            'baako': 'ba-ko',\n",
    "            'mmienu': 'mie-nu',\n",
    "            'mmiɛnsa': 'mie-n-sa',\n",
    "            'nnan': 'n-nan',\n",
    "            'nnum': 'n-num'\n",
    "        }\n",
    "        \n",
    "        # Extract common words from manifests\n",
    "        word_counts = {}\n",
    "        \n",
    "        for df in manifests.values():\n",
