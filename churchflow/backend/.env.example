# ChurchFlow Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME="ChurchFlow"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=True

# API Configuration
API_HOST="0.0.0.0"
API_PORT=8000
API_PREFIX="/api/v1"

# Security
SECRET_KEY="your-secret-key-here-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# Database
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="churchflow"

# Supabase (Authentication & Storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Twilio (SMS & WhatsApp)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_WHATSAPP_NUMBER="whatsapp:+1234567890"

# SendGrid (Email)
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@churchflow.com"
SENDGRID_FROM_NAME="ChurchFlow"

# Firebase (Push Notifications)
FIREBASE_CREDENTIALS_PATH="path/to/firebase-credentials.json"

# KasaAI Voice Lab
KASAAI_VOICE_LAB_URL="https://voice.kasaai.com"
KASAAI_VOICE_LAB_API_KEY="your-voice-lab-api-key"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:19006,https://church.kasaai.ailabsafrica.com"

# Sentry (Error Tracking)
SENTRY_DSN=""  # Optional

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# n8n Workflow Automation - PRODUCTION INSTANCE
# IMPORTANT: Use automations.ailabsafrica.com (NOT n8n.ailabsafrica.com)
# Using HTTP (no SSL) as it proxies to automate.inspirecreations.it.com
N8N_BASE_URL="http://automations.ailabsafrica.com"
N8N_API_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI0MTBhMTUzMi04YmRkLTRkYjAtYjU1OS01ZTIxYTAzNjI4ODMiLCJpc3MiOiJuOG4iLCJhdWQiOiJwdWJsaWMtYXBpIiwiaWF0IjoxNzU2NDQxNjg4fQ.oAcaO5v0As8jl543StOB87l21jkURptt7bn9X6E7NcU"
N8N_WEBHOOK_BASE_URL="http://automations.ailabsafrica.com/webhook"

# Supabase Realtime (for WebSocket connections)
SUPABASE_REALTIME_URL="wss://supabase.ailabsafrica.com/realtime/v1"

# iRedMail SMTP (Local Email Server)
SMTP_HOST="mail.ailabsafrica.com"
SMTP_PORT=587
SMTP_USERNAME="churchflow@ailabsafrica.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="churchflow@ailabsafrica.com"
SMTP_FROM_NAME="ChurchFlow"
SMTP_USE_TLS=True

# Stripe Payment & Billing (SaaS Multi-Church)
# Get these from Stripe Dashboard (https://dashboard.stripe.com/test/apikeys)
# Use test keys for development (sk_test_...) and live keys for production (sk_live_...)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
STRIPE_ENVIRONMENT="sandbox"  # sandbox or live

# Stripe Price IDs (create in Stripe Dashboard → Products)
# These must match the plan definitions in app/models/subscription.py
STRIPE_PRICE_STANDARD="price_standard_monthly"  # $49/month
STRIPE_PRICE_PREMIUM="price_premium_monthly"    # $99/month
