"""
VAPI Consolidated Integration Service.
Handles all VAPI-related functionality with unified interface and MCP support.
"""

import asyncio
import logging
import os
from typing import Dict, Any, Optional, List, Union
from datetime import datetime
from pydantic import BaseModel, Field

# Import from shared integration
import sys
sys.path.append('/opt/kasaai/apps/shared')
from integration.vapi import VAPIService

logger = logging.getLogger(__name__)


class VAPIServiceWrapper(VAPIService):
    """
    Consolidated service for VAPI integration.
    Extends the shared VAPI service with additional functionality and MCP support.
    """

    def __init__(self, config: Optional[Dict[str, Any]] = None):
        """
        Initialize VAPI service with configuration.

        Args:
            config: Configuration dictionary with VAPI settings
        """
        if config:
            # Pass config dict directly
            vapi_config = {
                "VAPI_API_KEY": config.get("api_key", os.getenv("VAPI_API_KEY", "")),
                "VAPI_US_PHONE_ID": config.get("us_phone_id", os.getenv("VAPI_US_PHONE_ID", "")),
                "webhook_url": config.get("webhook_url", "https://api.ailabsafrica.com/vapi/webhook")
            }
            super().__init__(vapi_config)
        else:
            # Use environment variables
            vapi_config = {
                "VAPI_API_KEY": os.getenv("VAPI_API_KEY", ""),
                "VAPI_US_PHONE_ID": os.getenv("VAPI_US_PHONE_ID", ""),
                "webhook_url": "https://api.ailabsafrica.com/vapi/webhook"
            }
            super().__init__(vapi_config)

    # Additional consolidated service methods can be added here
    async def get_service_info(self) -> Dict[str, Any]:
        """Get service information and status."""
        connection_test = await self.test_connection()
        return {
            "service_name": "VAPI Consolidated",
            "service_type": "Voice AI Platform",
            "version": "1.0.0",
            "connection_status": connection_test,
            "capabilities": [
                "voice_calls",
                "assistant_management",
                "phone_numbers",
                "call_logging",
                "analytics"
            ]
        }

    async def bulk_create_assistants(self, assistants_data: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
        """Create multiple assistants in batch."""
        results = []
        for assistant_data in assistants_data:
            try:
                result = await self.create_assistant(assistant_data)
                results.append({"success": True, "data": result})
            except Exception as e:
                results.append({"success": False, "error": str(e), "data": assistant_data})
        return results

    async def get_analytics_summary(self, days: int = 30) -> Dict[str, Any]:
        """Get analytics summary for the last N days."""
        try:
            calls = await self.get_calls()
            # Process analytics from calls data
            total_calls = len(calls.get("data", []))

            return {
                "period_days": days,
                "total_calls": total_calls,
                "total_assistants": len(await self.get_assistants()),
                "active_phone_numbers": len(await self.get_phone_numbers()),
                "summary_generated_at": datetime.utcnow().isoformat()
            }
        except Exception as e:
            logger.error(f"Error generating analytics summary: {e}")
            return {"error": str(e)}


# Create a singleton instance for use throughout the application
def get_vapi_service(config: Optional[Dict[str, Any]] = None) -> VAPIServiceWrapper:
    """Get VAPI service instance."""
    return VAPIServiceWrapper(config)


# For backward compatibility
vapi_consolidated_service = get_vapi_service()