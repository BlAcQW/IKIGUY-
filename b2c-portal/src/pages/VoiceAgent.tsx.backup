            >
              <Zap className="w-4 h-4" />
              {!sidebarCollapsed && <span className="text-sm">Overview</span>}
            </div>
            <div 
              className={`flex items-center ${sidebarCollapsed ? 'justify-center' : 'space-x-2'} px-2 py-2 rounded-md bg-blue-600 text-white cursor-pointer`}
