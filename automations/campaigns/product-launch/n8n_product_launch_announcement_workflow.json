      },
      "id": "webhook-trigger",
      "name": "Product Launch Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "product-launch-announcement-enhanced"
    },
    {
      "parameters": {
        "jsCode": "// Extract and validate product launch data\nconst requestBody = $input.first().json.body;\n\nconst productData = {\n  product_id: requestBody.product_id || '',\n  product_name: requestBody.product_name || '',\n  launch_date: requestBody.launch_date || new Date().toISOString(),\n  target_segments: requestBody.target_segments || ['early_adopters', 'loyal_customers'],\n  campaign_id: requestBody.campaign_id || `launch_${Date.now()}`,\n  customer_list: requestBody.customer_list || [],\n  launch_type: requestBody.launch_type || 'full_launch',\n  priority: requestBody.priority || 'high'\n};\n\n// Validate required fields\nif (!productData.product_id || !productData.product_name) {\n  throw new Error('Product ID and Product Name are required');\n}\n\n// Add metadata\nproductData.workflow_started = new Date().toISOString();\nproductData.workflow_id = 'enhanced_product_launch_announcement_vapi_n8n';\nproductData.processing_stage = 'segmentation';\n\nreturn {\n  json: productData\n};"
      },
      "id": "data-validation",
      "name": "Validate Launch Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "={{$node['Validate Launch Data'].json.api_base_url || 'https://api.ailabsafrica.com'}}/api/campaigns/customer-segmentation",
