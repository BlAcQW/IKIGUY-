    "# Flow-based components for F5 TTS\n",
    "class AffineCoupling(nn.Module):\n",
    "    \"\"\"Affine coupling layer for normalizing flows.\"\"\"\n",
    "    \n",
    "    def __init__(self, dim, hidden_dim):\n",
    "        super().__init__()\n",
    "        self.dim = dim\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(dim // 2, hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(hidden_dim, hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(hidden_dim, dim // 2 * 2)  # Output scale and shift\n",
    "        )\n",
    "    \n",
    "    def forward(self, x, reverse=False):\n",
    "        x1, x2 = x.chunk(2, dim=-1)\n",
    "        \n",
    "        if not reverse:\n",
    "            # Forward pass\n",
    "            h = self.net(x1)\n",
    "            shift, scale = h.chunk(2, dim=-1)\n",
    "            scale = torch.sigmoid(scale + 2.0)  # Ensure positive scale\n",
    "            x2 = x2 * scale + shift\n",
    "            log_det = torch.sum(torch.log(scale), dim=-1)\n",
    "        else:\n",
    "            # Reverse pass\n",
    "            h = self.net(x1)\n",
    "            shift, scale = h.chunk(2, dim=-1)\n",
    "            scale = torch.sigmoid(scale + 2.0)\n",
    "            x2 = (x2 - shift) / scale\n",
    "            log_det = -torch.sum(torch.log(scale), dim=-1)\n",
    "        \n",
    "        return torch.cat([x1, x2], dim=-1), log_det\n",
    "\n",
    "class FlowStep(nn.Module):\n",
    "    \"\"\"Single flow step with coupling and permutation.\"\"\"\n",
    "    \n",
    "    def __init__(self, dim, hidden_dim):\n",
    "        super().__init__()\n",
    "        self.coupling = AffineCoupling(dim, hidden_dim)\n",
    "        # Simple permutation (in practice, you'd use more sophisticated permutations)\n",
    "        self.register_buffer('perm', torch.randperm(dim))\n",
    "        self.register_buffer('inv_perm', torch.argsort(self.perm))\n",
    "    \n",
    "    def forward(self, x, reverse=False):\n",
    "        if not reverse:\n",
    "            # Forward: permute then couple\n",
    "            x = x[..., self.perm]\n",
    "            x, log_det = self.coupling(x, reverse=False)\n",
    "        else:\n",
    "            # Reverse: uncouple then unpermute\n",
    "            x, log_det = self.coupling(x, reverse=True)\n",
    "            x = x[..., self.inv_perm]\n",
    "        \n",
    "        return x, log_det\n",
    "\n",
    "class RealF5TTSModel(nn.Module):\n",
    "    \"\"\"Real F5 TTS model with flow-based synthesis.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: RealF5Config, vocab_size: int):\n",
    "        super().__init__()\n",
    "        self.config = config\n",
    "        self.vocab_size = vocab_size\n",
    "        \n",
    "        # Text encoder\n",
    "        self.text_embedding = nn.Embedding(vocab_size, config.hidden_dim)\n",
    "        self.text_encoder = nn.TransformerEncoder(\n",
    "            nn.TransformerEncoderLayer(\n",
    "                d_model=config.hidden_dim,\n",
    "                nhead=config.num_heads,\n",
    "                dim_feedforward=config.hidden_dim * 4,\n",
    "                dropout=0.1,\n",
    "                batch_first=True\n",
    "            ),\n",
    "            num_layers=6\n",
    "        )\n",
    "        \n",
    "        # Speaker encoder\n",
    "        self.speaker_embedding = nn.Linear(\n",
    "            config.speaker_embedding_dim, config.hidden_dim\n",
    "        )\n",
    "        \n",
    "        # Duration predictor\n",
    "        self.duration_predictor = nn.Sequential(\n",
    "            nn.Linear(config.hidden_dim, config.hidden_dim // 2),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.1),\n",
    "            nn.Linear(config.hidden_dim // 2, 1),\n",
    "            nn.Softplus()  # Ensure positive durations\n",
    "        )\n",
    "        \n",
    "        # Mel spectrogram encoder (for training)\n",
    "        self.mel_encoder = nn.Sequential(\n",
    "            nn.Linear(config.n_mels, config.hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(config.hidden_dim, config.hidden_dim)\n",
    "        )\n",
    "        \n",
    "        # Flow layers\n",
    "        self.flows = nn.ModuleList([\n",
    "            FlowStep(config.hidden_dim, config.hidden_dim)\n",
    "            for _ in range(config.flow_layers)\n",
    "        ])\n",
    "        \n",
    "        # Prior network\n",
    "        self.prior_net = nn.Sequential(\n",
    "            nn.Linear(config.hidden_dim * 2, config.hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(config.hidden_dim, config.hidden_dim * 2)  # Mean and log_std\n",
    "        )\n",
    "        \n",
    "        # Mel decoder (from latent to mel)\n",
    "        self.mel_decoder = nn.Sequential(\n",
    "            nn.Linear(config.hidden_dim, config.hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.1),\n",
    "            nn.Linear(config.hidden_dim, config.n_mels)\n",
    "        )\n",
    "    \n",
    "    def encode_text(self, text_ids, speaker_emb):\n",
    "        \"\"\"Encode text and speaker information.\"\"\"\n",
    "        batch_size, seq_len = text_ids.shape\n",
    "        \n",
    "        # Encode text\n",
    "        text_emb = self.text_embedding(text_ids)  # (B, T, D)\n",
    "        text_enc = self.text_encoder(text_emb)  # (B, T, D)\n",
    "        \n",
    "        # Add speaker information\n",
    "        speaker_emb = self.speaker_embedding(speaker_emb)  # (B, D)\n",
    "        speaker_emb = speaker_emb.unsqueeze(1).expand(-1, seq_len, -1)  # (B, T, D)\n",
    "        \n",
    "        # Combine text and speaker\n",
    "        combined = text_enc + speaker_emb  # (B, T, D)\n",
    "        \n",
    "        return combined\n",
    "    \n",
    "    def predict_duration(self, text_enc):\n",
    "        \"\"\"Predict phoneme durations.\"\"\"\n",
    "        durations = self.duration_predictor(text_enc).squeeze(-1)  # (B, T)\n",
    "        return durations\n",
    "    \n",
    "    def length_regulate(self, text_enc, durations):\n",
    "        \"\"\"Expand text encoding based on predicted durations.\"\"\"\n",
    "        batch_size, text_len, hidden_dim = text_enc.shape\n",
    "        \n",
    "        # Simple upsampling (in practice, use more sophisticated methods)\n",
    "        max_mel_len = int(durations.sum(dim=1).max().item())\n",
    "        \n",
    "        outputs = []\n",
    "        for i in range(batch_size):\n",
    "            output = []\n",
    "            for j in range(text_len):\n",
    "                duration = max(1, int(durations[i, j].item()))\n",
    "                frame = text_enc[i, j:j+1].expand(duration, -1)\n",
    "                output.append(frame)\n",
    "            \n",
    "            output = torch.cat(output, dim=0)\n",
    "            \n",
    "            # Pad or truncate to max length\n",
    "            if len(output) > max_mel_len:\n",
    "                output = output[:max_mel_len]\n",
    "            elif len(output) < max_mel_len:\n",
    "                padding = output[-1:].expand(max_mel_len - len(output), -1)\n",
    "                output = torch.cat([output, padding], dim=0)\n",
    "            \n",
    "            outputs.append(output.unsqueeze(0))\n",
    "        \n",
    "        return torch.cat(outputs, dim=0)\n",
    "    \n",
    "    def flow_forward(self, mel_latent, text_cond):\n",
    "        \"\"\"Apply normalizing flows.\"\"\"\n",
    "        batch_size, mel_len, _ = mel_latent.shape\n",
    "        \n",
    "        # Combine mel and text conditioning\n",
    "        if text_cond.shape[1] != mel_len:\n",
    "            # Simple interpolation for length matching\n",
    "            text_cond = F.interpolate(\n",
    "                text_cond.transpose(1, 2),\n",
    "                size=mel_len,\n",
    "                mode='linear',\n",
    "                align_corners=False\n",
    "            ).transpose(1, 2)\n",
    "        \n",
    "        # Apply flows\n",
    "        z = mel_latent\n",
    "        log_det_sum = 0\n",
    "        \n",
    "        for flow in self.flows:\n",
    "            z, log_det = flow(z, reverse=False)\n",
    "            log_det_sum += log_det.sum(dim=-1)  # Sum over time dimension\n",
    "        \n",
    "        # Compute prior\n",
    "        combined_cond = torch.cat([text_cond, z], dim=-1)\n",
    "        prior_params = self.prior_net(combined_cond)\n",
    "        prior_mean, prior_log_std = prior_params.chunk(2, dim=-1)\n",
    "        \n",
    "        return z, log_det_sum, prior_mean, prior_log_std\n",
    "    \n",
    "    def flow_reverse(self, z, text_cond):\n",
    "        \"\"\"Reverse normalizing flows for generation.\"\"\"\n",
    "        # Apply flows in reverse\n",
    "        x = z\n",
    "        for flow in reversed(self.flows):\n",
    "            x, _ = flow(x, reverse=True)\n",
    "        \n",
    "        return x\n",
    "    \n",
    "    def forward(self, text_ids, speaker_emb, target_mel=None):\n",
    "        \"\"\"Forward pass for training or inference.\"\"\"\n",
    "        # Encode text and speaker\n",
    "        text_enc = self.encode_text(text_ids, speaker_emb)\n",
    "        \n",
    "        # Predict durations\n",
    "        durations = self.predict_duration(text_enc)\n",
    "        \n",
    "        if target_mel is not None:\n",
    "            # Training mode\n",
    "            # Encode mel spectrogram\n",
    "            mel_enc = self.mel_encoder(target_mel)\n",
    "            \n",
    "            # Length regulate text encoding\n",
    "            mel_len = target_mel.shape[1]\n",
    "            if text_enc.shape[1] != mel_len:\n",
    "                text_cond = F.interpolate(\n",
    "                    text_enc.transpose(1, 2),\n",
    "                    size=mel_len,\n",
    "                    mode='linear',\n",
    "                    align_corners=False\n",
    "                ).transpose(1, 2)\n",
    "            else:\n",
    "                text_cond = text_enc\n",
    "            \n",
    "            # Apply flows\n",
    "            z, log_det, prior_mean, prior_log_std = self.flow_forward(mel_enc, text_cond)\n",
    "            \n",
    "            return {\n",
    "                'z': z,\n",
    "                'log_det': log_det,\n",
    "                'prior_mean': prior_mean,\n",
    "                'prior_log_std': prior_log_std,\n",
    "                'durations': durations,\n",
    "                'mel_enc': mel_enc\n",
    "            }\n",
    "        else:\n",
    "            # Inference mode\n",
    "            # Length regulate text encoding\n",
    "            text_cond = self.length_regulate(text_enc, durations)\n",
    "            \n",
    "            # Sample from prior\n",
    "            mel_len = text_cond.shape[1]\n",
    "            z = torch.randn(text_cond.shape[0], mel_len, self.config.hidden_dim).to(text_cond.device)\n",
    "            \n",
    "            # Reverse flows\n",
    "            mel_latent = self.flow_reverse(z, text_cond)\n",
    "            \n",
    "            # Decode to mel spectrogram\n",
    "            mel_pred = self.mel_decoder(mel_latent)\n",
    "            \n",
    "            return {\n",
    "                'mel_pred': mel_pred,\n",
    "                'durations': durations\n",
    "            }\n",
    "\n",
    "print(f\"✅ F5 TTS flow components implemented\")"
   ]
