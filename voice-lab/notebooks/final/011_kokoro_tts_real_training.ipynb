    "# Audio processing utilities for real TTS training\n",
    "class RealAudioProcessor:\n",
    "    \"\"\"Real audio processing for production Kokoro TTS training.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: RealKokoroConfig):\n",
    "        self.config = config\n",
    "        \n",
    "    def extract_mel_spectrogram(self, audio_path: str) -> np.ndarray:\n",
    "        \"\"\"Extract mel spectrogram from REAL audio file.\"\"\"\n",
    "        try:\n",
    "            # Load audio at target sample rate\n",
    "            audio, sr = librosa.load(audio_path, sr=self.config.sample_rate)\n",
    "            \n",
    "            # Ensure audio is not too long\n",
    "            max_samples = int(self.config.max_audio_length * self.config.sample_rate)\n",
    "            if len(audio) > max_samples:\n",
    "                audio = audio[:max_samples]\n",
    "            \n",
    "            # Extract mel spectrogram\n",
    "            mel_spec = librosa.feature.melspectrogram(\n",
    "                y=audio,\n",
    "                sr=self.config.sample_rate,\n",
    "                n_fft=self.config.n_fft,\n",
    "                hop_length=self.config.hop_length,\n",
    "                n_mels=self.config.n_mels,\n",
    "                fmin=0,\n",
    "                fmax=self.config.sample_rate // 2\n",
    "            )\n",
    "            \n",
    "            # Convert to log scale\n",
    "            mel_spec = librosa.power_to_db(mel_spec, ref=np.max)\n",
    "            \n",
    "            return mel_spec.T  # Transpose to (time, mels)\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error processing {audio_path}: {e}\")\n",
    "            # Return dummy mel spectrogram\n",
    "            return np.zeros((100, self.config.n_mels))\n",
    "    \n",
    "    def process_text(self, text: str) -> List[str]:\n",
    "        \"\"\"Process text for TTS training (simple tokenization).\"\"\"\n",
    "        # Simple character-level tokenization for now\n",
    "        # In production, you'd use proper phonemization\n",
    "        text = text.lower().strip()\n",
    "        return list(text)\n",
    "    \n",
    "    def create_speaker_embedding(self, speaker_id: str) -> np.ndarray:\n",
    "        \"\"\"Create speaker embedding (simplified approach).\"\"\"\n",
    "        # Simple hash-based embedding for demo\n",
    "        # In production, use learned speaker embeddings\n",
    "        np.random.seed(hash(speaker_id) % (2**32))\n",
    "        return np.random.randn(self.config.speaker_embedding_dim).astype(np.float32)\n",
    "\n",
    "# Text processing utilities\n",
    "class RealTextProcessor:\n",
    "    \"\"\"Real text processing for production TTS training.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: RealKokoroConfig):\n",
    "        self.config = config\n",
    "        self.vocab = self._build_vocab()\n",
    "        \n",
    "    def _build_vocab(self) -> Dict[str, int]:\n",
    "        \"\"\"Build character vocabulary for Twi TTS.\"\"\"\n",
    "        # Basic character set for Twi\n",
    "        chars = list('abcdefghijklmnopqrstuvwxyzɛɔɲŋ .,!?-')\n",
    "        vocab = {'<pad>': 0, '<unk>': 1}\n",
    "        \n",
    "        for i, char in enumerate(chars):\n",
    "            vocab[char] = i + 2\n",
    "        \n",
    "        return vocab\n",
    "    \n",
    "    def text_to_sequence(self, text: str) -> List[int]:\n",
    "        \"\"\"Convert text to sequence of token IDs.\"\"\"\n",
    "        text = text.lower().strip()\n",
    "        sequence = []\n",
    "        \n",
    "        for char in text:\n",
    "            sequence.append(self.vocab.get(char, self.vocab['<unk>']))\n",
    "        \n",
    "        return sequence\n",
    "    \n",
    "    def sequence_to_text(self, sequence: List[int]) -> str:\n",
    "        \"\"\"Convert sequence of token IDs back to text.\"\"\"\n",
    "        id_to_char = {v: k for k, v in self.vocab.items()}\n",
    "        text = ''.join([id_to_char.get(id, '<unk>') for id in sequence])\n",
    "        return text.replace('<pad>', '').replace('<unk>', '')\n",
