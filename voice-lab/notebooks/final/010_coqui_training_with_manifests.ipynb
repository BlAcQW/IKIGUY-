    "# Speaker embedding generation for voice cloning\n",
    "class SpeakerEmbeddingGenerator:\n",
    "    \"\"\"Generate speaker embeddings for voice cloning.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: CoquiManifestConfig):\n",
    "        self.config = config\n",
    "        self.speaker_encoder = None\n",
    "        self._setup_speaker_encoder()\n",
    "        \n",
    "    def _setup_speaker_encoder(self):\n",
    "        \"\"\"Setup speaker recognition model.\"\"\"\n",
    "        print(\"🎭 Setting up speaker recognition for embeddings...\")\n",
    "        \n",
    "        if not SPEECHBRAIN_AVAILABLE:\n",
    "            print(\"   ⚠️ SpeechBrain not available, using fallback embeddings\")\n",
    "            self.speaker_encoder = None\n",
    "            return\n",
    "        \n",
    "        try:\n",
    "            self.speaker_encoder = SpeakerRecognition.from_hparams(\n",
    "                source=\"speechbrain/spkrec-ecapa-voxceleb\",\n",
    "                savedir=str(self.config.output_dir / \"speaker_encoder\")\n",
    "            )\n",
    "            print(\"   ✅ SpeechBrain speaker encoder loaded\")\n",
    "        except Exception as e:\n",
    "            print(f\"   ⚠️ Could not load SpeechBrain: {e}\")\n",
    "            self.speaker_encoder = None\n",
    "    \n",
    "    def generate_speaker_embeddings(self, manifests: Dict[str, pd.DataFrame]) -> Dict[str, np.ndarray]:\n",
    "        \"\"\"Generate embeddings for all speakers in the dataset.\"\"\"\n",
    "        print(\"🎤 Generating speaker embeddings for voice cloning...\")\n",
    "        \n",
    "        # Collect all unique speakers and their representative samples\n",
    "        all_speakers = {}\n",
    "        \n",
    "        for split_name, df in manifests.items():\n",
    "            if df.empty:\n",
    "                continue\n",
    "            \n",
    "            for speaker_id in df['speaker_id'].unique():\n",
    "                if speaker_id not in all_speakers:\n",
    "                    # Get best representative sample for this speaker\n",
    "                    speaker_samples = df[df['speaker_id'] == speaker_id]\n",
    "                    \n",
    "                    # Choose sample with duration closest to 5 seconds\n",
    "                    target_duration = 5.0\n",
    "                    best_sample = speaker_samples.loc[\n",
    "                        (speaker_samples['duration'] - target_duration).abs().idxmin()\n",
    "                    ]\n",
    "                    \n",
    "                    all_speakers[speaker_id] = {\n",
    "                        'audio_path': best_sample['audio_path'],\n",
    "                        'duration': best_sample['duration'],\n",
    "                        'sample_count': len(speaker_samples)\n",
    "                    }\n",
    "        \n",
    "        print(f\"   📊 Processing embeddings for {len(all_speakers)} unique speakers\")\n",
    "        \n",
    "        speaker_embeddings = {}\n",
    "        \n",
    "        for speaker_id, info in tqdm(all_speakers.items(), desc=\"Generating embeddings\"):\n",
    "            try:\n",
    "                if self.speaker_encoder and Path(info['audio_path']).exists():\n",
    "                    # Generate real embeddings using SpeechBrain\n",
    "                    embedding = self.speaker_encoder.encode_file(info['audio_path'])\n",
    "                    speaker_embeddings[speaker_id] = embedding.squeeze().cpu().numpy()\n",
    "                else:\n",
    "                    # Generate deterministic pseudo-embeddings based on speaker ID\n",
    "                    np.random.seed(hash(speaker_id) % 2**32)\n",
    "                    embedding = np.random.randn(self.config.embedding_dim).astype(np.float32)\n",
    "                    # Normalize to unit length\n",
    "                    embedding = embedding / np.linalg.norm(embedding)\n",
    "                    speaker_embeddings[speaker_id] = embedding\n",
    "                    \n",
    "            except Exception as e:\n",
    "                print(f\"   ⚠️ Error generating embedding for {speaker_id}: {e}\")\n",
    "                # Fallback embedding\n",
    "                np.random.seed(hash(speaker_id) % 2**32)\n",
    "                embedding = np.random.randn(self.config.embedding_dim).astype(np.float32)\n",
    "                speaker_embeddings[speaker_id] = embedding / np.linalg.norm(embedding)\n",
    "        \n",
    "        # Save embeddings\n",
    "        embeddings_path = self.config.output_dir / \"speaker_embeddings.pkl\"\n",
    "        with open(embeddings_path, 'wb') as f:\n",
    "            pickle.dump(speaker_embeddings, f)\n",
    "        \n",
    "        print(f\"   ✅ Generated embeddings for {len(speaker_embeddings)} speakers\")\n",
    "        print(f\"   💾 Embeddings saved to: {embeddings_path}\")\n",
    "        \n",
    "        # Print embedding statistics\n",
    "        sample_counts = [info['sample_count'] for info in all_speakers.values()]\n",
    "        print(f\"   📊 Speaker statistics:\")\n",
    "        print(f\"     Average samples per speaker: {np.mean(sample_counts):.1f}\")\n",
    "        print(f\"     Speaker with most samples: {max(sample_counts)} samples\")\n",
    "        print(f\"     Speaker with least samples: {min(sample_counts)} samples\")\n",
    "        \n",
    "        return speaker_embeddings\n",
    "\n",
    "# Generate speaker embeddings if manifests are available\n",
    "if any(not df.empty for df in manifests.values()):\n",
    "    embedding_generator = SpeakerEmbeddingGenerator(config)\n",
    "    speaker_embeddings = embedding_generator.generate_speaker_embeddings(manifests)\n",
    "    print(\"✅ Speaker embeddings generated successfully!\")\n",
    "else:\n",
    "    print(\"⚠️ No valid manifests available for speaker embedding generation\")\n",
    "    speaker_embeddings = {}"
   ]
