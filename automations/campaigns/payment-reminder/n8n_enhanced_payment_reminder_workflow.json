              "id": "needs-followup",
              "leftValue": "={{ $('VAPI Payment Collection Call').item.json.call_result.outcome }}",
              "rightValue": "payment_promised",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "followup-scheduler",
