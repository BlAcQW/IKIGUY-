    "# Enhanced manifest loader for Kokoro TTS\n",
    "class KokoroManifestLoader:\n",
    "    \"\"\"Load TTS manifests optimized for Kokoro TTS training.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: KokoroManifestConfig):\n",
    "        self.config = config\n",
    "        \n",
    "    def load_kokoro_manifests(self) -> Dict[str, pd.DataFrame]:\n",
    "        \"\"\"Load Kokoro TTS manifests from enhanced processing pipeline.\"\"\"\n",
    "        print(\"📋 Loading Kokoro TTS manifests...\")\n",
    "        \n",
    "        manifests = {}\n",
    "        \n",
    "        # Primary manifest files for Kokoro (24kHz TTS)\n",
    "        kokoro_manifest_files = {\n",
    "            'train': self.config.manifest_dir / 'kokoro_tts_train.csv',\n",
    "            'val': self.config.manifest_dir / 'kokoro_tts_val.csv'\n",
    "        }\n",
    "        \n",
    "        # Fallback to other high-quality TTS manifests (24kHz)\n",
    "        fallback_manifests = {\n",
    "            'train': [\n",
    "                self.config.data_dir / 'processed/manifests/tts_24k_dataset.csv',\n",
    "                self.config.manifest_dir / 'openvoice_train.csv',\n",
    "                self.config.manifest_dir / 'f5_tts_train.csv',\n",
    "                self.config.manifest_dir / 'chattts_chatterbox_train.csv'\n",
    "            ],\n",
    "            'val': [\n",
    "                self.config.data_dir / 'processed/manifests/tts_24k_dataset.csv',\n",
    "                self.config.manifest_dir / 'openvoice_val.csv',\n",
    "                self.config.manifest_dir / 'f5_tts_val.csv',\n",
    "                self.config.manifest_dir / 'chattts_chatterbox_val.csv'\n",
    "            ]\n",
    "        }\n",
    "        \n",
    "        for split_name in ['train', 'val']:\n",
    "            manifest_path = kokoro_manifest_files[split_name]\n",
    "            \n",
    "            if manifest_path.exists():\n",
    "                print(f\"   ✅ Found Kokoro manifest: {manifest_path.name}\")\n",
    "                try:\n",
    "                    df = pd.read_csv(manifest_path)\n",
    "                    manifests[split_name] = self._validate_kokoro_manifest(df, split_name)\n",
    "                except Exception as e:\n",
    "                    print(f\"   ⚠️ Error loading {manifest_path}: {e}\")\n",
    "                    manifests[split_name] = pd.DataFrame()\n",
    "            else:\n",
    "                print(f\"   ⚠️ Kokoro manifest not found: {manifest_path.name}\")\n",
    "                print(f\"   🔄 Looking for fallback manifests...\")\n",
    "                \n",
    "                # Try fallback manifests\n",
    "                fallback_df = self._load_fallback_manifests(fallback_manifests[split_name])\n",
    "                \n",
    "                if not fallback_df.empty:\n",
    "                    # Split fallback data if needed\n",
    "                    if split_name == 'val':\n",
    "                        train_size = int(0.9 * len(fallback_df))\n",
    "                        if split_name == 'train':\n",
    "                            fallback_df = fallback_df.iloc[:train_size]\n",
    "                        else:\n",
    "                            fallback_df = fallback_df.iloc[train_size:]\n",
    "                    \n",
    "                    manifests[split_name] = self._validate_kokoro_manifest(fallback_df, split_name)\n",
    "                else:\n",
    "                    print(f\"   ❌ No valid manifests found for {split_name}\")\n",
    "                    manifests[split_name] = self._create_dummy_kokoro_manifest()\n",
    "        \n",
    "        return manifests\n",
    "    \n",
    "    def _load_fallback_manifests(self, fallback_paths: List[Path]) -> pd.DataFrame:\n",
    "        \"\"\"Load fallback manifests and combine them.\"\"\"\n",
    "        combined_df = pd.DataFrame()\n",
    "        \n",
    "        for fallback_path in fallback_paths:\n",
    "            if fallback_path.exists():\n",
    "                print(f\"   ✅ Using fallback: {fallback_path.name}\")\n",
    "                try:\n",
    "                    df = pd.read_csv(fallback_path)\n",
    "                    combined_df = pd.concat([combined_df, df], ignore_index=True)\n",
    "                except Exception as e:\n",
    "                    print(f\"   ⚠️ Error loading {fallback_path}: {e}\")\n",
    "                    continue\n",
    "        \n",
    "        return combined_df\n",
    "    \n",
    "    def _validate_kokoro_manifest(self, df: pd.DataFrame, split_name: str) -> pd.DataFrame:\n",
    "        \"\"\"Validate and format manifest for Kokoro TTS training.\"\"\"\n",
    "        print(f\"   🔍 Validating {split_name} manifest for Kokoro TTS...\")\n",
    "        \n",
    "        if df.empty:\n",
    "            return df\n",
    "        \n",
    "        # Required columns for Kokoro TTS\n",
    "        required_columns = ['audio_path', 'text']\n",
    "        \n",
    "        # Map common column variations\n",
    "        column_mappings = {\n",
    "            'transcript': 'text',\n",
    "            'transcription': 'text',\n",
    "            'sentence': 'text',\n",
    "            'audio': 'audio_path',\n",
    "            'path': 'audio_path',\n",
    "            'file_path': 'audio_path',\n",
    "            'processed_audio_path': 'audio_path'\n",
    "        }\n",
    "        \n",
    "        for old_col, new_col in column_mappings.items():\n",
    "            if old_col in df.columns and new_col not in df.columns:\n",
    "                df = df.rename(columns={old_col: new_col})\n",
    "                print(f\"   🔄 Mapped {old_col} → {new_col}\")\n",
    "        \n",
    "        # Check required columns\n",
    "        missing_columns = set(required_columns) - set(df.columns)\n",
    "        if missing_columns:\n",
    "            print(f\"   ❌ Missing required columns: {missing_columns}\")\n",
    "            return pd.DataFrame()\n",
    "        \n",
    "        # Add optional columns\n",
    "        if 'speaker_id' not in df.columns:\n",
    "            df['speaker_id'] = 'default_speaker'\n",
    "        if 'language' not in df.columns:\n",
    "            df['language'] = 'tw'\n",
    "        \n",
    "        # Add duration if not present\n",
    "        if 'duration' not in df.columns:\n",
    "            print(f\"   📊 Adding duration information...\")\n",
    "            durations = []\n",
    "            for audio_path in df['audio_path']:\n",
    "                try:\n",
    "                    if Path(audio_path).exists():\n",
    "                        info = sf.info(audio_path)\n",
    "                        durations.append(info.duration)\n",
    "                    else:\n",
    "                        durations.append(5.0)  # Default\n",
    "                except:\n",
    "                    durations.append(5.0)  # Default\n",
    "            df['duration'] = durations\n",
    "        \n",
    "        # Quality filtering for high-quality TTS\n",
    "        initial_count = len(df)\n",
    "        \n",
    "        # Filter valid audio files\n",
    "        df['audio_exists'] = df['audio_path'].apply(lambda x: Path(x).exists() if pd.notna(x) else False)\n",
    "        df = df[df['audio_exists']].drop(columns=['audio_exists'])\n",
    "        \n",
    "        # Filter valid text\n",
    "        df = df[df['text'].str.len() > 0]\n",
    "        df = df[df['text'].str.len() <= self.config.max_text_length]\n",
    "        \n",
    "        # Filter audio duration (optimal range for TTS)\n",
    "        df = df[\n",
    "            (df['duration'] >= self.config.min_audio_length) &\n",
    "            (df['duration'] <= self.config.max_audio_length)\n",
    "        ]\n",
    "        \n",
    "        # Remove very short text (likely noise)\n",
    "        df = df[df['text'].str.len() >= 10]\n",
    "        \n",
    "        final_count = len(df)\n",
    "        retention_rate = (final_count / initial_count * 100) if initial_count > 0 else 0\n",
    "        \n",
    "        print(f\"   📊 {split_name}: {final_count}/{initial_count} samples retained ({retention_rate:.1f}%)\")\n",
    "        if final_count > 0:\n",
    "            print(f\"     Unique speakers: {df['speaker_id'].nunique()}\")\n",
    "            print(f\"     Average duration: {df['duration'].mean():.1f}s\")\n",
    "            print(f\"     Average text length: {df['text'].str.len().mean():.0f} chars\")\n",
    "        \n",
    "        return df\n",
    "    \n",
    "    def _create_dummy_kokoro_manifest(self) -> pd.DataFrame:\n",
    "        \"\"\"Create dummy manifest for Kokoro testing.\"\"\"\n",
    "        print(\"   📝 Creating dummy Kokoro manifest...\")\n",
    "        \n",
    "        dummy_dir = self.config.data_dir / 'dummy_audio_kokoro'\n",
    "        dummy_dir.mkdir(parents=True, exist_ok=True)\n",
    "        \n",
    "        # High-quality samples for Kokoro (longer, more natural)\n",
    "        samples = [\n",
    "            \"Wo ho te sɛn? Me ho yɛ pa ara. Medaase.\",\n",
    "            \"Ɛyɛ anɔpa pa. Akwaaba wo ba ha.\",\n",
    "            \"Me ma wo akye. Ɛyɛ da pa bi.\",\n",
    "            \"Nante yie. Akyire yɛbɛhunu.\",\n",
    "            \"Me da wo ase. Wo ayɛ adwuma pa.\",\n",
    "            \"Ɛyɛ dɛn? Biribiara yɛ yie.\",\n",
    "            \"Mepɛ aduane. Me kɔm de me.\",\n",
    "            \"Ɛyɛ anɔpa anum. Me nkyen adeɛ.\",\n",
    "            \"Me kɔ sukuu. Mɛsua adeɛ.\",\n",
    "            \"Ɛyɛ awiɛ nsia. Yɛnkɔ fie.\"\n",
    "        ]\n",
    "        \n",
    "        dummy_data = []\n",
    "        for i, text in enumerate(samples):\n",
    "            audio_file = dummy_dir / f\"kokoro_dummy_{i:03d}.wav\"\n",
    "            \n",
    "            if not audio_file.exists():\n",
    "                # Create higher quality dummy audio (5-10 seconds)\n",
    "                duration = np.random.uniform(5.0, 10.0)\n",
    "                # Higher sample rate for Kokoro\n",
    "                dummy_audio = np.random.normal(0, 0.08, int(24000 * duration)).astype(np.float32)\n",
    "                sf.write(audio_file, dummy_audio, 24000)\n",
    "            \n",
    "            dummy_data.append({\n",
    "                'audio_path': str(audio_file),\n",
    "                'text': text,\n",
    "                'speaker_id': f'kokoro_speaker_{i % 3}',\n",
    "                'duration': sf.info(str(audio_file)).duration,\n",
    "                'language': 'tw',\n",
    "                'dataset': 'dummy_kokoro'\n",
    "            })\n",
    "        \n",
    "        return pd.DataFrame(dummy_data)\n",
    "\n",
    "# Load manifests\n",
    "manifest_loader = KokoroManifestLoader(config)\n",
    "manifests = manifest_loader.load_kokoro_manifests()\n",
    "\n",
    "print(f\"\\n📊 Kokoro Manifest Summary:\")\n",
    "for split_name, df in manifests.items():\n",
    "    print(f\"   {split_name}: {len(df)} samples\")\n",
    "    if not df.empty:\n",
    "        print(f\"     Unique speakers: {df['speaker_id'].nunique()}\")\n",
    "        print(f\"     Total duration: {df['duration'].sum()/60:.1f} minutes\")\n",
    "        print(f\"     Average duration: {df['duration'].mean():.1f}s\")\n",
    "        print(f\"     Average text length: {df['text'].str.len().mean():.0f} chars\")\n",
    "        print(f\"     Languages: {df['language'].unique()}\")"
   ]
