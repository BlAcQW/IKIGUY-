    {
      "parameters": {
        "jsCode": "// Format the API response for VAPI\nconst items = $input.all();\nconst apiResponse = items[0].json;\nconst originalData = items[0].json;\n\n// Extract provider data\nconst providers = apiResponse.data?.providers || [];\nconst totalFound = apiResponse.data?.total_found || 0;\nconst voiceResponse = apiResponse.data?.voice_response || 'No providers found.';\n\n// Store provider data for potential email/SMS use\nconst providerData = providers.map(provider => ({\n  name: provider.name,\n  specialty: provider.specialty,\n  location: provider.location,\n  phone: provider.phone,\n  address: provider.address,\n  rating: provider.rating\n}));\n\n// Create VAPI response format\nconst vapiResponse = {\n  message: {\n    type: 'assistant',\n    content: voiceResponse + (providers.length > 0 ? ' Would you like me to send this information to your email or phone?' : ''),\n    function_call_result: {\n      success: apiResponse.success || false,\n      data: {\n        providers: providers.slice(0, 3), // Limit for voice response\n        total_found: totalFound,\n        search_completed: true\n      }\n    }\n  }\n};\n\n// Include original call data and provider data for follow-up actions\nconst enhancedResponse = {\n  ...originalData,\n  vapi_response: vapiResponse,\n  provider_data: providerData,\n  providers_found_count: providers.length,\n  search_successful: apiResponse.success\n};\n\nconsole.log('VAPI Response Prepared:', JSON.stringify(vapiResponse, null, 2));\n\nreturn [{ json: enhancedResponse }];"
      },
