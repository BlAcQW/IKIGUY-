    "## 3. Comprehensive Data Loading and Processing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class ComprehensiveFasterWhisperDataLoader:\n",
    "    \"\"\"Comprehensive data loader for Faster-Whisper training.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: OptimizedFasterWhisperConfig):\n",
    "        self.config = config\n",
    "        self.processor = None\n",
    "        \n",
    "    def initialize_processor(self):\n",
    "        \"\"\"Initialize Whisper processor with proper language handling.\"\"\"\n",
    "        print(f\"🔧 Initializing Whisper processor...\")\n",
    "        \n",
    "        try:\n",
    "            # Use English as base language (supported by Whisper)\n",
    "            self.processor = WhisperProcessor.from_pretrained(\n",
    "                self.config.model_name,\n",
    "                language=self.config.base_language,\n",
    "                task=self.config.task,\n",
    "                cache_dir=DIRS['cache']\n",
    "            )\n",
    "            \n",
    "            # Add Twi-specific tokens\n",
    "            twi_tokens = [\n",
    "                'ɛ', 'Ɛ', 'ɔ', 'Ɔ', 'ã', 'ẽ', 'ĩ', 'õ', 'ũ', 'ŋ', 'Ŋ',\n",
    "                '[ASANTE]', '[AKUAPEM]', '[FANTE]', '[GA]', '[TWI]'\n",
    "            ]\n",
    "            \n",
    "            num_added = self.processor.tokenizer.add_tokens(twi_tokens)\n",
    "            print(f\"✅ Processor initialized with {num_added} Twi tokens\")\n",
    "            \n",
    "            return self.processor\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Processor initialization failed: {e}\")\n",
    "            return None\n",
    "    \n",
    "    def discover_and_load_comprehensive_data(self) -> Optional[DatasetDict]:\n",
    "        \"\"\"Discover and load comprehensive Twi data.\"\"\"\n",
    "        print(\"🔍 Discovering comprehensive Twi data for Faster-Whisper...\")\n",
    "        \n",
    "        # Method 1: Load from existing splits (fastest)\n",
    "        if (DIRS['splits'] / 'train.csv').exists():\n",
    "            print(\"📂 Loading from existing splits...\")\n",
    "            datasets = self._load_from_splits()\n",
    "            if datasets:\n",
    "                return datasets\n",
    "        \n",
    "        # Method 2: Load from raw MichSet data\n",
    "        if (DIRS['raw'] / 'michsethowusu').exists():\n",
    "            print(\"📦 Loading from raw MichSet data...\")\n",
    "            datasets = self._load_from_michset()\n",
    "            if datasets:\n",
    "                return datasets\n",
    "        \n",
    "        # Method 3: Create enhanced demo dataset\n",
    "        print(\"🎭 Creating enhanced demo dataset...\")\n",
    "        return self._create_enhanced_demo_dataset()\n",
    "    \n",
    "    def _load_from_splits(self) -> Optional[DatasetDict]:\n",
    "        \"\"\"Load data from existing train/val/test splits.\"\"\"\n",
    "        dataset_dict = {}\n",
    "        \n",
    "        for split in ['train', 'validation', 'test']:\n",
    "            split_file = DIRS['splits'] / f'{split}.csv'\n",
    "            if split_file.exists():\n",
    "                try:\n",
    "                    df = pd.read_csv(split_file)\n",
    "                    \n",
    "                    # Fix audio paths for current environment\n",
    "                    if 'audio' in df.columns:\n",
    "                        df['audio'] = df['audio'].apply(\n",
    "                            lambda x: str(x).replace('/opt/kasaai/apps/voice-lab/data', str(DIRS['base']))\n",
    "                            if pd.notna(x) else None\n",
    "                        )\n",
    "                    elif 'audio_path' in df.columns:\n",
    "                        df['audio'] = df['audio_path'].apply(\n",
    "                            lambda x: str(x).replace('/opt/kasaai/apps/voice-lab/data', str(DIRS['base']))\n",
    "                            if pd.notna(x) else None\n",
    "                        )\n",
    "                    \n",
    "                    # Ensure text column exists\n",
    "                    if 'text' not in df.columns:\n",
    "                        if 'processed_text' in df.columns:\n",
    "                            df['text'] = df['processed_text']\n",
    "                        elif 'original_text' in df.columns:\n",
    "                            df['text'] = df['original_text']\n",
    "                    \n",
    "                    # Validate files exist and have proper duration\n",
    "                    if 'audio' in df.columns:\n",
    "                        df['audio_exists'] = df['audio'].apply(\n",
    "                            lambda x: Path(x).exists() if pd.notna(x) else False\n",
    "                        )\n",
    "                        \n",
    "                        # Add duration filtering\n",
    "                        df['duration_valid'] = True  # Placeholder, can add actual duration checks\n",
    "                        \n",
    "                        valid_df = df[df['audio_exists'] & df['duration_valid']].copy()\n",
    "                        \n",
    "                        if len(valid_df) > 0:\n",
    "                            dataset_dict[split] = Dataset.from_pandas(valid_df)\n",
    "                            print(f\"✅ {split}: {len(valid_df)}/{len(df)} samples with valid audio\")\n",
    "                        else:\n",
    "                            print(f\"⚠️ {split}: No valid audio files found\")\n",
    "                    \n",
    "                except Exception as e:\n",
    "                    print(f\"❌ Error loading {split}: {e}\")\n",
    "        \n",
    "        return DatasetDict(dataset_dict) if dataset_dict else None\n",
    "    \n",
    "    def _load_from_michset(self) -> Optional[DatasetDict]:\n",
    "        \"\"\"Load data from raw MichSet datasets with enhanced processing.\"\"\"\n",
    "        michset_dir = DIRS['raw'] / 'michsethowusu'\n",
    "        all_samples = []\n",
    "        \n",
    "        # Priority order for dataset loading\n",
    "        dataset_priority = [\n",
    "            'twi_multispeaker_audio_transcribed',\n",
    "            'akuapem_multispeaker_audio_transcribed',\n",
    "            'fante_multispeaker_audio_transcribed',\n",
    "            'ga_multispeaker_audio_transcribed'\n",
    "        ]\n",
    "        \n",
    "        for dataset_name in dataset_priority:\n",
    "            dataset_dir = michset_dir / dataset_name\n",
    "            \n",
    "            if dataset_dir.exists():\n",
    "                try:\n",
    "                    # Try loading as HuggingFace dataset\n",
    "                    dataset = load_from_disk(str(dataset_dir))\n",
    "                    \n",
    "                    # Handle different split structures\n",
    "                    data_to_process = None\n",
    "                    if 'train' in dataset:\n",
    "                        data_to_process = dataset['train']\n",
    "                    elif isinstance(dataset, Dataset):\n",
    "                        data_to_process = dataset\n",
    "                    \n",
    "                    if data_to_process:\n",
    "                        df = data_to_process.to_pandas()\n",
    "                        \n",
    "                        # Add enhanced metadata\n",
    "                        df['source_dataset'] = dataset_name\n",
    "                        df['dialect'] = dataset_name.split('_')[0]  # Extract dialect\n",
    "                        df['language'] = 'twi'  # Standardize language\n",
    "                        \n",
    "                        # Ensure proper column names\n",
    "                        if 'transcription' in df.columns and 'text' not in df.columns:\n",
    "                            df['text'] = df['transcription']\n",
    "                        \n",
    "                        # Add dialect markers to text for enhanced training\n",
    "                        dialect_markers = {\n",
    "                            'twi': '[TWI]',\n",
    "                            'asante': '[ASANTE]',\n",
    "                            'akuapem': '[AKUAPEM]',\n",
    "                            'fante': '[FANTE]',\n",
    "                            'ga': '[GA]'\n",
    "                        }\n",
    "                        \n",
    "                        dialect = df['dialect'].iloc[0] if len(df) > 0 else 'twi'\n",
    "                        marker = dialect_markers.get(dialect, '[TWI]')\n",
    "                        df['text'] = df['text'].apply(lambda x: f\"{marker} {x}\" if pd.notna(x) else x)\n",
    "                        \n",
    "                        all_samples.append(df)\n",
    "                        print(f\"✅ Loaded {dataset_name}: {len(df)} samples with {marker} markers\")\n",
    "                        \n",
    "                except Exception as e:\n",
    "                    print(f\"⚠️ Error loading {dataset_name}: {e}\")\n",
    "        \n",
    "        if not all_samples:\n",
    "            return None\n",
    "        \n",
    "        # Combine and create balanced splits\n",
    "        combined_df = pd.concat(all_samples, ignore_index=True)\n",
    "        combined_df = combined_df.sample(frac=1, random_state=42).reset_index(drop=True)\n",
    "        \n",
    "        print(f\"📊 Combined dataset: {len(combined_df)} samples\")\n",
    "        \n",
    "        # Create enhanced splits with dialect balancing\n",
    "        return self._create_balanced_splits(combined_df)\n",
    "    \n",
    "    def _create_balanced_splits(self, df: pd.DataFrame) -> DatasetDict:\n",
    "        \"\"\"Create balanced train/val/test splits considering dialects.\"\"\"\n",
    "        print(f\"🎯 Creating balanced splits from {len(df)} samples...\")\n",
    "        \n",
    "        # Analyze dialect distribution\n",
    "        if 'dialect' in df.columns:\n",
    "            dialect_counts = df['dialect'].value_counts()\n",
    "            print(f\"📊 Dialect distribution: {dict(dialect_counts)}\")\n",
    "        \n",
    "        # Stratified split by dialect if possible\n",
    "        if 'dialect' in df.columns and len(df['dialect'].unique()) > 1:\n",
    "            train_dfs, val_dfs, test_dfs = [], [], []\n",
    "            \n",
    "            for dialect in df['dialect'].unique():\n",
    "                dialect_df = df[df['dialect'] == dialect].copy()\n",
    "                n_samples = len(dialect_df)\n",
    "                \n",
    "                if n_samples >= 5:  # Need at least 5 samples for splits\n",
    "                    n_train = max(1, int(0.8 * n_samples))\n",
    "                    n_val = max(1, int(0.1 * n_samples))\n",
    "                    \n",
    "                    train_dfs.append(dialect_df[:n_train])\n",
    "                    val_dfs.append(dialect_df[n_train:n_train+n_val])\n",
    "                    test_dfs.append(dialect_df[n_train+n_val:])\n",
    "                else:\n",
    "                    # Put small dialects in training\n",
    "                    train_dfs.append(dialect_df)\n",
    "            \n",
    "            splits = {\n",
    "                'train': pd.concat(train_dfs, ignore_index=True) if train_dfs else pd.DataFrame(),\n",
    "                'validation': pd.concat(val_dfs, ignore_index=True) if val_dfs else pd.DataFrame(),\n",
    "                'test': pd.concat(test_dfs, ignore_index=True) if test_dfs else pd.DataFrame()\n",
    "            }\n",
    "        else:\n",
    "            # Simple random split\n",
    "            n_samples = len(df)\n",
    "            n_train = int(0.8 * n_samples)\n",
    "            n_val = int(0.1 * n_samples)\n",
    "            \n",
    "            splits = {\n",
    "                'train': df[:n_train],\n",
    "                'validation': df[n_train:n_train+n_val],\n",
    "                'test': df[n_train+n_val:]\n",
    "            }\n",
    "        \n",
    "        # Convert to datasets\n",
    "        dataset_dict = {}\n",
    "        for split_name, split_df in splits.items():\n",
    "            if len(split_df) > 0:\n",
    "                dataset_dict[split_name] = Dataset.from_pandas(split_df)\n",
    "                print(f\"✅ {split_name}: {len(split_df)} samples\")\n",
    "        \n",
    "        return DatasetDict(dataset_dict)\n",
    "    \n",
    "    def _create_enhanced_demo_dataset(self) -> DatasetDict:\n",
    "        \"\"\"Create enhanced demo dataset with comprehensive dialect coverage.\"\"\"\n",
    "        print(\"🎭 Creating enhanced demo dataset for Faster-Whisper...\")\n",
    "        \n",
    "        # Enhanced demo data with full dialect representation\n",
    "        demo_data = [\n",
    "            {\"text\": \"[TWI] Wo ho te sɛn\", \"dialect\": \"twi\", \"translation\": \"How are you\"},\n",
    "            {\"text\": \"[ASANTE] Me ma wo akye\", \"dialect\": \"asante_twi\", \"translation\": \"I greet you (morning)\"},\n",
    "            {\"text\": \"[AKUAPEM] Me da wo ase\", \"dialect\": \"akuapem_twi\", \"translation\": \"Thank you\"},\n",
    "            {\"text\": \"[FANTE] Ɛyɛ sɛn na ɛkɔ\", \"dialect\": \"fante\", \"translation\": \"How is it going\"},\n",
    "            {\"text\": \"[GA] Nante yie\", \"dialect\": \"ga\", \"translation\": \"Go well\"},\n",
    "            {\"text\": \"[ASANTE] Mepaakyɛw, bɛkyɛ me\", \"dialect\": \"asante_twi\", \"translation\": \"Please, help me\"},\n",
    "            {\"text\": \"[AKUAPEM] Aane, ɛyɛ papa\", \"dialect\": \"akuapem_twi\", \"translation\": \"Yes, it is good\"},\n",
    "            {\"text\": \"[FANTE] Daabi, ɛnyɛ saa\", \"dialect\": \"fante\", \"translation\": \"No, it's not like that\"},\n",
    "            {\"text\": \"[TWI] Medɔ Twi kasa pa ara\", \"dialect\": \"twi\", \"translation\": \"I love the Twi language very much\"},\n",
    "            {\"text\": \"[GA] Ɔyɛ adwo sɛ yɛdi dwom\", \"dialect\": \"ga\", \"translation\": \"It's nice that we sing\"},\n",
    "            {\"text\": \"[ASANTE] Sɛ wopɛ a, yɛbɛtumi ayɛ\", \"dialect\": \"asante_twi\", \"translation\": \"If you want, we can do it\"},\n",
    "            {\"text\": \"[AKUAPEM] Yɛnkɔ fie ɛnnɛ anɔpa\", \"dialect\": \"akuapem_twi\", \"translation\": \"Let's go home this morning\"}\n",
    "        ]\n",
    "        \n",
    "        # Create demo audio files with varied characteristics\n",
    "        demo_dir = DIRS['base'] / \"demo_audio_enhanced\"\n",
    "        demo_dir.mkdir(exist_ok=True)\n",
    "        \n",
    "        for i, item in enumerate(demo_data):\n",
    "            audio_file = demo_dir / f\"demo_{item['dialect']}_{i:02d}.wav\"\n",
    "            if not audio_file.exists():\n",
    "                # Generate more realistic audio signals for different dialects\n",
    "                duration = np.random.uniform(2.0, 4.0)  # Varied duration\n",
    "                sample_rate = self.config.sample_rate\n",
    "                t = np.linspace(0, duration, int(sample_rate * duration))\n",
    "                \n",
    "                # Create dialect-specific frequency patterns\n",
    "                freq_patterns = {\n",
    "                    'twi': [440, 523, 659],  # Base pattern\n",
    "                    'asante_twi': [392, 494, 622],  # Lower frequencies\n",
    "                    'akuapem_twi': [466, 554, 698],  # Higher frequencies\n",
    "                    'fante': [415, 523, 659],  # Mid-range\n",
    "                    'ga': [370, 440, 554]  # Distinct pattern\n",
    "                }\n",
    "                \n",
    "                freqs = freq_patterns.get(item['dialect'], [440, 523, 659])\n",
    "                \n",
    "                # Create complex waveform\n",
    "                audio = np.zeros_like(t)\n",
    "                for j, freq in enumerate(freqs):\n",
    "                    weight = 0.3 / (j + 1)  # Decreasing amplitude\n",
    "                    audio += weight * np.sin(2 * np.pi * freq * t)\n",
    "                \n",
    "                # Add envelope and noise\n",
    "                envelope = np.exp(-2 * t / duration)  # Decay\n",
    "                noise = 0.02 * np.random.randn(len(audio))  # Small amount of noise\n",
    "                audio = audio * envelope + noise\n",
    "                \n",
    "                # Normalize\n",
    "                audio = audio / np.max(np.abs(audio)) * 0.7\n",
    "                \n",
    "                sf.write(audio_file, audio.astype(np.float32), sample_rate)\n",
    "            \n",
    "            item['audio'] = str(audio_file)\n",
    "            item['duration'] = duration\n",
    "        \n",
    "        # Create dataset with proper splits\n",
    "        df = pd.DataFrame(demo_data)\n",
    "        full_dataset = Dataset.from_pandas(df)\n",
    "        \n",
    "        # Create balanced splits\n",
    "        train_size = 8\n",
    "        val_size = 2\n",
    "        \n",
    "        dataset_dict = {\n",
    "            'train': full_dataset.select(range(train_size)),\n",
    "            'validation': full_dataset.select(range(train_size, train_size + val_size)),\n",
    "            'test': full_dataset.select(range(train_size + val_size, len(demo_data)))\n",
    "        }\n",
    "        \n",
    "        print(f\"✅ Enhanced demo dataset created with {len(demo_data)} samples\")\n",
    "        print(f\"📊 Dialect distribution: {df['dialect'].value_counts().to_dict()}\")\n",
    "        \n",
    "        return DatasetDict(dataset_dict)\n",
    "    \n",
    "    def prepare_dataset_for_whisper(self, batch):\n",
    "        \"\"\"Prepare batch for Whisper training with enhanced preprocessing.\"\"\"\n",
    "        audio_arrays = []\n",
    "        \n",
    "        # Process audio files in batch\n",
    "        for audio_path in batch[\"audio\"]:\n",
    "            try:\n",
    "                if Path(audio_path).exists():\n",
    "                    # Load audio\n",
    "                    audio, sr = librosa.load(audio_path, sr=self.config.sample_rate)\n",
    "                    \n",
    "                    # Apply duration limits\n",
    "                    min_samples = int(self.config.min_duration * self.config.sample_rate)\n",
    "                    max_samples = int(self.config.max_duration * self.config.sample_rate)\n",
    "                    \n",
    "                    if len(audio) < min_samples:\n",
    "                        # Pad short audio\n",
    "                        padding = min_samples - len(audio)\n",
    "                        audio = np.pad(audio, (0, padding), mode='constant')\n",
    "                    elif len(audio) > max_samples:\n",
    "                        # Truncate long audio\n",
    "                        audio = audio[:max_samples]\n",
    "                    \n",
    "                    audio_arrays.append(audio)\n",
    "                else:\n",
    "                    # Create silence for missing files\n",
    "                    audio_arrays.append(np.zeros(\n",
    "                        int(self.config.min_duration * self.config.sample_rate), \n",
    "                        dtype=np.float32\n",
    "                    ))\n",
    "            except Exception as e:\n",
    "                print(f\"⚠️ Error processing audio {audio_path}: {e}\")\n",
    "                audio_arrays.append(np.zeros(\n",
    "                    int(self.config.min_duration * self.config.sample_rate), \n",
    "                    dtype=np.float32\n",
    "                ))\n",
    "        \n",
    "        # Extract features\n",
    "        inputs = self.processor.feature_extractor(\n",
    "            audio_arrays,\n",
    "            sampling_rate=self.config.sample_rate,\n",
    "            return_tensors=\"pt\"\n",
    "        )\n",
    "        \n",
    "        # Process text labels\n",
    "        labels = self.processor.tokenizer(\n",
    "            batch[\"text\"],\n",
    "            padding=True,\n",
    "            truncation=True,\n",
    "            return_tensors=\"pt\"\n",
    "        )\n",
    "        \n",
    "        # Replace padding token id with -100 for loss calculation\n",
    "        labels[\"input_ids\"] = [\n",
    "            [(l if l != self.processor.tokenizer.pad_token_id else -100) for l in label]\n",
    "            for label in labels[\"input_ids\"]\n",
    "        ]\n",
    "        \n",
    "        return {\n",
    "            \"input_features\": inputs.input_features,\n",
    "            \"labels\": labels[\"input_ids\"]\n",
    "        }\n",
    "\n",
    "# Initialize comprehensive data loader\n",
    "data_loader = ComprehensiveFasterWhisperDataLoader(config)\n",
    "processor = data_loader.initialize_processor()\n",
    "\n",
    "if processor:\n",
    "    datasets = data_loader.discover_and_load_comprehensive_data()\n",
    "    \n",
    "    if datasets:\n",
    "        print(f\"\\n✅ Comprehensive dataset loaded successfully!\")\n",
    "        total_samples = sum(len(datasets[split]) for split in datasets.keys())\n",
    "        print(f\"📊 Total samples: {total_samples:,}\")\n",
    "        \n",
    "        for split, dataset in datasets.items():\n",
    "            print(f\"  {split}: {len(dataset):,} samples\")\n",
    "        \n",
    "        # Analyze sample\n",
    "        if 'train' in datasets and len(datasets['train']) > 0:\n",
    "            sample = datasets['train'][0]\n",
    "            print(f\"\\n📝 Sample data:\")\n",
    "            print(f\"  Text: {sample.get('text', 'N/A')[:100]}...\")\n",
    "            print(f\"  Dialect: {sample.get('dialect', 'N/A')}\")\n",
    "            print(f\"  Audio: ...{str(sample.get('audio', 'N/A'))[-30:]}\")\n",
    "    else:\n",
    "        print(\"❌ Failed to load dataset\")\n",
    "else:\n",
    "    print(\"❌ Failed to initialize processor\")"
   ]
  },
