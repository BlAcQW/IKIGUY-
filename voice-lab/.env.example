# Voice Lab API Configuration

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://api.ailabsafrica.com

# Model Settings
MODEL_CACHE_DIR=./models
ASR_MODEL=whisper-large-v3
TTS_MODEL=coqui-tts
VOICE_CLONE_MODEL=xtts-v2

# Data Paths
DATA_DIR=./data
AUDIO_UPLOAD_DIR=./data/uploads
PROCESSED_AUDIO_DIR=./data/processed
SYNTHETIC_DATA_DIR=./data/synthetic

# Processing Settings
MAX_AUDIO_LENGTH=300  # seconds
MIN_AUDIO_LENGTH=1    # seconds
DEFAULT_SAMPLE_RATE=16000
TTS_SAMPLE_RATE=22050

# GPU Settings
CUDA_VISIBLE_DEVICES=0
USE_GPU=true

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600  # seconds

# API Keys (if using external services)
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=
ABENA_API_KEY=

# Database (optional)
DATABASE_URL=postgresql://user:password@localhost/voicelab

# Security
SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Feature Flags
ENABLE_VOICE_CLONING=true
ENABLE_STREAMING=true
ENABLE_BATCH_PROCESSING=true
ENABLE_METRICS=true

# Limits
MAX_FILE_SIZE_MB=100
MAX_CONCURRENT_REQUESTS=10
RATE_LIMIT_PER_MINUTE=60