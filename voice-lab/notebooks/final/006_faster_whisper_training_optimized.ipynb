    "def run_faster_whisper_production_pipeline(enable_training=False, enable_ct2_conversion=False, max_train_samples=None):\n",
    "    \"\"\"Execute the complete Faster-Whisper production pipeline.\"\"\"\n",
    "    \n",
    "    print(\"🚀 FASTER-WHISPER PRODUCTION PIPELINE\")\n",
    "    print(\"=\" * 70)\n",
    "    \n",
    "    # 1. Verify prerequisites\n",
    "    print(\"\\n1️⃣ Verifying prerequisites...\")\n",
    "    if not processor:\n",
    "        print(\"❌ Processor not initialized\")\n",
    "        return False\n",
    "    \n",
    "    if not datasets:\n",
    "        print(\"❌ No datasets available\")\n",
    "        return False\n",
    "    \n",
    "    if not model:\n",
    "        print(\"❌ Model not initialized\")\n",
    "        return False\n",
    "    \n",
    "    train_data = datasets.get('train')\n",
    "    val_data = datasets.get('validation')\n",
    "    test_data = datasets.get('test')\n",
    "    \n",
    "    print(f\"✅ Training data: {len(train_data):,} samples\")\n",
    "    print(f\"✅ Validation data: {len(val_data):,} samples\" if val_data else \"⚠️ No validation data\")\n",
    "    print(f\"✅ Test data: {len(test_data):,} samples\" if test_data else \"⚠️ No test data\")\n",
    "    \n",
    "    # 2. Prepare datasets\n",
    "    print(\"\\n2️⃣ Preparing datasets for training...\")\n",
    "    \n",
    "    # Determine training size\n",
    "    if max_train_samples:\n",
    "        train_size = min(max_train_samples, len(train_data))\n",
    "        train_subset = train_data.select(range(train_size))\n",
    "    else:\n",
    "        train_subset = train_data\n",
    "        train_size = len(train_data)\n",
    "    \n",
    "    val_size = min(100, len(val_data)) if val_data else 0\n",
    "    val_subset = val_data.select(range(val_size)) if val_data and val_size > 0 else None\n",
    "    \n",
    "    print(f\"📊 Training subset: {len(train_subset):,} samples\")\n",
    "    print(f\"📊 Validation subset: {len(val_subset):,} samples\" if val_subset else \"📊 No validation subset\")\n",
    "    \n",
    "    # Process datasets\n",
    "    print(\"\\n🔄 Processing datasets...\")\n",
    "    \n",
    "    prepared_train = train_subset.map(\n",
    "        data_loader.prepare_dataset_for_whisper,\n",
    "        batched=True,\n",
    "        batch_size=8,\n",
    "        remove_columns=train_subset.column_names,\n",
    "        desc=\"Preparing training data\"\n",
    "    )\n",
    "    \n",
    "    if val_subset:\n",
    "        prepared_val = val_subset.map(\n",
    "            data_loader.prepare_dataset_for_whisper,\n",
    "            batched=True,\n",
    "            batch_size=8,\n",
    "            remove_columns=val_subset.column_names,\n",
    "            desc=\"Preparing validation data\"\n",
    "        )\n",
    "    else:\n",
    "        # Create validation from training data\n",
    "        val_size = min(50, len(prepared_train) // 10)\n",
    "        prepared_val = prepared_train.select(range(val_size))\n",
    "        prepared_train = prepared_train.select(range(val_size, len(prepared_train)))\n",
    "        print(f\"📊 Created validation set from training data: {val_size} samples\")\n",
    "    \n",
    "    print(f\"✅ Datasets prepared for training\")\n",
    "    \n",
    "    # 3. Setup training\n",
    "    print(\"\\n3️⃣ Setting up production training...\")\n",
    "    \n",
    "    production_trainer.setup_enhanced_training(prepared_train, prepared_val)\n",
    "    print(f\"✅ Training setup complete\")\n",
    "    \n",
    "    # 4. Execute training\n",
    "    print(\"\\n4️⃣ Training execution...\")\n",
    "    print(f\"💡 Training enabled: {enable_training}\")\n",
    "    \n",
    "    if enable_training:\n",
    "        print(\"\\n🏋️ Starting production training...\")\n",
    "        \n",
    "        try:\n",
    "            train_result = production_trainer.train_production_model()\n",
    "            print(\"\\n🎉 Training completed successfully!\")\n",
    "            \n",
    "            # 5. CTranslate2 conversion\n",
    "            print(\"\\n5️⃣ CTranslate2 conversion...\")\n",
    "            print(f\"💡 CT2 conversion enabled: {enable_ct2_conversion}\")\n",
    "            \n",
    "            if enable_ct2_conversion:\n",
    "                print(\"\\n⚡ Starting CTranslate2 optimization...\")\n",
    "                \n",
    "                # Convert to multiple optimized formats\n",
    "                ct2_results = ct2_converter.create_multiple_optimizations(config.final_model_dir)\n",
    "                \n",
    "                # Test successful conversions\n",
    "                for opt_name, ct2_path in ct2_results.items():\n",
    "                    if ct2_path:\n",
    "                        print(f\"\\n🧪 Testing {opt_name} optimization...\")\n",
    "                        test_result = ct2_converter.test_ct2_model(ct2_path)\n",
    "                        \n",
    "                        if test_result.get('success'):\n",
    "                            print(f\"✅ {opt_name}: {test_result['inference_time']:.3f}s inference\")\n",
    "                        else:\n",
    "                            print(f\"❌ {opt_name}: Test failed\")\n",
    "                \n",
    "                print(\"\\n🎉 CTranslate2 optimization complete!\")\n",
    "            else:\n",
    "                print(\"⏭️ CTranslate2 conversion skipped\")\n",
    "                print(\"💡 Set enable_ct2_conversion=True for optimization\")\n",
    "            \n",
    "            return True\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"\\n❌ Training failed: {e}\")\n",
    "            return False\n",
    "    else:\n",
    "        print(\"⏭️ Training skipped (demo mode)\")\n",
    "        print(\"💡 Set enable_training=True to start actual training\")\n",
    "    \n",
    "    # 6. Summary\n",
    "    print(\"\\n6️⃣ Pipeline Summary\")\n",
    "    print(f\"✅ Model: Enhanced Whisper for Faster-Whisper\")\n",
    "    print(f\"✅ Vocabulary: {len(processor.tokenizer):,} tokens\")\n",
    "    print(f\"✅ Training data: {train_size:,} samples\")\n",
    "    print(f\"✅ Dialects: {', '.join(config.target_dialects)}\")\n",
    "    print(f\"✅ CTranslate2 ready: {ct2_converter.check_ct2_availability()}\")\n",
    "    \n",
    "    print(\"\\n\" + \"=\" * 70)\n",
    "    print(\"🎯 FASTER-WHISPER PRODUCTION PIPELINE READY!\")\n",
    "    print(\"=\" * 70)\n",
    "    \n",
    "    return True\n",
    "\n",
    "# Execute the production pipeline\n",
    "print(\"🎯 Executing Faster-Whisper Production Pipeline...\")\n",
    "\n",
    "success = run_faster_whisper_production_pipeline(\n",
    "    enable_training=False,  # Set to True for actual training\n",
    "    enable_ct2_conversion=False,  # Set to True after training\n",
    "    max_train_samples=500   # Use subset for demo, None for full dataset\n",
    ")\n",
    "\n",
    "if success:\n",
    "    print(\"\\n🎉 Faster-Whisper production pipeline executed successfully!\")\n",
    "    print(\"\\n📋 Next steps:\")\n",
    "    print(\"  1. Set enable_training=True for actual training\")\n",
    "    print(\"  2. Set enable_ct2_conversion=True after training\")\n",
    "    print(\"  3. Use optimized models for production deployment\")\n",
    "else:\n",
    "    print(\"\\n❌ Pipeline execution failed\")"
   ]
