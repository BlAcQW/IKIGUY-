    "# Coqui dataset preparation and formatting\n",
    "class CoquiDatasetPreparer:\n",
    "    \"\"\"Prepare dataset in Coqui XTTS format.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: CoquiManifestConfig):\n",
    "        self.config = config\n",
    "        \n",
    "    def prepare_coqui_dataset(self, manifests: Dict[str, pd.DataFrame]) -> Path:\n",
    "        \"\"\"Convert manifests to Coqui XTTS dataset format.\"\"\"\n",
    "        print(\"📦 Preparing Coqui XTTS dataset from manifests...\")\n",
    "        \n",
    "        # Create dataset structure\n",
    "        dataset_dir = self.config.coqui_dataset_dir\n",
    "        audio_dir = dataset_dir / \"wavs\"\n",
    "        audio_dir.mkdir(parents=True, exist_ok=True)\n",
    "        \n",
    "        # Combine all manifests\n",
    "        all_samples = pd.DataFrame()\n",
    "        for split_name, df in manifests.items():\n",
    "            if not df.empty:\n",
    "                all_samples = pd.concat([all_samples, df], ignore_index=True)\n",
    "        \n",
    "        if all_samples.empty:\n",
    "            print(\"   ❌ No samples to process\")\n",
    "            return None\n",
    "        \n",
    "        print(f\"   📊 Processing {len(all_samples)} total samples\")\n",
    "        \n",
    "        # Process audio files and create metadata\n",
    "        metadata_lines = []\n",
    "        processed_count = 0\n",
    "        \n",
    "        for _, row in tqdm(all_samples.iterrows(), total=len(all_samples), desc=\"Processing audio\"):\n",
    "            try:\n",
    "                # Load and process audio\n",
    "                audio_path = Path(row['audio_path'])\n",
    "                if not audio_path.exists():\n",
    "                    continue\n",
    "                \n",
    "                # Load audio and resample to 22kHz if needed\n",
    "                audio, sr = librosa.load(audio_path, sr=self.config.sample_rate)\n",
    "                \n",
    "                # Apply basic audio processing\n",
    "                audio = self._process_audio_for_tts(audio)\n",
    "                \n",
    "                # Create output filename\n",
    "                dataset_name = row.get('dataset', 'unknown')\n",
    "                speaker_id = row['speaker_id']\n",
    "                original_stem = audio_path.stem\n",
    "                \n",
    "                output_filename = f\"{dataset_name}_{speaker_id}_{original_stem}.wav\"\n",
    "                output_path = audio_dir / output_filename\n",
    "                \n",
    "                # Save processed audio\n",
    "                sf.write(output_path, audio, self.config.sample_rate)\n",
    "                \n",
    "                # Clean text for TTS\n",
    "                cleaned_text = self._clean_text_for_tts(row['text'])\n",
    "                \n",
    "                if len(cleaned_text) > 0:\n",
    "                    # Create metadata line in Coqui format: wavs/filename.wav|text|speaker_name\n",
    "                    metadata_line = f\"wavs/{output_filename}|{cleaned_text}|{speaker_id}\"\n",
    "                    metadata_lines.append(metadata_line)\n",
    "                    processed_count += 1\n",
    "                    \n",
    "            except Exception as e:\n",
    "                print(f\"   ⚠️ Error processing {row.get('audio_path', 'unknown')}: {e}\")\n",
    "                continue\n",
    "        \n",
    "        print(f\"   ✅ Successfully processed {processed_count} samples\")\n",
    "        \n",
    "        # Create train/validation splits\n",
    "        self._create_train_val_splits(dataset_dir, metadata_lines)\n",
    "        \n",
    "        # Create dataset configuration\n",
    "        self._create_dataset_config(dataset_dir, all_samples)\n",
    "        \n",
    "        print(f\"   📁 Dataset prepared at: {dataset_dir}\")\n",
    "        return dataset_dir\n",
    "    \n",
    "    def _process_audio_for_tts(self, audio: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"Apply TTS-specific audio processing.\"\"\"\n",
    "        # Normalize audio\n",
    "        if audio.max() > 0:\n",
    "            audio = audio / audio.max() * 0.95\n",
    "        \n",
    "        # Apply gentle high-pass filter to remove low-frequency noise\n",
    "        from scipy import signal\n",
    "        try:\n",
    "            # High-pass filter at 50Hz\n",
    "            sos = signal.butter(2, 50, btype='high', fs=self.config.sample_rate, output='sos')\n",
    "            audio = signal.sosfilt(sos, audio)\n",
    "        except:\n",
    "            # If scipy not available, skip filtering\n",
    "            pass\n",
    "        \n",
    "        return audio.astype(np.float32)\n",
    "    \n",
    "    def _clean_text_for_tts(self, text: str) -> str:\n",
    "        \"\"\"Clean text for TTS training.\"\"\"\n",
    "        if not isinstance(text, str):\n",
    "            return \"\"\n",
    "        \n",
    "        # Basic cleaning\n",
    "        text = text.strip()\n",
    "        \n",
    "        # Remove excessive punctuation but keep basic punctuation\n",
    "        import re\n",
    "        text = re.sub(r'[^\\w\\sɛɔãẽĩõũáéíóúàèìòùŋ.,!?\\'\\-]', '', text)\n",
    "        \n",
    "        # Normalize whitespace\n",
    "        text = re.sub(r'\\s+', ' ', text)\n",
    "        \n",
    "        # Remove text that's too short or too long\n",
    "        if len(text) < 3 or len(text) > self.config.max_text_length:\n",
    "            return \"\"\n",
    "        \n",
    "        return text.strip()\n",
    "    \n",
    "    def _create_train_val_splits(self, dataset_dir: Path, metadata_lines: List[str]):\n",
    "        \"\"\"Create training and validation splits.\"\"\"\n",
    "        print(\"   📊 Creating train/validation splits...\")\n",
    "        \n",
    "        # Shuffle metadata\n",
    "        np.random.seed(42)\n",
    "        shuffled_lines = metadata_lines.copy()\n",
    "        np.random.shuffle(shuffled_lines)\n",
    "        \n",
    "        # 90/10 split\n",
    "        split_idx = int(len(shuffled_lines) * 0.9)\n",
    "        train_lines = shuffled_lines[:split_idx]\n",
    "        val_lines = shuffled_lines[split_idx:]\n",
    "        \n",
    "        # Save metadata files\n",
    "        with open(dataset_dir / \"metadata_train.csv\", 'w', encoding='utf-8') as f:\n",
    "            f.write('\\n'.join(train_lines))\n",
    "        \n",
    "        with open(dataset_dir / \"metadata_val.csv\", 'w', encoding='utf-8') as f:\n",
    "            f.write('\\n'.join(val_lines))\n",
    "        \n",
    "        print(f\"     Train: {len(train_lines)} samples\")\n",
    "        print(f\"     Validation: {len(val_lines)} samples\")\n",
    "    \n",
    "    def _create_dataset_config(self, dataset_dir: Path, samples: pd.DataFrame):\n",
    "        \"\"\"Create dataset configuration file.\"\"\"\n",
    "        config_info = {\n",
    "            \"dataset_name\": \"twi_xtts_manifests\",\n",
    "            \"language\": \"tw\",\n",
    "            \"sample_rate\": self.config.sample_rate,\n",
    "            \"total_samples\": len(samples),\n",
    "            \"unique_speakers\": samples['speaker_id'].nunique(),\n",
    "            \"total_duration_hours\": samples['duration'].sum() / 3600,\n",
    "            \"average_duration\": samples['duration'].mean(),\n",
    "            \"speaker_distribution\": samples['speaker_id'].value_counts().to_dict(),\n",
    "            \"created_from_manifests\": True,\n",
    "            \"manifest_source\": \"enhanced_multi_rate_data_processing\"\n",
    "        }\n",
    "        \n",
    "        with open(dataset_dir / \"dataset_config.json\", 'w', encoding='utf-8') as f:\n",
    "            json.dump(config_info, f, indent=2, ensure_ascii=False, default=str)\n",
    "        \n",
    "        print(f\"   📋 Dataset config saved with {len(samples)} samples\")\n",
    "\n",
    "# Prepare Coqui dataset if manifests are available\n",
    "if any(not df.empty for df in manifests.values()):\n",
    "    dataset_preparer = CoquiDatasetPreparer(config)\n",
    "    coqui_dataset_path = dataset_preparer.prepare_coqui_dataset(manifests)\n",
    "    \n",
    "    if coqui_dataset_path:\n",
    "        print(\"\\n✅ Coqui dataset preparation complete!\")\n",
    "        print(f\"   📁 Dataset location: {coqui_dataset_path}\")\n",
    "        print(f\"   🎵 Audio files: {len(list((coqui_dataset_path / 'wavs').glob('*.wav')))}\")\n",
    "    else:\n",
    "        print(\"❌ Failed to prepare Coqui dataset\")\n",
    "        coqui_dataset_path = None\n",
    "else:\n",
    "    print(\"⚠️ No valid manifests available for dataset preparation\")\n",
    "    coqui_dataset_path = None"
   ]
