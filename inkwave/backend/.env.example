# InkWave Backend Environment Variables
# Copy this file to .env and fill in the values

# App Configuration
DEBUG=False
API_HOST=0.0.0.0
API_PORT=8000

# Supabase (Authentication)
SUPABASE_URL=https://supabase.ailabsafrica.com/project/default
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# MongoDB
MONGODB_URI=mongodb://localhost:27017/inkwave
MONGODB_DB_NAME=inkwave

# PostgreSQL (pgvector for RAG)
POSTGRES_URI=postgresql://user:password@localhost:5432/inkwave

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI (STT/TTS)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Payment Gateways (Optional)
STRIPE_API_KEY=your_stripe_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
PAYSTACK_API_KEY=your_paystack_key_here

# Storage
STORAGE_PROVIDER=local
STORAGE_PATH=/opt/kasaai/apps/inkwave/storage

# RAG Configuration
RAG_RETRIEVAL_K=5
RAG_CONFIDENCE_THRESHOLD=0.7
RAG_TEMPERATURE=0.1

# Voice Configuration
MAX_RECORDING_DURATION=60
MAX_QUESTION_LENGTH=500

# Pricing (credits, 100 credits = $1)
PRICING_NARRATION_PER_MINUTE=2
PRICING_STT_PER_MINUTE=60
PRICING_TTS_PER_1K_CHARS=150
PRICING_RAG_PER_QUERY=30

# Free Trial
FREE_TRIAL_CREDITS=200
