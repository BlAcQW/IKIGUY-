    "# Enhanced manifest loader for Wav2Vec2\n",
    "class Wav2Vec2ManifestLoader:\n",
    "    \"\"\"Load ASR manifests optimized for Wav2Vec2 training.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: Wav2Vec2ManifestConfig):\n",
    "        self.config = config\n",
    "        \n",
    "    def load_wav2vec2_manifests(self) -> Dict[str, pd.DataFrame]:\n",
    "        \"\"\"Load Wav2Vec2 training manifests from enhanced processing pipeline.\"\"\"\n",
    "        print(\"📋 Loading Wav2Vec2 ASR manifests...\")\n",
    "        \n",
    "        manifests = {}\n",
    "        \n",
    "        # Primary manifest files for Wav2Vec2 (16kHz)\n",
    "        wav2vec2_manifest_files = {\n",
    "            'train': self.config.manifest_dir / 'wav2vec2_train.csv',\n",
    "            'val': self.config.manifest_dir / 'wav2vec2_val.csv'\n",
    "        }\n",
    "        \n",
    "        # Fallback to other ASR manifests\n",
    "        fallback_manifests = {\n",
    "            'train': [\n",
    "                self.config.manifest_dir / 'faster_whisper_train.csv',\n",
    "                self.config.manifest_dir / 'mms_train.csv',\n",
    "                self.config.data_dir / 'processed/manifests/asr_16k_dataset.csv'\n",
    "            ],\n",
    "            'val': [\n",
    "                self.config.manifest_dir / 'faster_whisper_val.csv',\n",
    "                self.config.manifest_dir / 'mms_val.csv',\n",
    "                self.config.data_dir / 'processed/manifests/asr_16k_dataset.csv'\n",
    "            ]\n",
    "        }\n",
    "        \n",
    "        for split_name in ['train', 'val']:\n",
    "            manifest_path = wav2vec2_manifest_files[split_name]\n",
    "            \n",
    "            if manifest_path.exists():\n",
    "                print(f\"   ✅ Found Wav2Vec2 manifest: {manifest_path.name}\")\n",
    "                try:\n",
    "                    df = pd.read_csv(manifest_path)\n",
    "                    manifests[split_name] = self._validate_wav2vec2_manifest(df, split_name)\n",
    "                except Exception as e:\n",
    "                    print(f\"   ⚠️ Error loading {manifest_path}: {e}\")\n",
    "                    manifests[split_name] = pd.DataFrame()\n",
    "            else:\n",
    "                print(f\"   ⚠️ Wav2Vec2 manifest not found: {manifest_path.name}\")\n",
    "                print(f\"   🔄 Looking for fallback manifests...\")\n",
    "                \n",
    "                # Try fallback manifests\n",
    "                fallback_df = self._load_fallback_manifests(fallback_manifests[split_name])\n",
    "                \n",
    "                if not fallback_df.empty:\n",
    "                    # Split fallback data if needed\n",
    "                    if split_name == 'val' and 'train' not in manifests:\n",
    "                        train_size = int(0.9 * len(fallback_df))\n",
    "                        if split_name == 'train':\n",
    "                            fallback_df = fallback_df.iloc[:train_size]\n",
    "                        else:\n",
    "                            fallback_df = fallback_df.iloc[train_size:]\n",
    "                    \n",
    "                    manifests[split_name] = self._validate_wav2vec2_manifest(fallback_df, split_name)\n",
    "                else:\n",
    "                    print(f\"   ❌ No valid manifests found for {split_name}\")\n",
    "                    manifests[split_name] = self._create_dummy_wav2vec2_manifest()\n",
    "        \n",
    "        return manifests\n",
    "    \n",
    "    def _load_fallback_manifests(self, fallback_paths: List[Path]) -> pd.DataFrame:\n",
    "        \"\"\"Load fallback manifests and combine them.\"\"\"\n",
    "        combined_df = pd.DataFrame()\n",
    "        \n",
    "        for fallback_path in fallback_paths:\n",
    "            if fallback_path.exists():\n",
    "                print(f\"   ✅ Using fallback: {fallback_path.name}\")\n",
    "                try:\n",
    "                    df = pd.read_csv(fallback_path)\n",
    "                    combined_df = pd.concat([combined_df, df], ignore_index=True)\n",
    "                except Exception as e:\n",
    "                    print(f\"   ⚠️ Error loading {fallback_path}: {e}\")\n",
    "                    continue\n",
    "        \n",
    "        return combined_df\n",
    "    \n",
    "    def _validate_wav2vec2_manifest(self, df: pd.DataFrame, split_name: str) -> pd.DataFrame:\n",
    "        \"\"\"Validate and format manifest for Wav2Vec2 training.\"\"\"\n",
    "        print(f\"   🔍 Validating {split_name} manifest for Wav2Vec2...\")\n",
    "        \n",
    "        if df.empty:\n",
    "            return df\n",
    "        \n",
    "        # Required columns for Wav2Vec2 ASR\n",
    "        required_columns = ['audio_path', 'transcript']\n",
    "        \n",
    "        # Map common column variations\n",
    "        column_mappings = {\n",
    "            'text': 'transcript',\n",
    "            'transcription': 'transcript',\n",
    "            'sentence': 'transcript',\n",
    "            'audio': 'audio_path',\n",
    "            'path': 'audio_path',\n",
    "            'file_path': 'audio_path',\n",
    "            'processed_audio_path': 'audio_path'\n",
    "        }\n",
    "        \n",
    "        for old_col, new_col in column_mappings.items():\n",
    "            if old_col in df.columns and new_col not in df.columns:\n",
    "                df = df.rename(columns={old_col: new_col})\n",
    "                print(f\"   🔄 Mapped {old_col} → {new_col}\")\n",
    "        \n",
    "        # Check required columns\n",
    "        missing_columns = set(required_columns) - set(df.columns)\n",
    "        if missing_columns:\n",
    "            print(f\"   ❌ Missing required columns: {missing_columns}\")\n",
    "            return pd.DataFrame()\n",
    "        \n",
    "        # Add optional columns\n",
    "        if 'duration' not in df.columns:\n",
    "            df['duration'] = 5.0  # Default duration\n",
    "        if 'language' not in df.columns:\n",
    "            df['language'] = 'tw'\n",
    "        if 'speaker_id' not in df.columns:\n",
    "            df['speaker_id'] = 'unknown'\n",
    "        \n",
    "        # Quality filtering\n",
    "        initial_count = len(df)\n",
    "        \n",
    "        # Filter valid audio files\n",
    "        df['audio_exists'] = df['audio_path'].apply(lambda x: Path(x).exists() if pd.notna(x) else False)\n",
    "        df = df[df['audio_exists']].drop(columns=['audio_exists'])\n",
    "        \n",
    "        # Filter valid transcripts\n",
    "        df = df[df['transcript'].str.len() > 0]\n",
    "        \n",
    "        # Filter audio duration (Wav2Vec2 works well with <20s)\n",
    "        if 'duration' in df.columns:\n",
    "            df = df[(df['duration'] >= 1.0) & (df['duration'] <= self.config.max_audio_length)]\n",
    "        \n",
    "        final_count = len(df)\n",
    "        retention_rate = (final_count / initial_count * 100) if initial_count > 0 else 0\n",
    "        \n",
    "        print(f\"   📊 {split_name}: {final_count}/{initial_count} samples retained ({retention_rate:.1f}%)\")\n",
    "        \n",
    "        return df\n",
    "    \n",
    "    def _create_dummy_wav2vec2_manifest(self) -> pd.DataFrame:\n",
    "        \"\"\"Create dummy manifest for Wav2Vec2 testing.\"\"\"\n",
    "        print(\"   📝 Creating dummy Wav2Vec2 manifest...\")\n",
    "        \n",
    "        dummy_dir = self.config.data_dir / 'dummy_audio_wav2vec2'\n",
    "        dummy_dir.mkdir(parents=True, exist_ok=True)\n",
    "        \n",
    "        samples = [\n",
    "            \"Wo ho te sɛn? Me ho yɛ.\",\n",
    "            \"Me ma wo akye.\",\n",
    "            \"Nante yie.\",\n",
    "            \"Me da wo ase.\",\n",
    "            \"Ɛyɛ dɛn?\",\n",
    "            \"Mepɛ aduane.\",\n",
    "            \"Ɛyɛ anɔpa anum.\",\n",
    "            \"Me kɔ sukuu.\",\n",
    "            \"Ɛyɛ awiɛ nsia.\",\n",
    "            \"Me frɛ wo.\"\n",
    "        ]\n",
    "        \n",
    "        dummy_data = []\n",
    "        for i, text in enumerate(samples):\n",
    "            audio_file = dummy_dir / f\"wav2vec2_dummy_{i:03d}.wav\"\n",
    "            \n",
    "            if not audio_file.exists():\n",
    "                # Create varied duration audio (3-10 seconds)\n",
    "                duration = np.random.uniform(3.0, 10.0)\n",
    "                dummy_audio = np.random.normal(0, 0.1, int(16000 * duration)).astype(np.float32)\n",
    "                sf.write(audio_file, dummy_audio, 16000)\n",
    "            \n",
    "            dummy_data.append({\n",
    "                'audio_path': str(audio_file),\n",
    "                'transcript': text,\n",
    "                'duration': sf.info(str(audio_file)).duration,\n",
    "                'language': 'tw',\n",
    "                'speaker_id': f'wav2vec2_dummy_{i % 3}',\n",
    "                'dataset': 'dummy_wav2vec2'\n",
    "            })\n",
    "        \n",
    "        return pd.DataFrame(dummy_data)\n",
    "\n",
    "# Load manifests\n",
    "manifest_loader = Wav2Vec2ManifestLoader(config)\n",
    "manifests = manifest_loader.load_wav2vec2_manifests()\n",
    "\n",
    "print(f\"\\n📊 Wav2Vec2 Manifest Summary:\")\n",
    "for split_name, df in manifests.items():\n",
    "    print(f\"   {split_name}: {len(df)} samples\")\n",
    "    if not df.empty:\n",
    "        print(f\"     Unique speakers: {df['speaker_id'].nunique()}\")\n",
    "        print(f\"     Total duration: {df['duration'].sum()/60:.1f} minutes\")\n",
    "        print(f\"     Average duration: {df['duration'].mean():.1f}s\")\n",
    "        print(f\"     Languages: {df['language'].unique()}\")"
   ]
