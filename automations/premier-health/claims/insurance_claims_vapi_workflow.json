      "id": "mongodb_insert_claim",
      "name": "MongoDB - Insert Claim",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1,
      "position": [750, 400],
      "credentials": {
        "mongoDb": {
          "id": "mongoDbCredentials",
          "name": "MongoDB Claims DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Validate and process claim data\nconst claim = $input.item.json;\n\n// Claim validation rules\nconst validationRules = {\n  requiredFields: ['customerName', 'customerPhone', 'claimType', 'description'],\n  claimTypes: ['auto', 'home', 'health', 'life', 'property'],\n  maxAmount: 1000000,\n  phoneRegex: /^[+]?[1-9]\\d{1,14}$/\n};\n\n// Validate required fields\nfor (const field of validationRules.requiredFields) {\n  if (!claim[field]) {\n    return {\n      json: {\n        valid: false,\n        error: `Missing required field: ${field}`\n      }\n    };\n  }\n}\n\n// Validate claim type\nif (!validationRules.claimTypes.includes(claim.claimType)) {\n  return {\n    json: {\n      valid: false,\n      error: `Invalid claim type: ${claim.claimType}`\n    }\n  };\n}\n\n// Validate phone number\nif (!validationRules.phoneRegex.test(claim.customerPhone)) {\n  return {\n    json: {\n      valid: false,\n      error: 'Invalid phone number format'\n    }\n  };\n}\n\n// Validate amount\nif (claim.amount && claim.amount > validationRules.maxAmount) {\n  return {\n    json: {\n      valid: false,\n      error: `Claim amount exceeds maximum: ${validationRules.maxAmount}`\n    }\n  };\n}\n\n// Generate claim ID\nconst claimId = `CLM-${Date.now()}-${Math.random().toString(36).substr(2, 9).toUpperCase()}`;\n\n// Calculate priority based on claim type and amount\nlet priority = 'normal';\nif (claim.amount > 50000) priority = 'high';\nif (claim.claimType === 'health' && claim.urgent) priority = 'urgent';\n\n// Return validated and enriched claim\nreturn {\n  json: {\n    valid: true,\n    claimId: claimId,\n    ...claim,\n    priority: priority,\n    status: 'pending_review',\n    createdAt: new Date().toISOString()\n  }\n};"
      },
      "id": "code_validate_claim",
      "name": "Code - Validate & Process Claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.valid }}",
              "operation": "true"
            }
          ]
        }
      },
      "id": "if_claim_valid",
      "name": "IF - Claim Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "fromEmail": "claims@insurance.com",
        "toEmail": "={{ $json.customerEmail }}",
        "subject": "Claim #{{ $json.claimId }} Received",
        "emailType": "html",
        "message": "<h2>Dear {{ $json.customerName }},</h2>\n<p>We have received your insurance claim with the following details:</p>\n<ul>\n<li><strong>Claim ID:</strong> {{ $json.claimId }}</li>\n<li><strong>Type:</strong> {{ $json.claimType }}</li>\n<li><strong>Status:</strong> {{ $json.status }}</li>\n<li><strong>Amount:</strong> ${{ $json.amount }}</li>\n</ul>\n<p>We will process your claim within 24-48 hours. You will receive updates via email and SMS.</p>\n<p>For urgent inquiries, please call our hotline or use the claim status checker on our website.</p>\n<br>\n<p>Best regards,<br>Insurance Claims Team</p>",
        "options": {
          "attachments": "={{ $json.attachments }}"
        }
      },
      "id": "email_confirmation",
      "name": "Email - Send Confirmation",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [900, 300],
      "credentials": {
        "smtp": {
          "id": "smtpCredentials",
          "name": "SMTP Server"
        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "SMS",
        "operation": "send",
        "from": "={{ $env.TWILIO_PHONE_NUMBER }}",
        "to": "={{ $json.customerPhone }}",
        "message": "Your insurance claim #{{ $json.claimId }} has been received and is being processed. Current status: {{ $json.status }}. Reply STOP to unsubscribe."
      },
      "id": "twilio_sms",
      "name": "Twilio - Send SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [900, 400],
      "credentials": {
        "twilioApi": {
