    "class AdvancedCT2Converter:\n",
    "    \"\"\"Advanced CTranslate2 converter with multiple optimization options.\"\"\"\n",
    "    \n",
    "    def __init__(self, config: OptimizedFasterWhisperConfig):\n",
    "        self.config = config\n",
    "        \n",
    "    def check_ct2_availability(self) -> bool:\n",
    "        \"\"\"Check if CTranslate2 tools are available.\"\"\"\n",
    "        try:\n",
    "            result = subprocess.run(\n",
    "                [\"ct2-transformers-converter\", \"--help\"], \n",
    "                capture_output=True, \n",
    "                text=True, \n",
    "                timeout=10\n",
    "            )\n",
    "            if result.returncode == 0:\n",
    "                print(\"✅ CTranslate2 converter available\")\n",
    "                return True\n",
    "            else:\n",
    "                print(\"⚠️ CTranslate2 converter not working properly\")\n",
    "                return False\n",
    "        except (subprocess.TimeoutExpired, FileNotFoundError):\n",
    "            print(\"❌ CTranslate2 converter not found\")\n",
    "            print(\"   Install with: pip install ctranslate2\")\n",
    "            return False\n",
    "    \n",
    "    def convert_model_to_ct2(self, model_path: Path, quantization: str = None) -> Optional[Path]:\n",
    "        \"\"\"Convert Whisper model to CTranslate2 format with advanced options.\"\"\"\n",
    "        if not self.check_ct2_availability():\n",
    "            return None\n",
    "        \n",
    "        if quantization is None:\n",
    "            quantization = self.config.ct2_quantization\n",
    "        \n",
    "        output_path = self.config.ct2_output_dir / f\"whisper_ct2_{quantization}\"\n",
    "        output_path.mkdir(parents=True, exist_ok=True)\n",
    "        \n",
    "        print(f\"🔄 Converting to CTranslate2 format...\")\n",
    "        print(f\"📂 Input: {model_path}\")\n",
    "        print(f\"📂 Output: {output_path}\")\n",
    "        print(f\"⚙️ Quantization: {quantization}\")\n",
    "        \n",
    "        # Prepare conversion command\n",
    "        cmd = [\n",
    "            \"ct2-transformers-converter\",\n",
    "            \"--model\", str(model_path),\n",
    "            \"--output_dir\", str(output_path),\n",
    "            \"--quantization\", quantization,\n",
    "            \"--force\"\n",
    "        ]\n",
    "        \n",
    "        try:\n",
    "            print(f\"🔧 Running: {' '.join(cmd)}\")\n",
    "            result = subprocess.run(\n",
    "                cmd, \n",
    "                capture_output=True, \n",
    "                text=True, \n",
    "                timeout=600  # 10 minutes timeout\n",
    "            )\n",
    "            \n",
    "            if result.returncode == 0:\n",
    "                print(f\"✅ CTranslate2 conversion successful!\")\n",
    "                \n",
    "                # Check output files\n",
    "                model_file = output_path / \"model.bin\"\n",
    "                config_file = output_path / \"config.json\"\n",
    "                \n",
    "                if model_file.exists() and config_file.exists():\n",
    "                    model_size = model_file.stat().st_size / (1024 * 1024)  # MB\n",
    "                    print(f\"📊 Model size: {model_size:.1f} MB\")\n",
    "                    print(f\"📁 Files: {list(output_path.glob('*'))}\")\n",
    "                    \n",
    "                    # Save conversion metadata\n",
    "                    metadata = {\n",
    "                        'source_model': str(model_path),\n",
    "                        'quantization': quantization,\n",
    "                        'model_size_mb': model_size,\n",
    "                        'conversion_date': pd.Timestamp.now().isoformat(),\n",
    "                        'files': [f.name for f in output_path.iterdir()]\n",
    "                    }\n",
    "                    \n",
    "                    with open(output_path / \"conversion_metadata.json\", 'w') as f:\n",
    "                        json.dump(metadata, f, indent=2)\n",
    "                    \n",
    "                    return output_path\n",
    "                else:\n",
    "                    print(f\"❌ Expected output files not found\")\n",
    "                    return None\n",
    "            else:\n",
    "                print(f\"❌ CTranslate2 conversion failed:\")\n",
    "                print(f\"   STDOUT: {result.stdout}\")\n",
    "                print(f\"   STDERR: {result.stderr}\")\n",
    "                return None\n",
    "                \n",
    "        except subprocess.TimeoutExpired:\n",
    "            print(\"❌ CTranslate2 conversion timed out\")\n",
    "            return None\n",
    "        except Exception as e:\n",
    "            print(f\"❌ CTranslate2 conversion error: {e}\")\n",
    "            return None\n",
    "    \n",
    "    def create_multiple_optimizations(self, model_path: Path) -> Dict[str, Optional[Path]]:\n",
    "        \"\"\"Create multiple CTranslate2 optimizations for different use cases.\"\"\"\n",
    "        print(\"🔄 Creating multiple CTranslate2 optimizations...\")\n",
    "        \n",
    "        optimizations = {\n",
    "            'int8': 'int8',  # Smallest size\n",
    "            'int8_float16': 'int8_float16',  # Balanced\n",
    "            'float16': 'float16'  # Highest quality\n",
    "        }\n",
    "        \n",
    "        results = {}\n",
    "        \n",
    "        for name, quantization in optimizations.items():\n",
    "            print(f\"\\n🎯 Creating {name} optimization...\")\n",
    "            result_path = self.convert_model_to_ct2(model_path, quantization)\n",
    "            results[name] = result_path\n",
    "            \n",
    "            if result_path:\n",
    "                print(f\"✅ {name} optimization complete: {result_path}\")\n",
    "            else:\n",
    "                print(f\"❌ {name} optimization failed\")\n",
    "        \n",
    "        # Create summary\n",
    "        summary = {\n",
    "            'created_optimizations': {k: str(v) if v else None for k, v in results.items()},\n",
    "            'successful_count': sum(1 for v in results.values() if v is not None),\n",
    "            'total_count': len(results),\n",
    "            'creation_date': pd.Timestamp.now().isoformat()\n",
    "        }\n",
    "        \n",
    "        summary_file = self.config.ct2_output_dir / \"optimization_summary.json\"\n",
    "        with open(summary_file, 'w') as f:\n",
    "            json.dump(summary, f, indent=2)\n",
    "        \n",
    "        print(f\"\\n📊 Optimization Summary:\")\n",
    "        print(f\"  Successful: {summary['successful_count']}/{summary['total_count']}\")\n",
    "        print(f\"  Summary saved: {summary_file}\")\n",
    "        \n",
    "        return results\n",
    "    \n",
    "    def test_ct2_model(self, ct2_model_path: Path, test_audio: str = None) -> Dict:\n",
    "        \"\"\"Test CTranslate2 model functionality.\"\"\"\n",
    "        if not FASTER_WHISPER_AVAILABLE:\n",
    "            print(\"⚠️ Faster-Whisper not available for testing\")\n",
    "            return {'error': 'faster-whisper not available'}\n",
    "        \n",
    "        print(f\"🧪 Testing CTranslate2 model: {ct2_model_path}\")\n",
    "        \n",
    "        try:\n",
    "            # Load model\n",
    "            model = WhisperModel(\n",
    "                str(ct2_model_path),\n",
    "                device=DEVICE,\n",
    "                compute_type=self.config.ct2_compute_type\n",
    "            )\n",
    "            \n",
    "            print(\"✅ Model loaded successfully\")\n",
    "            \n",
    "            # Create or use test audio\n",
    "            if test_audio is None or not Path(test_audio).exists():\n",
    "                # Create test audio\n",
    "                test_audio_path = DIRS['base'] / \"test_audio_ct2.wav\"\n",
    "                duration = 3.0\n",
    "                sample_rate = 16000\n",
    "                t = np.linspace(0, duration, int(sample_rate * duration))\n",
    "                audio = 0.3 * np.sin(2 * np.pi * 440 * t) * np.exp(-t/2)\n",
    "                sf.write(test_audio_path, audio.astype(np.float32), sample_rate)\n",
    "                test_audio = str(test_audio_path)\n",
    "            \n",
    "            # Test transcription\n",
    "            start_time = time.time()\n",
    "            segments, info = model.transcribe(\n",
    "                test_audio,\n",
    "                beam_size=3,\n",
    "                language=self.config.base_language\n",
    "            )\n",
    "            inference_time = time.time() - start_time\n",
    "            \n",
    "            # Process results\n",
    "            transcription = \" \".join([segment.text for segment in segments])\n",
    "            \n",
    "            results = {\n",
    "                'success': True,\n",
    "                'transcription': transcription,\n",
    "                'inference_time': inference_time,\n",
    "                'detected_language': info.language,\n",
    "                'language_probability': info.language_probability,\n",
    "                'duration': info.duration\n",
    "            }\n",
    "            \n",
    "            print(f\"✅ Test successful!\")\n",
    "            print(f\"📝 Transcription: {transcription}\")\n",
    "            print(f\"⏱️ Inference time: {inference_time:.3f}s\")\n",
    "            \n",
    "            return results\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Test failed: {e}\")\n",
    "            return {'success': False, 'error': str(e)}\n",
    "\n",
    "# Initialize CTranslate2 converter\n",
    "ct2_converter = AdvancedCT2Converter(config)\n",
    "\n",
    "print(\"🎯 Advanced CTranslate2 converter ready!\")\n",
    "print(\"💡 After training, use: ct2_converter.convert_model_to_ct2(model_path)\")"
   ]
