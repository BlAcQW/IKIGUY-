        assistant-id="baa69b3a-8944-4557-9ef9-3a5aa6956eb3"
        mode="voice"
        theme="dark"
        base-bg-color="#000000"
        accent-color="#14B8A6"
        cta-button-color="#14B8A6"
        cta-button-text-color="#ffffff"
        border-radius="large"
        size="full"
        position="bottom-right"
        title="Talk to Ama, Premier Apomoden"
        start-button-text="Start Call"
        end-button-text="End Call"
        chat-first-message="Maakye! I'm Ama, your Premier Health assistant. How can I help you today? You can ask me in English or Twi."
